---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const semua = (await getCollection('guides')).sort((a, b) => b.data.diperbarui.getTime() - a.data.diperbarui.getTime());
const situs = new URL('/', Astro.site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: situs },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/en/guides', Astro.site).href },
    ],
  },
];
---

<Base
  title="Roofing guides for Indonesia, in English | Atapura"
  description="Plain-English guides to asphalt shingle roofs in Indonesia: costs, tropical climate, villas in Bali, and what to ask an installer. Written by Atapura, Jakarta."
  schema={schema}
  lang="en"
  alternates={[{ hreflang: 'en', href: '/en/guides' }, { hreflang: 'id', href: '/panduan' }]}
>
  <Header terang lang="en" />
  <main class="eg">
    <div class="wrap">
      <nav class="remah" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Guides</span></nav>
      <div class="eg-kepala">
        <h1 class="eg-judul">Roofing in Indonesia, <span class="redup">explained in English.</span></h1>
        <p class="eg-lead">For expats, villa owners, and investors building or renovating in Indonesia. Our main site is in Indonesian; these guides cover what you need to decide and ask.</p>
      </div>
      <ul class="eg-daftar">
        {semua.map((a) => (
          <li><a href={`/en/guides/${a.id}`}><span>{a.data.kategori}</span><b>{a.data.judul}</b><em>{a.data.ringkasan}</em></a></li>
        ))}
      </ul>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .eg { background: var(--color-embun); color: var(--color-tinta); padding: 120px 0 6rem; }
  .remah { display: flex; gap: 0.5rem; font-size: 0.88rem; color: var(--color-lumut); }
  .remah a { color: inherit; }
  .eg-kepala { margin: 2rem 0 3rem; display: grid; gap: 1.25rem 4rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 60rem) { .eg-kepala { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: end; } }
  .eg-judul { font-size: clamp(2.4rem, 1.3rem + 4vw, 4.8rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; max-width: 16ch; }
  .redup { opacity: 0.55; }
  .eg-lead { font-size: 1.1rem; color: var(--color-lumut); max-width: 42ch; }
  .eg-daftar { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
  .eg-daftar a { display: grid; gap: 0.45rem; height: 100%; padding: 1.4rem; border-radius: 16px; background: var(--color-putih); color: inherit; text-decoration: none; transition: transform 400ms var(--ease-out), box-shadow 400ms var(--ease-out); }
  .eg-daftar a:hover { transform: translateY(-3px); box-shadow: 0 20px 36px -24px rgb(16 35 30 / 0.35); }
  .eg-daftar span { font-size: 0.8rem; color: var(--color-lumut); }
  .eg-daftar b { font-size: 1.25rem; font-weight: 500; letter-spacing: -0.02em; line-height: 1.25; }
  .eg-daftar em { font-style: normal; color: var(--color-lumut); font-size: 0.93rem; line-height: 1.45; }
  @media (max-width: 47.99rem) {
    .eg { padding-top: 96px; }
    .eg-judul { font-size: var(--hp-display); line-height: 1.05; }
    .eg-lead { font-size: 1rem; }
    .eg-daftar b { font-size: var(--hp-t4); }
    .eg-daftar em { font-size: 0.9375rem; }
  }
</style>
