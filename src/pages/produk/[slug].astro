---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import { LINI, fotoWarna, produk, rentangProduk, sampulProduk, type Produk } from '../../data/produk';
import { bagianRentang, estimasiPublik, harga } from '../../data/harga';
import KartuProduk from '../../components/KartuProduk.astro';
import GaleriProduk from '../../components/GaleriProduk.astro';
import { bisnis, waLink } from '../../data/bisnis';

export function getStaticPaths() {
  return produk.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Produk };
const situs = new URL('/', Astro.site).href;
const url = new URL(`/produk/${p.slug}`, Astro.site).href;
const L = LINI[p.lini];
// Judul: "Atap bitumen CTI", "Plafon Shunda"; rangka cukup nama lininya.
const [judulA, judulB] = p.lini === 'rangka' ? ['Rangka', 'baja ringan'] : [L.nama, p.nama];
const namaPanjang = p.lini === 'rangka' ? p.nama.toLowerCase() : `${L.nama.toLowerCase()} ${p.nama}`;
const lain = produk.filter((x) => x.slug !== p.slug && x.lini === p.lini);
const pesan = `Halo Atapura, saya mau tanya ${namaPanjang}.`;
// Kalkulator /hitung menerima ?merek= (atap atau plafon) dan langsung memilihnya.
const bisaDihitung = Boolean(p.harga) || p.lini === 'plafon';
const rentang = rentangProduk(p);
const genteng = p.lini === 'atap' && p.harga ? harga.merek[p.harga].genteng : null;
// Contoh total untuk 100 m² supaya angka per m² langsung terbayang (riset UX katalog: perkiraan total dekat tombol).
const contoh = rentang && bagianRentang(rentang[0] * 100, rentang[1] * 100);
// Lama pasang atap dari produktivitas tim di Ops (sama dengan Hitung AKAL); rangka menulisnya di fakta sendiri.
const hari = p.lini === 'atap' && p.harga ? estimasiPublik(100, p.harga).hari : null;
// Jaminan per lini (rangka & survey plafon: nilai sementara hasil riset 18 Nov, dikoreksi Bang Yusuf Kamis 19 Nov).
const jaminan: Record<Produk['lini'], string[]> = {
  atap: [`Garansi pemasangan ${bisnis.garansiPemasanganTahun} tahun`, 'Survey gratis di Jabodetabek'],
  plafon: ['Garansi pemasangan 1 tahun', 'Survey gratis di Jabodetabek'],
  rangka: ['Garansi pemasangan 5 tahun', 'Survey gratis di Jabodetabek'], // SEMENTARA, koreksi Kamis 19 Nov
};
const sampul = sampulProduk(p);
// Galeri atas: ilustrasi penerapan dulu (konteks), lalu close-up tiap seri (detail produk).
const galeri = [
  ...p.penerapan.map((g) => ({ src: g.gambar, alt: g.alt })),
  ...p.seri.flatMap((x) => (x.foto ? [{ src: x.foto, alt: `Close-up ${namaPanjang} ${x.nama} terpasang` }] : [])),
];
const kelompokUrl = new URL(`/produk#judul-${p.lini}`, Astro.site).href;
const namaSaja = (g: Produk['warna'][number]) => g.daftar.every((w) => !w.hex && !fotoWarna(g.tekstur, w.nama));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${url}#produk`,
    name: `${judulA} ${judulB}`,
    ...(p.lini !== 'rangka' && { brand: { '@type': 'Brand', name: p.nama } }),
    description: p.ringkas,
    category: L.kategori,
    ...(sampul && { image: new URL(sampul.src.src, Astro.site).href }),
    // Harga produk = harga genteng per m² (material); harga terpasang ada di Service di bawah (DECISIONS 078).
    ...(genteng && {
      offers: {
        '@type': 'Offer', priceCurrency: 'IDR', price: genteng, seller: { '@id': `${situs}#bisnis` },
        priceSpecification: { '@type': 'UnitPriceSpecification', price: genteng, priceCurrency: 'IDR', unitCode: 'MTK', unitText: 'm²' },
      },
    }),
    url,
    ...(p.seri.length && { model: p.seri.map((s) => s.nama).join(', ') }),
  },
  ...(rentang ? [{
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${url}#pasang`,
    name: `Pemasangan ${namaPanjang}`,
    serviceType: p.lini === 'rangka' ? 'Pemasangan rangka atap baja ringan' : 'Pemasangan atap bitumen',
    provider: { '@id': `${situs}#bisnis` },
    areaServed: 'Jabodetabek',
    offers: { '@type': 'AggregateOffer', priceCurrency: 'IDR', lowPrice: rentang[0], highPrice: rentang[1], description: 'Harga terpasang per m² di Jabodetabek' },
  }] : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: situs },
      { '@type': 'ListItem', position: 2, name: 'Produk & layanan', item: new URL('/produk', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: L.nama, item: kelompokUrl },
      ...(p.lini !== 'rangka' ? [{ '@type': 'ListItem', position: 4, name: p.nama, item: url }] : []),
    ],
  },
];
---

<Base title={`${p.judul} | Atapura`} description={p.ringkas} schema={schema}>
  <Header terang hitungHref={bisaDihitung ? `/hitung?merek=${encodeURIComponent(p.nama)}` : undefined} pesanWa={pesan} />
  <main class="pr">
    <section class="pr-buka">
      <div class="wrap pr-buka-isi">
        <div class="pr-teks">
          <nav class="remah" aria-label="Remah roti"><a href="/">Beranda</a><span aria-hidden="true">/</span><a href="/produk">Produk &amp; layanan</a><span aria-hidden="true">/</span>{p.lini === 'rangka' ? <span>{L.nama}</span> : <><a href={`/produk#judul-${p.lini}`}>{L.nama}</a><span aria-hidden="true">/</span><span>{p.nama}</span></>}</nav>
          <h1 class="pr-judul">{judulA} <span class="redup">{judulB}</span></h1>
          <GaleriProduk foto={galeri} />
          <p class="pr-lead">{p.ringkas}</p>
        </div>
        <aside class="slip" aria-label={`Ringkasan ${p.nama}`}>
          <dl class="slip-daftar">
            {p.fakta.map((f) => <div><dt>{f.label}</dt><dd>{f.nilai}</dd></div>)}
            {hari && <div><dt>Lama pasang</dt><dd>±{harga.m2PerHari[0]}–{harga.m2PerHari[1]} m² per hari</dd></div>}
          </dl>
          {contoh && (
            <p class="slip-contoh">
              Contoh 100 m²: <b>±Rp{contoh.min}–{contoh.max} {contoh.satuan === 'jt' ? 'juta' : 'ribu'}</b> terpasang{hari && <>, <span class="tanpa-putus">sekitar {hari[0]}–{hari[1]} hari kerja</span></>}
            </p>
          )}
          <div class="slip-aksi">
            {bisaDihitung && <a class="pill pill-tunas" href={`/hitung?merek=${encodeURIComponent(p.nama)}`}>Hitung biaya dengan {p.nama}</a>}
            <a class:list={['pill', bisaDihitung ? 'pill-garis' : 'pill-tunas']} href={waLink(pesan)} target="_blank" rel="noopener" data-wa="produk">Tanya {p.lini === 'rangka' ? namaPanjang : p.nama} lewat WhatsApp</a>
          </div>
          {jaminan[p.lini].length > 0 && (
            <ul class="slip-jaminan">
              {jaminan[p.lini].map((j) => <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 10.5 3.2 3L15 6.5" /></svg>{j}</li>)}
            </ul>
          )}
          {!p.terverifikasi && <p class="slip-kaki">Spesifikasi dan garansi pabrik akan kami tulis setelah dokumen resmi masuk.</p>}
        </aside>
        <div class="pr-tentang-blok">
          {p.tentang.map((t) => <p class="pr-tentang">{t}</p>)}
        </div>
      </div>
    </section>

    {p.seri.length > 0 && (
      <section class="pr-sek pr-putih" aria-labelledby="judul-seri">
        <div class="wrap">
          <h2 id="judul-seri" class="pr-h2">Pilihan {L.pilihan}{p.lini !== 'rangka' && <> <span class="redup">{p.nama}</span></>}</h2>
          <ul class="seri">
            {p.seri.map((s) => (
              <li class:list={['seri-baris', { 'seri-tanpa-foto': !s.foto }]}>
                {s.foto && <Image src={s.foto} alt={`Close-up ${namaPanjang} ${s.nama} terpasang, memperlihatkan bentuknya`} widths={[480, 800, 1200]} sizes="(min-width: 60rem) 30vw, 100vw" class="seri-foto" />}
                <div class="seri-teks">
                  <h3 class="seri-nama">{s.nama}</h3>
                  <p class="seri-ringkas">{s.ringkas}</p>
                </div>
                <dl class="rinci">
                  {s.spek.map((k) => <div><dt>{k.label}</dt><dd>{k.nilai}</dd></div>)}
                </dl>
              </li>
            ))}
          </ul>
          {p.seri.some((s) => s.foto) && <p class="pr-catatan">Foto di atas adalah ilustrasi bentuk setelah terpasang, bukan foto proyek Atapura. Sampel fisik kami bawa saat survey.</p>}
        </div>
      </section>
    )}

    {p.lini !== 'rangka' && <section class="pr-sek" aria-labelledby="judul-warna">
      <div class="wrap">
        <h2 id="judul-warna" class="pr-h2">Pilihan {L.corak}</h2>
        {p.warna.length > 0 ? (
          <>
            {p.warna.map((g, gi) => {
              const isi = (<>
                {g.catatan && <p class="pr-catatan">{g.catatan}</p>}
                <ul class:list={['warna', { 'warna-nama-saja': namaSaja(g) }]}>
                  {g.daftar.map((w) => (
                    <li><button type="button" class="warna-pilih" aria-pressed="false" data-pilih={`${w.nama}${w.kode ? ` (${w.kode})` : ''}`}>
                      {fotoWarna(g.tekstur, w.nama)
                        ? <Image src={fotoWarna(g.tekstur, w.nama)} alt={`Contoh warna ${namaPanjang} ${w.nama}`} widths={[240, 480]} sizes="10rem" class="contoh-warna" />
                        : w.hex && <span class="contoh-warna" style={`--w: ${w.hex}`} aria-hidden="true"></span>}
                      <span class="warna-nama">{w.nama}</span>
                      {w.kode && <span class="warna-kode">{w.kode}</span>}
                    </button></li>
                  ))}
                </ul>
              </>);
              // Daftar motif tanpa foto (plafon) dilipat per kelompok supaya halaman HP tidak memanjang; kelompok pertama terbuka.
              return namaSaja(g) ? (
                <details class="warna-grup motif-grup" open={gi === 0}>
                  <summary><span class="warna-judul">{g.judul}</span><span class="motif-jumlah">{g.daftar.length} motif</span><svg class="motif-tanda" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 8 4.5 4.5L14.5 8" /></svg></summary>
                  {isi}
                </details>
              ) : (
                <div class="warna-grup">
                  <h3 class="warna-judul">{g.judul}</h3>
                  {isi}
                </div>
              );
            })}
            {L.corak === 'motif'
              ? <p class="pr-catatan">Nama dan kode motif dari katalog resmi pabrik. Foto motif asli kami kirim lewat WhatsApp, dan sampel fisiknya kami bawa saat survey.</p>
              : <p class="pr-catatan">Warna di layar adalah perkiraan dan bisa berbeda dari aslinya. Saat survey kami membawa sampel fisik supaya Anda bisa melihatnya di bawah cahaya rumah sendiri.</p>}
            {/* Pilihan warna/motif yang diketuk masuk ke pesan WhatsApp (diatur skrip di bawah). */}
            <div class="pilihan-wa" data-pilihan-wa hidden>
              <p class="pilihan-teks" aria-live="polite">{L.corak === 'motif' ? 'Motif' : 'Warna'} dipilih: <b data-pilihan-nama></b></p>
              <a class="pill pill-tunas" href={waLink(pesan)} target="_blank" rel="noopener" data-wa="produk-warna" data-pesan={pesan} data-corak={L.corak}>Tanya {L.corak} ini lewat WhatsApp</a>
            </div>
          </>
        ) : (
          <p class="slot">Daftar {L.corak} {p.nama} akan kami tampilkan setelah katalog resmi masuk. Sampel fisik bisa Anda lihat saat survey.</p>
        )}
      </div>
    </section>}

    <section class="pr-sek pr-gelap" aria-labelledby="judul-penerapan">
      <div class="wrap">
        <h2 id="judul-penerapan" class="pr-h2">Penerapan di lapangan</h2>
        {p.penerapan.length > 0 ? (
          <ul class:list={['penerapan', { 'penerapan-satu': p.penerapan.length === 1 }]}>
            {p.penerapan.map((g) => (
              <li>
                <figure>
                  <Image src={g.gambar} alt={g.alt} widths={[640, 1024, 1600]} sizes={p.penerapan.length === 1 ? '(min-width: 64rem) 80vw, 100vw' : '(min-width: 60rem) 45vw, 100vw'} class="penerapan-foto" />
                  <figcaption>{g.keterangan}. <span>Ilustrasi, bukan proyek Atapura.</span></figcaption>
                </figure>
              </li>
            ))}
          </ul>
        ) : (
          <p class="slot slot-gelap">Ilustrasi penerapan {p.nama} kami tampilkan setelah spesifikasi resminya masuk, supaya gambarnya sesuai produk aslinya.</p>
        )}
      </div>
    </section>

    <section class="pr-sek pr-putih" aria-labelledby="judul-garansi">
      <div class="wrap pr-dua">
        <div>
          <h2 id="judul-garansi" class="pr-h2">Garansi</h2>
          <p class="pr-isi">{p.garansi}</p>
        </div>
        {p.aksesori.length > 0 && (
          <div>
            <h2 class="pr-h2">Aksesori pendukung</h2>
            <dl class="aksesori">
              {p.aksesori.map((a) => <div><dt>{a.nama}</dt><dd>{a.isi}</dd></div>)}
            </dl>
          </div>
        )}
      </div>
    </section>

    <section class="pr-sek" aria-labelledby="judul-lain">
      <div class="wrap">
        <h2 id="judul-lain" class="pr-h2">{lain.length ? `Merek ${L.nama.toLowerCase()} lain yang kami pasang` : 'Produk lain'}</h2>
        <ul class="lain">
          {(lain.length ? lain : produk.filter((x) => x.lini !== p.lini)).map((x) => <li><KartuProduk p={x} lengkap /></li>)}
        </ul>
        {p.sumber.length > 0 && (
          <div class="sumber">
            <h2 class="sumber-judul">Sumber data</h2>
            <ul>{p.sumber.map((s) => <li>{s.url ? <a href={s.url} rel="noopener" target="_blank">{s.nama}</a> : s.nama}</li>)}</ul>
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  // Ketuk contoh warna/motif: tandai terpilih (satu saja), tampilkan tombol WA berisi pilihan itu.
  const kotak = document.querySelector<HTMLElement>('[data-pilihan-wa]');
  const tautan = kotak?.querySelector<HTMLAnchorElement>('a');
  const nama = kotak?.querySelector<HTMLElement>('[data-pilihan-nama]');
  document.querySelectorAll<HTMLButtonElement>('.warna-pilih').forEach((b) => {
    b.addEventListener('click', () => {
      const aktif = b.getAttribute('aria-pressed') !== 'true';
      document.querySelectorAll('.warna-pilih[aria-pressed="true"]').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      b.setAttribute('aria-pressed', String(aktif));
      if (!kotak || !tautan || !nama) return;
      kotak.hidden = !aktif;
      if (!aktif) return;
      const pilih = b.dataset.pilih ?? '';
      nama.textContent = pilih;
      const url = new URL(tautan.href);
      url.searchParams.set('text', `${tautan.dataset.pesan?.replace(/\.$/, '')}, ${tautan.dataset.corak} ${pilih}.`);
      tautan.href = url.toString();
    });
  });
</script>

<style>
  .pr { background: var(--color-embun); color: var(--color-tinta); }
  .remah { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: var(--fs-14); color: var(--color-lumut); }
  .remah a { color: inherit; }
  .redup { opacity: 0.55; }

  .pr-buka { padding: 120px 0 clamp(3rem, 6vw, 5rem); }
  .pr-buka-isi { display: grid; gap: 2.5rem 4rem; grid-template-columns: minmax(0, 1fr); align-items: start; }
  /* Laptop: kiri judul + galeri + penjelasan, kanan slip harga. HP: urutan DOM (judul, galeri,
     ringkasan, slip harga & tombol, baru penjelasan) supaya harga & tombol terlihat sebelum banyak menggulir. */
  @media (min-width: 60rem) {
    .pr-buka-isi { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); row-gap: 0; }
    .pr-teks { grid-column: 1; grid-row: 1; }
    .pr-tentang-blok { grid-column: 1; grid-row: 2; }
    .slip { grid-column: 2; grid-row: 1 / span 2; align-self: start; }
  }
  .pr-judul { margin-top: 1.5rem; font-size: var(--t-d2); font-weight: var(--bobot-judul); letter-spacing: -0.035em; line-height: 1.04; }
  .pr-lead { margin-top: 1.25rem; font-size: clamp(1.125rem, 1rem + 0.4vw, 1.35rem); line-height: 1.5; max-width: 40ch; }
  .pr-tentang { margin-top: 1rem; color: var(--color-lumut); line-height: 1.5; max-width: 62ch; }

  .slip {
    position: relative; padding: 2.4rem 1.6rem 1.6rem; background: var(--color-putih); border-radius: 0 0 1.25rem 1.25rem;
    filter: drop-shadow(0 26px 30px rgb(16 35 30 / 0.16)) drop-shadow(0 6px 10px rgb(16 35 30 / 0.08));
    clip-path: polygon(0 22px, 50% 0, 100% 22px, 100% 100%, 0 100%);
  }
  .slip-daftar > div { display: flex; align-items: baseline; gap: 0.6rem; padding: 0.7rem 0; }
  .slip-daftar dt { color: var(--color-lumut); font-size: var(--fs-15); white-space: nowrap; display: flex; align-items: baseline; gap: 0.6rem; flex: 1; }
  .slip-daftar dt::after { content: ''; flex: 1; border-bottom: 1px dotted var(--color-garis); transform: translateY(-0.25rem); }
  .slip-daftar dd { font-weight: 500; text-align: right; max-width: 60%; font-variant-numeric: tabular-nums; }
  .slip-aksi { display: grid; gap: 0.6rem; margin-top: 1.4rem; }
  .slip-aksi .pill { justify-content: center; }
  .slip-contoh { margin-top: 0.75rem; padding: 0.7rem 0.85rem; border-radius: 12px; background: var(--color-embun); font-size: var(--fs-14); color: var(--color-lumut); font-variant-numeric: tabular-nums; }
  .slip-contoh b { color: var(--color-tinta); font-weight: 500; }
  .slip-jaminan { display: grid; gap: 0.4rem; margin-top: 1rem; }
  .slip-jaminan li { display: flex; align-items: center; gap: 0.5rem; font-size: var(--fs-14); color: var(--color-lumut); }
  .slip-jaminan svg { flex: none; width: 1.05rem; height: 1.05rem; fill: none; stroke: var(--color-pinus); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .slip-kaki { margin-top: 1rem; font-size: var(--fs-14); color: var(--color-lumut); line-height: 1.45; }

  .pr-sek { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .pr-putih { background: var(--color-putih); }
  .pr-gelap { background: var(--color-pinus); color: var(--color-embun); }
  .pr-h2 { font-size: var(--t-h1); font-weight: var(--bobot-judul); letter-spacing: -0.025em; line-height: 1.1; max-width: 22ch; }
  .pr-catatan { margin-top: 1.25rem; font-size: var(--fs-15); color: var(--color-lumut); max-width: 70ch; }
  .pr-isi { margin-top: 1rem; line-height: 1.5; max-width: 62ch; }

  .seri { margin-top: 2.25rem; border-top: 1px solid var(--color-tinta); }
  .seri-baris { display: grid; gap: 1.25rem 3rem; grid-template-columns: minmax(0, 1fr); padding: 1.75rem 0; border-bottom: 1px solid var(--color-garis); align-items: start; }
  @media (min-width: 60rem) { .seri-baris { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr) minmax(0, 1fr); } }
  @media (min-width: 60rem) { .seri-tanpa-foto { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); } }
  .seri-foto { width: 100%; max-width: 26rem; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 14px; display: block; }
  .seri-nama { font-size: var(--t-h3); font-weight: var(--bobot-judul); letter-spacing: -0.011em; line-height: 1.27; }
  .seri-ringkas { margin-top: 0.4rem; color: var(--color-lumut); line-height: 1.5; max-width: 46ch; }
  .rinci > div { display: flex; align-items: baseline; gap: 0.6rem; padding: 0.45rem 0; font-size: var(--fs-15); }
  .rinci dt { color: var(--color-lumut); display: flex; align-items: baseline; gap: 0.6rem; flex: 1; white-space: nowrap; }
  .rinci dt::after { content: ''; flex: 1; border-bottom: 1px dotted var(--color-garis); transform: translateY(-0.25rem); }
  .rinci dd { font-weight: 500; text-align: right; font-variant-numeric: tabular-nums lining-nums; }

  .warna-grup { margin-top: 2rem; }
  .warna-judul { font-size: var(--t-title); font-weight: var(--bobot-judul-kartu); letter-spacing: -0.006em; line-height: 1.4; }
  .warna { display: grid; gap: 1.25rem 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr)); margin-top: 1rem; }
  @media (max-width: 47.99rem) { .warna { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 0.75rem; } }
  .warna li { display: grid; }
  .warna-pilih { display: grid; gap: 0.3rem; width: 100%; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; border-radius: 0.85rem; }
  .warna-pilih:focus-visible { outline: 2px solid var(--color-pinus); outline-offset: 3px; }
