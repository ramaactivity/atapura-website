---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { LINI, produk, layanan, type Lini } from '../../data/produk';
import KartuProduk from '../../components/KartuProduk.astro';
import IkonLayanan from '../../components/IkonLayanan.astro';
import { TAMPIL_PLAFON, waLink } from '../../data/bisnis';
import { aksesoris, rupiah } from '../../data/aksesoris';
import { harga, tanggalPanjang } from '../../data/harga';

const situs = new URL('/', Astro.site).href;
// Catatan harga di bawah tiap kelompok lini.
const catatanLini: Record<Lini, string> = {
  atap: 'Harga terpasang untuk Jabodetabek dengan spek standar, belum termasuk rangka baru.',
  plafon: 'Harga terpasang untuk Jabodetabek, termasuk rangka hollow dan jasa pasang.',
  rangka: 'Harga terpasang termasuk material, aksesori, dan jasa pasang.',
};
const kelompok = (Object.keys(LINI) as Lini[]).map((l) => ({ l, daftar: produk.filter((p) => p.lini === l) })).filter((k) => k.daftar.length);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: situs },
      { '@type': 'ListItem', position: 2, name: 'Produk & layanan', item: new URL('/produk', Astro.site).href },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: produk.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.lini === 'rangka' ? p.nama : `${LINI[p.lini].nama} ${p.nama}`, url: new URL(`/produk/${p.slug}`, Astro.site).href })),
  },
];
---

<Base
  title={TAMPIL_PLAFON ? 'Produk & layanan: atap bitumen, plafon PVC, rangka baja ringan | Atapura' : 'Produk & layanan: atap bitumen, rangka baja ringan, aksesoris | Atapura'}
  description={TAMPIL_PLAFON
    ? 'Atap bitumen 5 merek, plafon PVC Shunda dan Javafon, serta rangka baja ringan Taso, Hi-Steel, K-Steel, lengkap dengan harga terpasang per m² di Jabodetabek.'
    : 'Atap bitumen 5 merek, rangka baja ringan Taso, Hi-Steel, K-Steel, dan aksesoris atap, lengkap dengan harga terpasang per m² di Jabodetabek.'}
  schema={schema}
>
  <Header terang />
  <main class="pk">
    <div class="wrap">
      <div class="kartu-buka">
        <nav class="remah" aria-label="Remah roti"><a href="/">Beranda</a><span aria-hidden="true">/</span><span>Produk &amp; layanan</span></nav>
        <div class="pk-kepala">
          <h1 class="pk-judul">{TAMPIL_PLAFON ? 'Dari rangka sampai plafon,' : 'Dari rangka sampai genteng,'} <span class="redup">satu tim yang pasang.</span></h1>
          <p class="pk-lead">{TAMPIL_PLAFON ? 'Atap bitumen, plafon PVC, dan rangka baja ringan' : 'Atap bitumen dan rangka baja ringan'} dari merek yang kami pasang sendiri. Harga terpasang per m² tertulis di tiap produk, berlaku sejak {tanggalPanjang(harga.berlakuSejak)}.</p>
        </div>
        <nav class="pk-lompat" aria-label="Lompat ke jenis produk">
          {kelompok.map(({ l, daftar }) => <a href={`#judul-${l}`}>{LINI[l].nama}<span>{daftar.length}</span></a>)}
          <a href="#judul-aksesoris">Aksesoris<span>{aksesoris.length}</span></a>
          <a href="#judul-layanan">Layanan<span>{layanan.length}</span></a>
        </nav>
      </div>

      {kelompok.map(({ l, daftar }) => (
      <section aria-labelledby={`judul-${l}`} class="pk-lini">
        <h2 id={`judul-${l}`} class="pk-h2">{LINI[l].nama}</h2>
        <ul class="katalog">
          {daftar.map((p) => <li><KartuProduk p={p} /></li>)}
        </ul>
        <p class="pk-catatan">{catatanLini[l]}</p>
      </section>
      ))}

      <section aria-labelledby="judul-aksesoris" class="pk-lini pk-aksesoris">
        <h2 id="judul-aksesoris" class="pk-h2">Aksesoris</h2>
        <ul class="ak">
          {aksesoris.map((a) => (
            <li><a href={`/produk/aksesoris#${a.slug}`}>
              <span class="ak-teks"><b>{a.nama}</b><span>{a.spek[0].label} {a.spek[0].nilai}</span></span>
              <span class="ak-harga">{a.harga ? <>{a.harga.catatan === 'mulai' && 'mulai '}{rupiah(a.harga.nilai)}<span> / {a.harga.satuan}</span></> : <span>Tanya admin</span>}</span>
            </a></li>
          ))}
        </ul>
        <p class="pk-catatan">Harga material per satuan; rangka sudah dengan pasang. Papan alas, lapis kedap, flashing, paku, dan skrup sudah termasuk di harga terpasang atap. <a href="/produk/aksesoris">Lihat ukuran dan fungsinya</a></p>
      </section>

      <section aria-labelledby="judul-layanan" class="pk-layanan">
        <h2 id="judul-layanan" class="pk-h2">Layanan</h2>
        <ul class="layanan">
          {layanan.map((l) => (
            <li><a href={l.href}>
              <span class="layanan-ikon"><IkonLayanan nama={l.ikon} /></span>
              <span class="layanan-teks"><b>{l.nama}</b><span>{l.isi}</span></span>
              <span class="layanan-panah" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="m8 5 5 5-5 5" /></svg></span>
            </a></li>
          ))}
        </ul>
        <a class="pill pill-tunas pk-wa" href={waLink(TAMPIL_PLAFON ? 'Halo Atapura, saya mau tanya soal atap, plafon, atau rangka baja ringan.' : 'Halo Atapura, saya mau tanya soal atap atau rangka baja ringan.')} target="_blank" rel="noopener" data-wa="produk-indeks">Tanya lewat WhatsApp</a>
      </section>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .pk { background: var(--color-embun); color: var(--color-tinta); padding: 120px 0 6rem; }
  .remah { display: flex; gap: 0.5rem; font-size: var(--fs-14); color: var(--color-lumut); }
  .remah a { color: inherit; }
  .redup { opacity: 0.55; }
  .pk-kepala { margin: 2rem 0 3.5rem; display: grid; gap: 1.25rem 4rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 60rem) { .pk-kepala { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: end; } }
  .pk-judul { font-size: clamp(2.4rem, 1.3rem + 4vw, 4.8rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; max-width: 14ch; }
  .pk-lead { font-size: var(--fs-18); color: var(--color-lumut); max-width: 42ch; line-height: 1.5; }
  .pk-h2 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem); font-weight: 500; letter-spacing: -0.035em; }
  .pk-lini + .pk-lini { margin-top: 4rem; }
  .pk-h2 { scroll-margin-top: 96px; }
  .pk-lompat { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: -1.5rem 0 2.5rem; }
  .pk-lompat a { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0 1rem; border-radius: 999px; background: var(--color-putih); color: var(--color-tinta); font-size: var(--fs-15); text-decoration: none; box-shadow: inset 0 0 0 1px var(--color-garis); transition: background-color 250ms, color 250ms; }
  .pk-lompat span { font-size: var(--fs-13); color: var(--color-lumut); font-variant-numeric: tabular-nums; }
  .pk-lompat a:focus-visible { outline: 2px solid var(--color-pinus); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) { .pk-lompat a:hover { background: var(--color-pinus); color: var(--color-embun); } .pk-lompat a:hover span { color: var(--color-tunas); } }
  .pk-catatan { margin-top: 1rem; font-size: var(--fs-15); color: var(--color-lumut); }

  .katalog { display: grid; gap: 0.85rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); margin-top: 1.25rem; }

  .pk-aksesoris { margin-top: 4rem; }
  /* Aksesoris: baris ringkas tanpa foto (nama, ukuran, harga per satuan); detail & ilustrasi di /produk/aksesoris. */
  .ak { display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); margin-top: 1.25rem; }
  .ak a {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 100%; min-height: 4rem;
    padding: 0.85rem 1.1rem; border-radius: 16px; background: var(--color-putih); color: inherit; text-decoration: none;
    box-shadow: 0 1px 2px rgb(16 35 30 / 0.06), 0 10px 24px -20px rgb(16 35 30 / 0.3);
    transition: transform 420ms var(--ease-out), box-shadow 420ms var(--ease-out);
  }
  .ak-teks { display: grid; gap: 0.15rem; min-width: 0; }
  .ak-teks b { font-size: var(--fs-16); font-weight: 500; letter-spacing: -0.015em; line-height: 1.3; }
  .ak-teks span { color: var(--color-lumut); font-size: var(--fs-14); line-height: 1.4; }
  .ak-harga { flex: none; font-weight: 500; font-variant-numeric: tabular-nums lining-nums; text-align: right; }
  .ak-harga span { font-weight: 400; font-size: var(--fs-14); color: var(--color-lumut); }
  .ak a:active { transform: scale(0.98); }
  .ak a:focus-visible { outline: 2px solid var(--color-pinus); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .ak a:hover { transform: translateY(-2px); box-shadow: 0 1px 2px rgb(16 35 30 / 0.06), 0 18px 34px -22px rgb(16 35 30 / 0.45); }
  }
  .pk-catatan a { color: var(--color-pinus); text-underline-offset: 3px; }
  .pk-layanan { margin-top: 4.5rem; }
  /* Kartu layanan = baris ala aplikasi di semua lebar: ikon, teks singkat, tanda masuk. */
  .layanan { display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); margin-top: 1.25rem; }
  .layanan a {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.9rem; height: 100%;
    padding: 0.9rem 1rem 0.9rem 0.9rem; border-radius: 16px; background: var(--color-putih); color: inherit; text-decoration: none;
    box-shadow: 0 1px 2px rgb(16 35 30 / 0.06), 0 10px 24px -20px rgb(16 35 30 / 0.3);
    transition: transform 420ms var(--ease-out), box-shadow 420ms var(--ease-out);
  }
  .layanan-ikon { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 14px; background: var(--color-embun); color: var(--color-pinus); transition: background-color 300ms, color 300ms; }
  .layanan-ikon :global(.ikon-layanan) { width: 1.6rem; height: 1.6rem; }
  .layanan-teks { display: grid; gap: 0.15rem; }
  .layanan-teks b { font-size: var(--fs-16); font-weight: 500; letter-spacing: -0.015em; line-height: 1.3; }
  .layanan-teks span { color: var(--color-lumut); font-size: var(--fs-14); line-height: 1.4; }
  .layanan-panah { display: grid; place-items: center; width: 1.25rem; color: var(--color-lumut); transition: color 300ms, transform 420ms var(--ease-out); }
  .layanan-panah svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .layanan a:active { transform: scale(0.98); }
  .layanan a:focus-visible { outline: 2px solid var(--color-pinus); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .layanan a:hover { transform: translateY(-2px); box-shadow: 0 1px 2px rgb(16 35 30 / 0.06), 0 18px 34px -22px rgb(16 35 30 / 0.45); }
    .layanan a:hover .layanan-ikon { background: var(--color-pinus); color: var(--color-tunas); }
    .layanan a:hover .layanan-panah { color: var(--color-pinus); transform: translateX(2px); }
  }
  @media (max-width: 47.99rem) {
    .layanan { gap: 0.5rem; }
    .layanan-ikon { width: 2.75rem; height: 2.75rem; border-radius: 12px; }
    .layanan-ikon :global(.ikon-layanan) { width: 1.45rem; height: 1.45rem; }
    .layanan-teks b { font-size: var(--fs-15); }
    .layanan-teks span { font-size: var(--fs-13); }
  }
  .pk-wa { margin-top: 1.75rem; }

  @media (max-width: 47.99rem) {
    .pk { background: #dde2dc; padding-top: 96px; }
    .kartu-buka { margin: 0 calc(8px - var(--gutter)) 1.25rem; padding: 1.5rem var(--gutter) 0.25rem; border-radius: 28px; background: var(--color-embun); }
    .kartu-buka .pk-kepala { margin-bottom: 1.5rem; }
    .pk-judul { font-size: var(--hp-display); line-height: 1.05; }
    .pk-lead { font-size: var(--fs-16); }
    .pk-h2 { font-size: var(--hp-t1); }
    .katalog { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  }
</style>
