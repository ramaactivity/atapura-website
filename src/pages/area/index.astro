---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { bisnis, waLink } from '../../data/bisnis';

const semua = (await getCollection('area')).sort((a, b) => a.data.urut - b.data.urut);
const kelompok = (['Jabodetabek', 'Luar Jabodetabek'] as const).map((w) => ({ w, isi: semua.filter((a) => a.data.wilayah === w) }));
const situs = new URL('/', Astro.site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: situs },
      { '@type': 'ListItem', position: 2, name: 'Area layanan', item: new URL('/area', Astro.site).href },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: semua.map((a, i) => ({ '@type': 'ListItem', position: i + 1, name: a.data.judul, url: new URL(`/area/${a.id}`, Astro.site).href })),
  },
];
---

<Base
  title="Area layanan pasang atap bitumen | Atapura"
  description={`Atapura memasang atap bitumen di seluruh Jabodetabek dan melayani proyek di luar Jabodetabek. Kondisi iklim dan atap tiap daerah.`}
  schema={schema}
>
  <Header terang />
  <main class="ae">
    <div class="wrap">
      <div class="kartu-buka">
      <nav class="remah" aria-label="Remah roti"><a href="/">Beranda</a><span aria-hidden="true">/</span><span>Area layanan</span></nav>
      <div class="ae-kepala">
        <h1 class="ae-judul">Atap di daerah Anda, <span class="redup">dengan hujan dan udaranya sendiri.</span></h1>
        <p class="ae-lead">Curah hujan, ketinggian, dan jarak ke laut berbeda tiap daerah, begitu juga yang perlu diperhatikan pada atapnya. Survey gratis di Jabodetabek; di luar itu harga dihitung bersama admin.</p>
      </div>
      </div>
      {kelompok.filter((k) => k.isi.length).map((k) => (
        <section class="ae-grup" id={k.w.toLowerCase().replace(/ /g, '-')} aria-label={k.w}>
          <h2 class="ae-grup-judul">{k.w}</h2>
          <ul class="ae-daftar">
            {k.isi.map((a) => (
              <li><a href={`/area/${a.id}`}><b>{a.data.nama}</b><span>{a.data.ringkasan}</span></a></li>
            ))}
          </ul>
        </section>
      ))}
      <section class="ae-penutup" aria-labelledby="ae-penutup-judul">
        <h2 id="ae-penutup-judul" class="ae-penutup-judul">Lokasi Anda tidak ada di daftar? <span class="redup">Tetap kami kerjakan.</span></h2>
        <div>
          <p>Hitung dulu biaya atapnya. Di luar Jabodetabek, ongkos kirim material dan transport tukang dihitung bersama admin.</p>
          <div class="ae-aksi">
            <a class="pill pill-tunas" href="/hitung">Hitung estimasi biaya</a>
            <a class="ae-tautan" href={waLink('Halo Atapura, saya mau tanya pemasangan atap di lokasi saya.')} target="_blank" rel="noopener" data-wa="area-indeks">Tanya lokasi lewat WhatsApp</a>
          </div>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .ae { background: var(--color-embun); color: var(--color-tinta); padding: 120px 0 6rem; }
  .remah { display: flex; gap: 0.5rem; font-size: var(--fs-14); color: var(--color-lumut); }
  .remah a { color: inherit; }
  .ae-kepala { margin: 2rem 0 3rem; display: grid; gap: 1.25rem 4rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 60rem) { .ae-kepala { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: end; } }
  .ae-judul { font-size: var(--t-d2); font-weight: var(--bobot-judul); letter-spacing: -0.035em; line-height: 1.04; max-width: 16ch; }
  .redup { opacity: 0.55; }
  .ae-lead { font-size: var(--fs-18); color: var(--color-lumut); max-width: 42ch; }
  .ae-grup { margin-top: 3rem; }
  .ae-grup-judul { font-size: var(--t-h3); font-weight: var(--bobot-judul); letter-spacing: -0.011em; margin-bottom: 1rem; line-height: 1.27; }
  .ae-daftar { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .ae-daftar a { display: grid; gap: 0.4rem; height: 100%; padding: 1.25rem 1.4rem; border-radius: 16px; background: var(--color-putih); color: inherit; text-decoration: none; transition: transform 400ms var(--ease-out), box-shadow 400ms var(--ease-out); }
  .ae-daftar a:hover { transform: translateY(-3px); box-shadow: 0 20px 36px -24px rgb(16 35 30 / 0.35); }
  .ae-daftar b { font-size: var(--t-title); font-weight: var(--bobot-judul-kartu); letter-spacing: -0.006em; line-height: 1.4; }
  .ae-daftar span { color: var(--color-lumut); font-size: var(--fs-15); line-height: 1.45; }

  .ae-penutup { margin-top: clamp(3.5rem, 7vw, 5.5rem); padding-top: clamp(2.5rem, 5vw, 3.5rem); border-top: 1px solid var(--color-garis); display: grid; gap: 1.25rem 5rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 60rem) { .ae-penutup { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: start; } }
  .ae-penutup-judul { font-size: var(--t-h1); font-weight: var(--bobot-judul); letter-spacing: -0.025em; line-height: 1.1; max-width: 18ch; }
  .ae-penutup p { font-size: var(--fs-16); line-height: 1.5; color: var(--color-lumut); max-width: 52ch; }
  .ae-aksi { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 2rem; margin-top: 1.5rem; }
  .ae-tautan { display: inline-flex; align-items: center; min-height: 44px; font-weight: 500; color: var(--color-pinus); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .ae-aksi a:focus-visible { outline: 2px solid var(--color-pinus); outline-offset: 3px; }

  @media (max-width: 47.99rem) {
    .ae { padding-top: 96px; padding-bottom: 8px; }
    .ae-penutup { margin: 1.25rem calc(8px - var(--gutter)) 0; padding: 2rem var(--gutter); border-top: 0; border-radius: 28px; background: var(--color-embun); }
    .ae-penutup-judul { font-size: var(--hp-t1); }
    .ae-penutup p { font-size: var(--fs-16); }
    .ae-aksi .pill { width: 100%; }
    .ae-judul { font-size: var(--hp-display); line-height: 1.05; }
    .ae-lead { font-size: var(--fs-16); }
    .ae-grup-judul { font-size: var(--hp-t2); }
    .ae-daftar b { font-size: var(--hp-t4); }
    .ae-daftar span { font-size: var(--fs-15); }
    /* Pola kartu HP sama dengan beranda. */
    .ae { background: #dde2dc; }
    .kartu-buka { margin: 0 calc(8px - var(--gutter)) 1.25rem; padding: 1.5rem var(--gutter) 0.25rem; border-radius: 28px; background: var(--color-embun); }
    .kartu-buka .ae-kepala { margin-bottom: 1.5rem; }
  }
</style>
