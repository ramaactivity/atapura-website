---
import { getCollection, render } from 'astro:content';
import Artikel from '../../layouts/Artikel.astro';

export async function getStaticPaths() {
  const semua = await getCollection('panduan');
  return semua.map((a) => ({ params: { slug: a.id }, props: { a, semua } }));
}

const { a, semua } = Astro.props;
const { Content } = await render(a);
const d = a.data;
const url = new URL(`/panduan/${a.id}`, Astro.site).href;
const situs = new URL('/', Astro.site).href;
const lain = semua.filter((x) => x.id !== a.id).slice(0, 3).map((x) => ({ href: `/panduan/${x.id}`, label: x.data.kategori, judul: x.data.judul }));

const artikel = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.judul,
  description: d.ringkasan,
  datePublished: d.terbit.toISOString(),
  dateModified: d.diperbarui.toISOString(),
  inLanguage: 'id-ID',
  author: { '@type': 'Organization', name: d.penulis, url: situs },
  publisher: { '@id': `${situs}#bisnis` },
  mainEntityOfPage: url,
  ...(d.sumber.length && { citation: d.sumber.map((s) => (s.url ? { '@type': 'CreativeWork', name: s.nama, url: s.url } : s.nama)) }),
};
---

<Artikel
  judul={d.judul} ringkasan={d.ringkasan} jawaban={d.jawaban} penulis={d.penulis} diperbarui={d.diperbarui}
  sampul={d.sampul} sampulAlt={d.sampulAlt} induk={{ nama: 'Panduan', href: '/panduan' }} label={d.kategori}
  faq={d.faq} sumber={d.sumber} lain={lain} schema={[artikel]}
  waPesan={`Halo Atapura, saya baru membaca panduan "${d.judul}" dan mau bertanya.`} dataWa="artikel"
>
  <Content />
</Artikel>
