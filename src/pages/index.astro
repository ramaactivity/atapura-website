  .c-pinus { background: var(--color-pinus); }
  .terang { color: var(--color-tinta); }
  .gelap { color: var(--color-embun); }
  /* Skala judul beranda (DECISIONS 085, acuan referensi Rama): hero ±59 px di 1230 px, judul bagian ±39 px (rasio ±1,5),
     penutup di antaranya. Tidak ada judul bagian yang lebih besar dari hero. */
  .judul-2 { font-size: var(--t-h1); font-weight: var(--bobot-judul); letter-spacing: -0.025em; line-height: 1.1; max-width: 20ch; }
  .lead { font-size: var(--fs-18); line-height: 1.5; max-width: 44ch; color: var(--color-lumut); }
  .gelap .lead { color: var(--embun-redup); }
  .kepala { display: grid; gap: 1.5rem 4rem; grid-template-columns: minmax(0, 1fr); margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 60rem) { .kepala { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: end; } }

  /* Hero: foto penuh, satu ajakan. Desktop: teks gelap di atas langit; HP: teks putih di bawah foto. */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: clip; isolation: isolate; background: #cfdde4; }
  /* Foto lahir di komponen Foto, jadi selektornya global; <picture> dijadikan lapisan latar. */
  .hero :global(picture) { position: absolute; inset: 0; z-index: -2; }
  :global(.hero-foto) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 40%; z-index: -2; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgb(10 20 16 / 0.92) 0%, rgb(10 20 16 / 0.68) 45%, transparent 75%); }
  .hero-isi { width: 100%; padding-bottom: clamp(2.5rem, 6vh, 4rem); color: var(--color-putih); }
  /* Judul dua baris: "Atap bitumen," / "harga masuk akal." (baris kedua diredupkan; HP: "akal." Tunas). */
  .hero-judul { display: flex; flex-direction: column; font-size: var(--t-d1); line-height: 1; letter-spacing: -0.033em; font-weight: var(--bobot-judul); }
  /* Tablet & HP (teks putih di atas foto gelap): baris kedua putih redup, "akal." Tunas. */
  .hero-redup { color: rgb(255 255 255 / 0.62); }
  .hero-akal { font-weight: inherit; color: var(--color-tunas); }
  /* Label di atas judul (tetap di dalam h1 untuk SEO): chip kaca kecil di desktop. */
  .hero-h1-sub {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem; padding: 0.5rem 1rem 0.5rem 0.85rem;
    border-radius: 999px; font-size: var(--fs-14); font-weight: 500; line-height: 1.2; letter-spacing: 0;
    background: rgb(255 255 255 / 0.12); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
  }
  .hero-h1-sub::before { content: ''; flex: none; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .hero-sub { margin-top: 1.25rem; max-width: 44ch; font-size: var(--fs-18); line-height: 1.5; }
  .hero-aksi { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .hero-aksi .pill { min-height: 54px; padding-inline: 1.6rem; font-size: var(--fs-16); }
  .hero-utama { background: var(--color-tunas); color: var(--color-pinus); }
  /* Tiga jaminan berikon di bawah tombol (acuan Logamax). */
  .hero-bukti { display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; margin-top: 1.75rem; }
  .hero-bukti li { display: inline-flex; align-items: center; gap: 0.45rem; font-size: var(--fs-14); font-weight: 500; }
  .hero-bukti svg { flex: none; width: 1.15rem; height: 1.15rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  @media (min-width: 64rem) {
    .hero-utama { background: var(--color-pinus); color: var(--color-putih); }
  }
  .ilustrasi { position: absolute; right: var(--gutter); bottom: 0.9rem; font-size: var(--fs-13); color: rgb(255 255 255 / 0.8); }
  @media (min-width: 64rem) {
    /* Hero sedikit di bawah satu layar supaya deret logo merek mengintip di layar pertama. */
    .hero { align-items: center; min-height: calc(100svh - 5.5rem); }
    .hero::before { background: linear-gradient(90deg, rgb(242 244 241 / 0.95) 0%, rgb(242 244 241 / 0.8) 40%, transparent 66%); }
    .hero-isi { color: var(--color-pinus); padding-top: 96px; padding-bottom: 2rem; }
    .baris { white-space: nowrap; }
    .hero-redup { color: rgb(16 35 30 / 0.6); }
    .hero-akal { color: inherit; }
    .hero-h1-sub { background: rgb(255 255 255 / 0.55); box-shadow: inset 0 0 0 1px rgb(16 35 30 / 0.1); }
    /* Lebih gelap dari Lumut + 450: ujung kalimat jatuh di atas daun kelapa di foto (masukan Rama, 23 Nov). */
    .hero-sub { color: color-mix(in srgb, var(--color-lumut), var(--color-tinta) 55%); font-weight: 450; }
    .hero-bukti { color: var(--color-tinta); }
    .ilustrasi { color: rgb(255 255 255 / 0.85); text-shadow: 0 1px 2px rgb(0 0 0 / 0.4); }
  }

  /* Bukti: deret logo merek + baris angka. HP: logo dua baris di tengah, angka 2×2. */
  .bukti { background: var(--color-putih); border-bottom: 1px solid var(--color-garis); }
  .merek-deret { display: grid; gap: 1rem; padding-block: 1.5rem 1.25rem; border-bottom: 1px solid var(--color-garis); }
  .merek-label { font-size: var(--fs-14); font-weight: 500; color: var(--color-lumut); text-align: center; }
  .merek-logo { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1rem 1.6rem; font-size: 1.6rem; }
  .merek-logo a { display: flex; align-items: center; min-height: 44px; opacity: 0.78; transition: opacity 200ms; }
  .merek-logo a:hover, .merek-logo a:focus-visible { opacity: 1; }
  .merek-logo img { display: block; height: var(--h); width: auto; }
  .bukti-daftar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .bukti-daftar li { padding: 1.4rem 1rem 1.4rem 0; border-top: 1px solid var(--color-garis); }
  .bukti-daftar li:nth-child(-n+2) { border-top: 0; }
  .bukti-daftar li:nth-child(3) { grid-column: 1 / -1; } /* HP: tiga angka = 2 + 1 lebar penuh */
  .bukti-daftar b { display: block; font-weight: var(--bobot-judul); font-size: var(--t-h2); letter-spacing: -0.024em; line-height: 1.23; white-space: nowrap; }
  .bukti-daftar li > span { font-size: var(--fs-14); color: var(--color-lumut); line-height: 1.4; display: block; margin-top: 0.2rem; }
  /* Desktop: logo sebaris dengan labelnya, angka empat kolom dengan garis pemisah tegak. */
  @media (min-width: 64rem) {
    .merek-deret { grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 3rem; padding-block: 1.75rem; }
    .merek-label { text-align: left; }
    .merek-logo { justify-content: space-between; flex-wrap: nowrap; gap: 2rem; font-size: 1.9rem; }
    .bukti-daftar { grid-template-columns: repeat(3, minmax(0, 1fr)); padding-block: 2rem; }
    .bukti-daftar li, .bukti-daftar li:nth-child(-n+2) { border-top: 0; padding: 0.25rem 1.5rem; border-left: 1px solid var(--color-garis); }
    .bukti-daftar li:first-child { border-left: 0; padding-left: 0; }
    .bukti-daftar li:nth-child(3) { grid-column: auto; }
    .bukti-daftar b { font-size: clamp(2.5rem, 1.2rem + 2.2vw, 3.5rem); line-height: 1; }
    .bukti-daftar li > span { font-size: var(--fs-15); margin-top: 0.6rem; }
  }

  /* Kartu contoh biaya terpasang di hero desktop (acuan Lupitor: kartu produk di atas foto). */
  .hero-kartu { display: none; }
  @media (min-width: 64rem) {
    .hero-kartu {
      position: absolute; right: var(--gutter); bottom: clamp(3rem, 9vh, 6rem); z-index: 2; isolation: isolate;
      display: grid; gap: 0.3rem; width: 19.5rem; padding: 2.2rem 1.4rem 1.4rem; color: var(--color-tinta);
      filter: drop-shadow(0 26px 30px rgb(0 0 0 / 0.32)) drop-shadow(0 6px 10px rgb(0 0 0 / 0.16));
    }
    .hero-kartu::before {
      content: ''; position: absolute; inset: 0; z-index: -1; background: var(--color-putih); border-radius: 0 0 1.25rem 1.25rem;
      clip-path: polygon(0 18px, 50% 0, 100% 18px, 100% 100%, 0 100%);
    }
    .hk-label { font-size: var(--fs-13); font-weight: 500; color: var(--color-lumut); }
    .hk-putar { display: grid; }
    .hk-item { grid-area: 1 / 1; display: grid; gap: 0.15rem; }
    .hk-item + .hk-item { opacity: 0; }
    .hk-jenis { font-size: var(--fs-15); font-weight: 500; }
    .hk-angka { font-size: var(--t-h2); font-weight: var(--bobot-judul); letter-spacing: -0.024em; line-height: 1.23; }
    .hk-angka small { font-size: var(--fs-16); color: var(--color-lumut); letter-spacing: 0; }
    .hk-hari { font-size: var(--fs-14); color: var(--color-lumut); }
  }

  /* Layanan: kartu berfoto (acuan Forma Casa), pita gelap perusahaan di bawahnya (acuan Logamax). */
  .lyn-daftar { display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); }
  .lyn-kartu {
    position: relative; display: flex; flex-direction: column; height: 100%; padding: 8px; border-radius: 1.25rem;
    background: var(--color-putih); color: var(--color-tinta); text-decoration: none;
    box-shadow: 0 1px 2px rgb(16 35 30 / 0.06), 0 14px 30px -18px rgb(16 35 30 / 0.28);
    transition: box-shadow 300ms var(--ease-out), transform 300ms var(--ease-out);
  }
  .lyn-kartu :global(.lyn-foto) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 0.85rem; }
  .lyn-isi { display: grid; gap: 0.4rem; padding: 1rem 0.6rem 3.6rem; }
  .lyn-judul { font-family: var(--font-merek); font-size: var(--t-title); font-weight: var(--bobot-judul-kartu); letter-spacing: -0.006em; line-height: 1.4; }
  .lyn-teks { font-size: var(--fs-15); line-height: 1.5; color: var(--color-lumut); }
  .lyn-panah {
    position: absolute; right: 0.9rem; bottom: 0.9rem; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--color-garis); color: var(--color-pinus); font-size: var(--fs-16);
    transition: background-color 250ms, color 250ms, transform 250ms var(--ease-out);
  }
  .lyn-kartu:focus-visible { outline: 2px solid var(--color-pinus); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .lyn-kartu:hover { transform: translateY(-3px); box-shadow: 0 1px 2px rgb(16 35 30 / 0.06), 0 22px 40px -20px rgb(16 35 30 / 0.4); }
    .lyn-kartu:hover .lyn-panah { background: var(--color-pinus); color: var(--color-tunas); box-shadow: none; }
  }
  /* Aksi WhatsApp tanpa panah (aturan tautan global.css). */
  .lyn-wa { display: inline-flex; align-items: center; min-height: 44px; font-weight: 500; color: var(--color-pinus); text-decoration: underline; text-decoration-color: rgb(16 35 30 / 0.35); text-underline-offset: 0.25em; }
  .lyn-catatan { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.6rem; margin-top: 0.75rem; font-size: var(--fs-15); color: var(--color-lumut); }
  .lyn-pita {
    display: grid; gap: 1.25rem; margin-top: 12px; padding: 1.75rem; border-radius: 1.25rem;
    background: var(--color-pinus); color: var(--color-embun); --tautan: var(--color-embun);
  }
  .lyn-pita-label { font-size: var(--fs-13); color: rgb(242 244 241 / 0.6); }
  .lyn-pita-judul { margin-top: 0.3rem; font-size: var(--t-h3); font-weight: var(--bobot-judul); letter-spacing: -0.011em; line-height: 1.27; }
  .lyn-pita-teks { margin-top: 0.4rem; max-width: 52ch; font-size: var(--fs-15); color: var(--embun-redup); }
  .lyn-pita-aksi { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  @media (min-width: 48rem) {
    .lyn-daftar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lyn-pita { grid-template-columns: minmax(0, 1fr) auto; align-items: center; padding: 2rem 2.25rem; }
  }
  @media (min-width: 64rem) {
    .lyn-daftar { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }



  /* Hujan: foto penuh + insight */

  /* Judul section besar: tipis, rapat, satu kata miring. */
  .judul-besar { font-size: var(--t-h1); font-weight: var(--bobot-judul); letter-spacing: -0.025em; line-height: 1.1; max-width: 20ch; }


  /* Cara kerja */

  /* Merek & harga: kartu produk berfoto (acuan Bau Cargo "Наши услуги"), urut termurah. HP & tablet digeser ke samping. */
  .mk-daftar {
    display: grid; grid-auto-flow: column; grid-auto-columns: 72%; gap: 12px;
    overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter)); padding: 0 var(--gutter) 10px; scroll-padding-inline: var(--gutter);
  }
  .mk-daftar::-webkit-scrollbar { display: none; }
  .mk-daftar li { scroll-snap-align: start; }
  .mk-kartu {
    position: relative; display: flex; flex-direction: column; height: 100%; padding: 1.1rem 1.1rem 1.25rem; border-radius: 1.25rem;
    background: var(--color-putih); color: var(--color-tinta); text-decoration: none;
    box-shadow: 0 1px 2px rgb(16 35 30 / 0.06), 0 14px 30px -18px rgb(16 35 30 / 0.28);
    transition: transform 300ms var(--ease-out), box-shadow 300ms var(--ease-out);
  }
  .mk-atas { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; min-height: 2.5rem; }
  .mk-logo { display: block; height: calc(var(--h) * 1.45); width: auto; max-width: 62%; opacity: 0.85; }
  .mk-kelas { padding: 0.3rem 0.7rem; border-radius: 999px; background: var(--color-embun); font-size: var(--fs-13); font-weight: 500; color: var(--color-lumut); white-space: nowrap; }
  .mk-kartu :global(.mk-foto) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; margin: 0.9rem 0 1rem; border-radius: 0.85rem; }
  .mk-harga-label { font-size: var(--fs-13); color: var(--color-lumut); }
  .mk-harga { margin-top: 0.15rem; font-family: var(--font-merek); font-size: var(--t-h2); font-weight: var(--bobot-judul); letter-spacing: -0.024em; line-height: 1.23; font-variant-numeric: tabular-nums lining-nums; }
  .mk-rp, .mk-satuan { font-size: var(--fs-15); letter-spacing: 0; color: var(--color-lumut); }
  .mk-rp { margin-right: 0.1em; }
  .mk-garansi { margin-top: 0.35rem; padding-right: 3rem; font-size: var(--fs-14); color: var(--color-lumut); }
  .mk-panah {
    position: absolute; right: 1rem; bottom: 1rem; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--color-garis); color: var(--color-pinus); transition: background-color 250ms, color 250ms;
  }
  .mk-kartu:focus-visible { outline: 2px solid var(--color-pinus); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .mk-kartu:hover { transform: translateY(-3px); box-shadow: 0 1px 2px rgb(16 35 30 / 0.06), 0 22px 40px -20px rgb(16 35 30 / 0.4); }
    .mk-kartu:hover .mk-panah { background: var(--color-pinus); color: var(--color-tunas); box-shadow: none; }
  }
  .mk-bawah { display: flex; flex-wrap: wrap; gap: 0 2rem; margin-top: 1.25rem; }
  @media (min-width: 48rem) { .mk-daftar { grid-auto-columns: 40%; } }
  @media (min-width: 64rem) { .mk-daftar { grid-auto-columns: 31%; } }
  /* Laptop lebar: lima kartu sejajar tanpa geser. */
  @media (min-width: 75rem) {
    .mk-daftar { grid-auto-flow: row; grid-template-columns: repeat(5, minmax(0, 1fr)); overflow: visible; margin-inline: 0; padding: 0; }
  }

  /* Area: tabel "Catatan atap tiap daerah" (tabel data ala Notion) + peta dalam kartu. */
  .ar { display: grid; gap: 2rem 3.5rem; grid-template-columns: minmax(0, 1fr); align-items: start; }
  .ar-kiri { display: grid; gap: 1.25rem; align-content: start; }
  .ar-tab { display: inline-flex; justify-self: start; gap: 4px; padding: 4px; border-radius: 999px; background: var(--color-embun); }
  .ar-tab button {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 40px; padding: 0 1rem; border-radius: 999px;
    font-size: var(--fs-15); font-weight: 500; color: var(--color-lumut); cursor: pointer; transition: background-color 200ms, color 200ms;
  }
  .ar-tab button span { font-size: var(--fs-13); font-variant-numeric: tabular-nums; color: var(--color-lumut); }
  .ar-tab button[aria-selected='true'] { background: var(--color-putih); color: var(--color-tinta); box-shadow: 0 1px 2px rgb(16 35 30 / 0.08), 0 0 0 1px rgb(16 35 30 / 0.06); }
  .ar-tab button:focus-visible { outline: 2px solid var(--color-pinus); outline-offset: 2px; }
  .ar-tabel { width: 100%; border-collapse: collapse; }
  .ar-tabel[hidden] { display: none; }
  .ar-tabel thead th {
    padding: 0 0 0.5rem; border-bottom: 1px solid var(--color-tinta); text-align: left; font-size: var(--fs-13); font-weight: 600;
    letter-spacing: 0.01em; line-height: 1.33; text-transform: uppercase; color: var(--color-tinta);
  }
  .ar-tabel tbody tr { position: relative; border-bottom: 1px solid var(--color-garis); transition: background-color 200ms; }
  .ar-tabel tbody th, .ar-tabel tbody td { padding: 0.8rem 0; vertical-align: middle; text-align: left; }
  .ar-tabel tbody th { width: 30%; padding-right: 1rem; font-size: var(--fs-16); font-weight: 500; }
  /* Seluruh baris bisa diklik: tautan di kolom daerah direntangkan ke satu baris. */
  .ar-tabel tbody th a { color: var(--color-tinta); text-decoration: none; }
  .ar-tabel tbody th a::after { content: ''; position: absolute; inset: 0; }
  .ar-tabel tbody th a:focus-visible { outline: none; }
  .ar-tabel tbody tr:has(a:focus-visible) { outline: 2px solid var(--color-pinus); outline-offset: -2px; }
  .ar-tabel td { display: flex; align-items: center; gap: 0.75rem; font-size: var(--fs-15); color: var(--color-lumut); font-variant-numeric: tabular-nums; }
  .ar-label { flex: none; display: inline-flex; align-items: center; min-height: 24px; padding: 0 0.6rem; border-radius: 999px; font-size: var(--fs-13); font-weight: 500; color: var(--color-pinus); }
  .ar-hujan { background: #dcebe2; }
  .ar-angin { background: var(--color-tunas-pucat); }
  .ar-panas { background: #f7e3c6; }
  .ar-aturan { background: #e3e8ee; }
  .ar-sorot { min-width: 0; }
  .ar-panah { margin-left: auto; padding-left: 0.5rem; color: var(--color-lumut); transition: transform 250ms var(--ease-out), color 200ms; }
  .ar-tabel tbody tr.menyala { background: var(--color-embun); }
  .ar-tabel tbody tr.menyala .ar-panah { transform: translateX(4px); color: var(--color-pinus); }
  .ar-tabel tbody tr.menyala th a { color: var(--color-pinus); }
  .ar-kiri .tautan-lanjut { justify-self: start; }
  .ar-peta { padding: 1.25rem; border-radius: 1.5rem; background: var(--color-embun); }
  @media (min-width: 60rem) { .ar { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); } }
  /* Kartu Indonesia kecil di peta: disembunyikan di beranda (tetap di /area). */
  .ar-peta :global(.peta-sisip) { display: none; }
  /* Tab Luar Jabodetabek: peta Jabodetabek diganti peta kecil Indonesia (pulau tempat tim pernah bekerja). */
  .ar[data-tab='luar'] .ar-peta :global(.peta-utama), .ar[data-tab='luar'] .ar-peta :global(.peta-ket) { display: none; }
  .ar[data-tab='luar'] .ar-peta :global(.peta-sisip) { display: grid; grid-template-columns: minmax(0, 1fr); margin-top: 0; }
  @media (max-width: 47.99rem) {
    .ar-peta { display: none; }
    .ar-tab { justify-self: stretch; }
    .ar-tab button { flex: 1; justify-content: center; padding: 0 0.6rem; font-size: var(--fs-14); }
    /* HP: daerah di atas, label + fakta di bawahnya. */
    .ar-tabel thead { display: none; }
    .ar-tabel tbody tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'nama label' 'sorot sorot'; align-items: center; padding: 0.7rem 0; row-gap: 0.2rem; column-gap: 0.75rem; }
    .ar-tabel tbody th, .ar-tabel tbody td { padding: 0; width: auto; }
    .ar-tabel tbody th { grid-area: nama; }
    .ar-tabel td { display: contents; }
    .ar-label { grid-area: label; }
    .ar-sorot { grid-area: sorot; font-size: var(--fs-14); }
    .ar-panah { display: none; }
  }

  /* Rapor */

  /* Tanya */
  .tanya { display: grid; gap: 2.5rem 4rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 60rem) {
    .tanya { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: start; }
    .tanya .judul-2 { position: sticky; top: 2.5rem; }
  }
  .tanya-daftar { display: grid; border-top: 1px solid var(--color-garis); interpolate-size: allow-keywords; }
  .tanya-item { border-bottom: 1px solid var(--color-garis); }
  .tanya-kiri { display: grid; gap: 1.25rem; align-content: start; }
  .tanya-kiri .label-bagian { margin-bottom: -0.75rem; } /* eyebrow → judul 8 px */
  .tanya-foto { border-radius: 16px; overflow: hidden; aspect-ratio: 16 / 10; }
  .tanya-foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .tanya-panduan { display: inline-block; margin-top: 1.25rem; font-weight: 500; color: var(--color-pinus); text-decoration: underline; text-decoration-color: rgb(16 35 30 / 0.3); }
  @media (min-width: 60rem) { .tanya-kiri { position: sticky; top: 5.5rem; } .tanya .judul-2 { position: static; } }
  @media (min-width: 48rem) { .tanya .judul-2 .miring { display: block; } }
  /* HP: foto suasana disembunyikan supaya daftar pertanyaan langsung terlihat. */
  @media (max-width: 47.99rem) { .tanya-foto { display: none; } }
  .tanya-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding-block: 1.4rem; cursor: pointer; list-style: none;
  }
  .tanya-item summary::-webkit-details-marker { display: none; }
  .tanya-q { font-size: var(--t-title); font-weight: var(--bobot-judul-kartu); letter-spacing: -0.006em; transition: transform 400ms var(--ease-out); line-height: 1.4; }
  .tanya-tanda { position: relative; flex: none; width: 14px; height: 14px; }
  .tanya-tanda::before, .tanya-tanda::after {
    content: ''; position: absolute; left: 0; top: 50%; width: 14px; height: 1px; background: currentColor;
    transition: transform 400ms var(--ease-out);
  }
  .tanya-tanda::after { transform: rotate(90deg); }
  .tanya-item[open] .tanya-tanda::after { transform: rotate(0deg); }
  /* Jawaban FAQ: body-md Notion 16/1.5, warna hampir hitam, rata kiri; jarak antarblok 12 px (skala 8 px Notion). */
  .tanya-a { display: grid; gap: 0.75rem; max-width: 64ch; padding-bottom: 1.5rem; font-size: var(--fs-16); line-height: 1.5; color: #24302b; }
  .tanya-a b { font-weight: 600; color: var(--color-tinta); }
  /* Visual di jawaban (acuan DESIGN.md Notion): permukaan level 0 = putih + garis tipis 1px, sudut 12px, label kecil
     kapital renggang, angka tabular. Isi lengkapnya tetap ada di FAQPage schema (teksJawab). */
  .tanya-kelompok, .vt-garansi > div, .vt-sudut li { background: var(--color-putih); border: 1px solid var(--color-garis); border-radius: 12px; }
  .vt-label, .tanya-kelompok-judul, .vt-g-label { font-size: var(--fs-13); font-weight: 600; letter-spacing: 0.03em; line-height: 1.33; text-transform: uppercase; color: var(--color-lumut); }
  /* Harga: tabel data ala Notion — judul kelompok di kepala kartu, baris dipisah garis tipis, harga tabular rata kanan. */
  .tanya-kelompok { padding: 0.9rem 1.1rem 0.35rem; }
  .tanya-kelompok-judul { text-transform: none; letter-spacing: 0; font-size: var(--fs-14); }
  .tanya-rincian { margin-top: 0.4rem; }
  .tanya-rincian > div { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-block: 0.55rem; border-top: 1px solid var(--color-garis); }
  .tanya-rincian dt { min-width: 0; font-weight: 600; color: var(--color-tinta); }
  .tanya-rincian dd { flex: none; margin: 0; font-variant-numeric: tabular-nums lining-nums; color: var(--color-tinta); }
  .tanya-rincian dd span { color: var(--color-lumut); font-size: 0.88em; }
  /* Termin jasa: batang bersegmen sebanding persen (Pinus · Tunas · putih), keterangan sejajar di bawahnya. */
  .vt-termin { display: grid; gap: 0.6rem; }
  .vt-bar { display: flex; gap: 4px; }
  .vt-bar span {
    display: grid; place-items: center; min-height: 2.6rem; border-radius: 10px; font-weight: var(--bobot-judul);
    font-size: var(--fs-17); font-variant-numeric: tabular-nums; background: var(--color-pinus); color: var(--color-embun);
  }
  .vt-bar span:nth-child(2) { background: var(--color-tunas); color: var(--color-pinus); }
