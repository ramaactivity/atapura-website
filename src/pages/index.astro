  <a href={waLink('Halo Atapura, saya mau tanya soal atap bitumen.')} target="_blank" rel="noopener" class="wa-apung no-print" data-wa="apung" aria-label="Chat WhatsApp Atapura" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm4.5 12.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3a.4.4 0 0 0 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z" /></svg>
    <span>Chat</span>
  </a>
</Base>

<script>
  // Desktop: foto besar (hero, penutup) bergeser halus mengikuti kursor dengan pegas; cahaya senja ikut di hero.
  const desktop = matchMedia('(min-width: 64rem) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  if (desktop.matches) {
    for (const [pilih, kekuatan] of [['.hero', 16], ['.penutup', 22]] as const) {
      const sek = document.querySelector<HTMLElement>(pilih);
      const foto = sek?.querySelector<HTMLElement>('img');
      if (!sek || !foto) continue;
      const cahaya = sek.querySelector<HTMLElement>('.hero-cahaya');
      let tx = 0.6, ty = 0.4, x = tx, y = ty, id = 0;
      const jalan = () => {
        x += (tx - x) * 0.07;
        y += (ty - y) * 0.07;
        foto.style.translate = `${((0.5 - x) * kekuatan).toFixed(2)}px ${((0.5 - y) * kekuatan * 0.6).toFixed(2)}px`;
        if (cahaya) {
          const r = sek.getBoundingClientRect();
          const d = cahaya.offsetWidth / 2;
          cahaya.style.transform = `translate(${(x * r.width - d).toFixed(1)}px, ${(y * r.height - d).toFixed(1)}px)`;
        }
        id = Math.abs(tx - x) + Math.abs(ty - y) > 0.0008 ? requestAnimationFrame(jalan) : 0;
      };
      sek.addEventListener('pointermove', (e) => {
        const r = sek.getBoundingClientRect();
        tx = (e.clientX - r.left) / r.width;
        ty = (e.clientY - r.top) / r.height;
        if (!id) id = requestAnimationFrame(jalan);
      });
    }
  }

  // FAQ: di desktop, pertanyaan yang disorot mouse langsung terbuka (satu per satu, name="tanya" menutup yang lain).
  const sorot = matchMedia('(hover: hover) and (pointer: fine)');
  document.querySelectorAll<HTMLDetailsElement>('[data-tanya] details').forEach((d) => {
    d.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse' && sorot.matches) d.open = true; });
  });

  // Desktop: pill "Hitung estimasi" melayang setelah hero lewat; sembunyi saat kalkulator atau penutup terlihat.
  const cta = document.querySelector<HTMLElement>('[data-cta-apung]');
  if (cta && matchMedia('(min-width: 64rem)').matches) {
    cta.hidden = false;
    const terlihat = new Set<Element>();
    let heroLewat = false;
    const perbarui = () => cta.classList.toggle('tampil', heroLewat && terlihat.size === 0);
    new IntersectionObserver(([e]) => { heroLewat = !e.isIntersecting && e.boundingClientRect.top < 0; perbarui(); }).observe(document.querySelector('.hero')!);
    const io = new IntersectionObserver((es) => { es.forEach((e) => (e.isIntersecting ? terlihat.add(e.target) : terlihat.delete(e.target))); perbarui(); });
    document.querySelectorAll('#hitung, .penutup-isi, footer').forEach((el) => io.observe(el));
  }

  // Tombol WA melayang muncul di HP setelah slip Hitung AKAL lewat, supaya tidak dobel dengan tombol di slip.
  const apung = document.querySelector<HTMLElement>('.wa-apung');
  const slip = document.querySelector('.hero');
  if (apung && slip) {
    apung.hidden = false;
    new IntersectionObserver(([e]) => {
      apung.classList.toggle('tampil', !e.isIntersecting && e.boundingClientRect.top < 0);
    }).observe(slip);
  }

  // Angka fakta menghitung naik sekali saat terlihat (HTML tetap memuat angka final untuk mesin pencari).
  {
    const kurangi = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      const el = e.target as HTMLElement;
      const m = el.textContent!.match(/^(\d+)(.*)$/);
      if (!m || kurangi) return;
      const n = Number(m[1]), sisa = m[2], t0 = performance.now();
      const jalan = (t: number) => {
        const p = Math.min(1, (t - t0) / 900);
        el.textContent = Math.round(n * (1 - Math.pow(1 - p, 3))) + sisa;
        if (p < 1) requestAnimationFrame(jalan);
      };
      requestAnimationFrame(jalan);
    }), { threshold: 0.6 });
    document.querySelectorAll('.bukti-daftar b').forEach((b) => io.observe(b));
  }

  // Bento bukti desktop: ruas garansi & pita meteran terisi sekali saat kotaknya terlihat.
  {
    const ul = document.querySelector('.bukti-daftar');
    if (ul && matchMedia('(min-width: 64rem) and (prefers-reduced-motion: no-preference)').matches) {
      ul.classList.add('bukti-gerak');
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('tampak'); io.unobserve(e.target); }
      }), { threshold: 0.5 });
      ul.querySelectorAll('.bk-garansi, .bk-survey').forEach((li) => io.observe(li));
    }
  }

  // Kalimat pernyataan menebal kata demi kata mengikuti gulir (referensi Framer "Perform").
  for (const p of document.querySelectorAll<HTMLElement>('[data-ungkap]')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) break;
    const kata = p.textContent!.trim().split(/\s+/);
    p.textContent = '';
    const span = kata.map((k, i) => { const s = document.createElement('span'); s.textContent = k + (i < kata.length - 1 ? ' ' : ''); p.append(s); return s; });
    let nyala = -1, antre = 0;
    const ukur = () => {
      antre = 0;
      const r = p.getBoundingClientRect();
      const prog = Math.min(1, Math.max(0, (innerHeight * 0.85 - r.top) / (r.height + innerHeight * 0.4)));
      const n = Math.round(prog * span.length);
      if (n === nyala) return;
      nyala = n;
      span.forEach((s, i) => s.classList.toggle('nyala', i < n));
    };
    addEventListener('scroll', () => { if (!antre) antre = requestAnimationFrame(ukur); }, { passive: true });
    ukur();
  }
</script>

<style>
  main { position: relative; }
  .sek { padding-block: clamp(4.5rem, 9vw, 8rem); }
  .teks-ungkap span { opacity: 0.22; transition: opacity 350ms var(--ease-out); }
  .teks-ungkap span.nyala { opacity: 1; }
  .c-embun { background: var(--color-embun); }
  .c-putih { background: var(--color-putih); }
  .c-pinus { background: var(--color-pinus); }
  .terang { color: var(--color-tinta); }
  .gelap { color: var(--color-embun); }
  .judul-2 { font-size: clamp(2.1rem, 1.3rem + 3vw, 4rem); font-weight: 500; max-width: 18ch; }
  .lead { font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem); line-height: 1.5; max-width: 40ch; color: var(--color-lumut); }
  .gelap .lead { color: var(--embun-redup); }
  .kepala { display: grid; gap: 1.5rem 4rem; grid-template-columns: minmax(0, 1fr); margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 60rem) { .kepala { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: end; } }

  /* Hero: foto penuh, satu ajakan. Desktop: teks gelap di atas langit; HP: teks putih di bawah foto. */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: clip; isolation: isolate; background: #cfdde4; }
  /* Foto lahir di komponen Foto, jadi selektornya global; <picture> dijadikan lapisan latar. */
  .hero :global(picture), .kartu.foto :global(picture) { position: absolute; inset: 0; z-index: -2; }
  .kartu.foto :global(picture) { z-index: 0; }
  :global(.hero-foto) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 40%; z-index: -2; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgb(10 20 16 / 0.92) 0%, rgb(10 20 16 / 0.68) 45%, transparent 75%); }
  .hero-isi { width: 100%; padding-bottom: clamp(2.5rem, 6vh, 4rem); color: var(--color-putih); }
  .hero-judul { display: flex; flex-direction: column; font-size: clamp(3.2rem, 1.4rem + 7vw, 7rem); line-height: 0.92; letter-spacing: -0.04em; font-weight: 500; max-width: 7.5ch; }
  .miring-hero { color: var(--color-tunas); }
  @media (min-width: 64rem) { .miring-hero { color: inherit; } }
  .hero-h1-sub { display: block; margin-top: 1.4rem; font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem); line-height: 1.45; letter-spacing: 0; font-weight: 500; max-width: 30ch; }
  .hero-sub { margin-top: 0.4rem; max-width: 34ch; font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem); line-height: 1.5; }
  .hero-aksi { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .hero-aksi .pill { min-height: 54px; padding-inline: 1.6rem; font-size: 1rem; }
  .hero-utama { background: var(--color-tunas); color: var(--color-pinus); }
  .hero-bukti { display: none; }
  .hero-kedua { color: var(--color-putih); border-color: rgb(255 255 255 / 0.6); }
  @media (min-width: 64rem) {
    .hero-utama { background: var(--color-pinus); color: var(--color-putih); }
    .hero-kedua { color: var(--color-pinus); border-color: rgb(16 35 30 / 0.45); background: rgb(242 244 241 / 0.4); }
  }
  .ilustrasi { position: absolute; right: var(--gutter); bottom: 0.9rem; font-size: 0.72rem; color: rgb(255 255 255 / 0.8); }
  @media (min-width: 64rem) {
    .hero { align-items: center; }
    .hero::before { background: linear-gradient(90deg, rgb(242 244 241 / 0.9) 0%, rgb(242 244 241 / 0.55) 34%, transparent 58%); }
    .hero-isi { color: var(--color-pinus); padding-top: 96px; padding-bottom: 0; }
    .hero-sub { color: var(--color-tinta); }
    .ilustrasi { color: rgb(255 255 255 / 0.85); text-shadow: 0 1px 2px rgb(0 0 0 / 0.4); }
  }

  /* Bukti: fakta yang bisa dicek */
  .bukti { background: var(--color-putih); border-bottom: 1px solid var(--color-garis); }
  .bukti-daftar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .bukti-daftar li { padding: 1.4rem 1rem 1.4rem 0; border-top: 1px solid var(--color-garis); }
  .bukti-daftar li:nth-child(-n+2) { border-top: 0; }
  .bukti-daftar b { display: block; font-weight: 500; font-size: 1.6rem; letter-spacing: -0.04em; line-height: 1.05; }
  .bukti-daftar span { font-size: 0.85rem; color: var(--color-lumut); line-height: 1.4; display: block; margin-top: 0.2rem; }
  .bukti-daftar .bk-desktop, .bukti-daftar .bv, .bukti-daftar .bk-tambah { display: none; }
  /* Desktop: bento (acuan Lockeroom) — tiap kotak membawa gambaran kecil dari isinya, bukan ikon. */
  @media (min-width: 64rem) {
    .bukti { padding-block: clamp(1.5rem, 3vw, 2.5rem); border-bottom: 0; }
    .bukti-daftar {
      gap: 12px; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'garansi merek kota' 'garansi survey kota';
    }
    .bukti-daftar li { display: flex; flex-direction: column; border: 0; border-radius: 1.25rem; padding: 1.5rem; background: var(--color-embun); min-height: 12.5rem; }
    .bukti-daftar b { font-size: 2rem; }
    .bukti-daftar .bk-hp { display: none; }
    .bukti-daftar .bk-desktop { display: block; }
    .bukti-daftar .bk-tambah { display: inline; }
    .bukti-daftar .bv { display: flex; margin-top: auto; padding-top: 1.25rem; }
    .bk-merek { grid-area: merek; } .bk-kota { grid-area: kota; } .bk-survey { grid-area: survey; }
    .bukti-daftar .bk-garansi { grid-area: garansi; background: var(--color-pinus); color: var(--color-embun); }
    .bk-garansi b { font-size: clamp(4rem, 2rem + 3vw, 5.5rem); line-height: 0.95; letter-spacing: -0.05em; }
    .bukti-daftar .bk-garansi > span:not(.bv) { color: var(--embun-redup); max-width: 22ch; }

    /* Merek: tiga nama sebagai pill */
    .bukti-daftar .bv-merek { flex-wrap: wrap; gap: 6px; }
    .bv-merek em { font-style: normal; font-size: 0.9rem; font-weight: 500; padding: 0.35rem 0.85rem; border-radius: 999px; background: var(--color-putih); box-shadow: inset 0 0 0 1px var(--color-garis); }

    /* Kota: semua nama, dipisah titik tengah */
    .bukti-daftar .bv-kota { display: block; font-size: 0.8rem; line-height: 1.55; color: var(--color-lumut); }
    .bv-kota em { font-style: normal; }
    .bv-kota em:not(:last-child)::after { content: ' · '; opacity: 0.6; }

    /* Survey: pita meteran */
    .bukti-daftar .bv-meteran {
      position: relative; height: 36px; border-radius: 6px; background-color: var(--color-putih); box-shadow: inset 0 0 0 1px var(--color-garis);
      background-image:
        repeating-linear-gradient(90deg, var(--color-lumut) 0 1px, transparent 1px 40px),
        repeating-linear-gradient(90deg, var(--color-garis) 0 1px, transparent 1px 8px);
      background-size: 100% 55%, 100% 30%; background-repeat: no-repeat; background-position: 8px 0, 8px 0;
    }
    .bv-meteran i { position: absolute; left: 8px; bottom: 6px; height: 3px; width: 64%; border-radius: 2px; background: var(--color-pinus); transform-origin: left; transition: transform 1200ms var(--ease-out); }

    /* Garansi: lima tahun sebagai lima ruas */
    .bukti-daftar .bv-tahun { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 4px; }
    .bv-tahun i { position: relative; display: block; height: 3.25rem; border-radius: 0.5rem; background: rgb(242 244 241 / 0.07); overflow: hidden; }
    .bv-tahun i::before { content: ''; position: absolute; inset: 0; background: rgb(242 244 241 / 0.16); transform-origin: bottom; transition: transform 700ms var(--ease-out); }
    .bv-tahun i:nth-child(2)::before { transition-delay: 120ms; } .bv-tahun i:nth-child(3)::before { transition-delay: 240ms; }
    .bv-tahun i:nth-child(4)::before { transition-delay: 360ms; } .bv-tahun i:nth-child(5)::before { transition-delay: 480ms; }
    .bv-tahun em { position: absolute; left: 0.55rem; bottom: 0.45rem; font-style: normal; font-size: 0.75rem; color: var(--embun-redup); }
    .bv-tahun small { grid-column: 1 / -1; margin-top: 0.5rem; font-size: 0.8rem; color: rgb(242 244 241 / 0.6); }

    /* Gerak (dipasang skrip hanya bila gerak tidak dikurangi): ruas & meteran terisi saat kotak terlihat. */
    .bukti-gerak li:not(.tampak) .bv-tahun i::before { transform: scaleY(0); }
    .bukti-gerak li:not(.tampak) .bv-meteran i { transform: scaleX(0); }
  }

  /* Kartu contoh Hitung AKAL di hero desktop (acuan Lupitor: kartu produk di atas foto). */
  .hero-kartu { display: none; }
  @media (min-width: 64rem) {
    .hero-kartu {
      position: absolute; right: var(--gutter); bottom: clamp(3rem, 9vh, 6rem); z-index: 2; isolation: isolate;
      display: grid; gap: 0.3rem; width: 19.5rem; padding: 2.2rem 1.4rem 1.2rem; color: var(--color-tinta); text-decoration: none;
      filter: drop-shadow(0 26px 30px rgb(0 0 0 / 0.32)) drop-shadow(0 6px 10px rgb(0 0 0 / 0.16));
    }
    .hero-kartu::before {
      content: ''; position: absolute; inset: 0; z-index: -1; background: var(--color-putih); border-radius: 0 0 1.25rem 1.25rem;
      clip-path: polygon(0 18px, 50% 0, 100% 18px, 100% 100%, 0 100%);
    }
    .hk-label { font-size: 0.8rem; font-weight: 500; color: var(--color-lumut); }
    .hk-putar { display: grid; }
    .hk-item { grid-area: 1 / 1; display: grid; gap: 0.15rem; }
    .hk-item + .hk-item { opacity: 0; }
    .hk-jenis { font-size: 0.95rem; font-weight: 500; }
    .hk-angka { font-size: 2.1rem; font-weight: 500; letter-spacing: -0.035em; line-height: 1.1; }
    .hk-angka small { font-size: 1rem; color: var(--color-lumut); letter-spacing: 0; }
    .hk-hari { font-size: 0.85rem; color: var(--color-lumut); }
    .hk-aksi {
      display: flex; justify-content: space-between; margin-top: 0.8rem; padding-top: 0.8rem;
      border-top: 1px dotted var(--color-garis); font-size: 0.95rem; font-weight: 500; color: var(--color-pinus);
    }
    .hk-aksi span { transition: transform 300ms var(--ease-out); }
    .hero-kartu:hover .hk-aksi span { transform: translateX(4px); }
    .hero-kartu:focus-visible { outline: 2px solid var(--color-tunas); outline-offset: 4px; }
  }

  /* Layanan: bento campur foto, angka, ajakan */
  .bento { display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); }
  .kartu { position: relative; border-radius: 14px; overflow: hidden; background: var(--color-putih); padding: 1.6rem; display: flex; flex-direction: column; gap: 0.4rem; min-height: 15rem; }
  .kartu.foto { padding: 0; color: var(--color-putih); min-height: 22rem; }
  .kartu.foto :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  .kartu.foto::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(10 20 16 / 0.8) 0%, transparent 58%); }
  .kartu-isi { position: relative; z-index: 1; margin-top: auto; padding: 1.6rem; }
  .kartu-isi p { color: rgb(255 255 255 / 0.85); font-size: 0.95rem; }
  .kartu-judul { font-size: 1.35rem; font-weight: 400; letter-spacing: -0.02em; line-height: 1.2; }
  .kartu-label { font-size: 0.82rem; color: var(--color-lumut); }
  .kartu .kartu-angka { font-size: 3.4rem; font-weight: 500; letter-spacing: -0.04em; line-height: 1; margin: 0.3rem 0; }
  .kartu p { font-size: 0.95rem; }
  .kartu-tautan { margin-top: auto; padding-top: 1rem; font-weight: 500; }
  .kartu.gelap { background: var(--color-pinus); color: var(--color-embun); }
  .kartu.gelap p { color: var(--embun-redup); }
  .kartu.gelap .kartu-label { color: rgb(242 244 241 / 0.6); }
  .kartu.gelap .pill { margin-top: auto; align-self: flex-start; }
  @media (min-width: 64rem) {
    .bento { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: 300px; }
    .kartu, .kartu.foto { min-height: 0; }
    .k-tukang { grid-column: span 5; grid-row: span 2; }
    .k-villa { grid-column: span 7; }
    .k-ganti { grid-column: span 4; }
    .k-bocor { grid-column: span 3; }
    .k-kafe { grid-column: span 7; }
    .k-proyek { grid-column: span 5; }
  }
  @media (hover: hover) and (pointer: fine) {
    .kartu.foto:hover :global(img) { transform: scale(1.04); }
  }


  /* Hujan: foto penuh + insight */

  /* Judul section besar: tipis, rapat, satu kata miring. */
  .judul-besar { font-size: clamp(2.4rem, 1.2rem + 4.6vw, 5.4rem); font-weight: 500; letter-spacing: -0.04em; line-height: 0.98; max-width: 16ch; }

  /* Anatomi: lembar gambar teknik di atas grid tipis. */
  .anatomi {
    background-image:
      linear-gradient(rgb(76 94 85 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(76 94 85 / 0.07) 1px, transparent 1px);
    background-size: 48px 48px; background-position: -1px -1px;
  }
  .anatomi-kepala { display: grid; gap: 1.5rem 4rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 60rem) { .anatomi-kepala { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: end; } }
  .anatomi-isi { display: grid; gap: 1rem; color: var(--color-lumut); }
  .lembar { position: relative; margin-top: clamp(3rem, 7vw, 6rem); padding-top: 1rem; }
  .lembar-sudut { position: absolute; inset: 0; pointer-events: none; }
  .lembar-sudut::before, .lembar-sudut::after {
    content: ''; position: absolute; width: 22px; height: 22px; border-color: var(--color-lumut); border-style: solid; opacity: 0.6;
  }
  .lembar-sudut::before { top: 0; left: 0; border-width: 1px 0 0 1px; }
  .lembar-sudut::after { bottom: 0; right: 0; border-width: 0 1px 1px 0; }
  .lembar-blok {
    margin-top: 2rem; display: grid; grid-template-columns: minmax(0, 1fr); border: 1px solid var(--color-tinta);
    background: var(--color-embun);
  }
  @media (min-width: 60rem) { .lembar-blok { grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr); margin-left: auto; width: min(100%, 52rem); } }
  .lembar-judul { padding: 0.9rem 1.1rem; font-size: 1.15rem; font-weight: 400; letter-spacing: -0.02em; border-bottom: 1px solid var(--color-tinta); }
  @media (min-width: 60rem) { .lembar-judul { border-bottom: 0; border-right: 1px solid var(--color-tinta); } }
  .lembar-data { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .lembar-data > div { padding: 0.6rem 1.1rem; border-left: 1px solid var(--color-garis); border-top: 1px solid var(--color-garis); }
  .lembar-data > div:nth-child(-n+2) { border-top: 0; }
  .lembar-data > div:nth-child(odd) { border-left: 0; }
  .lembar-data dt { font-size: 0.75rem; color: var(--color-lumut); }
  .lembar-data dd { font-size: 0.92rem; }

  /* Cara kerja */

  /* Merek: lembar spesifikasi */
  .merek-kepala { display: grid; gap: 1.5rem 4rem; grid-template-columns: minmax(0, 1fr); margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 60rem) { .merek-kepala { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: end; } }
  .merek-kepala .lead { color: var(--color-lumut); }
  .spek { margin-top: clamp(2.5rem, 5vw, 3.5rem); border-top: 1px solid var(--color-tinta); }
  .spek summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.3rem 0; cursor: pointer; list-style: none; font-size: 1.1rem; font-weight: 500; }
  .spek summary::-webkit-details-marker { display: none; }
  .spek-tanda { position: relative; width: 14px; height: 14px; flex: none; }
  .spek-tanda::before, .spek-tanda::after { content: ''; position: absolute; left: 0; top: 50%; width: 14px; height: 1px; background: currentColor; transition: transform 400ms var(--ease-out); }
  .spek-tanda::after { transform: rotate(90deg); }
  .spek[open] .spek-tanda::after { transform: rotate(0deg); }
  .spek .datasheet { border-top: 0; }
  .datasheet { overflow-x: auto; border-top: 1px solid var(--color-tinta); }
  .ds { width: 100%; min-width: 44rem; border-collapse: collapse; }
  .ds th, .ds td { text-align: left; vertical-align: top; padding: 1.1rem 1.25rem 1.1rem 0; border-bottom: 1px solid var(--color-garis); }
  .ds tbody th { width: 18%; font-weight: 400; font-size: 0.9rem; color: var(--color-lumut); }
  .ds td { width: 27%; color: var(--color-tinta); }
  .ds thead th { padding-top: 1.5rem; padding-bottom: 1.75rem; }
  .ds-no { display: block; font-size: 0.8rem; color: var(--color-lumut); margin-bottom: 0.4rem; }
  .ds-merek { display: block; font-size: clamp(2rem, 1.2rem + 2.4vw, 3.4rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; }
  .ds-harga td { font-size: clamp(1.8rem, 1.2rem + 1.6vw, 2.6rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; font-variant-numeric: tabular-nums lining-nums; }
  .harga-rp { font-size: 0.4em; letter-spacing: 0; vertical-align: 0.85em; margin-right: 0.15em; color: var(--color-lumut); }
  .harga-sat { font-size: 0.36em; letter-spacing: 0; margin-left: 0.35em; color: var(--color-lumut); }
  .ds-sd { color: var(--color-lumut); }
  .ds-pasti { font-size: 0.95rem; color: var(--color-lumut) !important; }
  .ds-tunggu { font-size: 0.95rem; color: var(--color-lumut) !important; }
  .ds-harga td.ds-tunggu { font-size: 0.95rem; letter-spacing: 0; line-height: 1.4; }
  .merek-hp { display: none; }
  @media (max-width: 47.99rem) {
    .datasheet { display: none; }
    .merek-hp { display: grid; border-top: 1px solid var(--color-tinta); }
    .merek-hp li { padding: 1.4rem 0; border-bottom: 1px solid var(--color-garis); }
    .merek-hp-harga { margin-top: 0.5rem; font-size: 1.5rem; font-weight: 500; letter-spacing: -0.03em; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.35rem; }
    .merek-hp-kelas { margin-top: 0.3rem; font-size: 0.9rem; color: var(--color-lumut); }
    .merek-hp-satuan { font-size: 0.9rem; color: var(--color-lumut); }
    .merek-hp-pasti { margin-top: 0.4rem; color: var(--color-lumut); font-size: 0.95rem; }
  }
  .tabel-catatan { margin-top: 1rem; font-size: 0.85rem; color: var(--color-lumut); }

  /* Area: teks + peta skematik */
  .area { display: grid; gap: 3rem 4rem; grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 60rem) { .area { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr); } }
  .area .lead { margin-top: 1.25rem; color: var(--color-lumut); }
  .wilayah { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); margin-top: 2.5rem; }
  .wilayah-nama { font-weight: 500; font-size: 0.9rem; padding-bottom: 0.5rem; margin-bottom: 0.5rem; border-bottom: 1px solid var(--color-garis); }
  .wilayah-kota { display: grid; gap: 0.2rem; color: var(--color-lumut); font-size: 0.92rem; }
  .area-tautan { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .wilayah-kota a { color: inherit; text-decoration: underline; text-decoration-color: var(--color-garis); text-underline-offset: 3px; }

  /* Rapor */

  /* Tanya */
  .tanya { display: grid; gap: 2.5rem 4rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 60rem) {
    .tanya { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: start; }
    .tanya .judul-2 { position: sticky; top: 2.5rem; }
  }
  .tanya-daftar { display: grid; border-top: 1px solid var(--color-garis); interpolate-size: allow-keywords; }
  .tanya-item { border-bottom: 1px solid var(--color-garis); }
  .tanya-kiri { display: grid; gap: 1.25rem; align-content: start; }
  .tanya-foto { border-radius: 16px; overflow: hidden; aspect-ratio: 16 / 10; }
  .tanya-foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .tanya-panduan { display: inline-block; margin-top: 1.25rem; font-weight: 500; color: var(--color-pinus); text-decoration: underline; text-decoration-color: rgb(16 35 30 / 0.3); }
  @media (min-width: 60rem) { .tanya-kiri { position: sticky; top: 2rem; } .tanya .judul-2 { position: static; } }
  .tanya-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding-block: 1.4rem; cursor: pointer; list-style: none;
  }
  .tanya-item summary::-webkit-details-marker { display: none; }
  .tanya-q { font-size: clamp(1.15rem, 1rem + 0.5vw, 1.45rem); font-weight: 500; letter-spacing: -0.02em; transition: transform 400ms var(--ease-out); }
  .tanya-tanda { position: relative; flex: none; width: 14px; height: 14px; }
  .tanya-tanda::before, .tanya-tanda::after {
    content: ''; position: absolute; left: 0; top: 50%; width: 14px; height: 1px; background: currentColor;
    transition: transform 400ms var(--ease-out);
  }
  .tanya-tanda::after { transform: rotate(90deg); }
  .tanya-item[open] .tanya-tanda::after { transform: rotate(0deg); }
  .tanya-a { color: var(--color-lumut); max-width: 62ch; padding-bottom: 1.5rem; }
  .tanya-item::details-content {
    block-size: 0; overflow: clip;
    transition: block-size 500ms var(--ease-out), content-visibility 500ms allow-discrete;
  }
  .tanya-item[open]::details-content { block-size: auto; }
  @media (hover: hover) and (pointer: fine) {
    .tanya-item:hover .tanya-q { transform: translateX(6px); }
  }

  /* Latar suasana: foto Magnific dikecilkan & diburamkan (±1,5 KB), digelapkan supaya teks terbaca (pola askmidnight). */



  /* Penutup + panduan: satu latar gelap, foto memudar ke latar dan menyambung dua bagian (pola "Are we a match?"). */
  .penutup { position: relative; isolation: isolate; overflow: clip; background: #0c1a16; color: var(--color-embun); }
  .penutup-latar {
    position: absolute; z-index: -1; top: 0; right: 0; width: 100%; height: 72svh;
    -webkit-mask-image: linear-gradient(180deg, #000 35%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 35%, transparent 100%);
  }
  .penutup-latar :global(picture), .penutup-latar :global(img) { display: block; width: 100%; height: 100%; }
  :global(.penutup-foto) { object-fit: cover; object-position: 60% 50%; opacity: 0.85; }
  .penutup-isi { min-height: 92svh; display: grid; align-content: end; gap: 1.5rem; justify-items: start; padding-block: 6rem 4rem; }
  .penutup-judul { font-size: clamp(2.8rem, 1rem + 7vw, 6.5rem); font-weight: 500; letter-spacing: -0.04em; line-height: 0.95; max-width: 11ch; text-shadow: 0 2px 30px rgb(0 0 0 / 0.35); }
  .penutup-teks { max-width: 40ch; font-size: 1.15rem; line-height: 1.6; color: rgb(242 244 241 / 0.82); }
  .penutup-aksi { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.75rem; margin-top: 0.5rem; }
  .pill-terang { background: var(--color-embun); color: var(--color-pinus); min-height: 54px; padding-inline: 1.6rem; }
  .pill-terang:hover { background: var(--color-tunas); }
  .penutup-tautan { color: rgb(242 244 241 / 0.8); text-decoration: underline; text-decoration-color: rgb(242 244 241 / 0.3); text-underline-offset: 0.3em; transition: color 250ms; padding-block: 0.6rem; }
  .penutup-tautan:hover { color: var(--color-tunas); }
  @media (min-width: 64rem) {
    .penutup-latar { left: auto; width: 62%; height: 100svh;
      -webkit-mask-image: linear-gradient(180deg, #000 45%, transparent 100%), linear-gradient(270deg, #000 55%, transparent 100%);
      -webkit-mask-composite: source-in; mask-image: linear-gradient(180deg, #000 45%, transparent 100%), linear-gradient(270deg, #000 55%, transparent 100%); mask-composite: intersect; }
    .penutup-isi { align-content: center; min-height: 100svh; padding-block: 8rem 6rem; }
  }
  .penutup-panduan { padding-bottom: clamp(4rem, 8vw, 7rem); }
  .jurnal-judul { padding-top: clamp(3rem, 6vw, 5rem); border-top: 1px solid rgb(242 244 241 / 0.14); font-size: clamp(2rem, 1.2rem + 2.6vw, 3.4rem); font-weight: 500; letter-spacing: -0.04em; margin-bottom: 2.5rem; }
  .jurnal { display: grid; }
  .jurnal-item { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; padding-block: 1.75rem; border-bottom: 1px solid rgb(242 244 241 / 0.1); color: inherit; text-decoration: none; }
  .jurnal li:first-child .jurnal-item { padding-top: 0; }
  :global(.jurnal-foto) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 12px; transition: transform 700ms var(--ease-out); }
  .jurnal-teks { display: grid; gap: 0.5rem; align-content: center; }
  .jurnal-kat { font-size: 0.85rem; color: var(--color-tunas); }
  .jurnal-nama { font-size: clamp(1.4rem, 1rem + 1.4vw, 2.2rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.12; transition: color 300ms; }
  .jurnal-ringkas { color: rgb(242 244 241 / 0.66); max-width: 56ch; }
  .jurnal-semua { display: inline-block; margin-top: 2rem; }
  @media (min-width: 64rem) {
    .jurnal-item { grid-template-columns: minmax(0, 0.32fr) minmax(0, 1fr); gap: 3rem; align-items: center; }
    .jurnal-item:hover .jurnal-nama { color: var(--color-tunas); }
    .jurnal-item:hover :global(.jurnal-foto) { transform: scale(1.03); }
  }

  /* Pill ajakan melayang (desktop, pola askmidnight) */
  .cta-apung {
    position: fixed; z-index: 30; left: 50%; bottom: 1.5rem; display: flex; align-items: center; gap: 1.25rem;
    padding: 0.45rem 0.45rem 0.45rem 1.5rem; border-radius: 999px; background: rgb(16 35 30 / 0.88); color: var(--color-embun);
    box-shadow: 0 20px 40px -18px rgb(0 0 0 / 0.55); backdrop-filter: blur(10px);
    opacity: 0; translate: -50% 24px; pointer-events: none; transition: opacity 500ms var(--ease-out), translate 600ms var(--ease-out);
  }
  .cta-apung span { font-size: 0.98rem; }
  .cta-apung .pill { min-height: 46px; }
  .cta-apung.tampil { opacity: 1; translate: -50% 0; pointer-events: auto; }
  @media (max-width: 63.99rem) { .cta-apung { display: none; } }

  /* WA melayang (HP saja) */
  .wa-apung {
    position: fixed; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 30;
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 52px; padding: 0 1.2rem 0 1rem;
    border-radius: 999px; background: var(--color-tunas); color: var(--color-pinus); font-weight: 500; text-decoration: none;
    box-shadow: 0 12px 28px -10px rgb(16 35 30 / 0.6);
    opacity: 0; transform: translateY(24px); pointer-events: none;
    transition: opacity 400ms var(--ease-out), transform 500ms var(--ease-out);
  }
  .wa-apung svg { width: 22px; height: 22px; fill: currentColor; }
  .wa-apung.tampil { opacity: 1; transform: none; pointer-events: auto; }
  @media (min-width: 64rem) { .wa-apung { display: none; } }
  /* ── HP: skala & ritme khusus layar kecil (token --hp-* di global.css, acuan iOS HIG). ───── */
  @media (max-width: 47.99rem) {
    .sek { padding-block: 3.25rem; }
    .kepala, .anatomi-kepala, .merek-kepala { gap: 0.75rem; margin-bottom: 1.5rem; }
    .judul-besar, .judul-2 { font-size: var(--hp-t1); line-height: 1.08; letter-spacing: -0.03em; max-width: 18ch; }
    .lead { font-size: 1rem; line-height: 1.5; }

    /* Hero HP: satu hierarki jelas — label kecil, judul besar rapat, satu kalimat, satu tombol utama,
       bukti di dekat tombol (landing-page-design: social proof dekat CTA). Label tetap di dalam h1 (SEO),
       dipindah ke atas lewat order. */
    .hero { min-height: calc(100svh - 49px - env(safe-area-inset-bottom)); }
    .hero::before {
      background:
        linear-gradient(180deg, rgb(10 20 16 / 0.35) 0%, transparent 16%),
        linear-gradient(0deg, rgb(10 20 16 / 0.96) 0%, rgb(10 20 16 / 0.82) 34%, rgb(10 20 16 / 0.25) 60%, transparent 78%);
    }
    .hero-isi { padding-bottom: 2.25rem; }
    .hero-judul { max-width: none; font-size: 2.875rem; line-height: 0.94; letter-spacing: -0.045em; }
    .hero-judul .baris { max-width: 8ch; }
    .hero-h1-sub {
      order: -1; display: flex; align-items: flex-start; gap: 0.55rem; margin: 0 0 1rem; max-width: 34ch;
      font-size: 0.8125rem; font-weight: 500; line-height: 1.35; letter-spacing: 0; color: rgb(255 255 255 / 0.82); text-wrap: balance;
    }
    .hero-h1-sub::before { content: ''; flex: none; margin-top: 0.68em; width: 22px; height: 1px; background: var(--color-tunas); }
    .hero-sub { display: none; } /* HP: cukup label, judul, satu tombol (permintaan Rama); kalimatnya tetap di desktop */
    .hero-aksi { margin-top: 1.75rem; display: grid; gap: 0.25rem; }
    .hero-aksi .pill { min-height: 50px; font-size: 1rem; }
    .hero-utama { box-shadow: 0 10px 28px -12px rgb(198 242 78 / 0.7); }
    .hero-utama::after { content: '→'; margin-left: 0.15rem; transition: transform 200ms var(--ease-out); }
    .hero-utama:active::after { transform: translateX(3px); }
    .hero-kedua { min-height: var(--hp-tombol) !important; border: 0; background: none; font-size: 0.875rem !important; font-weight: 500; color: rgb(255 255 255 / 0.85); text-decoration: underline; text-underline-offset: 0.3em; text-decoration-color: rgb(255 255 255 / 0.35); }
    .hero-bukti { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem 0.9rem; margin-top: 0.6rem; }
    .hero-bukti li { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.75rem; font-weight: 500; color: rgb(255 255 255 / 0.8); white-space: nowrap; }
    .hero-bukti li::before { content: '✓'; color: var(--color-tunas); }
