<script>
  // Area (DECISIONS 095): tab Jabodetabek / Luar Jabodetabek, dan baris tabel ↔ wilayah peta menyala bersamaan.
  const ar = document.querySelector<HTMLElement>('[data-ar]');
  if (ar) {
    const tab = [...ar.querySelectorAll<HTMLButtonElement>('[data-tab-ar]')];
    const pilih = (id: string) => {
      tab.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tabAr === id)));
      ar.querySelectorAll<HTMLElement>('[data-panel-ar]').forEach((p) => { p.hidden = p.dataset.panelAr !== id; });
      ar.dataset.tab = id;
    };
    tab.forEach((b) => b.addEventListener('click', () => pilih(b.dataset.tabAr!)));
    pilih('jabo');
    const nyala = (el: EventTarget | null, on: boolean) => {
      if (!(el instanceof Element)) return;
      const baris = el.closest<HTMLElement>('tr[data-cakupan]');
      const kota = baris ? baris.dataset.cakupan!.split('|') : [el.closest<HTMLElement>('[data-kota]')?.dataset.kota].filter(Boolean) as string[];
      if (!kota.length) return;
      const terkait = baris ?? [...ar.querySelectorAll<HTMLElement>('tr[data-cakupan]')].find((r) => r.dataset.cakupan!.split('|').includes(kota[0]));
      terkait?.classList.toggle('menyala', on);
      for (const k of (terkait?.dataset.cakupan ?? kota[0]).split('|')) ar.querySelector(`[data-kota="${k}"]`)?.classList.toggle('menyala', on);
    };
    for (const [masuk, keluar] of [['pointerover', 'pointerout'], ['focusin', 'focusout']] as const) {
      ar.addEventListener(masuk, (e) => nyala(e.target, true));
      ar.addEventListener(keluar, (e) => nyala(e.target, false));
    }
  }
  // Desktop: foto besar (hero, penutup) bergeser halus mengikuti kursor dengan pegas; cahaya senja ikut di hero.
  const desktop = matchMedia('(min-width: 64rem) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  if (desktop.matches) {
    for (const [pilih, kekuatan] of [['.hero', 16], ['.ajak', 14]] as const) {
      const sek = document.querySelector<HTMLElement>(pilih);
      const foto = sek?.querySelector<HTMLElement>('img');
      if (!sek || !foto) continue;
      const cahaya = sek.querySelector<HTMLElement>('.hero-cahaya');
      let tx = 0.6, ty = 0.4, x = tx, y = ty, id = 0;
      const jalan = () => {
        x += (tx - x) * 0.07;
        y += (ty - y) * 0.07;
        foto.style.translate = `${((0.5 - x) * kekuatan).toFixed(2)}px ${((0.5 - y) * kekuatan * 0.6).toFixed(2)}px`;
        if (cahaya) {
          const r = sek.getBoundingClientRect();
          const d = cahaya.offsetWidth / 2;
          cahaya.style.transform = `translate(${(x * r.width - d).toFixed(1)}px, ${(y * r.height - d).toFixed(1)}px)`;
        }
        id = Math.abs(tx - x) + Math.abs(ty - y) > 0.0008 ? requestAnimationFrame(jalan) : 0;
      };
      sek.addEventListener('pointermove', (e) => {
        const r = sek.getBoundingClientRect();
        tx = (e.clientX - r.left) / r.width;
        ty = (e.clientY - r.top) / r.height;
        if (!id) id = requestAnimationFrame(jalan);
      });
    }
  }

  // FAQ: di desktop, pertanyaan yang disorot mouse langsung terbuka (satu per satu, name="tanya" menutup yang lain).
  const sorot = matchMedia('(hover: hover) and (pointer: fine)');
  document.querySelectorAll<HTMLDetailsElement>('[data-tanya] details').forEach((d) => {
    d.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse' && sorot.matches) d.open = true; });
  });

  // Tombol WA melayang muncul di HP setelah slip Hitung AKAL lewat, supaya tidak dobel dengan tombol di slip.
  const apung = document.querySelector<HTMLElement>('.wa-apung');
  const slip = document.querySelector('.hero');
  if (apung && slip) {
    apung.hidden = false;
    new IntersectionObserver(([e]) => {
      apung.classList.toggle('tampil', !e.isIntersecting && e.boundingClientRect.top < 0);
    }).observe(slip);
  }

  // Angka fakta menghitung naik sekali saat terlihat (HTML tetap memuat angka final untuk mesin pencari).
  {
    const kurangi = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      const el = e.target as HTMLElement;
      const m = el.textContent!.match(/^(\d+)(.*)$/);
      if (!m || kurangi) return;
      const n = Number(m[1]), sisa = m[2], t0 = performance.now();
      const jalan = (t: number) => {
        const p = Math.min(1, (t - t0) / 900);
        el.textContent = Math.round(n * (1 - Math.pow(1 - p, 3))) + sisa;
        if (p < 1) requestAnimationFrame(jalan);
      };
      requestAnimationFrame(jalan);
    }), { threshold: 0.6 });
    document.querySelectorAll('.bukti-daftar b').forEach((b) => io.observe(b));
  }

</script>

<style>
  main { position: relative; }
