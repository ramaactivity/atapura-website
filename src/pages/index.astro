---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PetaArea from '../components/PetaArea.astro';
import AkalCerita from '../components/AkalCerita.astro';
import { getCollection } from 'astro:content';
import Foto from '../components/Foto.astro';
import { Image } from 'astro:assets';
import heroDesktop from '../../assets/gambar/magnific/hero-desktop.jpg';
import heroHp from '../../assets/gambar/magnific/hero-hp.jpg';
import kafe from '../../assets/gambar/magnific/segmen-kafe-3x2.jpg';
import kafeHp from '../../assets/gambar/magnific/segmen-kafe-4x5.jpg';
import terasHujan from '../../assets/gambar/magnific/faq-teras-hujan-16x9.jpg';
import fotoPasangBaru from '../../assets/gambar/magnific/artikel-tukang-pasang-3x2.jpg';
import fotoGantiAtap from '../../assets/gambar/magnific/ganti-atap-per-bagian-3x2.jpg';
import fotoRangka from '../../assets/gambar/magnific/penerapan-rangka-rumah-baru-3x2.jpg';
import fotoMaterial from '../../assets/gambar/magnific/pricelist-material-lengkap.jpg';
import '../styles/desktop.css';
import { bisnis, waLink } from '../data/bisnis';
import { bagianRentang, estimasiPublik, harga, rentangRangka, tanggalPanjang, type Merek } from '../data/harga';
import LogoKlien from '../components/LogoKlien.astro';
import { produk, layanan as daftarLayanan, sampulProduk } from '../data/produk';

// Kartu contoh hitungan di hero desktop: angka dihitung dari rumus yang sama dengan kalkulator (satu sumber).
const contohHitung = ([['Rumah satu lantai', 90, 'Maxxi'], ['Rumah dua lantai', 120, 'CTI'], ['Villa', 180, 'Javabitumen']] as const).map(([jenis, luas, merek]) => {
  const e = estimasiPublik(luas, merek as Merek);
  return { jenis, luas, merek, rp: bagianRentang(e.total[0], e.total[1]), hari: e.hari };
});

// Deret logo merek: file satu warna dari tools/logo/satu-warna.py. Tinggi diseimbangkan menurut rasio lebar
// supaya logo lebar (Javabitumen, Tegola) tidak terlihat lebih besar dari logo ringkas (Maxxi, Victory).
const fileLogo = import.meta.glob<{ default: ImageMetadata }>('../../assets/mitra/satu-warna/*.png', { eager: true });
const urutan: readonly string[] = bisnis.merek;
const logoMerek = produk.filter((p) => p.lini === 'atap').sort((a, b) => urutan.indexOf(a.nama) - urutan.indexOf(b.nama)).map((p) => {
  const src = fileLogo[`../../assets/mitra/satu-warna/${p.slug}.png`].default;
  return { slug: p.slug, nama: p.nama, src, tinggi: `${(1 / Math.sqrt(src.width / src.height / 3)).toFixed(3)}em` };
});
const hari120 = estimasiPublik(120, 'CTI').hari;

// Kartu merek & harga: urut dari harga terpasang termurah; logo satu warna, foto sampul, garansi pabrik bila ada angkanya.
const kartuMerek = produk.filter((p) => p.lini === 'atap' && p.harga).map((p) => {
  const h = harga.merek[p.harga as Merek];
  const lg = logoMerek.find((l) => l.slug === p.slug)!;
  const th = h.garansiPabrik.match(/\d+/)?.[0];
  return {
    slug: p.slug, nama: p.nama, kelas: h.kelas, foto: sampulProduk(p), logo: lg.src, tinggiLogo: lg.tinggi,
    min: h.terpasang[0], rp: bagianRentang(h.terpasang[0], h.terpasang[1]),
    garansi: th ? `Garansi pabrik ${/hingga/i.test(h.garansiPabrik) ? 's.d. ' : ''}${th} th` : null,
  };
}).sort((a, b) => a.min - b.min);

// Empat langkah ringkas untuk beranda (rincian enam tahap di /cara-kerja, src/data/cara-kerja.ts). Kalimat umum,
// tanpa janji prosedural yang tidak ada di Ops (foto per lapis, dsb.).
const langkah = [
  { nama: 'Konsultasi', isi: 'Ceritakan kebutuhan atap Anda lewat WhatsApp. Kami bantu pilih merek dan material yang pas.' },
  { nama: 'Survey & penawaran', isi: 'Atap diukur di lokasi, lalu Anda menerima penawaran lengkap dengan rincian biaya.' },
  { nama: 'Pemasangan', isi: 'Material dikirim ke lokasi dan dipasang lapis demi lapis sesuai panduan pabrik.' },
  { nama: 'Serah terima', isi: 'Hasil diperiksa bersama, lalu garansi pemasangan mulai berjalan.' },
];

// Kartu layanan beranda = daftar layanan bersama (src/data/produk.ts, sinkron dengan Ops). Kartu berfoto untuk layanan
// yang punya foto; "Jasa pasang saja" tampil sebagai baris kecil di bawah kartu.
const fotoLayanan: Partial<Record<string, { src: ImageMetadata; alt: string }>> = {
  'atap-baru': { src: fotoPasangBaru, alt: 'Ilustrasi tukang memasang genteng aspal di atap rumah baru' },
  'ganti-atap': { src: fotoGantiAtap, alt: 'Ilustrasi tukang mengganti atap rumah dua lantai dengan genteng aspal' },
  rangka: { src: fotoRangka, alt: 'Ilustrasi rumah baru dengan rangka atap baja ringan' },
  material: { src: fotoMaterial, alt: 'Ilustrasi material atap lengkap: genteng aspal, alas, underlayment, dan aksesoris' },
};
const layanan = daftarLayanan.flatMap((l) => { const f = fotoLayanan[l.ikon]; return f ? [{ judul: l.nama, teks: l.isi, href: l.href, foto: f.src, alt: f.alt }] : []; });
const jasaSaja = daftarLayanan.find((l) => l.ikon === 'jasa');
// Harga terpasang termurah dari data Ops (ikut berubah otomatis).
const hargaMulai = Math.min(...Object.values(harga.merek).map((m) => m.terpasang[0])) / 1000;

const panduanTerbaru =(await getCollection('panduan')).sort((a, b) => b.data.diperbarui.getTime() - a.data.diperbarui.getTime()).slice(0, 3);

// Tanya jawab beranda (juga FAQPage schema). Isi sinkron dengan Ops: harga dari ops.json, cara bayar & garansi = S&K
// penawaran Ops (src/lib/penawaran/syarat.ts), material saja / jasa saja = JENIS transaksi Ops. Urut dari yang paling dicari.
const tanya = [
  {
    q: 'Berapa biaya pasang atap bitumen per meter persegi?',
    a: `Di Jabodetabek, estimasi terpasang per m² (genteng, alas, underlayment, aksesoris, dan jasa pasang): CTI Rp${harga.merek.CTI.terpasang.map((n) => n / 1000).join('–')} ribu, Maxxi dan Javabitumen Rp${harga.merek.Maxxi.terpasang.map((n) => n / 1000).join('–')} ribu, Victory Rp${harga.merek.Victory.terpasang.map((n) => n / 1000).join('–')} ribu, Tegola Rp${harga.merek.Tegola.terpasang.map((n) => n / 1000).join('–')} ribu. Harga genteng saja: CTI Rp${harga.merek.CTI.genteng / 1000} ribu, Maxxi dan Javabitumen Rp${harga.merek.Maxxi.genteng / 1000} ribu, Victory Rp${harga.merek.Victory.genteng / 1000} ribu (Standar) per m². Rangka baja ringan baru, bila perlu, Rp${rentangRangka[0] / 1000}–${rentangRangka[1] / 1000} ribu per m² terpasang (material, aksesori, dan jasa), tergantung merek: K-Steel, Hi-Steel, atau Taso. Harga final kami tulis setelah survey dan pengukuran luas.`,
  },
  {
    q: 'Bisa beli material saja atau jasa pasang saja?',
    a: 'Bisa. Selain paket material dan pemasangan, kami melayani pembelian material saja untuk dipasang tukang Anda, dan jasa pasang saja bila material sudah Anda siapkan. Garansi material ditanggung pabrik masing-masing merek; garansi pemasangan berlaku untuk pekerjaan yang kami pasang.',
  },
  {
    q: 'Apakah atap bitumen cocok untuk bangunan saya?',
    a: 'Atap bitumen cocok untuk atap miring dengan rangka kayu atau baja ringan, karena bobotnya jauh lebih ringan dari genteng beton atau keramik. Batas kemiringannya mengikuti pabrik: Maxxi mulai 15 derajat, Tegola 14 derajat untuk pemasangan paku biasa, dan CTI mulai 10 derajat dengan cara pasang khusus. Kalau atap Anda lebih landai dari itu, kami sarankan material lain dan kami jelaskan alasannya saat survey.',
  },
  {
    q: 'Berapa lama pengerjaannya?',
    a: `Atap 120 m² umumnya selesai ${estimasiPublik(120, 'CTI').hari.join('–')} hari kerja, tergantung cuaca dan bentuk atap. Kalkulator biaya di halaman Hitung biaya menampilkan perkiraan untuk luas atap Anda. Jadwal pastinya disepakati setelah survey.`,
  },
  {
    q: 'Garansinya seperti apa?',
    a: `Ada dua garansi terpisah. Garansi pabrik menanggung material genteng sesuai dokumen resmi tiap merek. Garansi pemasangan dari Atapura berlaku ${bisnis.garansiPemasanganTahun} tahun sejak serah terima dan menanggung kebocoran dan kesalahan pasang, termasuk material dan jasa perbaikannya. Klaim cukup lewat WhatsApp dengan foto; tim memeriksa paling lambat 3 hari kerja.`,
  },
  {
    q: 'Bagaimana cara bayarnya?',
    a: `Detail kesepakatan kami bahas bersama lewat WhatsApp. Material dibayar lunas sebelum dikirim ke lokasi. Jasa pasang dibayar bertahap ${bisnis.pembayaran.jasa.map((t) => `${t.persen}%`).join(', ')}: ${bisnis.pembayaran.jasa.map((t) => t.saat.toLowerCase()).join('; ')}.`,
  },
  {
    q: 'Apakah Atapura melayani di luar Jabodetabek?',
    a: `Ya. Kami melayani seluruh Jabodetabek hingga luar Pulau Jawa. Untuk lokasi di luar Jabodetabek, harga dihitung langsung bersama admin lewat WhatsApp karena ada akomodasi tukang dan pengiriman material (misalnya tiket pesawat atau ekspedisi antarpulau). Tiket dan ekspedisi bisa kami carikan atau Anda atur sendiri; kami tidak mengambil untung dari akomodasi. Tim pemasang kami berpengalaman mengerjakan atap hingga ${bisnis.survey.pengalamanLuar.join(', ')}.`,
  },
  {
    q: 'Apa bedanya atap bitumen, genteng aspal, sirap aspal, dan shingle?',
    a: `Keempatnya sebutan untuk produk yang sama: lembaran fiberglass berlapis aspal dengan butiran batu di permukaannya. Shingle adalah istilah Inggrisnya, sirap aspal sebutan lama, dan di toko bangunan lebih sering disebut genteng aspal. Atapura memasang ${bisnis.merek.length} merek: ${bisnis.merek.slice(0, -1).join(', ')}, dan ${bisnis.merek.at(-1)}.`,
  },
];

// Kota yang sudah punya halaman /area/* jadi tautan (SEO internal); yang belum tetap teks biasa.
const halamanArea = new Map((await getCollection('area')).flatMap((a) => a.data.cakupan.map((c) => [c.nama, `/area/${a.id}`] as const)));
const wilayah = [
  { nama: 'DKI Jakarta', kota: bisnis.area.filter((a) => a.startsWith('Jakarta')) },
  { nama: 'Jawa Barat', kota: bisnis.area.filter((a) => /Bogor|Depok|Bekasi/.test(a)) },
  { nama: 'Banten', kota: bisnis.area.filter((a) => /Tangerang/.test(a)) },
];


const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tanya.map((t) => ({ '@type': 'Question', name: t.q, acceptedAnswer: { '@type': 'Answer', text: t.a } })),
};
---

<Base
  title="Atap Bitumen Jabodetabek: Hitung Biaya Pasang | Atapura"
  description="Pasang atap bitumen Maxxi, CTI, Javabitumen, Tegola, dan Victory di Jabodetabek. Hitung estimasi biaya total dalam satu menit, lihat cara pasang per lapis, survey gratis."
  schema={[faqSchema]}
>
  <Header />
  <main>
    <section class="hero" aria-labelledby="judul">
      <Foto desktop={heroDesktop} hp={heroHp} alt="Ilustrasi rumah dua lantai beratap genteng aspal di sore hari" class="hero-foto" eager />
      <div class="hero-cahaya" aria-hidden="true"></div>
      <div class="wrap hero-isi">
        <h1 id="judul" class="hero-judul">
          <span class="hero-h1-sub">Spesialis jasa pasang genteng aspal · Jabodetabek</span>
          <span class="baris"><span>Atap bitumen,</span></span>
          <span class="baris hero-redup"><span>harga masuk <b class="hero-akal">akal.</b></span></span>
        </h1>
        <p class="hero-sub">Dipasang lima lapis dari alas sampai nok oleh tim profesional dengan prinsip AKAL: Andal, Berkualitas, Amanah &amp; Lestari.</p>
        <div class="hero-aksi">
          <a href="/hitung" class="pill hero-utama">Hitung estimasi biaya</a>
        </div>
        <ul class="hero-bukti" aria-label="Yang Anda dapat">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 8 12 3.5 20.5 8v8L12 20.5 3.5 16z" /><path d="M3.5 8 12 12.5 20.5 8M12 12.5v8" /></svg><span>Material lengkap</span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 15.5 15.5 3l5.5 5.5L8.5 21z" /><path d="m7 11.5 2 2M10 8.5l2 2M13 5.5l2 2" /></svg><span>Jasa pasang tuntas</span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 19 12 5l9.5 14z" /><path d="M7.2 12h9.6M12 5v14M7.2 12 12 19l4.8-7" /></svg><span>Bisa sekalian rangka</span></li>
        </ul>
      </div>
      <!-- Contoh hasil saja (bukti harga terbuka), bukan tombol: hero cukup satu ajakan (Rama, 23 Nov 2026). -->
      <aside class="hero-kartu" aria-label="Contoh biaya pasang atap bitumen">
        <span class="hk-label">Contoh biaya terpasang</span>
        <span class="hk-putar">
          {contohHitung.map((c) => (
            <span class="hk-item">
              <span class="hk-jenis">{c.jenis} · <span class="angka">{c.luas}</span> m² · {c.merek}</span>
              <span class="hk-angka angka">Rp{c.rp.min}–{c.rp.max}<small> {c.rp.satuan}</small></span>
              <span class="hk-hari">±<span class="angka">{c.hari[0]}–{c.hari[1]}</span> hari kerja, terpasang</span>
            </span>
          ))}
        </span>
      </aside>
      <p class="ilustrasi">Ilustrasi, bukan proyek Atapura</p>
    </section>

    <section class="bukti" aria-label="Merek dan fakta Atapura">
      <div class="wrap">
        <!-- Deret logo merek (satu warna, DECISIONS 085) lalu baris angka bergaris pemisah (acuan Banklio/Redow). -->
        <div class="merek-deret">
          <p class="merek-label">Merek yang kami pasang</p>
          <ul class="merek-logo">
            {logoMerek.map((l) => (
              <li>
                <a href={`/produk/${l.slug}`} aria-label={`Atap bitumen ${l.nama}`} style={`--h: ${l.tinggi}`}>
                  <Image src={l.src} alt={l.nama} height={112} densities={[1]} loading="lazy" />
                </a>
              </li>
            ))}
          </ul>
        </div>
        <ul class="bukti-daftar">
          <li><b>±<span class="angka">{hari120[0]}–{hari120[1]}</span> hari</b><span>kerja untuk atap 120 m²</span></li>
          <li><b>Rp<span class="angka">{hargaMulai}</span> rb</b><span>per m² terpasang, harga mulai</span></li>
          <li><b>Jabodetabek</b><span>seluruhnya, hingga luar Pulau Jawa</span></li>
        </ul>
      </div>
    </section>

    <LogoKlien />

    <section id="layanan" class="sek c-embun" aria-labelledby="judul-layanan">
      <div class="wrap">
        <div class="kepala">
          <h2 id="judul-layanan" class="judul-besar judul-dua">Solusi layanan atap bitumen <span class="miring">sesuai kebutuhan proyek Anda.</span></h2>
          <p class="lead">Semua kebutuhan material dan pemasangan dalam satu pintu.</p>
        </div>
        <!-- Deret kartu berfoto (acuan Forma Casa & Logamax, DECISIONS 086); HP digeser ke samping. -->
        <ul class="lyn-daftar">
          {layanan.map((l) => (
            <li>
              <a class="lyn-kartu" href={l.href}>
                <Image class="lyn-foto" src={l.foto} alt={l.alt} widths={[400, 640, 960]} sizes="(min-width: 64rem) 25vw, (min-width: 48rem) 45vw, 78vw" loading="lazy" />
                <span class="lyn-isi">
                  <span class="lyn-judul">{l.judul}</span>
                  <span class="lyn-teks">{l.teks}</span>
                </span>
                <span class="lyn-panah" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        {jasaSaja && <p class="lyn-catatan">Material sudah ada? <a class="lyn-wa" href={jasaSaja.href} target="_blank" rel="noopener" data-wa="jasa-saja">Tanya {jasaSaja.nama.toLowerCase()}</a></p>}
        <div id="layanan-proyek" class="lyn-pita">
          <div>
            <p class="lyn-pita-label">Untuk perusahaan</p>
            <h3 class="lyn-pita-judul">Proyek perumahan &amp; komersial</h3>
            <p class="lyn-pita-teks">Penawaran per item, spesifikasi pabrik, dan termin pembayaran untuk diajukan ke atasan atau klien.</p>
          </div>
          <div class="lyn-pita-aksi">
            <a class="pill pill-tunas" href={waLink('Halo Atapura, saya dari perusahaan dan butuh penawaran resmi untuk proyek atap.')} target="_blank" rel="noopener" data-wa="proyek">Minta penawaran resmi</a>
            <a class="tautan-lanjut" href="/perusahaan">Selengkapnya</a>
          </div>
        </div>
      </div>
    </section>

    <section id="akal" class="sek terang c-putih" aria-labelledby="judul-akal">
      <div class="wrap">
        <div class="kepala">
          <h2 id="judul-akal" class="judul-besar judul-dua">Empat nilai yang kami pegang <span class="miring">di setiap proyek atap.</span></h2>
          <p class="lead">Prinsip AKAL kami jaga dari penawaran pertama sampai lama setelah atap terpasang.</p>
        </div>
        <AkalCerita />
      </div>
    </section>

    <section id="cara-kerja" class="sek gelap c-pinus" aria-labelledby="judul-cara">
      <div class="wrap">
        <div class="kepala">
          <h2 id="judul-cara" class="judul-besar judul-dua">Dari chat pertama <span class="miring">sampai atap terpasang.</span></h2>
          <p class="lead">Prosesnya jelas sejak awal, jadi Anda selalu tahu langkah berikutnya.</p>
        </div>
        <!-- Empat langkah bernomor di satu garis waktu (acuan Redow "From insight to impact", DECISIONS 090).
             Rincian enam tahap tetap di /cara-kerja. -->
        <ol class="langkah">
          {langkah.map((l, i) => (
            <li>
              <span class="langkah-no angka">0{i + 1}</span>
              <h3 class="langkah-nama">{l.nama}</h3>
              <p class="langkah-isi">{l.isi}</p>
            </li>
          ))}
        </ol>
        <a class="tautan-lanjut langkah-tautan" href="/cara-kerja">Rincian lengkap cara kerja</a>
      </div>
    </section>

    <section id="merek" class="sek terang c-embun" aria-labelledby="judul-merek">
      <div class="wrap">
        <div class="kepala">
          <h2 id="judul-merek" class="judul-besar judul-dua">Lima merek pilihan, <span class="miring">harga terpasang per m².</span></h2>
          <p class="lead">Sudah termasuk material lengkap dan jasa pasang di Jabodetabek.</p>
        </div>
        <!-- Kartu merek berfoto, urut dari termurah (acuan Bau Cargo "Наши услуги" + Forma Casa, DECISIONS 090).
             Pemilih merek, tabel spesifikasi, dan kalkulator pindah ke /produk dan /hitung. -->
        <ul class="mk-daftar">
          {kartuMerek.map((m) => (
            <li>
              <a class="mk-kartu" href={`/produk/${m.slug}`}>
                <span class="mk-atas">
                  <img class="mk-logo" src={m.logo.src} width={m.logo.width} height={m.logo.height} alt={m.nama} style={`--h: ${m.tinggiLogo}`} loading="lazy" decoding="async" />
                  <span class="mk-kelas">{m.kelas}</span>
                </span>
                {m.foto && <Image class="mk-foto" src={m.foto.src} alt={m.foto.alt} widths={[360, 540, 720]} sizes="(min-width: 75rem) 18vw, (min-width: 48rem) 30vw, 72vw" loading="lazy" />}
                <span class="mk-harga-label">Terpasang per m²</span>
                <span class="mk-harga angka" data-nosnippet><span class="mk-rp">Rp</span>{m.rp.min}–{m.rp.max}<span class="mk-satuan"> {m.rp.satuan}</span></span>
                {m.garansi && <span class="mk-garansi">{m.garansi}</span>}
                <span class="mk-panah" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="mk-bawah">
          <a class="tautan-lanjut" href="/produk">Bandingkan warna dan spesifikasi</a>
          <a class="tautan-lanjut" href="/hitung">Hitung untuk luas atap Anda</a>
        </div>
      </div>
    </section>

    <section id="area" class="sek terang c-putih" aria-labelledby="judul-area">
      <div class="wrap">
        <div class="kepala">
          <h2 id="judul-area" class="judul-besar judul-dua">Melayani seluruh Jabodetabek, <span class="miring">hingga luar Pulau Jawa.</span></h2>
          <p class="lead">Survey dan pengukuran di lokasi untuk wilayah Jabodetabek. Di luar Jabodetabek, ongkos kirim material dan akomodasi tukang dihitung bersama admin.</p>
        </div>
        <!-- Chip kota yang bisa diklik (acuan Bau Cargo) + peta di kartu (acuan Logamax "Key Trade Lanes"), DECISIONS 090.
             HP: peta disembunyikan, tersedia di /area. -->
        <div class="ar">
          <div class="ar-kiri">
            {wilayah.map((w) => (
              <div class="ar-grup">
                <h3 class="ar-nama">{w.nama}</h3>
                <ul class="ar-chip">{w.kota.map((k) => <li>{halamanArea.has(k) ? <a href={halamanArea.get(k)}>{k}</a> : <span>{k}</span>}</li>)}</ul>
              </div>
            ))}
            <div class="ar-grup">
              <h3 class="ar-nama">Pernah dikerjakan di luar Jabodetabek</h3>
