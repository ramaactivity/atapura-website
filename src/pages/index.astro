  @media (min-width: 48rem) { #judul-layanan { max-width: 30ch; } #judul-layanan .miring { display: block; } }
  /* Pengantar di kanan: dua baris seimbang, menempel ke tepi kanan (masukan Rama). */
  @media (min-width: 60rem) { #layanan .lead { justify-self: end; max-width: 30ch; text-wrap: balance; } }
