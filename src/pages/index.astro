---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lapisan from '../components/Lapisan.astro';
import PetaArea from '../components/PetaArea.astro';
import PilihMerek from '../components/PilihMerek.astro';
import AkalCerita from '../components/AkalCerita.astro';
import { getCollection } from 'astro:content';
import HitungCepat from '../islands/HitungCepat';
import Foto from '../components/Foto.astro';
import { Image } from 'astro:assets';
import heroDesktop from '../../assets/gambar/magnific/hero-desktop.jpg';
import heroHp from '../../assets/gambar/magnific/hero-hp.jpg';
import tukang from '../../assets/gambar/magnific/tukang-4x5.jpg';
import villa from '../../assets/gambar/magnific/segmen-villa-3x2.jpg';
import villaHp from '../../assets/gambar/magnific/segmen-villa-4x5.jpg';
import kafe from '../../assets/gambar/magnific/segmen-kafe-3x2.jpg';
import kafeHp from '../../assets/gambar/magnific/segmen-kafe-4x5.jpg';
import terasHujan from '../../assets/gambar/magnific/faq-teras-hujan-16x9.jpg';
import '../styles/desktop.css';
import { bisnis, waLink } from '../data/bisnis';
import { tahap } from '../data/cara-kerja';
import { bagianRentang, estimasiPublik, harga, rentangRangka, tanggalPanjang, type Merek } from '../data/harga';
import LogoKlien from '../components/LogoKlien.astro';

// Kartu contoh hitungan di hero desktop: angka dihitung dari rumus yang sama dengan kalkulator (satu sumber).
const contohHitung = ([['Rumah satu lantai', 90, 'Maxxi'], ['Rumah dua lantai', 120, 'CTI'], ['Villa', 180, 'Javabitumen']] as const).map(([jenis, luas, merek]) => {
  const e = estimasiPublik(luas, merek as Merek);
  return { jenis, luas, merek, rp: bagianRentang(e.total[0], e.total[1]), hari: e.hari };
});

const panduanTerbaru = (await getCollection('panduan')).sort((a, b) => b.data.diperbarui.getTime() - a.data.diperbarui.getTime()).slice(0, 3);

const tanya = [
  {
    q: 'Apakah Atapura melayani di luar Jabodetabek?',
    a: `Ya. Basis kami di Jabodetabek, tempat survey gratis. Untuk lokasi di luar Jabodetabek, harga dihitung langsung bersama admin lewat WhatsApp karena ada akomodasi tukang dan pengiriman material (misalnya tiket pesawat atau ekspedisi antarpulau). Tiket dan ekspedisi bisa kami carikan atau Anda atur sendiri; kami tidak mengambil untung dari akomodasi. Tim pemasang kami berpengalaman mengerjakan atap hingga ${bisnis.survey.pengalamanLuar.join(', ')}.`,
  },
  {
    q: 'Apa bedanya atap bitumen, genteng aspal, sirap aspal, dan shingle?',
    a: `Keempatnya sebutan untuk produk yang sama: lembaran fiberglass berlapis aspal dengan butiran batu di permukaannya. Shingle adalah istilah Inggrisnya, sirap aspal sebutan lama, dan di toko bangunan lebih sering disebut genteng aspal. Atapura memasang ${bisnis.merek.length} merek: ${bisnis.merek.slice(0, -1).join(', ')}, dan ${bisnis.merek.at(-1)}.`,
  },
  {
    q: 'Berapa biaya pasang atap bitumen per meter persegi?',
    a: `Di Jabodetabek, estimasi terpasang per m² (genteng, alas, underlayment, aksesoris, dan jasa pasang): CTI Rp${harga.merek.CTI.terpasang.map((n) => n / 1000).join('–')} ribu, Maxxi dan Javabitumen Rp${harga.merek.Maxxi.terpasang.map((n) => n / 1000).join('–')} ribu, Victory Rp${harga.merek.Victory.terpasang.map((n) => n / 1000).join('–')} ribu, Tegola Rp${harga.merek.Tegola.terpasang.map((n) => n / 1000).join('–')} ribu. Harga genteng saja: CTI Rp${harga.merek.CTI.genteng / 1000} ribu, Maxxi dan Javabitumen Rp${harga.merek.Maxxi.genteng / 1000} ribu, Victory Rp${harga.merek.Victory.genteng / 1000} ribu (Standar) per m². Rangka baja ringan baru, bila perlu, Rp${rentangRangka[0] / 1000}–${rentangRangka[1] / 1000} ribu per m² terpasang (material, aksesori, dan jasa), tergantung merek: K-Steel, Hi-Steel, atau Taso. Harga final kami tulis setelah survey gratis dan opname luas.`,
  },
  {
    q: 'Apakah atap bitumen cocok untuk rumah saya?',
    a: 'Atap bitumen cocok untuk atap miring dengan rangka kayu atau baja ringan, karena bobotnya jauh lebih ringan dari genteng beton atau keramik. Batas kemiringannya mengikuti pabrik: Maxxi mulai 15 derajat, Tegola 14 derajat untuk pemasangan paku biasa, dan CTI mulai 10 derajat dengan cara pasang khusus. Kalau atap Anda lebih landai dari itu, kami sarankan material lain dan kami jelaskan alasannya saat survey.',
  },
  {
    q: 'Berapa lama pengerjaannya?',
    a: `Atap 120 m² umumnya selesai ${estimasiPublik(120, 'CTI').hari.join('–')} hari kerja, tergantung cuaca dan bentuk atap. Hitung AKAL menampilkan perkiraan untuk luas Anda. Jadwal pasti kami kirim tertulis setelah survey.`,
  },
  {
    q: 'Garansinya seperti apa?',
    a: `Ada dua garansi terpisah. Garansi pabrik menanggung material genteng sesuai dokumen resmi tiap merek. Garansi pemasangan dari Atapura berlaku ${bisnis.garansiPemasanganTahun} tahun sejak serah terima dan menanggung kebocoran dan kesalahan pasang, termasuk material dan jasa perbaikannya. Klaim cukup lewat WhatsApp dengan foto; tim memeriksa paling lambat 3 hari kerja.`,
  },
  {
    q: 'Bagaimana cara bayarnya?',
    a: `Survey gratis di Jabodetabek. Detail kesepakatan kami bahas bersama lewat WhatsApp. Material dibayar lunas sebelum dikirim ke lokasi. Jasa pasang dibayar bertahap ${bisnis.pembayaran.jasa.map((t) => `${t.persen}%`).join(', ')}: ${bisnis.pembayaran.jasa.map((t) => t.saat.toLowerCase()).join('; ')}.`,
  },
];

// Kota yang sudah punya halaman /area/* jadi tautan (SEO internal); yang belum tetap teks biasa.
const halamanArea = new Map((await getCollection('area')).flatMap((a) => a.data.cakupan.map((c) => [c.nama, `/area/${a.id}`] as const)));
const wilayah = [
  { nama: 'DKI Jakarta', kota: bisnis.area.filter((a) => a.startsWith('Jakarta')) },
  { nama: 'Jawa Barat', kota: bisnis.area.filter((a) => /Bogor|Depok|Bekasi/.test(a)) },
  { nama: 'Banten', kota: bisnis.area.filter((a) => /Tangerang/.test(a)) },
];

const merekTabel = [
  { nama: 'Maxxi', kelas: harga.merek.Maxxi.kelas, pasti: 'Model 3-tab, 1000 × 333 mm, tebal 2,66 mm, 3,10 m² per bundel', r: harga.merek.Maxxi.terpasang, g: harga.merek.Maxxi.genteng, garansi: harga.merek.Maxxi.garansiPabrik },
  { nama: 'CTI', kelas: harga.merek.CTI.kelas, pasti: 'Seri CT3 (1000 × 333 mm), CT5, dan CT6 (1000 × 317,5 mm), 3,00 m² per bundel', r: harga.merek.CTI.terpasang, g: harga.merek.CTI.genteng, garansi: harga.merek.CTI.garansiPabrik },
  { nama: 'Javabitumen', kelas: harga.merek.Javabitumen.kelas, pasti: 'Spesifikasi menunggu brosur resmi dari produsen', r: harga.merek.Javabitumen.terpasang, g: harga.merek.Javabitumen.genteng, garansi: harga.merek.Javabitumen.garansiPabrik },
  // Harga Tegola SEMENTARA dari riset pasar (DECISIONS 047), dikoreksi Bang Yusuf Kamis 19 Nov.
  { nama: 'Tegola', kelas: harga.merek.Tegola.kelas, pasti: 'Pabrikan Tegola Canadese, Italia. Seri satu lapis Premium (1000 × 340 mm, ±10,7 kg/m²) dan dua lapis Master (±12,3 kg/m²); paku biasa mulai 14° (Master 19°)', r: harga.merek.Tegola.terpasang, g: harga.merek.Tegola.genteng, garansi: 'Garansi terbatas terdaftar hingga 40 tahun, bertahap; syarat pasang sesuai manual pabrik' },
  { nama: 'Victory', kelas: harga.merek.Victory.kelas, pasti: 'Model 3-tab, seri Standar dan Two Tone, 21 lembar (3 m²) per bundel', r: harga.merek.Victory.terpasang, g: harga.merek.Victory.genteng, garansi: harga.merek.Victory.garansiPabrik },
] as { nama: string; kelas: string; pasti: string; r: readonly [number, number] | null; g: number | null; garansi: string }[];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tanya.map((t) => ({ '@type': 'Question', name: t.q, acceptedAnswer: { '@type': 'Answer', text: t.a } })),
};
---

<Base
  title="Atap Bitumen Jabodetabek: Hitung Biaya Pasang | Atapura"
  description="Pasang atap bitumen Maxxi, CTI, Javabitumen, Tegola, dan Victory di Jabodetabek. Hitung estimasi biaya total dalam satu menit, lihat cara pasang per lapis, survey gratis."
  schema={[faqSchema]}
>
  <Header />
  <main>
    <section class="hero" aria-labelledby="judul">
      <Foto desktop={heroDesktop} hp={heroHp} alt="Ilustrasi rumah dua lantai beratap genteng aspal di sore hari" class="hero-foto" eager />
      <div class="hero-cahaya" aria-hidden="true"></div>
      <div class="wrap hero-isi">
        <h1 id="judul" class="hero-judul">
          <span class="baris"><span>Atap yang masuk</span></span>
          <span class="baris miring-hero"><span>AKAL.</span></span>
          <span class="hero-h1-sub">Jasa pasang atap bitumen (genteng aspal) di Jabodetabek.</span>
        </h1>
        <p class="hero-sub">Maxxi, CTI, Javabitumen, Tegola, dan Victory. Harga terbuka sebelum Anda bicara dengan siapa pun.</p>
        <div class="hero-aksi">
          <a href="/hitung" class="pill hero-utama">Hitung estimasi biaya</a>
          <a href="/perusahaan" class="pill pill-garis hero-kedua">Untuk perusahaan &amp; proyek</a>
        </div>
        <ul class="hero-bukti" aria-label="Jaminan">
          <li>Survey gratis</li>
          <li>Garansi {bisnis.garansiPemasanganTahun} tahun</li>
        </ul>
      </div>
      <a class="hero-kartu" href="/hitung" aria-label="Contoh hasil Hitung AKAL. Hitung biaya atap Anda">
        <span class="hk-label">Contoh Hitung AKAL</span>
        <span class="hk-putar">
          {contohHitung.map((c) => (
            <span class="hk-item">
              <span class="hk-jenis">{c.jenis} · <span class="angka">{c.luas}</span> m² · {c.merek}</span>
              <span class="hk-angka angka">Rp{c.rp.min}–{c.rp.max}<small> {c.rp.satuan}</small></span>
              <span class="hk-hari">±<span class="angka">{c.hari[0]}–{c.hari[1]}</span> hari kerja, terpasang</span>
            </span>
          ))}
        </span>
        <span class="hk-aksi">Hitung atap Anda <span aria-hidden="true">→</span></span>
      </a>
      <p class="ilustrasi">Ilustrasi, bukan proyek Atapura</p>
    </section>

    <section class="bukti" aria-label="Fakta Atapura">
      <div class="wrap">
        <!-- HP: 2×2 angka. Desktop ≥64rem: bento, tiap kotak membawa gambaran kecil (.bv) dari isinya. -->
        <ul class="bukti-daftar">
          <li class="bk-merek">
            <b>{bisnis.merek.length} merek</b><span class="bk-hp">{bisnis.merek.join(', ')}</span><span class="bk-desktop">yang kami pasang, saran tanpa memihak</span>
            <span class="bv bv-merek" aria-hidden="true">{bisnis.merek.map((m) => <em>{m}</em>)}</span>
          </li>
          <li class="bk-kota">
            <b>{bisnis.area.length} kota</b><span>dan kabupaten Jabodetabek</span>
            <span class="bv bv-kota" aria-hidden="true">{bisnis.area.map((a) => <em>{a}</em>)}</span>
          </li>
          <li class="bk-survey">
            <b>Gratis</b><span>survey &amp; ukur di lokasi</span>
            <span class="bv bv-meteran" aria-hidden="true"><i></i></span>
          </li>
          <li class="bk-garansi">
            <b>{bisnis.garansiPemasanganTahun} tahun</b><span>garansi pemasangan tertulis<span class="bk-tambah">, terpisah dari garansi pabrik</span></span>
            <span class="bv bv-tahun" aria-hidden="true">
              {Array.from({ length: bisnis.garansiPemasanganTahun ?? 0 }, (_, i) => <i><em>Th {i + 1}</em></i>)}
              <small>Dihitung sejak serah terima</small>
            </span>
          </li>
        </ul>
      </div>
    </section>

    <LogoKlien />

    <section id="hitung" class="sek gelap c-pinus" aria-labelledby="hitung-judul">
      <div class="wrap hc-wrap">
        <div class="hc-teks">
          <h2 id="hitung-judul" class="judul-besar">Berapa biaya atap Anda? <span class="miring">Lima merek, satu isian.</span></h2>
          <p class="lead">Isi luas atap Anda. Totalnya sudah termasuk genteng, alas, lapis kedap, flashing, dan jasa pasang. Harga per {tanggalPanjang(harga.berlakuSejak)}.</p>
        </div>
        <HitungCepat client:idle />
      </div>
    </section>

    <section id="lapisan" class="sek terang c-embun anatomi" aria-labelledby="judul-bocor">
      <div class="wrap">
        <div class="anatomi-kepala">
          <h2 id="judul-bocor" class="judul-besar">Atap bocor lagi <span class="miring">setelah diperbaiki?</span></h2>
          <div class="anatomi-isi">
            <p class="lead">
              Air yang menetes ke plafon sering masuk lewat lapisan di bawah genteng: alas yang tidak rata,
              underlayment yang terpotong, atau flashing yang terlewat di tepi dinding.
            </p>
            <p class="teks-ungkap" data-ungkap>
              Karena itu kami memasang atap bitumen sebagai satu sistem lima lapis, dan memotret setiap lapis
              sebelum tertutup lapis berikutnya. Foto itu Anda terima, jadi bagian yang nanti tidak terlihat tetap bisa dicek.
            </p>
            <a class="tautan-lanjut" href="/cara-kerja#lapisan">Standar Pasang AKAL selengkapnya</a>
          </div>
        </div>
        <div class="lembar">
          <span class="lembar-sudut" aria-hidden="true"></span>
          <Lapisan ringkas />
          <div class="lembar-blok">
            <h3 class="lembar-judul">Lima lapis di atas kepala Anda</h3>
            <dl class="lembar-data">
              <div><dt>Gambar</dt><dd>Penampang atap bitumen, terurai</dd></div>
              <div><dt>Urutan pasang</dt><dd class="angka">1 sampai 5, dari bawah</dd></div>
              <div><dt>Acuan</dt><dd>Standar Pasang AKAL</dd></div>
              <div><dt>Skala</dt><dd>Tidak berskala</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section id="akal" class="sek gelap c-pinus" aria-labelledby="judul-akal">
      <div class="wrap">
        <div class="kepala">
          <h2 id="judul-akal" class="judul-besar">Pasang atap tanpa <span class="tanpa-putus">was-was.</span> <span class="miring">Itu yang masuk AKAL.</span></h2>
          <p class="lead">Empat hal yang paling sering membuat pemilik rumah ragu mengganti atap, dan apa yang Anda pegang untuk masing-masing. Tiap janji menaut ke buktinya.</p>
        </div>
        <AkalCerita />
      </div>
    </section>

    <section id="layanan" class="sek c-embun" aria-labelledby="judul-layanan">
      <div class="wrap">
        <div class="kepala">
          <h2 id="judul-layanan" class="judul-besar">Apa pun atap Anda, <span class="miring">ada jalan keluarnya.</span></h2>
          <p class="lead">Membangun rumah baru, mengganti genteng yang berat, menghentikan bocor, atau menyiapkan kafe yang tidak boleh lama tutup. Pilih yang paling dekat dengan kebutuhan Anda.</p>
        </div>
        <div class="bento">
          <a class="kartu foto k-tukang" href="/panduan/rangka-atap-bitumen-baja-ringan-atau-kayu">
            <Foto desktop={tukang} alt="Ilustrasi tukang atap memaku genteng aspal" sizes="(min-width: 64rem) 40vw, 100vw" />
            <div class="kartu-isi"><h3 class="kartu-judul">Pasang atap baru</h3><p>Rangka baja ringan atau kayu, dari alas sampai nok.</p></div>
          </a>
          <a class="kartu foto k-villa" href="/produk">
            <Foto desktop={villa} hp={villaHp} alt="Ilustrasi villa beratap genteng aspal di dataran tinggi" sizes="(min-width: 64rem) 56vw, 100vw" />
            <div class="kartu-isi"><h3 class="kartu-judul">Villa di dataran tinggi</h3><p>Atap curam, hujan deras, kabut. Warna dicocokkan di lokasi.</p></div>
          </a>
          <article class="kartu k-ganti">
            <p class="kartu-label">Ganti atap lama</p>
            <p class="kartu-angka angka">8,5–13 kg</p>
            <p>per m² untuk genteng bitumen, dibanding 40–60 kg/m² genteng beton atau keramik. Beban rangka jauh lebih ringan.</p>
            <a class="kartu-tautan tautan-lanjut" href="/hitung">Hitung ganti atap</a>
          </article>
          <article class="kartu k-bocor">
            <p class="kartu-label">Perbaikan atap bocor</p>
            <h3 class="kartu-judul">Kami cari sumbernya dulu, bukan menambal.</h3>
            <a class="kartu-tautan" href={waLink('Halo Atapura, atap saya bocor. Saya mau jadwalkan cek.')} target="_blank" rel="noopener" data-wa="bocor">Jadwalkan cek</a>
          </article>
          <a class="kartu foto k-kafe" href="/panduan/atap-ruko-kafe-kos">
            <Foto desktop={kafe} hp={kafeHp} alt="Ilustrasi kafe beratap genteng aspal saat golden hour" sizes="(min-width: 64rem) 56vw, 100vw" />
            <div class="kartu-isi"><h3 class="kartu-judul">Kafe &amp; usaha</h3><p>Jadwal kerja tertulis, supaya usaha Anda tidak tutup lebih lama dari perlu.</p></div>
          </a>
          <article id="layanan-proyek" class="kartu gelap k-proyek">
            <p class="kartu-label">Untuk perusahaan</p>
            <h3 class="kartu-judul">Proyek perumahan &amp; komersial</h3>
            <p>Penawaran per item, spesifikasi pabrik, invoice, dan termin untuk diajukan ke atasan atau klien.</p>
            <a class="pill pill-tunas" href={waLink('Halo Atapura, saya dari perusahaan dan butuh penawaran resmi untuk proyek atap.')} target="_blank" rel="noopener" data-wa="proyek">Minta penawaran resmi</a>
            <a class="tautan-lanjut k-proyek-lanjut" href="/perusahaan">Selengkapnya untuk perusahaan</a>
          </article>
        </div>
      </div>
    </section>

    <section id="cara-kerja" class="sek gelap c-pinus" aria-labelledby="judul-cara">
      <div class="wrap">
        <div class="kepala">
          <h2 id="judul-cara" class="judul-besar">Uang Anda baru berpindah <span class="miring">di tahap tiga.</span></h2>
          <p class="lead">Sebelum membayar apa pun, Anda sudah memegang hasil survey dan rincian biaya tertulis. Setelah lunas, garansi pemasangan {bisnis.garansiPemasanganTahun} tahun mulai berjalan.</p>
        </div>
        <ol class="tahap">
          {tahap.map((t, i) => (
            <li class:list={{ 'tahap-bayar': i === 2 }}>
              <span class="tahap-no angka" aria-hidden="true">{i + 1}</span>
              <b class="tahap-nama">{t.nama}</b>
              <span class="tahap-judul">{t.judul}</span>
            </li>
          ))}
        </ol>
        <div class="tahap-tautan">
          <a class="tautan-lanjut" href="/cara-kerja">Rincian enam tahap &amp; lima lapis</a>
          <a class="tautan-lanjut" href="/garansi">Cara bayar &amp; garansi {bisnis.garansiPemasanganTahun} tahun</a>
        </div>
      </div>
    </section>

    <section id="merek" class="sek terang c-embun" aria-labelledby="judul-merek">
      <div class="wrap denah">
        <div class="merek-kepala">
          <h2 id="judul-merek" class="judul-besar">Bingung pilih merek? <span class="miring">Mulai dari kebutuhan Anda.</span></h2>
          <p class="lead">Semua merek yang kami pasang sama-sama atap bitumen yang baik. Bedanya ada di harga, asal produksi, dan lama garansi pabrik.</p>
        </div>
        <PilihMerek />
        <details class="spek">
          <summary><span>Bandingkan spesifikasi lengkap {merekTabel.length} merek</span><span class="spek-tanda" aria-hidden="true"></span></summary>
        <div class="datasheet" role="region" aria-label="Perbandingan merek" tabindex="0">
          <table class="ds">
            <caption class="sr-only">Perbandingan merek atap bitumen yang dipasang Atapura</caption>
            <thead>
              <tr>
                <td></td>
                {merekTabel.map((m, i) => (
                  <th scope="col"><span class="ds-no">{String(i + 1).padStart(2, '0')}</span><span class="ds-merek">{m.nama}</span></th>
                ))}
              </tr>
            </thead>
            <tbody>
              <tr class="ds-harga" data-nosnippet>
                <th scope="row">Terpasang per m²<span class="ds-ket">Jabodetabek, spek standar</span></th>
                {merekTabel.map((m) => { if (!m.r) return <td class="ds-tunggu">Tanya admin</td>; const b = bagianRentang(m.r[0], m.r[1]); return <td><span class="harga-rp">Rp</span>{b.min}<span class="ds-sd">–</span>{b.max}<span class="harga-sat">{b.satuan} / m²</span></td>; })}
              </tr>
              <tr data-nosnippet>
                <th scope="row">Genteng saja per m²</th>
                {merekTabel.map((m) => (m.g ? <td class="angka">Rp{(m.g / 1000).toLocaleString('id-ID')} rb</td> : <td class="ds-tunggu">Tanya admin</td>))}
              </tr>
              <tr>
                <th scope="row">Kelas harga</th>
                {merekTabel.map((m) => <td>{m.kelas}</td>)}
              </tr>
              <tr>
                <th scope="row">Yang sudah pasti</th>
