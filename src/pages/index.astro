---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lapisan from '../components/Lapisan.astro';
import CaraKerja from '../components/CaraKerja.astro';
import KlaimGaransi from '../components/KlaimGaransi.astro';
import PetaArea from '../components/PetaArea.astro';
import RaporContoh from '../components/RaporContoh.astro';
import Warna from '../components/Warna.astro';
import PilihMerek from '../components/PilihMerek.astro';
import AkalCerita from '../components/AkalCerita.astro';
import { getCollection } from 'astro:content';
import HitungAkal from '../islands/HitungAkal';
import Foto from '../components/Foto.astro';
import { Image } from 'astro:assets';
import Bumper from '../components/Bumper.astro';
import heroDesktop from '../../assets/gambar/magnific/hero-desktop.jpg';
import heroHp from '../../assets/gambar/magnific/hero-hp.jpg';
import hujanDesktop from '../../assets/gambar/magnific/hujan-desktop.jpg';
import hujanHp from '../../assets/gambar/magnific/hujan-hp.jpg';
import tukang from '../../assets/gambar/magnific/tukang-4x5.jpg';
import villa from '../../assets/gambar/magnific/segmen-villa-3x2.jpg';
import villaHp from '../../assets/gambar/magnific/segmen-villa-4x5.jpg';
import kafe from '../../assets/gambar/magnific/segmen-kafe-3x2.jpg';
import kafeHp from '../../assets/gambar/magnific/segmen-kafe-4x5.jpg';
import drone from '../../assets/gambar/magnific/cara-kerja-drone-16x9.jpg';
import cekAtap from '../../assets/gambar/magnific/garansi-cek-atap.jpg';
import terasHujan from '../../assets/gambar/magnific/faq-teras-hujan-16x9.jpg';
import '../styles/desktop.css';
import { bisnis, waLink } from '../data/bisnis';
import { bagianRentang, harga, tanggalPanjang } from '../data/harga';

const panduanTerbaru = (await getCollection('panduan')).sort((a, b) => b.data.diperbarui.getTime() - a.data.diperbarui.getTime()).slice(0, 3);

const tanya = [
  {
    q: 'Apakah Atapura melayani di luar Jabodetabek?',
    a: `Ya. Basis kami di Jabodetabek, tempat survey gratis. Untuk lokasi di luar Jabodetabek, harga dihitung langsung bersama admin lewat WhatsApp karena ada akomodasi tukang dan pengiriman material (misalnya tiket pesawat atau ekspedisi antarpulau). Tiket dan ekspedisi bisa kami carikan atau Anda atur sendiri; kami tidak mengambil untung dari akomodasi. Tim pemasang kami berpengalaman mengerjakan atap hingga ${bisnis.survey.pengalamanLuar.join(', ')}.`,
  },
  {
    q: 'Apa bedanya atap bitumen, genteng aspal, sirap aspal, dan shingle?',
    a: 'Keempatnya sebutan untuk produk yang sama: lembaran fiberglass berlapis aspal dengan butiran batu di permukaannya. Shingle adalah istilah Inggrisnya, sirap aspal sebutan lama, dan di toko bangunan lebih sering disebut genteng aspal. Atapura memasang tiga merek: Maxxi, CTI, dan Javabitumen.',
  },
  {
    q: 'Berapa biaya pasang atap bitumen per meter persegi?',
    a: `Di Jabodetabek, estimasi terpasang per m² (genteng, alas, underlayment, aksesoris, dan jasa pasang): CTI Rp${harga.merek.CTI.terpasang.map((n) => n / 1000).join('–')} ribu, Maxxi dan Javabitumen Rp${harga.merek.Maxxi.terpasang.map((n) => n / 1000).join('–')} ribu. Harga genteng saja: CTI Rp${harga.merek.CTI.genteng / 1000} ribu, Maxxi dan Javabitumen Rp${harga.merek.Maxxi.genteng / 1000} ribu per m². Rangka baja ringan baru, bila perlu, Rp${harga.rangka.harga / 1000} ribu per m² terpasang (material dan jasa). Harga final kami tulis setelah survey gratis dan opname luas.`,
  },
  {
    q: 'Apakah atap bitumen cocok untuk rumah saya?',
    a: 'Atap bitumen cocok untuk atap miring dengan rangka kayu atau baja ringan, karena bobotnya jauh lebih ringan dari genteng beton atau keramik. Kemiringan minimal yang kami pasang 5 derajat. Kalau atap Anda lebih landai dari itu, kami sarankan material lain dan kami jelaskan alasannya saat survey.',
  },
  {
    q: 'Berapa lama pengerjaannya?',
    a: 'Atap 100–120 m² umumnya selesai sekitar 4 hari kerja, tergantung cuaca dan bentuk atap. Hitung AKAL menampilkan perkiraan untuk luas Anda. Jadwal pasti kami kirim tertulis setelah survey.',
  },
  {
    q: 'Garansinya seperti apa?',
    a: `Ada dua garansi terpisah. Garansi pabrik menanggung material genteng sesuai dokumen resmi tiap merek. Garansi pemasangan dari Atapura berlaku ${bisnis.garansiPemasanganTahun} tahun sejak serah terima dan menanggung kebocoran dan kesalahan pasang, termasuk material dan jasa perbaikannya. Klaim cukup lewat WhatsApp dengan foto; tim memeriksa paling lambat 3 hari kerja.`,
  },
  {
    q: 'Bagaimana cara bayarnya?',
    a: `Survey (gratis di Jabodetabek), lalu penawaran tertulis dan kontrak. Material dibayar lunas sebelum dikirim ke lokasi. Jasa pasang dibayar bertahap ${bisnis.pembayaran.jasa.map((t) => `${t.persen}%`).join(', ')}: ${bisnis.pembayaran.jasa.map((t) => t.saat.toLowerCase()).join('; ')}. Semua pembayaran hanya ke rekening atas nama perusahaan, tidak pernah ke rekening pribadi.`,
  },
];

// Kota yang sudah punya halaman /area/* jadi tautan (SEO internal); yang belum tetap teks biasa.
const halamanArea = new Map((await getCollection('area')).flatMap((a) => a.data.cakupan.map((c) => [c.nama, `/area/${a.id}`] as const)));
const wilayah = [
  { nama: 'DKI Jakarta', kota: bisnis.area.filter((a) => a.startsWith('Jakarta')) },
  { nama: 'Jawa Barat', kota: bisnis.area.filter((a) => /Bogor|Depok|Bekasi/.test(a)) },
  { nama: 'Banten', kota: bisnis.area.filter((a) => /Tangerang/.test(a)) },
];

const merekTabel = [
  { nama: 'Maxxi', kelas: harga.merek.Maxxi.kelas, pasti: 'Model 3-tab, 1000 × 333 mm, tebal 2,66 mm, 3,10 m² per bundel', r: harga.merek.Maxxi.terpasang, g: harga.merek.Maxxi.genteng, garansi: harga.merek.Maxxi.garansiPabrik },
  { nama: 'CTI', kelas: harga.merek.CTI.kelas, pasti: 'Produksi Indonesia, bersertifikat TKDN; seri CT3 (1000 × 333 mm), CT5, dan CT6 (1000 × 317,5 mm), 3,00 m² per bundel', r: harga.merek.CTI.terpasang, g: harga.merek.CTI.genteng, garansi: harga.merek.CTI.garansiPabrik },
  { nama: 'Javabitumen', kelas: harga.merek.Javabitumen.kelas, pasti: 'Spesifikasi menunggu brosur resmi dari produsen', r: harga.merek.Javabitumen.terpasang, g: harga.merek.Javabitumen.genteng, garansi: harga.merek.Javabitumen.garansiPabrik },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tanya.map((t) => ({ '@type': 'Question', name: t.q, acceptedAnswer: { '@type': 'Answer', text: t.a } })),
};
---

<Base
  title="Atap Bitumen Jabodetabek: Hitung Biaya Pasang | Atapura"
  description="Pasang atap bitumen Maxxi, CTI, dan Javabitumen di Jabodetabek. Hitung estimasi biaya total dalam satu menit, lihat cara pasang per lapis, survey gratis."
  schema={[faqSchema]}
>
  <Bumper />
  <Header />
  <main>
    <section class="hero" aria-labelledby="judul">
      <Foto desktop={heroDesktop} hp={heroHp} alt="Ilustrasi rumah dua lantai beratap genteng aspal di sore hari" class="hero-foto" eager />
      <div class="hero-cahaya" aria-hidden="true"></div>
      <div class="wrap hero-isi">
        <h1 id="judul" class="hero-judul">
          <span class="baris"><span>Atap yang masuk</span></span>
          <span class="baris miring-hero"><span>AKAL.</span></span>
          <span class="hero-h1-sub">Jasa pasang atap bitumen (genteng aspal) di Jabodetabek.</span>
        </h1>
        <p class="hero-sub">Maxxi, CTI, dan Javabitumen. Harga terbuka sebelum Anda bicara dengan siapa pun.</p>
        <div class="hero-aksi">
          <a href="#hitung" class="pill hero-utama">Hitung estimasi biaya</a>
          <a href="#layanan-proyek" class="pill pill-garis hero-kedua">Untuk perusahaan &amp; proyek</a>
        </div>
      </div>
      <p class="ilustrasi">Ilustrasi, bukan proyek Atapura</p>
    </section>

    <section class="bukti" aria-label="Fakta Atapura">
      <div class="wrap">
        <ul class="bukti-daftar">
          <li><b>Kontrak</b><span>tertulis sebelum pembayaran</span></li>
          <li><b>{bisnis.merek.length} merek</b><span>{bisnis.merek.join(', ')}</span></li>
          <li><b>{bisnis.area.length} kota</b><span>dan kabupaten Jabodetabek</span></li>
          <li><b>Gratis</b><span>survey &amp; ukur di lokasi</span></li>
          <li><b>{bisnis.garansiPemasanganTahun} tahun</b><span>garansi pemasangan tertulis</span></li>
          <li><b>Rekening resmi</b><span>atas nama perusahaan, bukan pribadi</span></li>
        </ul>
      </div>
    </section>

    <section id="layanan" class="sek c-embun" aria-labelledby="judul-layanan">
      <div class="wrap">
        <div class="kepala">
          <h2 id="judul-layanan" class="judul-besar">Apa pun atap Anda, <span class="miring">ada jalan keluarnya.</span></h2>
          <p class="lead">Membangun rumah baru, mengganti genteng yang berat, menghentikan bocor, atau menyiapkan kafe yang tidak boleh lama tutup. Pilih yang paling dekat dengan kebutuhan Anda.</p>
        </div>
        <div class="bento">
          <article class="kartu foto k-tukang">
            <Foto desktop={tukang} alt="Ilustrasi tukang atap memaku genteng aspal" sizes="(min-width: 64rem) 40vw, 100vw" />
            <div class="kartu-isi"><h3 class="kartu-judul">Pasang atap baru</h3><p>Rangka baja ringan atau kayu, dari alas sampai nok.</p></div>
          </article>
          <article class="kartu foto k-villa">
            <Foto desktop={villa} hp={villaHp} alt="Ilustrasi villa beratap genteng aspal di dataran tinggi" sizes="(min-width: 64rem) 56vw, 100vw" />
            <div class="kartu-isi"><h3 class="kartu-judul">Villa di dataran tinggi</h3><p>Atap curam, hujan deras, kabut. Warna dicocokkan di lokasi.</p></div>
          </article>
          <article class="kartu k-ganti">
            <p class="kartu-label">Ganti atap lama</p>
            <p class="kartu-angka angka">8,5–13 kg</p>
            <p>per m² untuk genteng bitumen, dibanding 40–60 kg/m² genteng beton atau keramik. Beban rangka jauh lebih ringan.</p>
            <a class="kartu-tautan" href="#hitung">Hitung ganti atap</a>
          </article>
          <article class="kartu k-bocor">
            <p class="kartu-label">Perbaikan atap bocor</p>
            <h3 class="kartu-judul">Kami cari sumbernya dulu, bukan menambal.</h3>
            <a class="kartu-tautan" href={waLink('Halo Atapura, atap saya bocor. Saya mau jadwalkan cek.')} target="_blank" rel="noopener" data-wa="bocor">Jadwalkan cek</a>
          </article>
          <article class="kartu foto k-kafe">
            <Foto desktop={kafe} hp={kafeHp} alt="Ilustrasi kafe beratap genteng aspal saat golden hour" sizes="(min-width: 64rem) 56vw, 100vw" />
            <div class="kartu-isi"><h3 class="kartu-judul">Kafe &amp; usaha</h3><p>Jadwal kerja tertulis, supaya usaha Anda tidak tutup lebih lama dari perlu.</p></div>
          </article>
          <article id="layanan-proyek" class="kartu gelap k-proyek">
            <p class="kartu-label">Untuk perusahaan</p>
            <h3 class="kartu-judul">Proyek perumahan &amp; komersial</h3>
            <p>TDS, TKDN, faktur, termin, dan penawaran resmi berkop untuk diajukan ke atasan atau klien.</p>
            <a class="pill pill-tunas" href={waLink('Halo Atapura, saya dari perusahaan dan butuh penawaran resmi untuk proyek atap.')} target="_blank" rel="noopener" data-wa="proyek">Minta penawaran resmi</a>
          </article>
        </div>
      </div>
    </section>

    <section id="akal" class="sek gelap c-pinus" aria-labelledby="judul-akal">
      <div class="wrap">
        <div class="kepala">
          <h2 id="judul-akal" class="judul-besar">Pasang atap tanpa was-was. <span class="miring">Itu yang masuk AKAL.</span></h2>
          <p class="lead">Empat hal yang paling sering membuat pemilik rumah ragu mengganti atap, dan apa yang Anda pegang untuk masing-masing. Semuanya bisa Anda cek di halaman ini.</p>
        </div>
        <AkalCerita />
      </div>
    </section>

    <section id="hitung" class="sek c-putih" aria-labelledby="hitung-judul">
      <div class="wrap">
        <div class="kepala">
          <h2 id="hitung-judul" class="judul-besar">Hitung dulu, <span class="miring">baru bicara.</span></h2>
          <p class="lead">Cukup luas atap dan merek. Hasilnya bisa Anda kirim ke WhatsApp atau simpan untuk dibahas di rumah.</p>
        </div>
        <HitungAkal client:idle awal={120} />
        <p class="hitung-catatan" data-nosnippet>
          {harga.contoh ? 'Harga acuan pasar Jabodetabek, dihitung dari harga distributor dan jasa pasang. Harga final kami tulis setelah survey gratis. ' : 'Estimasi untuk lokasi di Jabodetabek. Harga final kami tulis setelah survey gratis dan opname luas. '}Harga per {tanggalPanjang(harga.berlakuSejak)}.
        </p>
      </div>
    </section>

    <section class="hujan" aria-labelledby="judul-hujan">
      <Foto desktop={hujanDesktop} hp={hujanHp} alt="Ilustrasi hujan deras di atap genteng aspal saat senja" class="hujan-foto" />
      <div class="wrap hujan-isi">
        <h2 id="judul-hujan" class="judul-besar">Hujan deras seharusnya cuma jadi <span class="miring">suara.</span></h2>
        <ul class="hujan-fakta">
          <li><b>Underlayment</b>menahan air yang lolos dari genteng sebelum sampai ke plafon.</li>
          <li><b>Flashing</b>menutup titik rawan: dinding, talang, dan tepi atap.</li>
          <li><b>Difoto tiap lapis</b>sebelum tertutup, jadi bagian yang tak terlihat tetap bisa dicek.</li>
        </ul>
      </div>
    </section>

    <section id="lapisan" class="sek terang c-embun anatomi" aria-labelledby="judul-bocor">
      <div class="wrap">
        <div class="anatomi-kepala">
          <h2 id="judul-bocor" class="judul-besar">Atap bocor lagi <span class="miring">setelah diperbaiki?</span></h2>
          <div class="anatomi-isi">
            <p class="lead">
              Air yang menetes ke plafon sering masuk lewat lapisan di bawah genteng: alas yang tidak rata,
              underlayment yang terpotong, atau flashing yang terlewat di tepi dinding.
            </p>
            <p>
              Karena itu kami memasang atap bitumen sebagai satu sistem lima lapis, dan memotret setiap lapis
              sebelum tertutup lapis berikutnya. Foto itu Anda terima, jadi bagian yang nanti tidak terlihat tetap bisa dicek.
            </p>
          </div>
        </div>
        <div class="lembar">
          <span class="lembar-sudut" aria-hidden="true"></span>
          <Lapisan />
          <div class="lembar-blok">
            <h3 class="lembar-judul">Lima lapis di atas kepala Anda</h3>
            <dl class="lembar-data">
              <div><dt>Gambar</dt><dd>Penampang atap bitumen, terurai</dd></div>
              <div><dt>Urutan pasang</dt><dd class="angka">1 sampai 5, dari bawah</dd></div>
              <div><dt>Acuan</dt><dd>Standar Pasang AKAL</dd></div>
              <div><dt>Skala</dt><dd>Tidak berskala</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section id="cara-kerja" class="sek gelap latar-foto" aria-labelledby="judul-cara">
      <Foto desktop={drone} alt="" class="latar-img" sizes="100vw" />
      <div class="wrap">
        <div class="cara-kepala">
          <h2 id="judul-cara" class="judul-besar">Uang Anda baru berpindah <span class="miring">di tahap empat.</span></h2>
          <p class="lead">Tujuh tahap, semuanya tertulis. Sebelum membayar apa pun, Anda sudah memegang hasil survey, penawaran berkop, dan kontrak.</p>
        </div>
        <CaraKerja />
      </div>
    </section>

    <section id="garansi" class="sek gelap kabut" style="--kabut: url(/kabut/villa.webp)" aria-labelledby="judul-garansi">
      <div class="wrap">
        <div class="kepala">
          <h2 id="judul-garansi" class="judul-besar">Bayar bertahap, <span class="miring">garansi {bisnis.garansiPemasanganTahun} tahun.</span></h2>
          <p class="lead">Jasa pasang dibayar mengikuti kemajuan pekerjaan. Hasil pemasangan kami jamin tertulis, terpisah dari garansi pabrik.</p>
        </div>
        <div class="gb">
          <div class="gb-termin">
            <h3 class="gb-judul">Cara pembayaran</h3>
            <div class="bayar-material">
              <p class="bayar-label">Material</p>
              <p class="bayar-isi"><b>Lunas sebelum dikirim.</b> Material dipesan khusus untuk atap Anda, jadi dibayar penuh sebelum diantar ke lokasi.</p>
            </div>
            <p class="bayar-label bayar-label-jasa">Jasa pasang, bertahap</p>
            <ol class="termin">
              {bisnis.pembayaran.jasa.map((t) => (
                <li>
                  <span class="termin-persen">{t.persen}<span>%</span></span>
                  <span class="termin-teks"><b>{t.tahap}</b>{t.saat}</span>
                </li>
              ))}
            </ol>
            <p class="gb-catatan">Semua pembayaran ke rekening atas nama perusahaan, disertai kuitansi. Setiap termin jasa disertai foto progres.</p>
          </div>
          <div class="gb-garansi">
            <p class="garansi-angka">{bisnis.garansiPemasanganTahun}<span>tahun</span></p>
            <p class="garansi-sub">Garansi pemasangan, berlaku sejak berita acara serah terima.</p>
            <div class="garansi-dua">
              <div>
                <h3 class="gb-label">Yang ditanggung</h3>
                <ul class="garansi-daftar">{bisnis.garansi.cakupan.map((c) => <li>{c}</li>)}</ul>
              </div>
              <div>
                <h3 class="gb-label">Yang tidak ditanggung</h3>
                <ul class="garansi-daftar garansi-tidak">{bisnis.garansi.pengecualian.map((c) => <li>{c}</li>)}</ul>
              </div>
            </div>
          </div>
        </div>
        <KlaimGaransi />
        <aside class="cek-atap">
          <div class="cek-foto"><Foto desktop={cekAtap} alt="Ilustrasi teknisi memeriksa talang dan flashing setelah hujan" sizes="(min-width: 64rem) 30vw, 100vw" /></div>
          <div class="cek-teks">
            <h3 class="cek-judul">Cek Atap Gratis</h3>
            <p>Setelah musim hujan pertama, tim kami datang memeriksa flashing, talang, dan nok tanpa biaya. Atap yang baik dirawat sebelum bermasalah.</p>
            <a class="pill pill-gelap" href={waLink('Halo Atapura, saya mau tanya soal garansi dan Cek Atap Gratis.')} target="_blank" rel="noopener" data-wa="garansi">Tanya soal garansi</a>
          </div>
        </aside>
      </div>
    </section>

    <section id="merek" class="sek terang c-putih" aria-labelledby="judul-merek">
      <div class="wrap">
        <div class="merek-kepala">
          <h2 id="judul-merek" class="judul-besar">Bingung pilih merek? <span class="miring">Mulai dari kebutuhan Anda.</span></h2>
          <p class="lead">Ketiga merek yang kami pasang sama-sama atap bitumen yang baik. Bedanya ada di harga, asal produksi, dan lama garansi pabrik.</p>
        </div>
        <PilihMerek />
        <details class="spek">
          <summary><span>Bandingkan spesifikasi lengkap ketiga merek</span><span class="spek-tanda" aria-hidden="true"></span></summary>
        <div class="datasheet" role="region" aria-label="Perbandingan merek" tabindex="0">
          <table class="ds">
            <caption class="sr-only">Perbandingan tiga merek atap bitumen yang dipasang Atapura</caption>
            <thead>
              <tr>
                <td></td>
                {merekTabel.map((m, i) => (
                  <th scope="col"><span class="ds-no">{String(i + 1).padStart(2, '0')}</span><span class="ds-merek">{m.nama}</span></th>
                ))}
              </tr>
            </thead>
            <tbody>
              <tr class="ds-harga" data-nosnippet>
                <th scope="row">Terpasang per m²<span class="ds-ket">Jabodetabek, spek standar</span></th>
                {merekTabel.map((m) => { const b = bagianRentang(m.r[0], m.r[1]); return <td><span class="harga-rp">Rp</span>{b.min}<span class="ds-sd">–</span>{b.max}<span class="harga-sat">{b.satuan} / m²</span></td>; })}
              </tr>
              <tr data-nosnippet>
                <th scope="row">Genteng saja per m²</th>
                {merekTabel.map((m) => <td class="angka">Rp{(m.g / 1000).toLocaleString('id-ID')} rb</td>)}
              </tr>
              <tr>
                <th scope="row">Kelas harga</th>
                {merekTabel.map((m) => <td>{m.kelas}</td>)}
              </tr>
              <tr>
                <th scope="row">Yang sudah pasti</th>
                {merekTabel.map((m) => <td class="ds-pasti">{m.pasti}</td>)}
              </tr>
              <tr>
                <th scope="row">Garansi pabrik</th>
                {merekTabel.map((m) => <td class="ds-tunggu">{m.garansi}</td>)}
              </tr>
            </tbody>
          </table>
        </div>
        <ol class="merek-hp" aria-label="Perbandingan merek">
          {merekTabel.map((m, i) => (
            <li>
