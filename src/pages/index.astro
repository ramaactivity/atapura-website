---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lapisan from '../components/Lapisan.astro';
import CaraKerja from '../components/CaraKerja.astro';
import PetaArea from '../components/PetaArea.astro';
import RaporContoh from '../components/RaporContoh.astro';
import HitungAkal from '../islands/HitungAkal';
import Foto from '../components/Foto.astro';
import heroDesktop from '../../assets/gambar/magnific/hero-desktop.jpg';
import heroHp from '../../assets/gambar/magnific/hero-hp.jpg';
import hujanDesktop from '../../assets/gambar/magnific/hujan-desktop.jpg';
import hujanHp from '../../assets/gambar/magnific/hujan-hp.jpg';
import tukang from '../../assets/gambar/magnific/tukang-4x5.jpg';
import villa from '../../assets/gambar/magnific/segmen-villa-3x2.jpg';
import villaHp from '../../assets/gambar/magnific/segmen-villa-4x5.jpg';
import kafe from '../../assets/gambar/magnific/segmen-kafe-3x2.jpg';
import kafeHp from '../../assets/gambar/magnific/segmen-kafe-4x5.jpg';
import '../styles/desktop.css';
import { bisnis, waLink } from '../data/bisnis';
import { harga, rupiahRingkas, tanggalPanjang } from '../data/harga';

const tanya = [
  {
    q: 'Berapa biaya pasang atap bitumen per meter persegi?',
    a: 'Biaya ditentukan oleh merek genteng, jenis alas, dan kerumitan bentuk atap. Hitung AKAL di atas memberi rentang total untuk luas dan merek pilihan Anda, sudah termasuk alas, underlayment, aksesoris, dan jasa pasang. Harga final kami tulis setelah survey gratis.',
  },
  {
    q: 'Apakah atap bitumen cocok untuk rumah saya?',
    a: 'Atap bitumen cocok untuk atap miring dengan rangka kayu atau baja ringan, karena bobotnya jauh lebih ringan dari genteng beton atau keramik. Setiap merek punya kemiringan minimal dari pabrik. Kalau atap Anda lebih landai dari batas itu, kami sarankan material lain dan kami jelaskan alasannya saat survey.',
  },
  {
    q: 'Berapa lama pengerjaannya?',
    a: 'Tergantung luas dan bentuk atap. Hitung AKAL menampilkan perkiraan hari kerja. Jadwal pasti kami kirim tertulis setelah survey, sebelum Anda membayar uang muka.',
  },
  {
    q: 'Garansinya seperti apa?',
    a: 'Ada dua garansi terpisah. Garansi pabrik menanggung material genteng sesuai dokumen resmi tiap merek. Garansi pemasangan dari Atapura menanggung hasil kerja tim kami, diberikan tertulis bersama berita acara serah terima.',
  },
  {
    q: 'Bagaimana cara bayarnya?',
    a: 'Survey gratis, lalu penawaran tertulis. Setelah Anda setuju, kami buat kontrak, Anda membayar uang muka, dan pelunasan dilakukan setelah serah terima. Semua pembayaran hanya ke rekening atas nama perusahaan, tidak pernah ke rekening pribadi.',
  },
];

const wilayah = [
  { nama: 'DKI Jakarta', kota: bisnis.area.filter((a) => a.startsWith('Jakarta')) },
  { nama: 'Jawa Barat', kota: bisnis.area.filter((a) => /Bogor|Depok|Bekasi/.test(a)) },
  { nama: 'Banten', kota: bisnis.area.filter((a) => /Tangerang/.test(a)) },
];

const merekTabel = [
  { nama: 'Maxxi', kelas: harga.merek.Maxxi.kelas, pasti: 'Model 3-tab, 1000 × 333 mm, tebal 2,6 mm, 21 lembar per bundel', r: harga.merek.Maxxi.genteng },
  { nama: 'CTI', kelas: harga.merek.CTI.kelas, pasti: 'Diproduksi di Indonesia, bersertifikat TKDN; seri CT3, CT5, CT6', r: harga.merek.CTI.genteng },
  { nama: 'Javabitumen', kelas: harga.merek.Javabitumen.kelas, pasti: 'Spesifikasi menunggu brosur resmi dari produsen', r: harga.merek.Javabitumen.genteng },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tanya.map((t) => ({ '@type': 'Question', name: t.q, acceptedAnswer: { '@type': 'Answer', text: t.a } })),
};
---

<Base
  title="Atap Bitumen Jabodetabek: Hitung Biaya Pasang | Atapura"
  description="Pasang atap bitumen Maxxi, CTI, dan Javabitumen di Jabodetabek. Hitung estimasi biaya total dalam satu menit, lihat cara pasang per lapis, survey gratis."
  schema={[faqSchema]}
>
  <Header />
  <main>
    <section class="hero" aria-labelledby="judul">
      <Foto desktop={heroDesktop} hp={heroHp} alt="Ilustrasi rumah dua lantai beratap genteng aspal di sore hari" class="hero-foto" eager />
      <div class="hero-cahaya" aria-hidden="true"></div>
      <div class="wrap hero-isi">
        <h1 id="judul" class="hero-judul">
          <span class="baris"><span>Atap yang masuk</span></span>
          <span class="baris miring-hero"><span>AKAL.</span></span>
        </h1>
        <p class="hero-sub">
          Pasang atap bitumen Maxxi, CTI, dan Javabitumen di Jabodetabek. Harga terbuka sebelum Anda bicara dengan siapa pun.
        </p>
        <form class="hitung-bar" data-hero-hitung action="#hitung">
          <label class="hitung-bar-isi">
            <span>Luas atap (m²)</span>
            <input name="luas" inputmode="numeric" autocomplete="off" value="120" aria-label="Luas atap dalam meter persegi" />
          </label>
          <button type="submit" class="pill pill-gelap">Hitung estimasi</button>
        </form>
        <p class="hero-alt">Untuk proyek perumahan atau gedung? <a href="#layanan-proyek">Jalur perusahaan</a></p>
      </div>
      <p class="ilustrasi">Ilustrasi, bukan proyek Atapura</p>
    </section>

    <section class="bukti" aria-label="Fakta Atapura">
      <div class="wrap">
        <ul class="bukti-daftar">
          <li><b>PT Atapura</b><span>Karya Lestari, kontrak &amp; faktur resmi</span></li>
          <li><b>{bisnis.merek.length} merek</b><span>{bisnis.merek.join(', ')}</span></li>
          <li><b>{bisnis.area.length} kota</b><span>dan kabupaten Jabodetabek</span></li>
          <li><b>Gratis</b><span>survey &amp; ukur di lokasi</span></li>
          <li><b>Tertulis</b><span>garansi pemasangan</span></li>
          <li><b>Rekening PT</b><span>satu-satunya tujuan bayar</span></li>
        </ul>
      </div>
    </section>

    <section id="layanan" class="sek c-embun" aria-labelledby="judul-layanan">
      <div class="wrap">
        <div class="kepala">
          <h2 id="judul-layanan" class="judul-besar">Satu tim untuk <span class="miring">setiap jenis atap.</span></h2>
          <p class="lead">Dari rumah baru sampai kafe yang tidak boleh lama tutup. Semua dipasang dengan Standar Pasang AKAL yang sama.</p>
        </div>
        <div class="bento">
          <article class="kartu foto k-tukang">
            <Foto desktop={tukang} alt="Ilustrasi tukang atap memaku genteng aspal" sizes="(min-width: 64rem) 40vw, 100vw" />
            <div class="kartu-isi"><h3 class="kartu-judul">Pasang atap baru</h3><p>Rangka baja ringan atau kayu, dari alas sampai nok.</p></div>
          </article>
          <article class="kartu foto k-villa">
            <Foto desktop={villa} hp={villaHp} alt="Ilustrasi villa beratap genteng aspal di dataran tinggi" sizes="(min-width: 64rem) 56vw, 100vw" />
            <div class="kartu-isi"><h3 class="kartu-judul">Villa di dataran tinggi</h3><p>Atap curam, hujan deras, kabut. Warna dicocokkan di lokasi.</p></div>
          </article>
          <article class="kartu k-ganti">
            <p class="kartu-label">Ganti atap lama</p>
            <p class="kartu-angka angka">8,5–13 kg</p>
            <p>per m² untuk genteng bitumen, dibanding 40–60 kg/m² genteng beton atau keramik. Beban rangka jauh lebih ringan.</p>
            <a class="kartu-tautan" href="#hitung">Hitung ganti atap</a>
          </article>
          <article class="kartu k-bocor">
            <p class="kartu-label">Perbaikan atap bocor</p>
            <h3 class="kartu-judul">Kami cari sumbernya dulu, bukan menambal.</h3>
            <a class="kartu-tautan" href={waLink('Halo Atapura, atap saya bocor. Saya mau jadwalkan cek.')} target="_blank" rel="noopener" data-wa="bocor">Jadwalkan cek</a>
          </article>
          <article class="kartu foto k-kafe">
            <Foto desktop={kafe} hp={kafeHp} alt="Ilustrasi kafe beratap genteng aspal saat golden hour" sizes="(min-width: 64rem) 56vw, 100vw" />
            <div class="kartu-isi"><h3 class="kartu-judul">Kafe &amp; usaha</h3><p>Jadwal kerja tertulis, supaya usaha Anda tidak tutup lebih lama dari perlu.</p></div>
          </article>
          <article id="layanan-proyek" class="kartu gelap k-proyek">
            <p class="kartu-label">Untuk perusahaan</p>
            <h3 class="kartu-judul">Proyek perumahan &amp; komersial</h3>
            <p>TDS, TKDN, faktur, termin, dan penawaran resmi berkop untuk diajukan ke atasan atau klien.</p>
            <a class="pill pill-tunas" href={waLink('Halo Atapura, saya dari perusahaan dan butuh penawaran resmi untuk proyek atap.')} target="_blank" rel="noopener" data-wa="proyek">Minta penawaran resmi</a>
          </article>
        </div>
      </div>
    </section>

    <section id="hitung" class="sek c-putih" aria-labelledby="hitung-judul">
      <div class="wrap">
        <div class="kepala">
          <h2 id="hitung-judul" class="judul-besar">Hitung dulu, <span class="miring">baru bicara.</span></h2>
          <p class="lead">Empat pertanyaan, satu menit. Hasilnya bisa Anda kirim ke WhatsApp atau simpan untuk dibahas di rumah.</p>
        </div>
        <HitungAkal client:idle awal={120} />
        <p class="hitung-catatan">
          {harga.contoh ? 'Angka ini contoh untuk uji tampilan, bukan harga resmi. ' : ''}Harga per {tanggalPanjang(harga.berlakuSejak)}.
        </p>
      </div>
    </section>

    <section class="hujan" aria-labelledby="judul-hujan">
      <Foto desktop={hujanDesktop} hp={hujanHp} alt="Ilustrasi hujan deras di atap genteng aspal saat senja" class="hujan-foto" />
      <div class="wrap hujan-isi">
        <h2 id="judul-hujan" class="judul-besar">Hujan deras seharusnya cuma jadi <span class="miring">suara.</span></h2>
        <ul class="hujan-fakta">
          <li><b>Underlayment</b>menahan air yang lolos dari genteng sebelum sampai ke plafon.</li>
          <li><b>Flashing</b>menutup titik rawan: dinding, talang, dan tepi atap.</li>
          <li><b>Difoto tiap lapis</b>sebelum tertutup, jadi bagian yang tak terlihat tetap bisa dicek.</li>
        </ul>
      </div>
    </section>

    <section id="lapisan" class="sek terang c-embun anatomi" aria-labelledby="judul-bocor">
      <div class="wrap">
        <div class="anatomi-kepala">
          <h2 id="judul-bocor" class="judul-besar">Atap bocor lagi <span class="miring">setelah diperbaiki?</span></h2>
          <div class="anatomi-isi">
            <p class="lead">
              Air yang menetes ke plafon sering masuk lewat lapisan di bawah genteng: alas yang tidak rata,
              underlayment yang terpotong, atau flashing yang terlewat di tepi dinding.
            </p>
            <p>
              Karena itu kami memasang atap bitumen sebagai satu sistem lima lapis, dan memotret setiap lapis
              sebelum tertutup lapis berikutnya. Foto itu Anda terima, jadi bagian yang nanti tidak terlihat tetap bisa dicek.
            </p>
          </div>
        </div>
        <div class="lembar">
          <span class="lembar-sudut" aria-hidden="true"></span>
          <Lapisan />
          <div class="lembar-blok">
            <h3 class="lembar-judul">Lima lapis di atas kepala Anda</h3>
            <dl class="lembar-data">
              <div><dt>Gambar</dt><dd>Penampang atap bitumen, terurai</dd></div>
              <div><dt>Urutan pasang</dt><dd class="angka">1 sampai 5, dari bawah</dd></div>
              <div><dt>Acuan</dt><dd>Standar Pasang AKAL</dd></div>
              <div><dt>Skala</dt><dd>Tidak berskala</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section id="cara-kerja" class="sek gelap c-pinus" aria-labelledby="judul-cara">
      <div class="wrap">
        <div class="cara-kepala">
          <h2 id="judul-cara" class="judul-besar">Uang Anda baru berpindah <span class="miring">di tahap empat.</span></h2>
          <p class="lead">Tujuh tahap, semuanya tertulis. Sebelum uang muka, Anda sudah memegang hasil survey, penawaran berkop, dan kontrak.</p>
        </div>
        <CaraKerja />
      </div>
    </section>

    <section id="merek" class="sek terang c-putih" aria-labelledby="judul-merek">
      <div class="wrap">
        <div class="merek-kepala">
          <h2 id="judul-merek" class="judul-besar">Tiga merek, <span class="miring">satu standar pasang.</span></h2>
          <p class="lead">
            Kami memasang tiga merek, jadi kami bisa jujur soal mana yang cocok untuk atap Anda.
            Garansi pabrik kami tulis persis seperti dokumen resmi tiap merek.
          </p>
        </div>
        <div class="datasheet" role="region" aria-label="Perbandingan merek" tabindex="0">
          <table class="ds angka">
            <caption class="sr-only">Perbandingan tiga merek atap bitumen yang dipasang Atapura</caption>
            <thead>
              <tr>
                <td></td>
                {merekTabel.map((m, i) => (
                  <th scope="col"><span class="ds-no">{String(i + 1).padStart(2, '0')}</span><span class="ds-merek">{m.nama}</span></th>
                ))}
              </tr>
            </thead>
            <tbody>
              <tr class="ds-harga">
                <th scope="row">Genteng per m²{harga.contoh && <span class="contoh contoh-kecil">contoh</span>}</th>
                {merekTabel.map((m) => <td>{rupiahRingkas(m.r[0])}<span class="ds-sd">–</span>{rupiahRingkas(m.r[1]).replace('Rp', '')}</td>)}
              </tr>
              <tr>
                <th scope="row">Kelas harga</th>
                {merekTabel.map((m) => <td>{m.kelas}</td>)}
              </tr>
              <tr>
                <th scope="row">Yang sudah pasti</th>
                {merekTabel.map((m) => <td class="ds-pasti">{m.pasti}</td>)}
              </tr>
              <tr>
                <th scope="row">Garansi pabrik</th>
                {merekTabel.map(() => <td class="ds-tunggu">Ditulis sesuai dokumen resmi</td>)}
              </tr>
            </tbody>
          </table>
        </div>
        <ol class="merek-hp angka" aria-label="Perbandingan merek">
          {merekTabel.map((m, i) => (
            <li>
              <p class="ds-no">{String(i + 1).padStart(2, '0')}</p>
              <p class="ds-merek">{m.nama}</p>
              <p class="merek-hp-kelas">{m.kelas}</p>
              <p class="merek-hp-harga">{rupiahRingkas(m.r[0])}<span class="ds-sd">–</span>{rupiahRingkas(m.r[1]).replace('Rp', '')} <span class="merek-hp-satuan">/ m²</span>{harga.contoh && <span class="contoh contoh-kecil">contoh</span>}</p>
              <p class="merek-hp-pasti">{m.pasti}</p>
            </li>
          ))}
        </ol>
        <p class="tabel-catatan">Data spesifikasi dari brosur publik, diverifikasi ulang dengan dokumen resmi sebelum kontrak.</p>
        <div class="batas">
          <h3 class="batas-judul">Kapan kami menyarankan <span class="miring">pilihan lain</span></h3>
          <ol class="batas-daftar">
            <li>
              <strong>Atap terlalu landai.</strong> Setiap merek punya kemiringan minimal dari pabrik. Di bawah batas itu,
              air hujan mengalir terlalu pelan dan bisa merembes ke sambungan. Untuk dak atau atap nyaris datar, kami jelaskan alternatifnya saat survey.
            </li>
            <li>
              <strong>Lokasi di luar Jabodetabek.</strong> Tim kami belum melayani di luar {bisnis.area.length} kota dan kabupaten
              di peta bawah, karena kami ingin bisa kembali untuk Cek Atap Gratis.
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section id="area" class="sek terang c-embun" aria-labelledby="judul-area">
      <div class="wrap area">
        <div class="area-teks">
          <h2 id="judul-area" class="judul-besar">Survey gratis di <span class="miring">{bisnis.area.length} kota dan kabupaten.</span></h2>
          <p class="lead">Tim kami datang mengukur atap, memeriksa rangka, dan mencocokkan warna di bawah cahaya asli rumah Anda.</p>
          <div class="wilayah">
            {wilayah.map((w) => (
              <div>
                <h3 class="wilayah-nama">{w.nama}</h3>
                <ul class="wilayah-kota">{w.kota.map((k) => <li>{k}</li>)}</ul>
              </div>
            ))}
          </div>
        </div>
        <PetaArea />
      </div>
    </section>

    <section id="rapor" class="sek terang c-putih" aria-labelledby="judul-rapor">
      <div class="wrap rapor-blok">
        <div class="rapor-teks">
          <h2 id="judul-rapor" class="judul-besar">Bukti yang bisa Anda <span class="miring">simpan.</span></h2>
          <p class="lead">
            Setiap atap yang kami pasang mendapat Rapor Proyek: data pekerjaan dan foto tiap lapis, diperiksa kepala aplikator.
          </p>
          <p class="rapor-jujur">Rapor pertama terbit di sini setelah proyek pertama diserahterimakan. Di samping ini formatnya.</p>
        </div>
        <RaporContoh />
      </div>
    </section>

    <section id="tanya" class="sek terang c-embun" aria-labelledby="judul-tanya">
      <div class="wrap tanya">
        <h2 id="judul-tanya" class="judul-2">Yang biasanya ditanyakan sebelum survey</h2>
        <div class="tanya-daftar" data-tanya>
          {tanya.map((t, i) => (
            <details class="tanya-item" name="tanya" open={i === 0}>
              <summary><span class="tanya-q">{t.q}</span><span class="tanya-tanda" aria-hidden="true"></span></summary>
              <p class="tanya-a">{t.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="penutup" aria-labelledby="judul-penutup">
      <Foto desktop={kafe} hp={kafeHp} alt="" class="penutup-foto" />
      <div class="wrap penutup-isi">
        <h2 id="judul-penutup" class="penutup-judul">Hitung dulu, <span class="miring">baru pasang.</span></h2>
        <div class="penutup-aksi">
          <a href="#hitung" class="pill pill-tunas">Hitung estimasi biaya</a>
          <a href={waLink('Halo Atapura, saya mau jadwalkan survey atap.')} target="_blank" rel="noopener" class="pill pill-garis" data-wa="penutup">Jadwalkan survey lewat WhatsApp</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <a href={waLink('Halo Atapura, saya mau tanya soal atap bitumen.')} target="_blank" rel="noopener" class="wa-apung no-print" data-wa="apung" aria-label="Chat WhatsApp Atapura" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm4.5 12.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3a.4.4 0 0 0 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z" /></svg>
    <span>Chat</span>
  </a>
</Base>

<script>
  // Desktop: cahaya senja & foto mengikuti kursor dengan pegas (lerp), berhenti sendiri saat diam.
  const desktop = matchMedia('(min-width: 64rem) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  const hero = document.querySelector<HTMLElement>('.hero');
  const foto = hero?.querySelector<HTMLElement>('.hero-foto');
  const cahaya = hero?.querySelector<HTMLElement>('.hero-cahaya');
  if (desktop.matches && hero && foto && cahaya) {
    let tx = 0.75, ty = 0.15, x = tx, y = ty, id = 0;
    const jalan = () => {
      x += (tx - x) * 0.07;
      y += (ty - y) * 0.07;
      const r = hero.getBoundingClientRect();
      const d = cahaya.offsetWidth / 2;
      foto.style.transform = `scale(1.06) translate(${((0.5 - x) * 16).toFixed(2)}px, ${((0.5 - y) * 10).toFixed(2)}px)`;
      cahaya.style.transform = `translate(${(x * r.width - d).toFixed(1)}px, ${(y * r.height - d).toFixed(1)}px)`;
      id = Math.abs(tx - x) + Math.abs(ty - y) > 0.0008 ? requestAnimationFrame(jalan) : 0;
    };
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      tx = (e.clientX - r.left) / r.width;
      ty = (e.clientY - r.top) / r.height;
      if (!id) id = requestAnimationFrame(jalan);
    });
    jalan();
  }

  // Kolom luas di hero: kirim angka ke Hitung AKAL lalu gulir ke sana.
  document.querySelector<HTMLFormElement>('[data-hero-hitung]')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const n = Number(new FormData(e.currentTarget as HTMLFormElement).get('luas')?.toString().replace(/\D/g, ''));
    document.getElementById('hitung')?.scrollIntoView({ behavior: 'smooth' });
    setTimeout(() => dispatchEvent(new CustomEvent('atapura:luas', { detail: n || 120 })), 400);
  });

  // FAQ: di desktop, pertanyaan yang disorot mouse langsung terbuka (satu per satu, name="tanya" menutup yang lain).
  const sorot = matchMedia('(hover: hover) and (pointer: fine)');
  document.querySelectorAll<HTMLDetailsElement>('[data-tanya] details').forEach((d) => {
    d.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse' && sorot.matches) d.open = true; });
  });

  // Tombol WA melayang muncul di HP setelah slip Hitung AKAL lewat, supaya tidak dobel dengan tombol di slip.
  const apung = document.querySelector<HTMLElement>('.wa-apung');
  const slip = document.querySelector('.hero');
  if (apung && slip) {
    apung.hidden = false;
    new IntersectionObserver(([e]) => {
      apung.classList.toggle('tampil', !e.isIntersecting && e.boundingClientRect.top < 0);
    }).observe(slip);
  }
</script>

