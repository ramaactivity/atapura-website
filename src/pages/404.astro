---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { waLink } from '../data/bisnis';
import '../styles/halaman.css';

// 404 dengan menu & footer seperti halaman lain (DECISIONS 083): orang yang nyasar tetap bisa lanjut, bukan buntu.
const tujuan = [
  { b: 'Hitung biaya atap', s: 'Masukkan luas atap, estimasi lima merek langsung terlihat.', href: '/hitung' },
  { b: 'Produk & layanan', s: 'Merek genteng aspal, rangka baja ringan, dan aksesoris beserta harga terpasang.', href: '/produk' },
  { b: 'Panduan', s: 'Biaya, pemasangan, perawatan, dan perbandingan, dibuka dengan jawaban singkat.', href: '/panduan' },
  { b: 'Area layanan', s: 'Kota dan kabupaten yang kami layani, juga di luar Jabodetabek.', href: '/area' },
];
---
<Base title="Halaman tidak ditemukan | Atapura" description="Halaman yang Anda cari tidak ada. Hitung biaya atap bitumen, lihat produk, atau baca panduan Atapura.">
  <Header terang />
  <main class="hl">
    <div class="wrap">
      <div class="hl-kartu-buka">
        <nav class="hl-remah" aria-label="Remah roti"><a href="/">Beranda</a><span aria-hidden="true">/</span><span>Tidak ditemukan</span></nav>
        <div class="hl-kepala">
          <h1 class="hl-judul">Halaman ini tidak ada, <span class="hl-redup">tapi atap Anda tetap bisa dihitung.</span></h1>
          <p class="hl-lead">Mungkin alamatnya salah ketik, atau halamannya sudah dipindah. Pilih salah satu tujuan di bawah, atau tanya admin langsung.</p>
        </div>
      </div>

      <section class="hl-sek" aria-labelledby="judul-tujuan">
        <h2 id="judul-tujuan" class="hl-h2">Yang biasanya <span class="hl-redup">dicari di sini.</span></h2>
        <div>
          <ul class="hl-daftar">
            {tujuan.map((x) => <li><b>{x.b}</b><span>{x.s}</span><a class="tautan-lanjut" href={x.href}>Buka {x.b.toLowerCase()}</a></li>)}
          </ul>
          <div class="hl-aksi">
            <a class="pill pill-tunas" href="/hitung">Hitung estimasi biaya</a>
            <a class="hl-tautan" href={waLink('Halo Atapura, saya mau tanya soal atap bitumen.')} target="_blank" rel="noopener" data-wa="404">Tanya admin lewat WhatsApp</a>
          </div>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Base>
