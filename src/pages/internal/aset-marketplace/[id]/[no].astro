---
// Satu slide aset marketplace = satu halaman 1080 × 1080 (website DECISIONS 059, sistem slide 062). Dipotret Chrome headless
// oleh tools/aset/render.mjs → public/unduh/marketplace/<id>/<no>-<nama>.jpg. Sistem slide (acuan Dr.Shield/Dr.Sonne/guenteng,
// disetujui Rama di kanvas Claude Design 20 Nov): bingkai Pinus, logo putih + pil Tunas "Chat admin sebelum checkout" di setiap
// slide, kartu putih dengan puncak atap di tengah, judul rata tengah. Huruf: Public Sans 500 (judul & angka) + Inter 400,
// tanpa tebal di tengah kalimat. TANPA nomor WA/situs (dilarang di gambar marketplace). Semua angka & teks dari src/data.
import '../../../../styles/global.css';
import { Image } from 'astro:assets';
import Logo from '../../../../components/Logo.astro';
import { aksesorisListing, coverListing, halamanWarna, penerapanListing, produkListing, semuaSlide } from '../../../../data/aset';
import { harga } from '../../../../data/harga';
import { NOTE_CHAT } from '../../../../data/listing';
import { fotoWarna, sampulProduk, warnaSeri } from '../../../../data/produk';

export function getStaticPaths() {
  return semuaSlide.map(({ l, s }) => ({ params: { id: l.id, no: String(s.no) }, props: { l, s } }));
}
const { l, s } = Astro.props;

const p = produkListing(l);
const a = aksesorisListing(l);
const genteng = l.ref.jenis === 'seri';
const seri = p ? (p.seri.find((x) => x.nama === (l.ref as { seri: string | null }).seri) ?? { nama: p.nama, ringkas: p.ringkas, spek: [], foto: undefined }) : null;
const nilai = (label: string) => l.atribut.find((x) => x.label === label)?.nilai;
const spekSeri = (label: string) => seri?.spek.find((x) => x.label === label)?.nilai;
const fakta = (label: string) => p?.fakta.find((x) => x.label === label)?.nilai;

/** Kalimat pertama; bila masih panjang, potong di koma pertama (deskripsi satu baris di bawah judul). */
const ringkas = (t: string) => {
  const satu = t.split(/(?<=\.)\s/)[0].replace(/\.$/, '');
  return (satu.length > 70 ? satu.split(',')[0] : satu) + '.';
};
const deskripsi = genteng ? ringkas(seri!.ringkas) : ringkas(a!.fungsi);
const kategori = genteng ? 'Genteng aspal' : 'Aksesoris atap bitumen';
const ukuranJudul = l.nama.length <= 16 ? 64 : l.nama.length <= 22 ? 56 : 48;

// Angka genteng.
const isiBundel = nilai('Isi per kemasan')?.replace(' per bundel', '');
const m2 = isiBundel ? Number(isiBundel.replace(/[^\d,]/g, '').replace(',', '.')) : null;
const contohBundel = m2 ? Math.ceil((100 * (1 + harga.susut)) / m2) : null;
const fmt = (n: number) => n.toLocaleString('id-ID', { maximumFractionDigits: 1 });
const susutPct = Math.round(harga.susut * 100);
const tambahM2 = 100 * (1 + harga.susut);
const pesanM2 = m2 && contohBundel ? contohBundel * m2 : null;
const garansi = nilai('Garansi')?.replace(' (pabrik)', '').replace(/\s*dari pabrik/i, '');

// Strip pil cover: angka penting (muat ±32 karakter) + satuan jual. Aksesoris tanpa harga di Ops jatuh ke satuan "pcs" di
// kit listing; di gambar diambil dari spesifikasi ("1 × 30 m per roll" → roll) supaya tidak menulis satuan yang salah.
const satuanSpek = a?.spek.map((x) => x.nilai.match(/per (roll|batang|lembar|pak)\b/)?.[1]).find(Boolean);
const satuanJual = genteng ? 'm²' : a?.harga ? l.satuan : (satuanSpek ?? l.satuan);
const kandidatPil = genteng ? [isiBundel ? `${isiBundel}/bundel` : null, garansi ? `Garansi pabrik ${garansi.replace(' tahun', ' th')}` : null] : (a?.spek.map((x) => x.nilai) ?? []);
const pil: string[] = [];
for (const v of kandidatPil) if (v && v.length <= 24 && [...pil, v].join('').length <= 32 && pil.length < 3) pil.push(v);

// Foto cover genteng: lembar rakitan → foto seri → contoh warna pertama → sampul merek (penerapan, paling akhir karena
// bukan foto produk).
const fotoCoverGenteng = genteng ? coverListing(l) : undefined;
const warnaPertama = (() => {
  if (!p || l.ref.jenis !== 'seri') return undefined;
  for (const g of warnaSeri(p, l.ref.seri)) for (const w of g.daftar) { const f = fotoWarna(g.tekstur, w.nama); if (f) return f; }
  return undefined;
})();
const teksturGenteng = genteng ? (seri?.foto ?? warnaPertama ?? sampulProduk(p!)?.src) : undefined;

// Gambar ukur genteng dari "Ukuran per lembar" (mis. "1.000 × 333 mm"): garis luar lembar (kotak pembatas), tanpa
// menebak bentuk potongan.
const ukuran = spekSeri('Ukuran per lembar')?.match(/([\d.,]+)\s*×\s*([\d.,]+)\s*mm/);
const ukurLembar = ukuran
  ? (() => {
      const [w, h] = [ukuran[1], ukuran[2]].map((x) => Number(x.replace(/\./g, '').replace(',', '.')));
      const lebar = Math.min(420, Math.round((140 * w) / h));
      return { lebar, tinggi: Math.round((lebar * h) / w), labelW: `${ukuran[1]} mm`, labelH: `${ukuran[2]} mm` };
    })()
  : null;

const barisSpek = genteng
  ? [
      { label: "Isi per bundel", nilai: spekSeri("Isi per bundel")?.includes("m²") ? spekSeri("Isi per bundel") : [spekSeri("Isi per bundel"), isiBundel].filter(Boolean).join(", ") },
      { label: 'Bahan', nilai: spekSeri('Bahan') },
      { label: 'Kemiringan atap', nilai: fakta('Kemiringan') },
      { label: 'Garansi pabrik', nilai: garansi },
      ...(ukurLembar ? [] : [{ label: 'Ukuran per lembar', nilai: spekSeri('Ukuran per lembar') }]),
    ].filter((x): x is { label: string; nilai: string } => Boolean(x.nilai)).slice(0, 4)
  : (a?.spek ?? []).slice(0, 4);

const warna = s.kunci === 'warna' ? halamanWarna(l)[s.bagian ?? 0] : null;
const tinggiUbin = warna?.baris === 3 ? 100 : 164;

const penerapan = genteng ? penerapanListing(l) : [];
const kemiringan = fakta('Kemiringan');

const syarat = [
  NOTE_CHAT,
  genteng
    ? m2
      ? `Harga per m². Dikirim per bundel isi ${isiBundel}, pesanan dibulatkan ke kelipatan ${isiBundel}.`
      : 'Harga per m². Dikirim per bundel.'
    : `Harga per ${satuanJual}.`,
  genteng && l.varian ? 'Warna di layar bisa sedikit berbeda dari aslinya.' : null,
  garansi ? `Garansi pabrik ${garansi}, mengikuti syarat dokumen garansi pabrik.` : null,
  'Papan alas, underlayer, paku bitumen, dan flashing tersedia terpisah di toko kami.',
].filter((x): x is string => Boolean(x));
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=1080" />
    <title>{l.nama} · {s.nama}</title>
  </head>
  <body>
    <main class="sl">
      <header class="sl-atas">
        <span class="sl-logo"><Logo tinggi="44px" /></span>
        <p class="sl-chat">
          <svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H9l-5 4z"></path></svg>
          Chat admin sebelum checkout
        </p>
      </header>

      <section class="sl-kartu">
        {s.kunci === 'cover' ? (
          <>
            <p class="sl-kat">{kategori}</p>
            <h1 class="sl-judul" style={`--judul: ${ukuranJudul}px`}>{l.nama}</h1>
            {fotoCoverGenteng ? (
              <div class="sl-foto-cover"><Image src={fotoCoverGenteng} alt="" widths={[1000]} sizes="1000px" loading="eager" decoding="sync" /></div>
            ) : genteng && teksturGenteng ? (
              <div class="sl-tekstur"><Image src={teksturGenteng} alt="" widths={[1000]} sizes="888px" loading="eager" decoding="sync" /></div>
            ) : a?.wujud ? (
              <div class="sl-foto-cover sl-wujud"><Image src={a.wujud} alt="" widths={[1000]} sizes="600px" loading="eager" decoding="sync" /></div>
            ) : (
              <div class="sl-isi" />
            )}
            <div class="sl-strip">
              {pil.length ? (
                <div class="sl-strip-isi">
                  {pil.map((v, i) => (
                    <>
                      {i > 0 ? <span class="sl-strip-garis" /> : null}
                      <span>{v}</span>
                    </>
                  ))}
                </div>
              ) : null}
              <p class="sl-strip-jual">Dijual per {satuanJual}</p>
            </div>
          </>
        ) : s.kunci === 'spek' ? (
          <>
            <p class="sl-kat">{l.nama}</p>
            <h1 class="sl-judul">Deskripsi &amp; spesifikasi</h1>
            <p class="sl-desk">{deskripsi}</p>
            {ukurLembar ? (
              <div class="sl-ukur" style={`--lw: ${ukurLembar.lebar}px; --lh: ${ukurLembar.tinggi}px`}>
                <div class="sl-ukur-h"><span>{ukurLembar.labelW}</span></div>
                <div class="sl-ukur-lembar" role="img" aria-label={`Ukuran satu lembar ${ukurLembar.labelW} × ${ukurLembar.labelH}`} />
                <div class="sl-ukur-v" />
                <p class="sl-ukur-vlabel">{ukurLembar.labelH}</p>
              </div>
            ) : !genteng && a?.wujud ? (
              <div class="sl-gambar"><Image src={a.wujud} alt="" widths={[800]} sizes="400px" loading="eager" decoding="sync" /></div>
            ) : teksturGenteng ? (
              <div class="sl-tekstur sl-tekstur-pendek"><Image src={teksturGenteng} alt="" widths={[1000]} sizes="888px" loading="eager" decoding="sync" /></div>
            ) : null}
            {ukurLembar && !barisSpek.length && teksturGenteng ? (
              <div class="sl-tekstur sl-tekstur-isi"><Image src={teksturGenteng} alt="" widths={[1000]} sizes="888px" loading="eager" decoding="sync" /></div>
            ) : null}
            {barisSpek.length ? (
              <dl class="sl-tabel">
                {barisSpek.map((x) => (
                  <div><dt>{x.label}</dt><dd>{x.nilai}</dd></div>
                ))}
              </dl>
            ) : null}
          </>
        ) : s.kunci === 'warna' && warna ? (
          <>
            <p class="sl-kat">{l.nama}{warna.halaman ? `, halaman ${warna.halaman}` : ''}</p>
            <h1 class="sl-judul">{warna.judul[0].toUpperCase() + warna.judul.slice(1)}</h1>
            <ul class="sl-ubin" style={`--tinggi-ubin: ${tinggiUbin}px`}>
              {warna.daftar.map((w) => (
                <li>
                  {w.foto ? <Image src={w.foto} alt="" widths={[600]} sizes="280px" loading="eager" decoding="sync" /> : <span class="sl-ubin-hex" style={w.hex ? `background:${w.hex}` : undefined} />}
                  <p>{w.nama}{warna.baris === 2 && w.kode ? <span>{w.kode}</span> : null}</p>
                </li>
              ))}
            </ul>
            <p class="sl-catatan">Pilih di varian. Warna di layar bisa sedikit berbeda dari aslinya.</p>
          </>
        ) : s.kunci === 'penerapan' ? (
          <>
            <p class="sl-kat">{l.nama}</p>
            <h1 class="sl-judul">Penerapan</h1>
            {genteng ? (
              <>
                <div class="sl-pakai" style={`--kolom: ${penerapan.length}`}>
                  {penerapan.map((x) => (
                    <figure>
                      <Image src={x.gambar} alt="" widths={[1000]} sizes="440px" loading="eager" decoding="sync" />
                      <figcaption>{x.keterangan}</figcaption>
                    </figure>
                  ))}
                </div>
                {kemiringan ? <p class="sl-info">Kemiringan atap: {kemiringan}.</p> : null}
              </>
            ) : a?.foto ? (
              <>
                <div class="sl-pakai-satu"><Image src={a.foto.src} alt="" widths={[1600]} sizes="888px" loading="eager" decoding="sync" /></div>
                <p class="sl-pakai-teks">{a.fungsi}</p>
              </>
            ) : null}
          </>
        ) : s.kunci === 'hitung' && m2 && contohBundel && pesanM2 ? (
          <>
            <p class="sl-kat">{l.nama}, dikirim per bundel isi {isiBundel}</p>
            <h1 class="sl-judul">Hitung kebutuhan</h1>
            <p class="sl-contoh">Contoh, atap 100 m²</p>
            <dl class="sl-rincian">
              <div><dt>Luas atap</dt><span /><dd>100 m²</dd></div>
              <div><dt>Tambah ±{susutPct}% untuk potongan</dt><span /><dd>{fmt(tambahM2)} m²</dd></div>
              <div><dt>Bulatkan ke kelipatan {isiBundel}</dt><span /><dd>{fmt(pesanM2)} m²</dd></div>
            </dl>
            <div class="sl-total">
              <p>Pesan</p>
              <p><span>{contohBundel} bundel</span><b>{fmt(pesanM2)} m²</b></p>
            </div>
            <p class="sl-catatan">Atap limasan butuh potongan lebih banyak.</p>
          </>
        ) : s.kunci === 'syarat' ? (
          <>
            <p class="sl-kat">Harap dibaca sebelum order</p>
            <h1 class="sl-judul">Syarat &amp; ketentuan</h1>
            <ol class="sl-syarat">
              {syarat.map((x, i) => (
                <li><span>{i + 1}</span><p>{x}</p></li>
              ))}
            </ol>
            {syarat.length <= 4 ? <p class="sl-tutup">Bingung hitung kebutuhan? Chat admin dulu.</p> : null}
          </>
        ) : null}
      </section>
    </main>
  </body>
</html>

<style is:global>
  html, body { margin: 0; padding: 0; background: var(--color-pinus); }
  body { width: 1080px; height: 1080px; overflow: hidden; }
  .sl { position: relative; width: 1080px; height: 1080px; overflow: hidden; background: var(--color-pinus); color: var(--color-tinta); font-family: var(--font-sans); letter-spacing: -0.011em; }
  .sl p, .sl h1, .sl figure, .sl dl, .sl dd, .sl ol, .sl ul { margin: 0; }

  /* Header: logo putih + satu-satunya elemen Tunas. */
  .sl-atas { position: absolute; left: 56px; right: 56px; top: 46px; height: 60px; display: flex; align-items: center; justify-content: space-between; }
  .sl-logo { color: #fff; display: inline-flex; }
  .sl-chat { display: flex; align-items: center; gap: 14px; height: 60px; padding: 0 28px 0 22px; border-radius: 999px; background: var(--color-tunas); color: var(--color-pinus); font-size: 30px; font-weight: 500; line-height: 1; white-space: nowrap; }

  /* Kartu putih dengan puncak atap di tengah (kemiringan 40/500). */
  .sl-kartu { position: absolute; left: 40px; top: 148px; width: 1000px; height: 892px; box-sizing: border-box; padding: 92px 56px 56px; background: #fff; clip-path: path('M0 40 L500 0 L1000 40 L1000 860 Q1000 892 968 892 L32 892 Q0 892 0 860 Z'); display: flex; flex-direction: column; }
  .sl-kat { font-size: 30px; line-height: 1.25; color: var(--color-lumut); text-align: center; }
  .sl-judul { margin-top: 8px !important; font-family: var(--font-merek); font-size: var(--judul, 64px); font-weight: 500; line-height: 1.05; letter-spacing: -0.025em; text-align: center; text-wrap: balance; }
  .sl-desk { margin-top: 12px !important; font-size: 32px; line-height: 1.35; color: var(--color-lumut); text-align: center; text-wrap: balance; }
  .sl-isi { flex: 1; }
  .sl-catatan { margin-top: auto !important; font-size: 30px; line-height: 1.3; color: var(--color-lumut); text-align: center; }

  /* Cover */
  .sl-foto-cover { flex: 1; min-height: 0; margin: 8px -56px 24px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .sl-foto-cover img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .sl-wujud img { transform: scale(1.1); mix-blend-mode: multiply; filter: brightness(1.05) contrast(1.03); }
  .sl-tekstur { flex: 1; min-height: 0; margin: 40px 0 32px; border-radius: 20px; overflow: hidden; }
  .sl-tekstur img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sl-strip { display: flex; align-items: stretch; height: 76px; flex: none; border: 2px solid var(--color-garis); border-radius: 999px; overflow: hidden; }
  .sl-strip-isi { flex: 1; display: flex; align-items: center; justify-content: space-evenly; padding: 0 16px; font-family: var(--font-merek); font-size: 32px; font-weight: 500; letter-spacing: -0.01em; white-space: nowrap; font-variant-numeric: tabular-nums lining-nums; }
  .sl-strip-garis { width: 2px; height: 32px; background: var(--color-garis); }
  .sl-strip-jual { display: flex; align-items: center; justify-content: center; padding: 0 36px; flex: 1 0 auto; background: var(--color-pinus); color: var(--color-embun); font-size: 30px; font-weight: 500; white-space: nowrap; }
  .sl-strip-isi + .sl-strip-jual { flex: 0 0 auto; }
  /* Tanpa angka yang muat: cukup pil satuan jual di tengah, bukan batang gelap selebar kartu. */
  .sl-strip:not(:has(.sl-strip-isi)) { align-self: center; border-color: var(--color-pinus); }

  /* Deskripsi & spesifikasi */
  .sl-ukur { position: relative; margin-top: 40px; height: 200px; flex: none; border-radius: 20px; background: var(--color-embun); }
  .sl-ukur-lembar { position: absolute; left: calc(414px - var(--lw) / 2); top: 70px; width: var(--lw); height: var(--lh); box-sizing: border-box; border: 3px solid var(--color-pinus); border-radius: 4px; background: #fff; }
  .sl-ukur-h { position: absolute; left: calc(414px - var(--lw) / 2); top: 22px; width: var(--lw); height: 34px; border-left: 3px solid var(--color-pinus); border-right: 3px solid var(--color-pinus); box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
  .sl-ukur-h::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; border-top: 3px solid var(--color-pinus); }
  .sl-ukur-h span { position: relative; padding: 0 18px; background: var(--color-embun); font-family: var(--font-merek); font-size: 40px; font-weight: 500; line-height: 1.1; letter-spacing: -0.01em; white-space: nowrap; font-variant-numeric: tabular-nums lining-nums; }
  .sl-ukur-v { position: absolute; left: calc(414px + var(--lw) / 2 + 36px); top: 70px; width: 34px; height: var(--lh); box-sizing: border-box; border-top: 3px solid var(--color-pinus); border-bottom: 3px solid var(--color-pinus); transform: translateX(-17px); }
  .sl-ukur-v::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; border-left: 3px solid var(--color-pinus); }
  .sl-ukur-vlabel { position: absolute; left: calc(414px + var(--lw) / 2 + 66px); top: calc(70px + var(--lh) / 2 - 22px); font-family: var(--font-merek); font-size: 40px; font-weight: 500; line-height: 1.1; letter-spacing: -0.01em; white-space: nowrap; font-variant-numeric: tabular-nums lining-nums; }
  .sl-gambar { margin-top: 40px; height: 300px; flex: none; border-radius: 20px; background: var(--color-embun); overflow: hidden; display: flex; justify-content: center; }
  .sl-gambar img { height: 100%; width: auto; aspect-ratio: 1; object-fit: contain; mix-blend-mode: multiply; filter: brightness(1.05) contrast(1.03); transform: scale(1.12); display: block; }
  .sl-tekstur-pendek { flex: none; height: 260px; margin: 40px 0 0; }
  .sl-tekstur-isi { margin: 24px 0 0; }
  .sl-tabel { margin-top: auto !important; padding-top: 24px; display: grid; }
  .sl-tabel div { display: grid; grid-template-columns: 300px minmax(0, 1fr); min-height: 64px; border: 2px solid var(--color-garis); border-top-width: 0; }
  .sl-tabel div:first-child { border-top-width: 2px; border-radius: 20px 20px 0 0; }
  .sl-tabel div:last-child { border-radius: 0 0 20px 20px; }
  .sl-tabel div:only-child { border-radius: 20px; }
  .sl-tabel dt { display: flex; align-items: center; padding: 8px 28px; background: var(--color-embun); font-size: 30px; color: var(--color-lumut); }
  .sl-tabel div:first-child dt { border-top-left-radius: 18px; }
  .sl-tabel div:last-child dt { border-bottom-left-radius: 18px; }
  .sl-tabel dd { display: flex; align-items: center; padding: 8px 28px; font-family: var(--font-merek); font-size: 34px; font-weight: 500; line-height: 1.2; letter-spacing: -0.01em; font-variant-numeric: tabular-nums lining-nums; }

  /* Etalase warna: grid 3 kolom rata atas-bawah (komentar Rama 20 Nov). */
  .sl-ubin { list-style: none; padding: 0; margin-top: 40px !important; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .sl-ubin li { min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .sl-ubin img, .sl-ubin-hex { display: block; width: 100%; height: var(--tinggi-ubin); object-fit: cover; border-radius: 14px; background: var(--color-garis); }
  .sl-ubin p { font-size: 30px; font-weight: 500; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sl-ubin p span { display: block; font-weight: 400; color: var(--color-lumut); }

  /* Penerapan */
  .sl-pakai { flex: 1; min-height: 0; margin-top: 40px; display: grid; grid-template-columns: repeat(var(--kolom), minmax(0, 1fr)); gap: 24px; }
  .sl-pakai figure { min-height: 0; display: flex; flex-direction: column; gap: 20px; }
  .sl-pakai img { flex: 1; min-height: 0; width: 100%; object-fit: cover; border-radius: 20px; display: block; }
  .sl-pakai figcaption { font-size: 30px; line-height: 1.3; text-align: center; text-wrap: balance; }
  .sl-info { margin-top: 28px !important; padding: 22px 28px; border-radius: 20px; background: var(--color-embun); font-size: 30px; line-height: 1.35; text-align: center; text-wrap: balance; }
  .sl-pakai-satu { flex: 1; min-height: 0; margin-top: 40px; border-radius: 20px; overflow: hidden; }
  .sl-pakai-satu img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sl-pakai-teks { margin-top: 28px !important; font-size: 34px; line-height: 1.35; text-align: center; text-wrap: pretty; }

  /* Hitung kebutuhan: rincian bertitik khas slip Atapura. */
  .sl-contoh { margin-top: 40px !important; font-size: 34px; font-weight: 500; line-height: 1.25; }
