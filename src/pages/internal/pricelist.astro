---
// Pricelist A4 untuk pelanggan (DECISIONS 051). Halaman ini sumber PDF: `npm run pricelist`.
// Semua angka dibaca dari harga.ts / produk.ts / aksesoris.ts / bisnis.ts — jangan ketik harga di sini.
// Desain v4 (DECISIONS 053): meniru referensi Rama (docs/desain/referensi-dokumen di Atapura Ops): bentuk bersudut besar
// bertakik, foto di dalam bentuk, judul Public Sans 500 + satu frasa diredupkan, Inter untuk teks kecil.
// Narasi umum: tanpa jumlah merek/wilayah/klaim/disclaimer yang membatasi (Rama 20 Nov 2026).
// Jebakan PDF: tanpa box-shadow/text-shadow/filter/mask; foto dalam bentuk memakai <clipPath> SVG.
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Bulat from '../../components/BulatWarna.astro';
import { harga, type Merek } from '../../data/harga';
import { produk, fotoWarna } from '../../data/produk';
import { aksesoris } from '../../data/aksesoris';
import { bisnis, TAMPIL_PLAFON } from '../../data/bisnis';
import qr from '../../../assets/gambar/pricelist-qr-wa.svg?raw';
import fMaterial from '../../../assets/gambar/magnific/pricelist-material-lengkap.jpg';
import lMaxxi from '../../../assets/mitra/maxxi-logo.png';
import lCti from '../../../assets/mitra/cti-logo.png';
import lTegola from '../../../assets/mitra/tegola-logo.png';
import lHisteel from '../../../assets/mitra/histeel-logo.jpg';
import lTatalogam from '../../../assets/mitra/tatalogam-logo.png';
import lJavabitumen from '../../../assets/mitra/javabitumen-logo-putih.png';
import lVictory from '../../../assets/mitra/victory-logo.png';
import fSampul from '../../../assets/gambar/magnific/pricelist-sampul.jpg';
import fJavabitumen from '../../../assets/gambar/magnific/pricelist-javabitumen.jpg';
import fMaxxi from '../../../assets/gambar/magnific/pricelist-maxxi.jpg';
import fCti from '../../../assets/gambar/magnific/pricelist-cti.jpg';
import fVictory from '../../../assets/gambar/magnific/pricelist-victory.jpg';
import fTegola from '../../../assets/gambar/magnific/pricelist-tegola.jpg';
import fShunda from '../../../assets/gambar/magnific/pricelist-plafon-shunda.jpg';
import fJavafon from '../../../assets/gambar/magnific/pricelist-plafon-javafon.jpg';
import fRangka from '../../../assets/gambar/magnific/pricelist-rangka.jpg';
import fPerumahan from '../../../assets/gambar/magnific/pricelist-perumahan.jpg';
// Foto suasana kedua: dipakai pada rasio aslinya (atap tidak boleh terpotong, Rama) bila sisa halaman warna cukup.
import h2Java from '../../../assets/gambar/magnific/pricelist-hero2-javabitumen.jpg';
import h2Maxxi from '../../../assets/gambar/magnific/pricelist-hero2-maxxi.jpg';
import h2Cti from '../../../assets/gambar/magnific/pricelist-hero2-cti.jpg';
import h2Victory from '../../../assets/gambar/magnific/pricelist-hero2-victory.jpg';
import mEcoRect from '../../../assets/gambar/seri/tegola-eco-roof-rectangular.jpg';
import mEcoTrad from '../../../assets/gambar/seri/tegola-eco-roof-traditional.jpg';
import mEcoHex from '../../../assets/gambar/seri/tegola-eco-roof-hexagonal.jpg';
import mTop from '../../../assets/gambar/seri/tegola-top-shingles-rectangular.jpg';
import sTegolaEco from '../../../assets/gambar/magnific/pricelist-tegola-eco-roof.jpg';
import sTegolaMaster from '../../../assets/gambar/magnific/pricelist-tegola-master.jpg';

const rp = (n: number) => `Rp${n.toLocaleString('id-ID')}`;
const ribu = (n: number) => (n / 1000).toLocaleString('id-ID');
const juta = (n: number) => (n / 1_000_000).toLocaleString('id-ID', { maximumFractionDigits: 1 });
const m2 = (n: number) => `${n.toLocaleString('id-ID', { maximumFractionDigits: 2 })} m²`;
const tanggal = new Date(`${harga.berlakuSejak}T00:00:00+07:00`).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' });
const tahun = harga.berlakuSejak.slice(0, 4);
const waTampil = bisnis.whatsapp ? `+${bisnis.whatsapp.slice(0, 2)} ${bisnis.whatsapp.slice(2, 5)}-${bisnis.whatsapp.slice(5, 9)}-${bisnis.whatsapp.slice(9)}` : '';
const situs = 'atapura.com';
const src = async (f: ImageMetadata, width = 1600, quality = 80) => (await getImage({ src: f, format: 'jpg', width: Math.min(width, f.width), quality })).src;

// Urut dari harga genteng terendah. Negara asal, bukan kelas harga (Rama 19 Nov). `deskripsi` ditulis di sini supaya
// tanpa klaim/disclaimer. `acuan` = seri yang dipakai untuk harga terpasang. `motif` = close-up tambahan tanpa baris seri.
const ATAP: { merek: Merek; slug: string; foto: ImageMetadata; asal: string; deskripsi: string; acuan?: string; hero2?: { foto: ImageMetadata; judul: string; sub: string }; suasana?: { foto: ImageMetadata; judul: string; sub?: string }[]; motif?: { nama: string; foto: ImageMetadata }[] }[] = [
  { merek: 'Javabitumen', slug: 'javabitumen', foto: fJavabitumen, asal: 'Tiongkok', deskripsi: 'Genteng aspal dengan pilihan warna solid dan gradasi, untuk rumah tinggal dan renovasi.', hero2: { foto: h2Java, judul: 'Solid dan gradasi.', sub: 'Pilih warna yang menyatu dengan rumah Anda.' } },
  { merek: 'Maxxi', slug: 'maxxi', foto: fMaxxi, asal: 'Tiongkok', deskripsi: 'Maxxiroof 3-tab satu lapis untuk yang ingin hemat, Promaxxi laminasi dua lapis yang lebih tebal.', hero2: { foto: h2Maxxi, judul: 'Tebal, berbayang.', sub: 'Promaxxi laminasi dua lapis.' } },
  { merek: 'CTI', slug: 'cti', foto: fCti, asal: 'Indonesia', deskripsi: 'Genteng aspal buatan dalam negeri dengan potongan 3-tab, tidak beraturan, dan segi enam.', hero2: { foto: h2Cti, judul: 'Buatan Indonesia.', sub: '3-tab, tidak beraturan, atau segi enam.' } },
  { merek: 'Victory', slug: 'victory', foto: fVictory, asal: 'USA', deskripsi: 'Seri Standar berwarna rata dan Two Tone yang memadukan dua nada warna di tiap lidah genteng.', hero2: { foto: h2Victory, judul: 'Dua nada.', sub: 'Two Tone memberi dimensi di tiap lidah genteng.' } },
  { merek: 'Tegola', slug: 'tegola', foto: fTegola, asal: 'Italia', acuan: 'Premium Rectangular', suasana: [
    { foto: sTegolaEco, judul: 'Eco Roof Hexagonal', sub: 'Hijau campuran pada bungalow di dataran tinggi.' },
    { foto: sTegolaMaster, judul: 'Master', sub: 'Laminasi dua lapis abu gelap pada villa di perbukitan.' },
  ], deskripsi: 'Genteng aspal Tegola Canadese: Eco Roof dan Top Shingles, Premium satu lapis, dan Master dua lapis.', motif: [
    { nama: 'Eco Roof Rectangular', foto: mEcoRect },
    { nama: 'Eco Roof Traditional', foto: mEcoTrad },
    { nama: 'Eco Roof Hexagonal', foto: mEcoHex },
    { nama: 'Top Shingles Rectangular', foto: mTop },
  ] },
];
/** "±Rp315–350 ribu per m²" → teks rupiah + angka terendah. */
const hargaSeri = (t?: string) => {
  if (!t) return null;
  const n = [...t.matchAll(/(\d+) ribu|(\d+)–/g)].map((m) => Number(m[1] ?? m[2]) * 1000);
  return { teks: t.replace(/^±/, '').replace(/(\d+)–(\d+) ribu per m²/, '$1–$2 rb / m²').replace(/(\d+) ribu per m²/, '$1 rb / m²'), min: Math.min(...n) };
};
/** Garansi pabrik pendek untuk baris ikon; null bila belum ada angka (tidak ditulis sama sekali). */
const garansiPendek = (t: string) => {
  const m = t.match(/(\d+)(?: dan (\d+))? tahun/);
  if (!m) return null;
  return `${/hingga/.test(t) ? 'hingga ' : ''}${m[2] ? `${m[1]}–${m[2]}` : m[1]} tahun`;
};
const halamanAtap = await Promise.all(
  ATAP.map(async (a) => {
    const p = produk.find((x) => x.slug === a.slug)!;
    const m = harga.merek[a.merek];
    // Catatan warna yang berupa disclaimer (dipastikan/dikonfirmasi ke pemasok) tidak dicetak (Rama 20 Nov).
    const warna = p.warna.map((g) => ({ judul: g.judul, catatan: g.catatan && !/pastikan|dikonfirmasi|perkiraan/i.test(g.catatan) ? g.catatan : undefined, daftar: g.daftar.map((w) => ({ ...w, foto: fotoWarna(g.tekstur, w.nama) })) }));
    const semuaWarna = warna.flatMap((g) => g.daftar);
    const seri = p.seri.map((s) => ({ nama: s.nama, harga: hargaSeri(s.spek.find((k) => k.label === 'Genteng saja')?.nilai) }));
    const mulai = Math.min(m.genteng, ...seri.map((x) => x.harga?.min ?? Infinity));
    const motif = [...(a.motif ?? []), ...p.seri.filter((x) => x.foto && !(a.motif ?? []).some((y) => y.foto.src === x.foto!.src)).map((x) => ({ nama: x.nama, foto: x.foto! }))];
    const tekstur = motif.at(-1)?.foto ?? a.foto;
    return {
      ...a, p, m, warna, seri, mulai, motif,
      totalWarna: semuaWarna.length,
      titik: semuaWarna.filter((w) => w.hex).slice(0, 5).map((w) => w.hex!),
      pabrik: garansiPendek(m.garansiPabrik),
      fotoSrc: await src(a.foto, 1400),
      teksturSrc: await src(tekstur, 900, 82),
      fotoSuasana: [
        ...(a.hero2 ? [{ src: await src(a.hero2.foto, 1800), rasio: a.hero2.foto.width / a.hero2.foto.height, judul: a.hero2.judul, sub: a.hero2.sub }] : []),
        ...(await Promise.all((a.suasana ?? []).map(async (x) => ({ src: await src(x.foto, 1400), rasio: x.foto.width / x.foto.height, judul: x.judul, sub: x.sub })))),
        ...(await Promise.all(p.penerapan.map(async (x) => ({ src: await src(x.gambar, 1400), rasio: x.gambar.width / x.gambar.height, judul: x.keterangan })))),
      ] as Foto[],
    };
  }),
);
// Kartu sorotan di katalog = merek dengan harga terpasang tertinggi; sisanya baris daftar.
const unggul = halamanAtap.reduce((x, y) => (y.m.terpasang[0] > x.m.terpasang[0] ? y : x));
const barisKatalog = halamanAtap.filter((a) => a !== unggul); // ponytail: muat ±4 baris; tambah merek → perkecil baris.
const seriUnggul = [...new Set(unggul.p.seri.map((s) => s.nama.replace(/ (Rectangular|Traditional|Hexagonal|Beaver)$/, '')))].join(', ');
const rangka = Object.entries(harga.rangka.merek).map(([nama, r]) => ({ nama, ...r }));
const rangkaMulai = Math.min(...rangka.map((r) => r.harga));
const plafon = (['Shunda', 'Javafon'] as const).map((nama) => ({ nama, h: harga.plafon.merek[nama], foto: nama === 'Shunda' ? fShunda : fJavafon }));
const sampulSrc = await src(fSampul, 1700);
const materialSrc = await src(fMaterial, 2000);
// Halaman mitra (Rama 20 Nov): merek yang dipasok & dipasang, per kelompok material. Logo hanya file resmi (assets/mitra);
// merek yang belum punya file resmi ditulis namanya saja — logo tidak pernah dibuat ulang.
const LOGO: Record<string, ImageMetadata> = { Javabitumen: lJavabitumen, Maxxi: lMaxxi, CTI: lCti, Victory: lVictory, Tegola: lTegola, 'Hi-Steel': lHisteel, Taso: lTatalogam };
// Logo resmi yang hanya ada versi putih tampil di ubin gelap (tidak diwarnai ulang).
const LOGO_GELAP = new Set(['Javabitumen']);
const logoSrc = Object.fromEntries(await Promise.all(Object.entries(LOGO).map(async ([k, f]) => [k, (await getImage({ src: f, format: 'png', width: Math.min(500, f.width) })).src])));
const MITRA: { kelompok: string; isi: string[] }[] = [
  { kelompok: 'Genteng bitumen', isi: Object.keys(harga.merek) },
  { kelompok: 'Alas atap', isi: ['Multiplek', 'GRC board'] },
  { kelompok: 'Lapis kedap', isi: ['CTI', 'Alphaproof', 'Bitumax', 'Non-woven'] },
  { kelompok: 'Rangka baja ringan', isi: Object.keys(harga.rangka.merek) },
  { kelompok: 'Flashing & aksesoris', isi: ['Flashing U & Z', 'Paku & skrup', 'Aluminium foil'] },
];
const perumahanSrc = await src(fPerumahan, 1700);
const rangkaSrc = await src(fRangka, 1600);

// ── Motif & warna: dipaginasi dengan perkiraan tinggi (mm) yang sama dengan CSS di bawah; tinggi area isi 232 mm.
// Diukur di Chrome (20 Nov): baris warna 37,1 mm (dengan kode), motif 54,4 mm, judul 7,8 mm, catatan satu baris 7,2 mm.
const TINGGI = 232, CELAH = 7, MOTIF_KOLOM = 3, WARNA_KOLOM = 5, JUDUL = 8;
const tinggiCatatan = (c?: string) => (c ? (c.length > 110 ? 13 : 8) : 0);
type Motif = { nama: string; foto: ImageMetadata; harga?: string };
type Warna = { nama: string; kode?: string; hex?: string; foto?: ImageMetadata };
type Blok =
  | { jenis: 'bagian'; judul: string; lanjut: boolean; catatan?: undefined; isi: [] }
  | { jenis: 'motif'; judul: string; lanjut: boolean; catatan?: undefined; isi: Motif[] }
  | { jenis: 'warna'; judul: string; lanjut: boolean; catatan?: string; isi: Warna[] }
  | { jenis: 'samping'; judul: string; lanjut: boolean; catatan?: undefined; isi: Motif[]; warna: { judul: string; catatan?: string; daftar: Warna[] }[] };
type Foto = { src: string; rasio: number; judul: string; sub?: string };
const BAGIAN = 12;
/** Motif & warna dikelompokkan per seri (Rama: "jangan bercampur"): kunci = kata pertama nama motif; grup warna ikut seri
 *  yang namanya disebut di judulnya ("CT5 dan CT6" menyatukan CT5 + CT6). Grup tanpa motif (Javabitumen) tetap berdiri. */
const kelompokSeri = (motif: Motif[], warna: { judul: string; catatan?: string; daftar: Warna[] }[]) => {
  const kunci = (n: string) => n.split(' ')[0];
  const seri: { kunci: string[]; motif: Motif[]; warna: typeof warna; judul?: string }[] = [];
  for (const m of motif) {
    const s = seri.find((x) => x.kunci.includes(kunci(m.nama)));
    if (s) s.motif.push(m);
    else seri.push({ kunci: [kunci(m.nama)], motif: [m], warna: [] });
  }
  for (const g of warna) {
    const kata = g.judul.split(/[\s(),·]+/);
    const cocok = seri.filter((x) => x.kunci.some((k) => kata.includes(k)));
    if (!cocok.length) { seri.push({ kunci: [], motif: [], warna: [g] }); continue; }
    const [utama, ...lain] = cocok;
    for (const x of lain) { utama.motif.push(...x.motif); utama.kunci.push(...x.kunci); utama.warna.push(...x.warna); seri.splice(seri.indexOf(x), 1); }
    utama.warna.push(g);
  }
  for (const s of seri) {
    if (!s.motif.length) continue;
    const kata = s.motif.map((m) => m.nama.split(' '));
    const awal: string[] = [];
    for (let i = 0; kata.every((k) => k[i] && k[i] === kata[0][i]); i++) awal.push(kata[0][i]);
    s.judul = awal.length ? awal.join(' ') : s.motif.map((m) => m.nama).join(' dan ');
  }
  return seri;
};
const labelWarna = (judulSeri: string | undefined, g: string) => {
  if (!judulSeri || !g.startsWith(judulSeri)) return g;
  const sisa = g.slice(judulSeri.length).replace(/^[\s·]+/, '');
  if (!sisa || sisa.startsWith('(')) return 'Warna';
  return /warna/i.test(sisa) ? sisa[0].toUpperCase() + sisa.slice(1) : `Warna ${sisa}`;
};
const halamanDetail = (a: (typeof halamanAtap)[number]) => {
  const hargaMotif = new Map(a.seri.map((s) => [s.nama, s.harga?.teks]));
  const potong: (Blok & { total: number; kolom: number; seri?: string })[] = [];
  for (const s of kelompokSeri(a.motif.map((x) => ({ ...x, harga: hargaMotif.get(x.nama) })), a.warna)) {
    if (s.judul) potong.push({ jenis: 'bagian', judul: s.judul, lanjut: false, isi: [], total: 0, kolom: 1, seri: s.judul });
    // Seri bermotif satu dengan warna sedikit: motif di kiri, warnanya di kanan (ringkas, tetap terpisah per seri).
    const jumlahWarna = s.warna.reduce((n, g) => n + g.daftar.length, 0);
    if (s.motif.length === 1 && jumlahWarna > 0 && jumlahWarna <= 9) {
      potong.push({ jenis: 'samping', judul: 'Motif', lanjut: false, isi: s.motif, total: 0, kolom: 1, seri: s.judul, warna: s.warna.map((g) => ({ ...g, judul: labelWarna(s.judul, g.judul) })) });
      continue;
    }
    for (let i = 0; i < s.motif.length; i += MOTIF_KOLOM) potong.push({ jenis: 'motif', judul: 'Motif', lanjut: i > 0, total: s.motif.length, kolom: MOTIF_KOLOM, seri: s.judul, isi: s.motif.slice(i, i + MOTIF_KOLOM) });
    for (const g of s.warna) {
      const judul = labelWarna(s.judul, g.judul);
      for (let i = 0; i < g.daftar.length; i += WARNA_KOLOM) potong.push({ jenis: 'warna', judul, catatan: g.catatan, lanjut: i > 0, total: g.daftar.length, kolom: WARNA_KOLOM, seri: s.judul, isi: g.daftar.slice(i, i + WARNA_KOLOM) });
    }
  }
  // Tinggi baris diukur di Chrome: motif 50,1 mm (54,4 bila ada harga), warna 32,8 mm (37,1 bila ada kode).
  const tinggiBaris = (b: Blok) => (b.jenis === 'motif' ? (b.isi.some((x) => x.harga) ? 54.5 : 50.5) : b.jenis === 'warna' ? (b.isi.some((x) => x.kode) ? 37.5 : 33) : 0);
  // Samping: kanan 3 kolom (ubin ±36 mm, baris ±38 mm dengan kode / ±34 tanpa), kiri satu motif.
  const tinggiSamping = (b: Extract<Blok, { jenis: 'samping' }>) =>
    Math.max(JUDUL + tinggiBaris({ jenis: 'motif', judul: '', lanjut: false, isi: b.isi }),
      b.warna.reduce((n, g, k) => { const r = Math.ceil(g.daftar.length / 3); return n + (k ? 5 : 0) + JUDUL + tinggiCatatan(g.catatan) + r * (g.daftar.some((w) => w.kode) ? 38.5 : 34) + (r - 1) * 4; }, 0));
  const tinggi = (b: Blok) => (b.jenis === 'samping' ? tinggiSamping(b) : b.jenis === 'bagian' ? BAGIAN : JUDUL + (b.lanjut ? 0 : tinggiCatatan(b.catatan)) + tinggiBaris(b));
  const hal: { blok: Blok[]; pakai: number }[] = [];
  const halamanBaru = (b: (typeof potong)[number]) => {
    const blok: Blok[] = [];
    let pakai = 0;
    // Seri yang berlanjut ke halaman baru: judul serinya diulang dengan "lanjutan".
    if (b.jenis !== 'bagian' && b.seri) { blok.push({ jenis: 'bagian', judul: b.seri, lanjut: true, isi: [] }); pakai = BAGIAN + CELAH; }
    blok.push({ ...b } as Blok);
    hal.push({ blok, pakai: pakai + tinggi(b) });
  };
  // Halaman yang masih kebagian foto menyisakan ±62 mm untuknya (Rama: halaman lanjutan juga bergambar).
  const batas = (i: number) => (i < a.fotoSuasana.length ? TINGGI - 62 : TINGGI);
  potong.forEach((b, idx) => {
    const baris = tinggiBaris(b);
    const akhir = hal.at(-1);
    const sebelum = akhir?.blok.at(-1);
    const sambung = !!akhir && !!sebelum && sebelum.jenis === b.jenis && b.jenis !== 'bagian' && b.jenis !== 'samping' && sebelum.judul === b.judul;
    let tambah = sambung ? baris + 4 : CELAH + tinggi(b);
    // Judul seri tidak boleh sendirian di bawah halaman: harus muat bersama baris pertama sesudahnya.
    if (b.jenis === 'bagian' && potong[idx + 1]) tambah += CELAH + tinggi(potong[idx + 1]);
    // Jangan tinggalkan 1–2 ubin sendirian di halaman berikutnya: kelompok seperti itu pindah utuh.
    let yatim = false;
    if (akhir && b.jenis !== 'bagian' && b.jenis !== 'samping' && !b.lanjut) {
      const muat = Math.floor((batas(hal.length - 1) - akhir.pakai - CELAH - (tinggi(b) - baris) + 4) / (baris + 4));
      const sisa = b.total - muat * b.kolom;
      // ...kecuali halaman ini baru terisi kurang dari separuh: lebih baik dipecah daripada halaman kosong.
      yatim = muat >= 1 && sisa > 0 && sisa <= 2 && akhir.pakai > TINGGI / 2;
    }
    // Sisa 1–2 ubin terakhir sebuah kelompok boleh memakai ruang foto daripada pindah sendirian ke halaman baru.
    const ekor = sambung && b.jenis === 'warna' && b.isi.length <= 2 && !potong[idx + 1]?.lanjut;
    if (akhir && !yatim && akhir.pakai + tambah <= (ekor ? TINGGI : batas(hal.length - 1))) {
      if (sambung) (sebelum!.isi as unknown[]).push(...b.isi);
      else akhir.blok.push({ ...b } as Blok);
      akhir.pakai += sambung ? baris + 4 : CELAH + tinggi(b);
    } else halamanBaru(b);
  });
  // Foto suasana mengisi sisa tiap halaman (Rama: halaman lanjutan juga bergambar), pada rasio asli — tidak dipotong.
  // Sisa lebar ≥ 150 mm + tinggi cukup → selebar halaman dengan teks di atas; kalau tidak → foto di kiri, teks di kanan.
  // Foto dipasangkan dengan seri di halamannya (teks foto menyebut nama seri); foto milik seri lain tidak dipakai di sini.
  const kolam = [...a.fotoSuasana];
  const seriHal = hal.map((h) => h.blok.filter((b) => b.jenis === 'bagian').map((b) => b.judul));
  const sebut = (f: Foto, nama: string[]) => nama.some((n) => `${f.judul} ${f.sub ?? ''}`.includes(n));
  return hal.map((h, j) => {
    const L = TINGGI - h.pakai - CELAH;
    if (L < 40 || !kolam.length) return { blok: h.blok, foto: null };
    const lain = seriHal.filter((_, k) => k !== j).flat().filter((n) => !seriHal[j].includes(n));
    const f = kolam.find((x) => sebut(x, seriHal[j])) ?? kolam.find((x) => !sebut(x, lain)) ?? kolam[0];
    kolam.splice(kolam.indexOf(f), 1);
    const tinggiPenuh = 182 / f.rasio;
    if (L >= tinggiPenuh + 11) return { blok: h.blok, foto: { ...f, mode: 'penuh' as const, w: 182, h: tinggiPenuh } };
    const w = Math.min(122, L * f.rasio);
    return { blok: h.blok, foto: { ...f, mode: 'samping' as const, w, h: w / f.rasio } };
  });
};
const detail = halamanAtap.map(halamanDetail);

// Rangka baja ringan sudah punya halaman sendiri, jadi tidak diulang di aksesoris.
const aksDaftar = aksesoris.filter((a) => a.href !== '/produk/rangka-baja-ringan');
const aksHal: (typeof aksesoris)[] = [];
for (let i = 0; i < aksDaftar.length; i += 9) aksHal.push(aksDaftar.slice(i, i + 9));
const aksSrc = await Promise.all(aksesoris.map((a) => (a.foto ? src(a.foto.src, 700, 78) : Promise.resolve(null))));
const hargaAks = (a: (typeof aksesoris)[number]) => (a.harga ? `${a.harga.catatan === 'mulai' ? 'mulai ' : ''}${rp(a.harga.nilai)}` : 'Tanya admin');
const satuanAks = (a: (typeof aksesoris)[number]) => (a.harga ? `per ${a.harga.satuan}` : '');

// Nomor halaman dari susunan sebenarnya (plafon ikut sakelar TAMPIL_PLAFON, DECISIONS 052).
const urut: string[] = ['sampul', 'mitra', 'katalog'];
halamanAtap.forEach((_, i) => { urut.push(`merek-${i}`); detail[i].forEach((_, j) => urut.push(`detail-${i}-${j}`)); });
urut.push('perumahan');
if (TAMPIL_PLAFON) urut.push('plafon');
urut.push('rangka', ...aksHal.map((_, k) => `aks-${k}`), 'ketentuan-0', 'ketentuan-1', 'belakang');
const no = (k: string) => String(urut.indexOf(k) + 1).padStart(2, '0');
// Nama merek di halaman merek: kolom 74 mm, huruf diperkecil untuk nama panjang (lebar rata-rata ±0,56 em).
const ukuranNama = (s: string) => Math.min(42, Math.floor((74 / (s.length * 0.56)) * 2.835));

const IK = {
  telepon: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  situs: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  lokasi: '<path d="M12 21s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  perisai: '<path d="M12 3 5 6v6c0 4 3 7 7 9 4-2 7-5 7-9V6z"/><path d="m9 12 2 2 4-4"/>',
  pabrik: '<path d="M4 7h16v12H4z"/><path d="M8 7V4h8v3"/>',
  rumah: '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/>',
  palet: '<circle cx="12" cy="12" r="9"/><circle cx="8.5" cy="10" r="1.2"/><circle cx="12" cy="7.5" r="1.2"/><circle cx="15.5" cy="10" r="1.2"/>',
  centang: '<path d="m6 12 4 4 8-8"/>',
  strip: '<path d="M7 12h10"/>',
};
---

<Base title="Pricelist Atapura" description="Daftar harga atap bitumen, rangka baja ringan, dan aksesoris Atapura." noindex>
<main class="buku">

  <!-- 1. Sampul: satu foto bertakik, judul di langit, pil di takik -->
  <section class="hal s1">
    <svg class="bentuk" viewBox="0 0 210 297" aria-hidden="true">
      <defs><clipPath id="k-sampul"><path d="M28 14H182A14 14 0 0 1 196 28V194.5A7.5 7.5 0 0 1 188.5 202H132.5A12.5 12.5 0 0 0 120 214.5A7.5 7.5 0 0 1 112.5 222H28A14 14 0 0 1 14 208V28A14 14 0 0 1 28 14Z" /></clipPath></defs>
      <image href={sampulSrc} x="14" y="-12" width="182" height="271.3" preserveAspectRatio="xMidYMid slice" clip-path="url(#k-sampul)" />
    </svg>
    <img src="/brand/atapura-logo-putih.svg" alt="Atapura" class="abs logo-pdf" style="left:26mm;top:25mm;height:6.5mm" />
    <h1 class="abs s1-judul"><span class="redup">Daftar harga</span><span>atap bitumen {tahun}.</span></h1>
    <span class="abs pil pil-isi s1-pil">Supplier &amp; aplikator</span>
    <div class="abs s1-bawah"><h2><span class="redup">Atap yang masuk</span> AKAL.</h2><p>Harga genteng bitumen terpasang, dari survey sampai garansi.</p></div>
    <div class="abs s1-berlaku">Berlaku sejak<b>{tanggal}</b></div>
    <div class="bilah bilah-garis">
      <span><svg viewBox="0 0 24 24" class="ik" set:html={IK.telepon} />{waTampil}</span>
      <span><svg viewBox="0 0 24 24" class="ik" set:html={IK.situs} />{situs}</span>
    </div>
  </section>

  <!-- Mitra & material lengkap -->
  <section class="hal s10">
    <h2 class="abs s10-judul">Satu pintu, <span class="redup">dari genteng sampai rangka.</span></h2>
    <p class="abs s10-sub">Material dari merek yang kami pasok dan pasang sendiri, lengkap dengan aksesorisnya.</p>
    <img src={materialSrc} alt="" class="abs s10-foto" />
    <div class="abs s10-daftar">
      {MITRA.map((m) => (
        <div class="s10-baris">
          <h3>{m.kelompok}</h3>
          <ul>{m.isi.map((n) => <li class:list={[{ gelap: LOGO_GELAP.has(n) }]}>{logoSrc[n] ? <img src={logoSrc[n]} alt={n} /> : <span>{n}</span>}</li>)}</ul>
        </div>
      ))}
    </div>
    <div class="bilah bilah-garis"><span>Merek mitra</span><span>{no('mitra')}</span></div>
  </section>

  <!-- 2. Katalog ringkas (pola 19): kepala Pinus, daftar merek, satu merek sorotan -->
  <section class="hal s2">
    <svg class="bentuk" viewBox="0 0 210 297" aria-hidden="true"><path d="M0 0H210V80Q210 92 198 92H0Z" fill="#10231E" /></svg>
    <div class="abs s2-kepala"><h2><span class="redup-terang">Katalog</span><br />atap bitumen</h2><p>Harga per m². Terpasang sudah termasuk material pendukung dan jasa pasang.</p></div>
    <span class="abs pil pil-garis s2-pil">Pricelist {tahun}</span>
    <div class="abs s2-daftar">
      {barisKatalog.map((a) => (
        <div class="s2-baris">
          <img src={a.fotoSrc} alt="" />
          <div>
            <h3>{a.merek}<span>{a.asal}</span></h3>
            <div class="s2-baris-bawah">
              <span class="titik">{a.titik.slice(0, 4).map((h) => <i style={`background:${h}`} />)}</span>
              <span class="pil pil-isi">Rp{ribu(a.m.terpasang[0])}–{ribu(a.m.terpasang[1])} rb</span>
            </div>
            <p class="s2-gs">Genteng saja {a.mulai < a.m.genteng ? 'mulai ' : ''}{rp(a.mulai)} · {a.totalWarna} warna</p>
          </div>
        </div>
      ))}
    </div>
    <div class="abs s2-unggul">
      <img src={unggul.fotoSrc} alt="" />
      <h3>{unggul.merek}</h3>
      <p class="s2-asal">Buatan {unggul.asal} · {seriUnggul}</p>
      <div class="s2-wt"><span>Warna tersedia<br />{unggul.totalWarna} pilihan</span><span class="titik">{unggul.titik.map((h) => <i style={`background:${h}`} />)}</span></div>
      <div class="s2-harga"><span>Terpasang /m²</span><b>Rp{ribu(unggul.m.terpasang[0])}–{ribu(unggul.m.terpasang[1])} rb</b></div>
      <p class="s2-asal" style="margin-top:2.5mm">Genteng saja mulai {rp(unggul.mulai)}</p>
    </div>
    <div class="abs s2-bintang"><svg viewBox="0 0 100 100" aria-hidden="true"><polygon fill="#C6F24E" points="50,2 61,16 78,9 80,27 97,32 88,48 97,64 80,70 78,88 61,82 50,97 39,82 22,88 20,70 3,64 12,48 3,32 20,27 22,9 39,16" /></svg><span>Dari<br />{unggul.asal}</span></div>
    <div class="abs s2-dua">
      <div class="s2-kecil"><img src={rangkaSrc} alt="" /><div><h3>Rangka baja ringan</h3><p>{rangka.map((r) => r.nama).join(', ')}</p><span class="pil pil-isi">mulai Rp{ribu(rangkaMulai)} rb</span></div></div>
      <div class="s2-kecil">{aksSrc[0] && <img src={aksSrc[0]} alt="" />}<div><h3>Aksesoris</h3><p>Alas, lapis kedap, flashing</p><span class="pil pil-isi">Halaman {no('aks-0')}</span></div></div>
    </div>
    <div class="bilah bilah-pil">
      <span><svg viewBox="0 0 24 24" class="ik" set:html={IK.lokasi} />{bisnis.alamat.kecamatan}, {bisnis.alamat.kota}</span>
      <span><svg viewBox="0 0 24 24" class="ik" set:html={IK.telepon} />{waTampil}</span>
      <span><svg viewBox="0 0 24 24" class="ik" set:html={IK.situs} />{situs}</span>
    </div>
  </section>

  {halamanAtap.map((a, i) => (
    <>
      <!-- Halaman merek (pola 25 + 12) -->
      <section class="hal s3">
        <svg class="bentuk" viewBox="0 0 210 297" aria-hidden="true">
          <defs>
            <clipPath id={`k-foto-${i}`}><path d="M38.5 26H106Q110 26 110 30V148Q110 152 106 152H24Q20 152 20 148V44.5Z" /></clipPath>
            <clipPath id={`k-tekstur-${i}`}><rect x="14" y="166" width="58" height="72" rx="10" /></clipPath>
          </defs>
          <path d="M36 20H186Q196 20 196 30V170L178 188Q174 192 168 192H24Q14 192 14 182V42Z" fill="#F2F4F1" stroke="#F2F4F1" stroke-width="5" stroke-linejoin="round" />
          <image href={a.fotoSrc} x="20" y="26" width="90" height="126" preserveAspectRatio="xMidYMid slice" clip-path={`url(#k-foto-${i})`} />
          <image href={a.teksturSrc} x="14" y="166" width="58" height="72" preserveAspectRatio="xMidYMid slice" clip-path={`url(#k-tekstur-${i})`} />
        </svg>
        <img src="/brand/atapura-logo-putih.svg" alt="Atapura" class="abs logo-pdf" style="left:16mm;top:7mm;height:6mm" />
        <div class="abs s3-nama"><h2 style={`font-size:${ukuranNama(a.merek)}pt`}>{a.merek}<span>dari {a.asal}.</span></h2><p>{a.deskripsi}</p></div>
        <div class="abs s3-takik"><p>Genteng saja{a.mulai < a.m.genteng ? ', mulai' : ''}</p><b>{rp(a.mulai)} <small>/m²</small></b><p class="s3-bundel">Isi bundel {m2(a.m.m2PerBundel)}</p></div>
        <div class="abs s3-warna">{a.titik.length > 0 && <span class="titik">{a.titik.map((h) => <i style={`background:${h}`} />)}</span>}<span><b>{a.totalWarna} warna</b><br />lihat di halaman berikut</span></div>
        <div class="abs s3-harga"><p>Terpasang, per m²{a.acuan ? ` (${a.acuan})` : ''}</p><b><span class="rp">Rp</span>{ribu(a.m.terpasang[0])}–{ribu(a.m.terpasang[1])}<sup>rb</sup></b></div>
        <div class="abs s3-ikon">
          {bisnis.garansiPemasanganTahun && <div><i><svg viewBox="0 0 24 24" class="ik" set:html={IK.perisai} /></i><span><b>{bisnis.garansiPemasanganTahun} tahun</b><small>garansi pemasangan</small></span></div>}
          {a.pabrik ? (
            <div><i><svg viewBox="0 0 24 24" class="ik" set:html={IK.pabrik} /></i><span><b>{a.pabrik}</b><small>garansi pabrik</small></span></div>
          ) : (
            <div><i><svg viewBox="0 0 24 24" class="ik" set:html={IK.palet} /></i><span><b>{a.totalWarna} warna</b><small>pilihan warna</small></span></div>
          )}
          <div><i><svg viewBox="0 0 24 24" class="ik" set:html={IK.rumah} /></i><span><b>±Rp{juta(a.m.terpasang[0] * 100)}–{juta(a.m.terpasang[1] * 100)} juta</b><small>atap 100 m², terpasang</small></span></div>
        </div>
        <div class="bilah bilah-terang"><span>Atap bitumen {a.merek}</span><span>{no(`merek-${i}`)}</span></div>
      </section>

      <!-- Motif & warna, langsung sesudah merek (Rama) -->
      {detail[i].map((h, j) => (
        <section class="hal s4">
          <h2 class="abs s4-judul">{a.merek} <span class="redup">motif dan warna{j > 0 ? ', lanjutan' : ''}</span></h2>
          <div class="abs s4-isi">
            {h.blok.map((b) => b.jenis === 'bagian' ? (
              <h3 class="s4-bagian">{b.judul}{b.lanjut && <span class="redup">, lanjutan</span>}</h3>
            ) : b.jenis === 'samping' ? (
              <div class="s4-samping">
                <div class="s4-blok">
                  <h3>Motif</h3>
                  <ul class="s4-motif s4-motif-1">{b.isi.map((x) => <li><Bulat w={{ nama: x.nama, foto: x.foto }} besar /><p class="s4-nama">{x.nama}</p>{x.harga && <p class="s4-sub">{x.harga}</p>}</li>)}</ul>
                </div>
                <div class="s4-kanan">
                  {b.warna.map((g) => (
                    <div class="s4-blok">
                      <h3>{g.judul}</h3>
                      {g.catatan && <p class="s4-catatan">{g.catatan}</p>}
                      <ul class="s4-warna s4-warna-3">{g.daftar.map((w) => <li><Bulat w={w} besar /><p class="s4-nama">{w.nama}</p>{w.kode && <p class="s4-sub">{w.kode}</p>}</li>)}</ul>
                    </div>
                  ))}
                </div>
              </div>
            ) : (
              <div class="s4-blok">
                <h3>{b.judul}{b.lanjut && <span class="redup">, lanjutan</span>}</h3>
                {b.catatan && !b.lanjut && <p class="s4-catatan">{b.catatan}</p>}
                {b.jenis === 'motif' ? (
                  <ul class="s4-motif">
                    {b.isi.map((x) => (
                      <li><Bulat w={{ nama: x.nama, foto: x.foto }} besar /><p class="s4-nama">{x.nama}</p>{x.harga && <p class="s4-sub">{x.harga}</p>}</li>
                    ))}
                  </ul>
                ) : (
                  <ul class="s4-warna">
                    {b.isi.map((w) => <li><Bulat w={w} besar /><p class="s4-nama">{w.nama}</p>{w.kode && <p class="s4-sub">{w.kode}</p>}</li>)}
                  </ul>
                )}
              </div>
            ))}
            {h.foto && (
              <div class:list={['s4-foto', `s4-foto-${h.foto.mode}`]}>
                <img src={h.foto.src} alt="" style={`width:${h.foto.w.toFixed(1)}mm;height:${h.foto.h.toFixed(1)}mm`} />
                <p><b>{h.foto.judul}</b>{h.foto.sub && <span>{h.foto.sub}</span>}</p>
              </div>
            )}
          </div>
          <div class="bilah bilah-garis"><span>Motif dan warna {a.merek}</span><span>{no(`detail-${i}-${j}`)}</span></div>
        </section>
      ))}
    </>
  ))}

  <!-- Perumahan: satu foto besar, judul di langit -->
  <section class="hal s5">
    <svg class="bentuk" viewBox="0 0 210 297" aria-hidden="true">
      <defs><clipPath id="k-perumahan"><rect x="14" y="66" width="182" height="217" rx="14" /></clipPath></defs>
      <image href={perumahanSrc} x="14" y="66" width="182" height="217" preserveAspectRatio="xMidYMid slice" clip-path="url(#k-perumahan)" />
    </svg>
    <h2 class="abs s5-judul"><span class="redup">Satu kawasan,</span><span>satu atap.</span></h2>
    <p class="abs s5-sub">Untuk developer, cluster, dan proyek: dipasang per bagian dengan jadwal kerja tertulis.</p>
  </section>

  {TAMPIL_PLAFON && (
    <section class="hal s6">
      <h2 class="abs s6-judul">Plafon PVC <span class="redup">termasuk rangka hollow dan pasang.</span></h2>
      <div class="abs s6-daftar">
        {plafon.map((x) => (
          <div class="s6-baris"><h3>{x.nama}</h3><span class="pil pil-isi">Rp{ribu(x.h.terpasang[0])}–{ribu(x.h.terpasang[1])} rb / m²</span></div>
        ))}
      </div>
      <div class="bilah bilah-garis"><span>Plafon PVC</span><span>{no('plafon')}</span></div>
    </section>
  )}

  <!-- Rangka baja ringan -->
  <section class="hal s6">
    <svg class="bentuk" viewBox="0 0 210 297" aria-hidden="true">
      <defs><clipPath id="k-rangka"><rect x="14" y="14" width="182" height="121" rx="14" /></clipPath></defs>
      <image href={rangkaSrc} x="14" y="14" width="182" height="121" preserveAspectRatio="xMidYMid slice" clip-path="url(#k-rangka)" />
    </svg>
    <h2 class="abs s6-judul" style="top:150mm">Rangka baja ringan <span class="redup">sudah dengan pasang.</span></h2>
    <div class="abs s6-daftar" style="top:172mm">
      {rangka.map((r) => (
        <div class="s6-baris"><div><h3>{r.nama}</h3><p>{r.spek}</p></div><span class="pil pil-isi">Rp{ribu(r.harga)} rb / m²</span></div>
      ))}
      <div class="s6-baris"><div><h3>Jasa pasang saja</h3><p>Material dari Anda</p></div><span class="pil pil-garis">Rp{ribu(harga.rangka.jasaSaja)} rb / m²</span></div>
    </div>
    <div class="bilah bilah-garis"><span>Rangka baja ringan{bisnis.garansiPemasanganTahun ? `, garansi pemasangan ${bisnis.garansiPemasanganTahun} tahun` : ''}</span><span>{no('rangka')}</span></div>
  </section>

  <!-- Aksesoris: grid katalog 3 × 3 -->
  {aksHal.map((daftar, k) => (
    <section class="hal s7">
      <h2 class="abs s7-judul">Aksesoris <span class="redup">{k > 0 ? 'lanjutan' : 'dan material pendukung.'}</span></h2>
      {k === 0 && <p class="abs s7-lead">Sudah termasuk di harga terpasang. Harga di bawah untuk membeli material saja.</p>}
      <ul class="abs s7-grid">
        {daftar.map((a) => (
          <li>
            {aksSrc[aksesoris.indexOf(a)] && <img src={aksSrc[aksesoris.indexOf(a)]!} alt="" />}
            <h3>{a.nama}</h3>
            <p>{a.spek[0].nilai}</p>
            <span class="pil pil-isi">{hargaAks(a)}<small>{satuanAks(a)}</small></span>
          </li>
        ))}
      </ul>
      <div class="bilah bilah-garis"><span>Aksesoris</span><span>{no(`aks-${k}`)}</span></div>
    </section>
  ))}

  <!-- Ketentuan 1: termasuk / belum termasuk + cara bayar -->
  <section class="hal s8">
    <h2 class="abs s8-judul">Yang Anda bayar, <span class="redup">tertulis dari awal.</span></h2>
    <div class="abs s8-dua">
      <div><h3>Sudah termasuk</h3><ul class="s8-daftar">{harga.termasuk.map((t) => <li><i><svg viewBox="0 0 24 24" class="ik" set:html={IK.centang} /></i>{t}</li>)}</ul></div>
      <div><h3>Belum termasuk</h3><ul class="s8-daftar s8-belum">{harga.tidakTermasuk.map((t) => <li><i><svg viewBox="0 0 24 24" class="ik" set:html={IK.strip} /></i>{t}</li>)}</ul></div>
    </div>
    <div class="abs s8-bawah">
      <h3>Cara bayar</h3>
      <p class="s8-material"><b>Material</b>{bisnis.pembayaran.material}</p>
      <ol class="s8-termin">
        {bisnis.pembayaran.jasa.map((j) => <li><b>{j.persen}%</b><span>{j.tahap} jasa pasang</span><small>{j.saat}</small></li>)}
      </ol>
    </div>
    <div class="bilah bilah-garis"><span>Ketentuan</span><span>{no('ketentuan-0')}</span></div>
  </section>

  <!-- Ketentuan 2: garansi + survey -->
  <section class="hal s8">
    <h2 class="abs s8-judul">Garansi pemasangan <span class="redup">{bisnis.garansiPemasanganTahun} tahun.</span></h2>
    <div class="abs s8-dua">
      <div><h3>Ditanggung</h3><ul class="s8-daftar">{bisnis.garansi.cakupan.map((t) => <li><i><svg viewBox="0 0 24 24" class="ik" set:html={IK.centang} /></i>{t}</li>)}</ul></div>
      <div><h3>Tidak ditanggung</h3><ul class="s8-daftar s8-belum">{bisnis.garansi.pengecualian.map((t) => <li><i><svg viewBox="0 0 24 24" class="ik" set:html={IK.strip} /></i>{t}</li>)}</ul></div>
    </div>
    <div class="abs s8-bawah">
      <h3>Cara klaim</h3>
      <ol class="s8-klaim">{bisnis.garansi.klaim.map((k, n) => <li><b>{n + 1}</b><span>{k.nama}</span><small>{k.isi}</small></li>)}</ol>
      <h3 style="margin-top:9mm">Survey</h3>
      <p class="s8-survey">Jadwal survey diatur bersama admin. Di luar Jabodetabek ada biaya akomodasi tukang dan pengiriman material, dihitung sesuai lokasi.</p>
    </div>
    <div class="bilah bilah-garis"><span>Ketentuan</span><span>{no('ketentuan-1')}</span></div>
  </section>

  <!-- Sampul belakang -->
  <section class="hal s9">
    <img src="/brand/atapura-logo-putih.svg" alt="Atapura" class="abs logo-pdf" style="left:14mm;top:20mm;height:8mm" />
