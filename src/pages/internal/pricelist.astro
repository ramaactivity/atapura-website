---
// Pricelist A4 untuk pelanggan (DECISIONS 051). Halaman ini sumber PDF: `node tools/pricelist/render.mjs`.
// Semua angka dibaca dari harga.ts / produk.ts / aksesoris.ts / bisnis.ts — jangan ketik harga di sini.
// Foto: ilustrasi Magnific (pricelist-*.jpg), selalu berlabel ilustrasi, bukan proyek Atapura.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import Bulat from '../../components/BulatWarna.astro';
import { harga, type Merek } from '../../data/harga';
import { produk, fotoWarna } from '../../data/produk';
import { aksesoris } from '../../data/aksesoris';
import { bisnis, TAMPIL_PLAFON } from '../../data/bisnis';
import qr from '../../../assets/gambar/pricelist-qr-wa.svg?raw';
import fSampul from '../../../assets/gambar/magnific/pricelist-sampul.jpg';
import fJavabitumen from '../../../assets/gambar/magnific/pricelist-javabitumen.jpg';
import fMaxxi from '../../../assets/gambar/magnific/pricelist-maxxi.jpg';
import fCti from '../../../assets/gambar/magnific/pricelist-cti.jpg';
import fVictory from '../../../assets/gambar/magnific/pricelist-victory.jpg';
import fTegola from '../../../assets/gambar/magnific/pricelist-tegola.jpg';
import fShunda from '../../../assets/gambar/magnific/pricelist-plafon-shunda.jpg';
import fJavafon from '../../../assets/gambar/magnific/pricelist-plafon-javafon.jpg';
import fRangka from '../../../assets/gambar/magnific/pricelist-rangka.jpg';
import fPerumahan from '../../../assets/gambar/magnific/pricelist-perumahan.jpg';
// Foto suasana kedua dibuat sesuai rasio ruang kosong halaman motif & warna, supaya atap tidak terpotong (Rama).
import h2Java from '../../../assets/gambar/magnific/pricelist-hero2-javabitumen.jpg';
import h2Maxxi from '../../../assets/gambar/magnific/pricelist-hero2-maxxi.jpg';
import h2Cti from '../../../assets/gambar/magnific/pricelist-hero2-cti.jpg';
import h2Victory from '../../../assets/gambar/magnific/pricelist-hero2-victory.jpg';
import mEcoRect from '../../../assets/gambar/seri/tegola-eco-roof-rectangular.jpg';
import mEcoTrad from '../../../assets/gambar/seri/tegola-eco-roof-traditional.jpg';
import mEcoHex from '../../../assets/gambar/seri/tegola-eco-roof-hexagonal.jpg';
import mTop from '../../../assets/gambar/seri/tegola-top-shingles-rectangular.jpg';

const rp = (n: number) => `Rp${n.toLocaleString('id-ID')}`;
const rentang = ([a, b]: readonly [number, number]) => (a === b ? rp(a) : `${rp(a)}–${b.toLocaleString('id-ID')}`);
const m2 = (n: number) => `${n.toLocaleString('id-ID', { minimumFractionDigits: 1, maximumFractionDigits: 2 })} m²`;
const juta = (n: number) => (n / 1_000_000).toLocaleString('id-ID', { maximumFractionDigits: 1 });
const tanggal = new Date(`${harga.berlakuSejak}T00:00:00+07:00`).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' });
const waTampil = bisnis.whatsapp ? `+${bisnis.whatsapp.slice(0, 2)} ${bisnis.whatsapp.slice(2, 5)}-${bisnis.whatsapp.slice(5, 9)}-${bisnis.whatsapp.slice(9)}` : '';

// Urut dari harga genteng terendah; foto & kalimat pembuka per merek.
// Pricelist menyebut negara asal, bukan kelas harga (Rama, 19 Nov 2026). `deskripsi` mengganti ringkas produk.ts
// bila kalimatnya memuat narasi kelas. `acuan` = seri yang dipakai untuk harga terpasang merek itu.
// `motif` = close-up motif tambahan yang tidak punya baris seri sendiri (mis. tiga potongan Eco Roof).
const ATAP: { merek: Merek; slug: string; foto: ImageMetadata; suasana: string; asal: string; deskripsi?: string; acuan?: string; hero2?: { foto: ImageMetadata; ket: string; judul: string; sub: string; posisi: 'atas' | 'bawah' | 'tengah' }; motif?: { nama: string; foto: ImageMetadata }[] }[] = [
  { merek: 'Javabitumen', slug: 'javabitumen', foto: fJavabitumen, suasana: 'Rumah tinggal di perumahan, sore hari', asal: 'Tiongkok', hero2: { foto: h2Java, ket: 'Rumah tinggal beratap Javabitumen', judul: '20 warna.', sub: 'Pilihan paling banyak di antara merek kami.', posisi: 'atas' }, deskripsi: 'Genteng aspal Javabitumen buatan Tiongkok, dengan pilihan warna solid dan gradasi yang paling banyak di antara merek kami.' },
  { merek: 'Maxxi', slug: 'maxxi', foto: fMaxxi, suasana: 'Rumah keluarga selepas hujan', asal: 'Tiongkok', hero2: { foto: h2Maxxi, ket: 'Maxxi pada rumah satu lantai', judul: 'Sampai 30 tahun.', sub: 'Garansi pabrik Promaxxi, 25 tahun untuk Maxxiroof.', posisi: 'bawah' } },
  { merek: 'CTI', slug: 'cti', foto: fCti, suasana: 'Rumah satu lantai, cahaya sore', asal: 'Indonesia', hero2: { foto: h2Cti, ket: 'CT3 pada kafe', judul: 'Buatan Indonesia.', sub: '3-tab, tak beraturan, atau segi enam.', posisi: 'tengah' } },
  { merek: 'Victory', slug: 'victory', foto: fVictory, suasana: 'Penginapan di dataran tinggi', asal: 'USA', hero2: { foto: h2Victory, ket: 'Victory Two Tone pada rumah dua lantai', judul: 'Dua nada.', sub: 'Two Tone memberi dimensi di tiap lidah genteng.', posisi: 'atas' } },
  { merek: 'Tegola', slug: 'tegola', foto: fTegola, suasana: 'Villa di perbukitan Puncak', asal: 'Italia', acuan: 'Premium Rectangular', motif: [
    { nama: 'Eco Roof Rectangular', foto: mEcoRect },
    { nama: 'Eco Roof Traditional', foto: mEcoTrad },
    { nama: 'Eco Roof Hexagonal', foto: mEcoHex },
    { nama: 'Top Shingles Rectangular', foto: mTop },
  ] },
];
/** "±Rp315–350 ribu per m²" → teks rupiah lengkap + angka terendah. */
const hargaSeri = (t?: string) => {
  if (!t) return null;
  const n = [...t.matchAll(/(\d+) ribu|(\d+)–/g)].map((m) => Number(m[1] ?? m[2]) * 1000);
  return { teks: t.replace(/(\d+)–(\d+) ribu per m²/, '$1.000–$2.000 / m²').replace(/(\d+) ribu per m²/, '$1.000 / m²'), min: Math.min(...n) };
};
const halamanAtap = ATAP.map((a) => {
  const p = produk.find((x) => x.slug === a.slug)!;
  const m = harga.merek[a.merek];
  // Semua warna per kelompok seri, lengkap (contoh foto bila ada, kalau tidak bulatan warna perkiraan layar).
  const warna = p.warna.map((g) => ({ judul: g.judul, catatan: g.catatan, daftar: g.daftar.map((w) => ({ ...w, foto: fotoWarna(g.tekstur, w.nama) })) }));
  const totalWarna = warna.reduce((n, g) => n + g.daftar.length, 0);
  const seri = p.seri.map((s) => ({ nama: s.nama, ringkas: s.ringkas, harga: hargaSeri(s.spek.find((k) => k.label === 'Genteng saja')?.nilai), motif: s.spek.find((k) => k.label === 'Motif')?.nilai }));
  const mulai = Math.min(m.genteng, ...seri.map((x) => x.harga?.min ?? Infinity));
  // Motif: close-up tiap seri yang punya foto, lalu motif tambahan dari ATAP.
  const motif = [...(a.motif ?? []), ...p.seri.filter((x) => x.foto && !(a.motif ?? []).some((m) => m.foto.src === x.foto!.src)).map((x) => ({ nama: x.nama, foto: x.foto! }))];
  return { ...a, p, m, warna, totalWarna, seri, mulai, motif };
});
const plafon = (['Shunda', 'Javafon'] as const).map((nama) => ({
  nama,
  p: produk.find((x) => x.slug === nama.toLowerCase())!,
  h: harga.plafon.merek[nama],
  foto: nama === 'Shunda' ? fShunda : fJavafon,
}));
// Nomor halaman: plafon ikut sakelar TAMPIL_PLAFON (DECISIONS 052), jadi nomor sesudahnya bergeser otomatis.
const dua = (n: number) => String(n).padStart(2, '0');
// Tiap merek dua halaman: halaman merek lalu halaman motif & warnanya (Rama: jangan dipisah dari produknya).
const noMerek = (i: number) => 3 + i * 2;
const noPerumahan = 3 + halamanAtap.length * 2;
const noPlafon = noPerumahan + 1;
const noRangka = noPlafon + (TAMPIL_PLAFON ? 1 : 0);
const rangka = Object.entries(harga.rangka.merek).map(([nama, r]) => ({ nama, ...r }));
const hargaAks = (a: (typeof aksesoris)[number]) => (a.harga ? `${a.harga.catatan === 'mulai' ? 'mulai ' : ''}${rp(a.harga.nilai)}` : 'Tanya admin');
const satuanAks = (a: (typeof aksesoris)[number]) => (a.harga ? `/ ${a.harga.satuan}${a.harga.catatan && a.harga.catatan !== 'mulai' ? ` · ${a.harga.catatan}` : ''}` : '');
---

<Base title="Pricelist Atapura" description="Daftar harga atap bitumen, plafon PVC, rangka baja ringan, dan aksesoris Atapura untuk Jabodetabek." noindex>
<main class="buku">

  <!-- 1 · Sampul -->
  <section class="hal sampul">
    <Image src={fSampul} alt="" widths={[1600]} sizes="210mm" class="latar" loading="eager" />
    <div class="sampul-redup"></div>
    <header class="sampul-atas">
      <Logo tinggi="9mm" class="logo-terang" />
      <span class="label-terang">Pricelist · Jabodetabek</span>
    </header>
    <div class="sampul-bawah">
      <p class="label-terang">{TAMPIL_PLAFON ? 'Atap bitumen · Plafon PVC · Rangka baja ringan' : 'Atap bitumen · Rangka baja ringan · Aksesoris'}</p>
      <h1 class="sampul-judul">Atap yang<br />masuk AKAL.</h1>
      <p class="sampul-sub">Daftar harga lengkap, dari genteng sampai paku. Berlaku sejak {tanggal}.</p>
    </div>
    <p class="ilustrasi ilustrasi-terang">Ilustrasi suasana, bukan proyek Atapura.</p>
  </section>

  <!-- 2 · Ringkasan harga -->
  <section class="hal kertas">
    <div class="isi">
      <p class="label">Ringkasan harga</p>
      <h2 class="judul">Semua harga<br /><span class="redup">di satu halaman.</span></h2>
      <p class="pengantar">Harga <b>genteng saja</b> untuk pembelian material. Harga <b>terpasang</b> sudah termasuk papan alas, lapis kedap, flashing, paku, skrup, jasa pasang, dan ongkos kirim di Jabodetabek.</p>

      <table class="tabel">
        <thead><tr><th>Atap bitumen</th><th>Asal</th><th class="kanan">Genteng saja / m²</th><th class="kanan">Terpasang / m²</th><th class="kanan">Isi bundel</th></tr></thead>
        <tbody>
          {halamanAtap.map((a) => (
            <tr><td class="merek">{a.merek}</td><td>{a.asal}</td><td class="kanan angka">{a.mulai < a.m.genteng ? `mulai ${rp(a.mulai)}` : rp(a.m.genteng)}</td><td class="kanan angka kuat">{rentang(a.m.terpasang)}</td><td class="kanan angka">{m2(a.m.m2PerBundel)}</td></tr>
          ))}
        </tbody>
      </table>

      <div class:list={[{ dua: TAMPIL_PLAFON }]}>
        {TAMPIL_PLAFON && (
        <table class="tabel">
          <thead><tr><th>Plafon PVC</th><th class="kanan">Terpasang / m²</th></tr></thead>
          <tbody>{plafon.map((x) => <tr><td class="merek">{x.nama}</td><td class="kanan angka kuat">{rentang(x.h.terpasang)}</td></tr>)}</tbody>
        </table>
        )}
        <table class="tabel">
          <thead><tr><th>Rangka baja ringan</th><th class="kanan">Terpasang / m²</th></tr></thead>
          <tbody>
            {rangka.map((r) => <tr><td class="merek">{r.nama}</td><td class="kanan angka kuat">{rp(r.harga)}</td></tr>)}
          </tbody>
        </table>
      </div>

      <table class="tabel">
        <thead><tr><th>Jasa saja (material dari Anda)</th><th class="kanan">Per m²</th></tr></thead>
        <tbody>
          <tr><td class="merek">Jasa pasang atap bitumen</td><td class="kanan angka kuat">{rentang(harga.jasa)}</td></tr>
          <tr><td class="merek">Jasa pasang rangka baja ringan</td><td class="kanan angka kuat">{rp(harga.rangka.jasaSaja)}</td></tr>
        </tbody>
      </table>
      <p class="catatan">Harga untuk Jabodetabek. Rentang terpasang bergantung pada bentuk atap dan pilihan material pendukung{halamanAtap.filter((a) => a.acuan).map((a) => `; terpasang ${a.merek} dihitung untuk seri ${a.acuan}`).join('')}. Angka pasti tertulis di penawaran setelah survey gratis.</p>
    </div>
    <footer class="kaki"><span>Atapura · Pricelist {tanggal}</span><span>02</span></footer>
  </section>

  <!-- 3–7 · Satu halaman per merek atap -->
  {halamanAtap.map((a, i) => (
    <section class="hal kertas">
      <div class="foto-atas">
        <Image loading="eager" format="jpg" quality={78} src={a.foto} alt={`Ilustrasi atap bitumen ${a.merek} terpasang: ${a.suasana.toLowerCase()}`} widths={[1600]} sizes="210mm" class="latar" />
        <div class="foto-redup"></div>
        <div class="foto-teks">
          <p class="label-terang">Atap bitumen · Buatan {a.asal}</p>
          <h2 class="merek-besar">{a.merek}</h2>
        </div>
        <p class="ilustrasi ilustrasi-terang">{a.suasana}. Ilustrasi, bukan proyek Atapura.</p>
      </div>
      <div class="isi merek-isi">
        <div class="merek-kiri">
          <p class="ringkas">{a.deskripsi ?? a.p.ringkas}</p>
          {a.seri.length > 0 && (
            <ul class:list={["seri", { "seri-padat": a.seri.length >= 4 }]}>
              {a.seri.map((s) => (
                <li><b>{s.nama}</b>{s.harga && <span class="seri-harga">{s.harga.teks}</span>}<span class="seri-ringkas">{s.motif ? `Motif ${s.motif}. ` : ''}{s.ringkas}</span></li>
              ))}
            </ul>
          )}
          {a.totalWarna > 0 && <p class="label warna-lanjut">{a.motif.length > 0 ? `${a.motif.length} motif · ` : ''}{a.totalWarna} pilihan warna · di halaman berikutnya</p>}
        </div>
        <aside class="slip">
          <p class="slip-label">Genteng saja{a.mulai < a.m.genteng && ', mulai'}</p>
          <p class="slip-harga"><span class="rp">Rp</span>{a.mulai.toLocaleString('id-ID')}<span class="per">/ m²</span></p>
          <dl>
            <div><dt>Terpasang, spek standar{a.acuan && ` · ${a.acuan}`}</dt><dd>{rentang(a.m.terpasang)} / m²</dd></div>
            <div><dt>Contoh atap 100 m²</dt><dd>±Rp{juta(a.m.terpasang[0] * 100)}–{juta(a.m.terpasang[1] * 100)} juta</dd></div>
            <div><dt>Isi per bundel{a.acuan && ` · ${a.acuan}`}</dt><dd>{m2(a.m.m2PerBundel)}</dd></div>
            <div><dt>Garansi pabrik</dt><dd>{a.m.garansiPabrik}</dd></div>
            <div><dt>Garansi pemasangan</dt><dd>{bisnis.garansiPemasanganTahun} tahun dari Atapura</dd></div>
          </dl>
        </aside>
      </div>
      <footer class="kaki"><span>Atap bitumen {a.merek}</span><span>{dua(noMerek(i))}</span></footer>
    </section>
    <section class:list={['hal kertas', { padat: a.motif.length >= 4 }]}>
      <div class="isi isi-penuh">
        <p class="label">Atap bitumen {a.merek} · Buatan {a.asal}</p>
        <h2 class="judul">Motif &amp; warna<br /><span class="redup">{a.merek}.</span></h2>
        {a.motif.length > 0 && (
          <div class="kat-grup">
            <p class="label">Motif</p>
            <ul class:list={['motif', { 'motif-4': a.motif.length >= 4 }]}>
              {a.motif.map((x) => <li><Image loading="eager" format="jpg" quality={85} src={x.foto} alt={`Close-up motif ${a.merek} ${x.nama}`} widths={[640]} sizes="45mm" class="motif-foto" /><span>{x.nama}</span></li>)}
            </ul>
          </div>
        )}
        <div class="kat">
          {a.warna.map((g) => (
            <div class="kat-grup">
              <p class="label">{g.judul}</p>
              {g.catatan && <p class="kat-catatan">{g.catatan}</p>}
              <ul class="kat-warna">
                {g.daftar.map((w) => <li><Bulat w={w} besar /><span>{w.nama}{w.kode && <em>{w.kode}</em>}</span></li>)}
              </ul>
            </div>
          ))}
        </div>
        <p class="catatan">Warna di layar dan kertas adalah perkiraan. Saat survey kami membawa sampel fisik supaya Anda bisa melihatnya di bawah cahaya rumah sendiri. Foto motif adalah ilustrasi bentuk setelah terpasang.</p>
        {a.hero2 && (
          <figure class:list={['hero2', `hero-${a.hero2.posisi}`]}>
            <Image loading="eager" format="jpg" quality={80} src={a.hero2.foto} alt={`Ilustrasi ${a.hero2.ket.toLowerCase()}`} widths={[1600]} sizes="180mm" class="latar" />
            <div class="hero-teks"><p class="hero-judul">{a.hero2.judul}</p><p class="hero-sub">{a.hero2.sub}</p></div>
            <figcaption>{a.hero2.ket}. Ilustrasi, bukan proyek Atapura.</figcaption>
          </figure>
        )}
      </div>
      <footer class="kaki"><span>Motif &amp; warna {a.merek}</span><span>{dua(noMerek(i) + 1)}</span></footer>
    </section>
  ))}

  <!-- Perumahan & proyek: foto drone satu kawasan beratap sama -->
  <section class="hal sampul perumahan">
    <Image loading="eager" format="jpg" quality={80} src={fPerumahan} alt="Ilustrasi foto drone perumahan di perbukitan dengan deretan rumah beratap bitumen yang sama" widths={[1600]} sizes="210mm" class="latar" />
    <div class="perumahan-redup"></div>
    <div class="perumahan-teks">
      <p class="label-terang">Perumahan · Cluster · Proyek</p>
      <h2 class="perumahan-judul">Satu kawasan,<br />satu atap.</h2>
      <p class="sampul-sub">Untuk developer, cluster, dan proyek, kami pasang per bagian dengan jadwal kerja tertulis. Harga untuk volume besar kami hitung bersama Anda.</p>
    </div>
    <p class="ilustrasi ilustrasi-terang">Ilustrasi suasana, bukan proyek Atapura.</p>
    <footer class="kaki kaki-terang"><span>Perumahan &amp; proyek</span><span>{dua(noPerumahan)}</span></footer>
  </section>

  <!-- Plafon (disembunyikan selama TAMPIL_PLAFON false) -->
  {TAMPIL_PLAFON && <section class="hal kertas">
    {plafon.map((x) => (
      <div class="plafon">
        <div class="plafon-foto">
          <Image loading="eager" format="jpg" quality={78} src={x.foto} alt={`Ilustrasi plafon PVC ${x.nama} terpasang`} widths={[1600]} sizes="210mm" class="latar" />
          <div class="foto-redup"></div>
          <div class="foto-teks"><p class="label-terang">Plafon PVC</p><h2 class="merek-sedang">{x.nama}</h2></div>
        </div>
        <div class="plafon-isi">
          <div>
            <p class="ringkas">{x.p.seri.map((s) => s.nama).join(' · ')}</p>
            <p class="catatan">Terpasang sudah termasuk rangka hollow dan jasa pasang. Barang saja: {rentang(x.h.barang)} / m².</p>
          </div>
          <p class="plafon-harga"><span class="slip-label gelap">Terpasang</span><span class="angka-besar">{rentang(x.h.terpasang)}</span><span class="per">/ m²</span></p>
        </div>
      </div>
    ))}
    <p class="ilustrasi">Foto adalah ilustrasi, bukan proyek Atapura. Garansi pemasangan plafon 1 tahun.</p>
    <footer class="kaki"><span>Plafon PVC</span><span>{dua(noPlafon)}</span></footer>
  </section>}

  <!-- 9 · Rangka -->
  <section class="hal kertas">
    <div class="foto-atas foto-atas-pendek">
      <Image loading="eager" format="jpg" quality={78} src={fRangka} alt="Ilustrasi rangka atap baja ringan terpasang pada rumah baru" widths={[1600]} sizes="210mm" class="latar" />
      <div class="foto-redup"></div>
      <div class="foto-teks"><p class="label-terang">Sudah dengan pasang</p><h2 class="merek-besar">Rangka baja ringan</h2></div>
      <p class="ilustrasi ilustrasi-terang">Ilustrasi, bukan proyek Atapura.</p>
    </div>
    <div class="isi">
      <p class="pengantar">Untuk rumah baru, atau rangka kayu lama yang lapuk dan melendut. Harga per m² sudah termasuk material, screw, dynabolt, dan jasa pasang.</p>
      <ul class="kartu-tiga">
        {rangka.map((r) => (
          <li><b>{r.nama}</b><span>{r.spek}</span><p class="angka-besar">{rp(r.harga)}<span class="per">/ m²</span></p></li>
        ))}
      </ul>
      <table class="tabel">
        <tbody>
          <tr><td class="merek">Jasa pasang saja, material dari Anda</td><td class="kanan angka kuat">{rp(harga.rangka.jasaSaja)} / m²</td></tr>
          <tr><td class="merek">Garansi pemasangan rangka</td><td class="kanan">5 tahun</td></tr>
        </tbody>
      </table>
    </div>
    <footer class="kaki"><span>Rangka baja ringan</span><span>{dua(noRangka)}</span></footer>
  </section>

  <!-- 10 · Aksesoris -->
  <section class="hal kertas">
    <div class="isi">
      <p class="label">Aksesoris</p>
      <h2 class="judul">Lapis di bawah genteng,<br /><span class="redup">harga per satuan.</span></h2>
      <ul class="aks">
        {aksesoris.map((a) => (
          <li>
            {a.foto && <Image loading="eager" format="jpg" quality={78} src={a.foto.src} alt="" widths={[480]} sizes="40mm" class="aks-foto" />}
            <div class="aks-teks"><b>{a.nama}</b><span>{a.spek[0].label} {a.spek[0].nilai}</span></div>
            <p class="aks-harga"><span class="angka">{hargaAks(a)}</span><span class="per">{satuanAks(a)}</span></p>
          </li>
        ))}
      </ul>
      <p class="catatan">Papan alas, lapis kedap, flashing, paku, dan skrup sudah termasuk di harga terpasang atap. Harga di atas untuk pembelian material saja, belum termasuk ongkos kirim.</p>
    </div>
    <footer class="kaki"><span>Aksesoris</span><span>{dua(noRangka + 1)}</span></footer>
  </section>

  <!-- 11 · Yang termasuk, pembayaran, garansi -->
  <section class="hal kertas">
    <div class="isi">
      <p class="label">Ketentuan</p>
      <h2 class="judul">Yang Anda bayar,<br /><span class="redup">tertulis dari awal.</span></h2>
      <div class="dua dua-atas">
        <div>
          <h3 class="sub">Sudah termasuk di harga terpasang</h3>
          <ul class="centang">{harga.termasuk.map((t) => <li>{t.replace(/ /g, ' ')}</li>)}</ul>
        </div>
        <div>
          <h3 class="sub">Belum termasuk</h3>
          <ul class="strip">{harga.tidakTermasuk.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>
      <h3 class="sub">Pembayaran</h3>
      <ol class="termin">
        <li><b>Material</b><span>{bisnis.pembayaran.material}</span></li>
        {bisnis.pembayaran.jasa.map((j) => <li><b>{j.persen}%</b><span>{j.tahap} jasa pasang · {j.saat}</span></li>)}
      </ol>
      <div class="dua dua-atas">
        <div>
          <h3 class="sub">Garansi pemasangan {bisnis.garansiPemasanganTahun} tahun</h3>
          <ul class="centang">{bisnis.garansi.cakupan.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div>
          <h3 class="sub">Survey</h3>
          <p class="teks">Gratis di Jabodetabek. Di luar Jabodetabek, harga dihitung bersama admin karena ada akomodasi tukang dan pengiriman material.</p>
        </div>
      </div>
    </div>
    <footer class="kaki"><span>Ketentuan</span><span>{dua(noRangka + 2)}</span></footer>
  </section>

  <!-- 12 · Sampul belakang -->
  <section class="hal belakang">
    <div class="belakang-isi">
      <Logo tinggi="14mm" class="logo-terang" />
      <p class="belakang-judul">Kirim foto atap Anda,<br /><span class="redup-terang">kami estimasikan segera.</span></p>
      <div class="kontak">
        <div class="qr" set:html={qr} aria-label="Kode QR WhatsApp Atapura"></div>
        <dl>
          <div><dt>WhatsApp</dt><dd>{waTampil}</dd></div>
          <div><dt>Email</dt><dd>{bisnis.email}</dd></div>
          <div><dt>Situs</dt><dd>atapura.vercel.app</dd></div>
          <div><dt>Alamat</dt><dd>{bisnis.alamat.jalan}, {bisnis.alamat.kecamatan}, {bisnis.alamat.kota} {bisnis.alamat.kodePos}</dd></div>
        </dl>
      </div>
    </div>
    <p class="belakang-kaki">{bisnis.namaLegal} ({bisnis.statusLegal}). Harga berlaku sejak {tanggal} untuk Jabodetabek dan dapat berubah sewaktu-waktu. Angka pasti mengikuti penawaran tertulis setelah survey. Foto di dokumen ini adalah ilustrasi.</p>
  </section>

</main>
</Base>

<style>
