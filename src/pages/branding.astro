---
// Panduan brand + design system Atapura: logo & unduhan, warna, huruf, komponen, foto,
// templat sosial media, penerapan di media cetak, dan suara tulisan. Sumber token: DESIGN.md.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import villa45 from '../../assets/gambar/magnific/segmen-villa-4x5.jpg';
import hujanHp from '../../assets/gambar/magnific/hujan-hp.jpg';
import hujanDesktop from '../../assets/gambar/magnific/hujan-desktop.jpg';
import heroDesktop from '../../assets/gambar/magnific/hero-desktop.jpg';
import tukang from '../../assets/gambar/magnific/tukang-4x5.jpg';
import kafe from '../../assets/gambar/magnific/segmen-kafe-3x2.jpg';
import { getImage } from 'astro:assets';
import { logoMitra } from '../data/mitra';

const menu = [
  ['logo', 'Logo'],
  ['warna', 'Warna'],
  ['huruf', 'Huruf'],
  ['komponen', 'Komponen'],
  ['foto', 'Foto'],
  ['sosmed', 'Sosial media'],
  ['penerapan', 'Penerapan'],
  ['tulisan', 'Tulisan'],
  ['unduh', 'Unduh'],
];

const warna = [
  { nama: 'Pinus', hex: '#10231E', rgb: '16 35 30', peran: 'Bidang gelap, logo di latar terang, teks besar.', gelap: true },
  { nama: 'Pinus 2', hex: '#183129', rgb: '24 49 41', peran: 'Bidang gelap kedua, penutup halaman.', gelap: true },
  { nama: 'Tinta', hex: '#151A18', rgb: '21 26 24', peran: 'Teks utama di latar terang.', gelap: true },
  { nama: 'Lumut', hex: '#4C5E55', rgb: '76 94 85', peran: 'Teks sekunder, keterangan, label.', gelap: true },
  { nama: 'Embun', hex: '#F2F4F1', rgb: '242 244 241', peran: 'Latar baca utama, logo di latar gelap.' },
  { nama: 'Putih', hex: '#FFFFFF', rgb: '255 255 255', peran: 'Kartu, tabel, kertas penawaran.' },
  { nama: 'Garis', hex: '#D9DED8', rgb: '217 222 216', peran: 'Semua garis 1 px di latar terang.' },
  { nama: 'Tunas', hex: '#C6F24E', rgb: '198 242 78', peran: 'Satu-satunya aksen: tombol utama, satu chip atau satu kata di atas gelap.' },
  { nama: 'Tunas pucat', hex: '#EAF8C4', rgb: '234 248 196', peran: 'Latar chip penanda di bidang terang.' },
  { nama: 'Senja', hex: '#F2B66B', rgb: '242 182 107', peran: 'Hanya cahaya di foto. Bukan warna tombol atau teks.' },
];

const skala = [
  { nama: 'Display', spek: 'Public Sans 500 · 96 px · −0,04 em · baris 0,95', contoh: 'Hitung dulu,', redup: 'baru pasang.', kelas: 's-display' },
  { nama: 'Headline', spek: 'Public Sans 500 · 56 px · −0,035 em · baris 1,05', contoh: 'Tiga merek,', redup: 'satu standar pasang.', kelas: 's-headline' },
  { nama: 'Title', spek: 'Public Sans 400 · 28 px · −0,025 em', contoh: 'Underlayment menahan air yang lolos', kelas: 's-title' },
  { nama: 'Lead', spek: 'Inter 400 · 21 px · baris 1,5', contoh: 'Hitung estimasi biaya dalam satu menit, lihat standar pasangnya, lalu putuskan.', kelas: 's-lead' },
  { nama: 'Body', spek: 'Inter 400 · 17–18 px · baris 1,6', contoh: 'Setiap lapis difoto sebelum tertutup lapis berikutnya. Foto itu Anda terima, jadi bagian yang nanti tidak terlihat tetap bisa dicek.', kelas: 's-body' },
  { nama: 'Label', spek: 'Inter 500 · 15 px', contoh: 'Luas atap (m²)', kelas: 's-label' },
  { nama: 'Caption', spek: 'Inter 400 · 13 px · Lumut', contoh: 'Harga per 2 November 2026. Angka contoh untuk uji tampilan.', kelas: 's-caption' },
];

const unduhan = [
  { file: 'atapura-logo.svg', label: 'Logo utama', ket: 'SVG · latar terang' },
  { file: 'atapura-logo.png', label: 'Logo utama', ket: 'PNG 2400 px transparan' },
  { file: 'atapura-logo-putih.svg', label: 'Logo putih', ket: 'SVG · latar gelap & foto' },
  { file: 'atapura-logo-putih.png', label: 'Logo putih', ket: 'PNG 2400 px transparan' },
  { file: 'atapura-simbol.svg', label: 'Simbol Λ', ket: 'SVG · latar terang' },
  { file: 'atapura-simbol.png', label: 'Simbol Λ', ket: 'PNG 1024 px transparan' },
  { file: 'atapura-simbol-putih.svg', label: 'Simbol Λ putih', ket: 'SVG · latar gelap' },
  { file: 'atapura-simbol-putih.png', label: 'Simbol Λ putih', ket: 'PNG 1024 px transparan' },
  { file: 'avatar-profil-1080.png', label: 'Foto profil', ket: 'PNG 1080 × 1080 · WA, IG, Google' },
  { file: 'icon-512.png', label: 'Ikon aplikasi', ket: 'PNG 512 × 512' },
  { file: 'apple-touch-icon.png', label: 'Ikon layar iPhone', ket: 'PNG 180 × 180' },
  { file: 'favicon.svg', label: 'Favicon', ket: 'SVG · Λ tebal khusus ukuran kecil' },
  { file: 'favicon.ico', label: 'Favicon', ket: 'ICO 16/32/48 px' },
];

// Logo merek mitra untuk desain konten (file resmi, tidak diubah warna atau digabung).
const unduhMitra = await Promise.all(logoMitra.map(async (l) => ({ ...l, src: (await getImage({ src: l.file, format: 'png', width: l.file.width })).src })));

const dilarang = ['solusi terbaik', 'terpercaya No.1', 'profesional dan berpengalaman', 'kualitas tak tertandingi', 'dengan harga terjangkau', 'hadir untuk Anda', 'wujudkan atap impian', 'di era modern ini', 'tak perlu khawatir lagi'];
---

<Base
  title="Branding Atapura: logo, warna, huruf, dan templat"
  description="Panduan brand Atapura: unduh logo, kode warna, kombinasi huruf, komponen, aturan foto, templat sosial media, dan penerapan di media cetak."
>
  <header class="b-kepala">
    <div class="wrap b-kepala-isi">
      <a href="/" class="b-logo" aria-label="Atapura, ke beranda"><Logo tinggi="1.3rem" /></a>
      <span class="b-kepala-label">Panduan brand</span>
      <a href="/brand/atapura-brand-kit.zip" class="pill pill-tunas b-kepala-unduh" download>Unduh semua logo</a>
    </div>
  </header>

  <main class="b">
    <section class="b-hero">
      <div class="wrap">
        <p class="eyebrow">Brand & design system · versi 2 November 2026</p>
        <h1 class="b-judul">Atapnya sudah ada <span class="miring">di nama kami.</span></h1>
        <p class="b-lead">Halaman ini patokan untuk semua yang membawa nama Atapura: website, sosial media, penawaran, spanduk, seragam. Ambil logonya di sini, salin kode warnanya, dan ikuti aturannya supaya orang yang melihat postingan lalu membuka website merasa ada di tempat yang sama.</p>
        <nav class="b-menu" aria-label="Isi halaman">
          {menu.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        </nav>
      </div>
    </section>

    <!-- LOGO -->
    <section id="logo" class="b-sek">
      <div class="wrap">
        <div class="b-sek-kepala">
          <p class="eyebrow">01 · Logo</p>
          <h2 class="b-h2">Λtapura. <span class="miring">Huruf A yang jadi atap.</span></h2>
          <p class="b-teks">Huruf A pertama tanpa palang tengah menjadi atap pelana dengan puncak runcing seperti bubungan. Sisanya huruf kecil yang tenang. Hurufnya Public Sans Medium, sama dengan judul website, dan sudah diubah jadi garis vektor.</p>
        </div>
        <div class="b-dua">
          <figure class="papan papan-terang"><Logo tinggi="clamp(3rem, 2rem + 4vw, 5.5rem)" /><figcaption>Logo utama · Pinus di latar terang</figcaption></figure>
          <figure class="papan papan-gelap"><Logo tinggi="clamp(3rem, 2rem + 4vw, 5.5rem)" /><figcaption>Logo putih · Embun di latar gelap atau foto</figcaption></figure>
        </div>
        <div class="b-tiga">
          <figure class="kartu">
            <div class="aturan-ruang"><span class="ruang"><Logo tinggi="2.6rem" /></span></div>
            <figcaption><b>Ruang kosong</b> di sekeliling logo minimal setinggi huruf "a". Jangan ada teks, tepi foto, atau elemen lain di dalamnya.</figcaption>
          </figure>
          <figure class="kartu">
            <div class="aturan-ukuran">
              <span><Logo tinggi="21px" /><small>80 px</small></span>
              <span><img src="/brand/atapura-simbol.svg" alt="" width="24" height="24" /><small>di bawahnya: simbol</small></span>
            </div>
            <figcaption><b>Ukuran minimum</b> logo lengkap 80 px lebar di layar atau 20 mm di cetak. Lebih kecil dari itu, pakai simbol Λ saja.</figcaption>
          </figure>
          <figure class="kartu">
            <div class="aturan-simbol">
              <img src="/brand/avatar-profil-1080.png" alt="" width="72" height="72" class="bulat" />
              <img src="/brand/favicon.svg" alt="" width="32" height="32" />
              <img src="/brand/favicon.svg" alt="" width="16" height="16" />
            </div>
            <figcaption><b>Simbol Λ</b> untuk foto profil, ikon tab, stempel foto proyek. Ikon 16–48 px memakai Λ yang lebih tebal supaya tetap terbaca.</figcaption>
          </figure>
        </div>

        <h3 class="b-h3">Jangan</h3>
        <div class="jangan">
          <figure><div class="jangan-kotak"><Logo tinggi="1.6rem" class="j-regang" /></div><figcaption>Meregangkan atau memampatkan</figcaption></figure>
          <figure><div class="jangan-kotak"><Logo tinggi="1.6rem" class="j-lime" /></div><figcaption>Mengganti warna, termasuk lime</figcaption></figure>
          <figure><div class="jangan-kotak"><Logo tinggi="1.6rem" class="j-bayang" /></div><figcaption>Bayangan, gradasi, atau garis tepi</figcaption></figure>
          <figure><div class="jangan-kotak"><Logo tinggi="1.6rem" class="j-miring" /></div><figcaption>Memiringkan atau memutar</figcaption></figure>
          <figure><div class="jangan-kotak"><span class="j-a">Atapura</span></div><figcaption>Mengetik ulang dengan A biasa</figcaption></figure>
          <figure><div class="jangan-kotak jangan-foto"><Image src={kafe} alt="" width={480} class="jangan-img" /><Logo tinggi="1.6rem" class="j-pinus" /></div><figcaption>Logo Pinus di atas foto gelap</figcaption></figure>
        </div>
      </div>
    </section>

    <!-- WARNA -->
    <section id="warna" class="b-sek b-sek-putih">
      <div class="wrap">
        <div class="b-sek-kepala">
          <p class="eyebrow">02 · Warna</p>
          <h2 class="b-h2">Hijau pinus, <span class="miring">bukan hitam.</span></h2>
          <p class="b-teks">Bidang gelap selalu Pinus, bukan hitam. Lime Tunas dipakai sangat hemat. Ketuk kotak warna untuk menyalin kode hex-nya.</p>
        </div>
        <div class="proporsi" aria-label="Proporsi warna">
          <span style="flex: 70" class="pr-terang">Embun & Putih · 70%</span>
          <span style="flex: 25" class="pr-gelap">Pinus & foto · 25%</span>
          <span style="flex: 5" class="pr-tunas" title="Tunas ≤5%">≤5%</span>
        </div>
        <ul class="swatch-grid">
          {warna.map((w) => (
            <li class="swatch">
              <button type="button" class:list={['swatch-warna', { 'swatch-gelap': w.gelap }]} style={`background:${w.hex}`} data-salin={w.hex} aria-label={`Salin ${w.nama} ${w.hex}`}>
                <span class="swatch-status" aria-live="polite"></span>
              </button>
              <div class="swatch-info">
                <p class="swatch-nama">{w.nama}</p>
                <p class="swatch-kode angka">{w.hex} · RGB {w.rgb}</p>
                <p class="swatch-peran">{w.peran}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="pasangan">
          <div class="psg" style="background:#F2F4F1;color:#151A18">Tinta di Embun <b>AAA</b></div>
          <div class="psg" style="background:#10231E;color:#F2F4F1">Embun di Pinus <b>AAA</b></div>
          <div class="psg" style="background:#10231E;color:#C6F24E">Tunas di Pinus <b>AAA</b></div>
          <div class="psg" style="background:#C6F24E;color:#10231E">Pinus di Tunas <b>AAA</b></div>
          <div class="psg psg-x" style="background:#F2F4F1;color:#C6F24E">Tunas di Embun <b>jangan</b></div>
        </div>
      </div>
    </section>

    <!-- HURUF -->
    <section id="huruf" class="b-sek">
      <div class="wrap">
        <div class="b-sek-kepala">
          <p class="eyebrow">03 · Huruf</p>
          <h2 class="b-h2">Dua huruf, <span class="miring">satu suara.</span></h2>
          <p class="b-teks">Public Sans untuk logo, judul, dan angka besar: bobot 500, jarak huruf rapat −0,04 em. Inter untuk teks isi, label, harga kecil, dan tombol, karena lebih jelas dibaca di ukuran kecil dan tampil sama di semua perangkat. Tanpa huruf miring, tanpa serif. Penekanan datang dari meredupkan sebagian kalimat, paling banyak satu frasa per judul.</p>
          <div class="b-aksi">
            <a class="pill pill-gelap" href="https://fonts.google.com/specimen/Public+Sans" target="_blank" rel="noopener">Unduh Public Sans (gratis)</a>
            <a class="pill pill-gelap" href="https://fonts.google.com/specimen/Inter" target="_blank" rel="noopener">Unduh Inter (gratis)</a>
          </div>
        </div>
        <div class="spesimen">
          <p class="spesimen-besar spesimen-merek" aria-hidden="true">Aa</p>
          <div class="spesimen-info">
            <p class="spesimen-nama spesimen-merek">Public Sans · judul & angka besar</p>
            <p class="b-teks">Lisensi SIL Open Font License, boleh dipakai komersial di website, Canva, Figma, dan cetak. Bobot yang dipakai: 400 Regular dan 500 Medium.</p>
            <p class="spesimen-set angka spesimen-merek">ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />abcdefghijklmnopqrstuvwxyz<br />0123456789 Rp m² · – — ( ) ?</p>
          </div>
        </div>
        <div class="spesimen">
          <p class="spesimen-besar" aria-hidden="true">Aa</p>
          <div class="spesimen-info">
            <p class="spesimen-nama">Inter · teks isi, label, tombol</p>
            <p class="b-teks">Lisensi SIL Open Font License, bebas dipakai komersial. Bobot 400 untuk isi, 500 untuk label dan tombol. Di HP ukurannya 13–16 px.</p>
            <p class="spesimen-set angka">ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />abcdefghijklmnopqrstuvwxyz<br />0123456789 Rp m² · – — ( ) ?</p>
          </div>
        </div>
        <ol class="skala">
          {skala.map((s) => (
            <li>
              <div class="skala-spek"><p class="skala-nama">{s.nama}</p><p class="angka">{s.spek}</p></div>
              <p class={s.kelas}>{s.contoh}{s.redup && <> <span class="miring">{s.redup}</span></>}</p>
            </li>
          ))}
          <li>
            <div class="skala-spek"><p class="skala-nama">Angka</p><p>tabular, rupiah tanpa desimal</p></div>
            <p class="s-angka angka">Rp41.400.000 – Rp53.100.000</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- KOMPONEN -->
    <section id="komponen" class="b-sek b-sek-putih">
      <div class="wrap">
        <div class="b-sek-kepala">
          <p class="eyebrow">04 · Komponen</p>
          <h2 class="b-h2">Yang bisa disentuh <span class="miring">selalu bulat.</span></h2>
          <p class="b-teks">Tombol, chip, dan kontrol berbentuk pill dengan tinggi minimal 48 px. Wadah memakai sudut lembut. Bayangan selalu jatuh ke bawah, seperti matahari di atap.</p>
        </div>
        <div class="komp-grid">
          <div class="komp komp-terang">
            <p class="komp-label">Tombol di latar terang</p>
            <div class="komp-baris"><a class="pill pill-tunas" href="#komponen">Hitung estimasi biaya</a><a class="pill pill-gelap" href="#komponen">Chat WhatsApp</a></div>
            <p class="komp-ket">Utama: Tunas + teks Pinus, pendar Tunas di bawahnya. Kedua: Pinus + teks putih.</p>
          </div>
          <div class="komp komp-gelap">
            <p class="komp-label">Tombol di latar gelap</p>
            <div class="komp-baris"><a class="pill pill-tunas" href="#komponen">Hitung estimasi biaya</a><a class="pill pill-garis" href="#komponen">Jadwalkan survey</a></div>
            <p class="komp-ket">Kedua: garis 1 px warna teks.</p>
          </div>
          <div class="komp komp-foto">
            <Image src={heroDesktop} alt="" width={720} class="komp-foto-img" />
            <div class="komp-foto-isi">
              <p class="komp-label">Chip fakta di atas foto</p>
              <div class="komp-baris"><span class="chip-fakta">Survey gratis</span><span class="chip-fakta">13 kota Jabodetabek</span><span class="chip-fakta chip-tunas">Garansi pasang 5 tahun</span></div>
              <p class="komp-ket">Pinus 72% + garis tipis. Paling banyak satu chip Tunas per desain.</p>
            </div>
          </div>
          <div class="komp komp-terang">
            <p class="komp-label">Penanda angka belum resmi</p>
            <div class="komp-baris"><span class="angka komp-harga">Rp135 rb–160 rb</span><span class="contoh">contoh</span></div>
            <p class="komp-ket">Chip Tunas pucat menempel pada angka yang belum resmi, hilang begitu data asli masuk.</p>
          </div>
        </div>
        <dl class="token">
          <div><dt>Sudut</dt><dd>Pill 999 px untuk yang disentuh · 24 px wadah besar · 16 px kartu · 6 px kertas cetak</dd></div>
          <div><dt>Bayangan</dt><dd class="angka">0 14px 30px −14px Pinus 60% · selalu jatuh ke bawah, tanpa bayangan keras</dd></div>
          <div><dt>Jarak</dt><dd>Gutter 20–72 px mengikuti layar · jarak antarbagian 56–112 px · konten selebar halaman, sejajar judul</dd></div>
          <div><dt>Gerak</dt><dd>Halus, satu warna, minimal 0,8 detik untuk efek besar; hanya transform & opacity; ikut setelan kurangi gerak</dd></div>
          <div><dt>Chevron Λ</dt><dd>Garis tipis 1 px searah kemiringan atap, paling banyak satu per layar, sebagai supergrafis di atas foto</dd></div>
        </dl>
      </div>
    </section>

    <!-- FOTO -->
    <section id="foto" class="b-sek">
      <div class="wrap">
        <div class="b-sek-kepala">
          <p class="eyebrow">05 · Foto</p>
          <h2 class="b-h2">Hangat, tenang, <span class="miring">dan asli.</span></h2>
          <p class="b-teks">Cahaya sore yang wajar, langit biru, daun blur di depan untuk kedalaman, atap selalu terlihat jelas. Foto proyek asli selalu menang. Gambar AI hanya untuk suasana dan selalu ditandai sebagai ilustrasi.</p>
        </div>
        <div class="foto-grid">
          <figure><Image src={heroDesktop} alt="Contoh foto suasana: rumah tropis dengan atap bitumen di sore hari" width={900} /><figcaption><b>Ya.</b> Sore terang, rumah tropis Jabodetabek, atap jelas, daun blur di depan.</figcaption></figure>
          <figure><Image src={hujanDesktop} alt="Contoh foto detail: hujan di atap bitumen saat senja" width={900} /><figcaption><b>Ya.</b> Detail material dengan cahaya hangat untuk cerita hujan.</figcaption></figure>
          <figure><Image src={tukang} alt="Contoh foto pemasangan oleh tukang" width={600} /><figcaption><b>Sementara.</b> Foto tukang AI hanya sampai ada foto tim asli.</figcaption></figure>
        </div>
        <ul class="daftar-aturan">
          <li><b>Selalu:</b> foto proyek asli di Rapor Proyek dan postingan bukti, dengan kota, merek, luas, dan lama pengerjaan.</li>
          <li><b>Boleh dengan label:</b> gambar AI (Magnific) untuk suasana, tertulis "ilustrasi" di caption atau kaki halaman.</li>
          <li><b>Jangan:</b> foto rumah stok, foto proyek dari galeri merek atau kota lain, ornamen Bali, rumah gaya Eropa, panel surya, langit jingga berlebihan, tulisan atau logo palsu di gambar.</li>
        </ul>
      </div>
    </section>

    <!-- SOSMED -->
    <section id="sosmed" class="b-sek b-sek-pinus">
      <div class="wrap">
        <div class="b-sek-kepala">
          <p class="eyebrow">06 · Sosial media</p>
          <h2 class="b-h2">Struktur tetap, <span class="miring">isi berganti.</span></h2>
          <p class="b-teks">Logo kecil di kiri atas, judul 2–3 baris, satu kalimat pendukung, foto penuh, paling banyak tiga chip fakta, dan bilah bawah yang posisinya selalu sama. Maksimal sekitar 25 kata per desain feed; detail pindah ke caption.</p>
        </div>
        <div class="sos-grid">
          <figure class="sos">
            <div class="feed">
              <Image src={villa45} alt="" width={720} class="sos-img" />
              <div class="feed-isi">
                <span class="feed-logo"><Logo tinggi="0.9rem" /></span>
                <p class="feed-judul">Atap villa yang <span class="miring">tenang saat kabut turun.</span></p>
                <div class="feed-chip"><span class="chip-fakta">Puncak, Bogor</span><span class="chip-fakta chip-tunas">5 lapis</span></div>
                <p class="feed-bilah"><span>WhatsApp</span><span>atapura.com</span><span>@atapura</span></p>
              </div>
            </div>
            <figcaption><b>Feed IG/FB</b> · 1080 × 1350 (4:5)</figcaption>
          </figure>
          <figure class="sos">
            <div class="story">
              <Image src={hujanHp} alt="" width={540} class="sos-img" />
              <span class="aman aman-atas">zona aman 250 px</span>
              <div class="story-isi">
                <span class="feed-logo"><Logo tinggi="0.75rem" /></span>
                <p class="story-judul">Hujan deras seharusnya cuma jadi <span class="miring">suara.</span></p>
                <span class="pill pill-tunas story-tombol">Hitung estimasi</span>
              </div>
              <span class="aman aman-bawah">zona aman 340 px</span>
            </div>
            <figcaption><b>Story, Reels, TikTok</b> · 1080 × 1920 (9:16)</figcaption>
          </figure>
          <figure class="sos">
            <div class="carousel">
