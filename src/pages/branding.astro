<script>
  // Salin kode hex saat kotak warna diketuk; status ditulis di dalam kotak (tanpa alert).
  document.querySelectorAll<HTMLButtonElement>('[data-salin]').forEach((tombol) => {
    const status = tombol.querySelector<HTMLElement>('.swatch-status');
    let jeda: number | undefined;
    tombol.addEventListener('click', async () => {
      const hex = tombol.dataset.salin ?? '';
      let pesan = 'Disalin';
      try {
        await navigator.clipboard.writeText(hex);
      } catch {
        pesan = hex;
      }
      if (status) status.textContent = pesan;
      clearTimeout(jeda);
      jeda = window.setTimeout(() => { if (status) status.textContent = ''; }, 1600);
    });
  });
</script>

