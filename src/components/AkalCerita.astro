---
// AKAL = empat nilai/komitmen Atapura (Rama, 24 Nov: nilai, bukan studi kasus; bukan soal harga). Kartu berwarna
// Embun · Tunas · Pinus · Embun bertepi atas atap pelana landai (acuan Rent H&U + ciri Λ Atapura), nama nilai besar,
// tombol tautan di takik sudut kiri bawah (acuan Biztop). Kalimat umum, tanpa janji prosedural (jangan over promise).
const pilar = [
  { nama: 'Andal', warna: 'embun', isi: 'Pelayanan yang bisa diandalkan, dari tim penjualan, tukang di lapangan, sampai layanan purnajual.', bukti: '/cara-kerja', label: 'Cara kerja' },
  { nama: 'Kualitas', warna: 'tunas', isi: 'Dikerjakan tukang profesional, dengan material asli langsung dari pabrikan.', bukti: '/produk', label: 'Material & merek' },
  { nama: 'Amanah', warna: 'pinus', isi: 'Jujur dan terbuka sejak awal. Setiap kesepakatan kami pegang sampai pekerjaan selesai.', bukti: '/tentang', label: 'Tentang kami' },
  { nama: 'Lestari', warna: 'embun', isi: 'Atap yang awet, dan hubungan yang tetap terjaga setelah serah terima.', bukti: '/garansi', label: 'Garansi' },
];
---

<ol class="akal-kartu">
  {pilar.map((p, i) => (
    <li class:list={['kartu-akal', `w-${p.warna}`]}>
      <span class="ka-nomor">0{i + 1}</span>
      <h3 class="ka-nama"><span class="ka-awal">{p.nama.charAt(0)}</span>{p.nama.slice(1)}</h3>
      <p class="ka-isi">{p.isi}</p>
      <span class="ka-takik">
        <a class="ka-bukti" href={p.bukti}>{p.label}<span aria-hidden="true">→</span></a>
      </span>
    </li>
  ))}
</ol>

<style>
  .akal-kartu { --latar: var(--color-putih); --r: 1.25rem; display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); }
  .kartu-akal {
    position: relative; display: flex; flex-direction: column; min-height: 100%;
    padding: 2.25rem 1.5rem 4.75rem; border-radius: 1.5rem; background: var(--k-latar); color: var(--k-teks);
    /* Tepi atas = atap pelana landai (naik 1.1rem ke tengah). Bawaan polygon; browser yang mendukung shape() dapat sudut
       atas membulat supaya tidak tajam. Sudut bawah tetap dari border-radius. */
    --s: 1.1rem;
    clip-path: polygon(0 var(--s), 50% 0, 100% var(--s), 100% 100%, 0 100%);
  }
  @supports (clip-path: shape(from 0 0, line to 1px 1px)) {
    .kartu-akal {
      clip-path: shape(
        from 0 calc(var(--s) + 1.25rem),
        curve to 1.25rem calc(var(--s) - 0.1rem) with 0 var(--s),
        line to calc(50% - 1.75rem) 0.22rem,
        curve to calc(50% + 1.75rem) 0.22rem with 50% -0.08rem,
        line to calc(100% - 1.25rem) calc(var(--s) - 0.1rem),
        curve to 100% calc(var(--s) + 1.25rem) with 100% var(--s),
        line to 100% 100%, line to 0 100%, close);
    }
  }
  .w-embun { --k-latar: var(--color-embun); --k-teks: var(--color-tinta); --k-redup: var(--color-lumut); --k-garis: rgb(16 35 30 / 0.14); }
  .w-tunas { --k-latar: var(--color-tunas); --k-teks: var(--color-pinus); --k-redup: rgb(16 35 30 / 0.72); --k-garis: rgb(16 35 30 / 0.2); }
  .w-pinus { --k-latar: var(--color-pinus); --k-teks: var(--color-embun); --k-redup: var(--embun-redup); --k-garis: rgb(242 244 241 / 0.2); }
  .ka-nomor { align-self: flex-end; font-size: var(--fs-14); font-weight: 500; color: var(--k-redup); font-variant-numeric: tabular-nums; }
  /* Nama pegangan = judul kartu, besar; huruf depan penuh, sisanya diredupkan supaya A-K-A-L terbaca berurutan. */
  .ka-nama {
    margin-top: 2.5rem; font-family: var(--font-merek); font-size: clamp(2.5rem, 1.4rem + 2.3vw, 3.5rem); font-weight: 500;
    letter-spacing: -0.045em; line-height: 0.95; color: color-mix(in srgb, var(--k-teks) 58%, transparent);
  }
  .ka-awal { color: var(--k-teks); }
  .ka-isi { margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid var(--k-garis); font-size: var(--fs-16); line-height: 1.5; color: var(--k-redup); max-width: 30ch; }

  /* Takik: potongan sudut kiri bawah selatar bagian, sudut dalamnya melengkung (acuan Biztop). */
  .ka-takik {
    position: absolute; left: 0; bottom: 0; padding: 0.6rem 0.75rem 0 0; background: var(--latar);
    border-top-right-radius: var(--r);
  }
  .ka-takik::before, .ka-takik::after { content: ''; position: absolute; width: var(--r); height: var(--r); pointer-events: none; }
  .ka-takik::before { left: 0; top: calc(-1 * var(--r)); background: radial-gradient(circle at 100% 0, transparent calc(var(--r) - 0.5px), var(--latar) var(--r)); }
  .ka-takik::after { right: calc(-1 * var(--r)); bottom: 0; background: radial-gradient(circle at 100% 0, transparent calc(var(--r) - 0.5px), var(--latar) var(--r)); }
  .ka-bukti {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 1.1rem; border-radius: 999px;
    background: var(--k-latar); color: var(--k-teks); font-size: var(--fs-15); font-weight: 500; text-decoration: none;
    transition: transform 250ms var(--ease-out);
  }
  .ka-bukti span { transition: transform 250ms var(--ease-out); }
  .ka-bukti:focus-visible { outline: 2px solid var(--color-pinus); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) { .kartu-akal:hover .ka-bukti span { transform: translateX(4px); } }

  @media (min-width: 48rem) { .akal-kartu { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .kartu-akal { padding: 1.75rem 1.6rem 5rem; }
  }
  /* Empat kolom baru dari 75rem: di 1024 px judul kartu sempit sampai tiga baris, jadi 2×2 dulu. */
  @media (min-width: 75rem) { .akal-kartu { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  /* HP: kartu digeser ke samping seperti Layanan, kartu berikutnya mengintip di tepi. */
  @media (max-width: 47.99rem) {
    .akal-kartu {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 84%; gap: 10px;
      overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter)); padding: 0 var(--gutter) 6px; scroll-padding-inline: var(--gutter);
    }
    .akal-kartu::-webkit-scrollbar { display: none; }
    .kartu-akal { scroll-snap-align: start; }
  }
</style>
