---
// AKAL: empat janji, masing-masing menaut ke buktinya. Desktop: kisi kartu foto (dulu panggung menempel 360vh,
// diganti DECISIONS 072 karena 4,4 layar gulir untuk 4 kartu). HP: kartu foto digeser ke samping. Foto: Magnific gelombang 2 (docs/desain/prompt-magnific-gelombang-2.md), ilustrasi.
import { getImage } from 'astro:assets';
import { bisnis } from '../data/bisnis';
import fotoAndal from '../../assets/gambar/magnific/akal-andal.jpg';
import fotoKualitas from '../../assets/gambar/magnific/akal-kualitas.jpg';
import fotoAmanah from '../../assets/gambar/magnific/akal-amanah.jpg';
import fotoLestari from '../../assets/gambar/magnific/akal-lestari.jpg';

const pilar = [
  { id: 'andal', h: 'A', nama: 'Andal', takut: 'Tukang datang seenaknya, kerjaan molor?', dapat: 'Anda tahu tanggal mulai dan perkiraan selesai sebelum membayar apa pun, tertulis. Setiap tahap dikabari lewat chat.', bukti: '/cara-kerja', label: 'Lihat 6 tahap kerja', foto: fotoAndal, alt: 'Ilustrasi pemilik rumah menerima kabar jadwal sementara tim tiba membawa genteng' },
  { id: 'kualitas', h: 'K', nama: 'Kualitas', takut: 'Takut bocor lagi padahal sudah bayar mahal?', dapat: 'Anda bisa melihat bagian atap yang nanti tertutup: setiap lapis difoto sebelum ditutup lapis berikutnya, lalu dikirim ke Anda.', bukti: '/cara-kerja#lapisan', label: 'Lihat kelima lapis', foto: fotoKualitas, alt: 'Ilustrasi tangan tukang memaku genteng aspal di atas underlayment, ponsel memotret pekerjaan' },
  { id: 'amanah', h: 'A', nama: 'Amanah', takut: 'Takut harga membengkak atau tertipu?', dapat: 'Anda tahu kisaran biayanya sebelum bicara dengan siapa pun, lalu membayar material sebelum dikirim dan jasa pasang bertahap mengikuti progres.', bukti: '/garansi#bayar', label: 'Lihat termin bayar', foto: fotoAmanah, alt: 'Ilustrasi pemilik rumah meninjau rincian biaya dengan sampel genteng di meja' },
  { id: 'lestari', h: 'L', nama: 'Lestari', takut: 'Ditinggal begitu lunas?', dapat: `Atap Anda tetap dijaga ${bisnis.garansiPemasanganTahun} tahun: bocor akibat pemasangan diperbaiki tanpa biaya. Klaim cukup lewat WhatsApp dengan foto.`, bukti: '/garansi', label: 'Lihat garansi', foto: fotoLestari, alt: 'Ilustrasi keluarga bersantai di teras saat hujan sore' },
];
const foto = await Promise.all(pilar.map(async (p) => ({ ...p, img: await getImage({ src: p.foto, width: 1100, format: 'webp', quality: 74 }) })));
---

<div class="cerita">
  <ol class="cerita-babak">
      {foto.map((p, i) => (
        <li class="babak">
          <img class="babak-foto" src={p.img.src} alt={p.alt} width="1100" height="1375" loading="lazy" decoding="async" />
          <div class="babak-isi">
            <p class="babak-nama"><span class="babak-urut">{String(i + 1).padStart(2, '0')} / 04</span>{p.nama}</p>
            <h3 class="babak-takut">{p.takut}</h3>
            <p class="babak-dapat">{p.dapat}</p>
            <a class="babak-bukti tautan-lanjut" href={p.bukti}>{p.label}</a>
          </div>
        </li>
      ))}
  </ol>
</div>


<style>
  /* HP: kartu foto per pilar */
    .cerita-babak { display: grid; gap: 1.25rem; }
  .babak { border-radius: 18px; overflow: hidden; background: var(--color-pinus-2); }
  .babak-foto { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .babak-isi { padding: 1.5rem 1.4rem 1.75rem; display: grid; gap: 0.6rem; }
  .babak-nama {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 3.4rem); font-weight: 500; letter-spacing: -0.05em; line-height: 0.95; color: var(--color-tunas);
    display: grid; gap: 0.5rem;
  }
  .babak-urut { font-size: var(--fs-13); font-weight: 500; letter-spacing: 0.02em; color: var(--embun-redup); }
  .babak-takut { font-size: 1.45rem; font-weight: 500; letter-spacing: -0.03em; line-height: 1.2; color: var(--color-embun); }
  .babak-dapat { color: var(--embun-redup); }
  @media (max-width: 47.99rem) {
    .babak-nama { font-size: 1.75rem; }
    /* Empat kartu digeser ke samping, kartu berikutnya mengintip di tepi. */
    .cerita-babak {
      grid-auto-flow: column; grid-auto-columns: 84%; gap: 10px;
      overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter)); padding: 0 var(--gutter) 6px; scroll-padding-inline: var(--gutter);
    }
    .cerita-babak::-webkit-scrollbar { display: none; }
    .babak { scroll-snap-align: start; }
    .babak-foto { aspect-ratio: 16 / 10; }
    .babak-isi { padding: 1.1rem 1.1rem 1.25rem; gap: 0.45rem; }
    .babak-takut { font-size: var(--hp-t3); }
    .babak-dapat { font-size: var(--fs-15); }
  }
  .babak-bukti { justify-self: start; margin-top: 0.1rem; }

  /* Tablet: dua kolom; desktop: empat kartu sejajar. Nama pilar Embun (Satu Tunas Rule: maks satu kata Tunas per layar). */
  @media (min-width: 48rem) { .cerita-babak { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .cerita-babak { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
    .babak { display: flex; flex-direction: column; }
    .babak-foto { aspect-ratio: 4 / 5; }
    .babak-isi { flex: 1; align-content: start; padding: 1.4rem 1.3rem 1.5rem; gap: 0.55rem; }
    .babak-nama { font-size: 2.4rem; color: var(--color-embun); }
    .babak-takut { font-size: 1.2rem; line-height: 1.25; }
    .babak-dapat { font-size: var(--fs-16); line-height: 1.5; }
    .babak-bukti { margin-top: auto; padding-top: 0.6rem; }
  }
</style>
