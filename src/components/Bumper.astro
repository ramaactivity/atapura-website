---
// Bumper pembuka (bukan loading screen): Λ tergambar → logo → empat nilai AKAL → layar "terangkat" seperti
// atap membuka hero. ±2,6 detik, sekali per sesi, bisa dilewati. Tanpa JS / reduced-motion / kunjungan ulang:
// tidak pernah tampil (default display:none), jadi tidak mengganggu Google maupun pembaca layar.
import Logo from './Logo.astro';
const nilai = ['Andal', 'Kualitas', 'Amanah', 'Lestari'];
---

<script is:inline>
  (function () {
    try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (sessionStorage.getItem('atapura-bumper')) return;
      sessionStorage.setItem('atapura-bumper', '1');
    } catch (e) { return; }
    document.documentElement.classList.add('ada-bumper');
  })();
</script>

<div class="bumper" data-bumper aria-hidden="true">
  <div class="bumper-panel">
    <div class="bumper-isi">
      <svg class="bumper-atap" viewBox="0 0 120 80"><path d="M6 76 L60 6 L114 76" /></svg>
      <span class="bumper-logo"><Logo tinggi="clamp(1.8rem, 1.2rem + 2.4vw, 3rem)" /></span>
      <ul class="bumper-nilai">
        {nilai.map((n) => <li><b>{n[0]}</b>{n.slice(1)}</li>)}
      </ul>
    </div>
  </div>
  <button type="button" class="bumper-lewati" tabindex="-1">Lewati</button>
</div>

<script>
  const b = document.querySelector<HTMLElement>('[data-bumper]');
  if (b && document.documentElement.classList.contains('ada-bumper')) {
    const selesai = () => { document.documentElement.classList.add('bumper-selesai'); setTimeout(() => b.remove(), 50); };
    b.addEventListener('animationend', (e) => { if (e.animationName.includes('bp-angkat')) selesai(); });
    const lewati = () => { b.classList.add('cepat'); };
    b.addEventListener('pointerdown', lewati);
    addEventListener('keydown', lewati, { once: true });
    addEventListener('wheel', lewati, { once: true, passive: true });
    setTimeout(selesai, 5000); // pengaman: apa pun yang terjadi, bumper hilang
  } else b?.remove();
</script>

<style>
  /* Kurva (skill animation-principles): masuk = ease-out, keluar = ease-in, gerak besar = ease-in-out berbobot.
     Semua gerak memakai transform/opacity (dikerjakan GPU) supaya tidak bergetar; bentuk atap di panel statis. */
  .bumper { display: none; }
  :global(html.ada-bumper) .bumper { display: block; position: fixed; inset: 0; z-index: 100; overflow: hidden; pointer-events: auto; }
  .bumper-panel {
    position: absolute; left: 0; right: 0; top: 0; height: calc(100% + 26vh);
    display: grid; place-items: start center; color: var(--color-embun);
    background: radial-gradient(ellipse 70% 45% at 50% 38%, #1a362d 0%, var(--color-pinus) 70%);
    /* Tepi bawah bertakik Λ (di luar layar saat mulai); ikut terangkat utuh. */
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% calc(100% - 26vh), 0 100%);
    will-change: transform; transform: translate3d(0, 0, 0);
    animation: bp-angkat 1150ms cubic-bezier(0.76, 0, 0.24, 1) 2150ms forwards;
  }
  @keyframes bp-angkat { to { transform: translate3d(0, -100%, 0); } }
  .bumper-isi {
    height: 100vh; height: 100svh; display: grid; place-content: center; justify-items: center; gap: 1.4rem;
    animation: bp-pergi 450ms cubic-bezier(0.7, 0, 0.84, 0) 1950ms forwards;
  }
  @keyframes bp-pergi { to { opacity: 0; transform: translate3d(0, -18px, 0); } }
  .bumper.cepat .bumper-panel { animation-delay: 150ms !important; animation-duration: 800ms !important; }
  .bumper.cepat .bumper-isi { animation-delay: 0ms !important; animation-duration: 250ms !important; }

  .bumper-atap { width: clamp(5rem, 3rem + 8vw, 9rem); overflow: visible; }
  .bumper-atap path {
    fill: none; stroke: var(--color-tunas); stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 190; stroke-dashoffset: 190; animation: bp-gambar 1000ms cubic-bezier(0.65, 0, 0.35, 1) 150ms forwards;
  }
  @keyframes bp-gambar { to { stroke-dashoffset: 0; } }
  .bumper-logo, .bumper-nilai li { opacity: 0; transform: translate3d(0, 14px, 0); will-change: transform, opacity; }
  .bumper-logo { animation: bp-muncul 800ms cubic-bezier(0.16, 1, 0.3, 1) 750ms forwards; }
  .bumper-nilai { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 1.6rem; font-size: clamp(0.85rem, 0.8rem + 0.3vw, 1rem); color: var(--embun-redup); }
  .bumper-nilai li { animation: bp-muncul 650ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .bumper-nilai li:nth-child(1) { animation-delay: 1050ms; }
  .bumper-nilai li:nth-child(2) { animation-delay: 1120ms; }
  .bumper-nilai li:nth-child(3) { animation-delay: 1190ms; }
  .bumper-nilai li:nth-child(4) { animation-delay: 1260ms; }
  .bumper-nilai b { color: var(--color-tunas); font-weight: 500; }
  @keyframes bp-muncul { to { opacity: 1; transform: translate3d(0, 0, 0); } }
  .bumper-lewati {
    position: absolute; right: 1.5rem; bottom: 1.5rem; font-size: 0.85rem; color: var(--embun-redup); padding: 0.6rem 1rem; cursor: pointer;
    opacity: 0; animation: bp-muncul 500ms ease-out 600ms forwards, bp-pergi 300ms ease-in 1950ms forwards;
  }

  /* Follow-through di hero: foto mendekat pelan setelah atap terangkat, teks naik bertahap. */
  :global(html.ada-bumper .hero-foto) { animation: bp-hero-dekat 2600ms cubic-bezier(0.16, 1, 0.3, 1) 2250ms backwards; }
  @keyframes bp-hero-dekat { from { scale: 1.16; } }
  :global(html.ada-bumper .hero-isi > *) { animation: bp-hero-naik 1100ms cubic-bezier(0.16, 1, 0.3, 1) backwards; }
  :global(html.ada-bumper .hero-isi > :nth-child(1)) { animation-delay: 2700ms; }
  :global(html.ada-bumper .hero-isi > :nth-child(2)) { animation-delay: 2800ms; }
  :global(html.ada-bumper .hero-isi > :nth-child(3)) { animation-delay: 2900ms; }
  @keyframes bp-hero-naik { from { opacity: 0; transform: translate3d(0, 32px, 0); } }
</style>
