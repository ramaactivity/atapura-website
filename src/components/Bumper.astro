---
// Bumper pembuka (bukan loading screen): Λ tergambar → logo → empat nilai AKAL → layar "terangkat" seperti
// atap membuka hero. ±2,6 detik, sekali per sesi, bisa dilewati. Tanpa JS / reduced-motion / kunjungan ulang:
// tidak pernah tampil (default display:none), jadi tidak mengganggu Google maupun pembaca layar.
import Logo from './Logo.astro';
const nilai = ['Andal', 'Kualitas', 'Amanah', 'Lestari'];
---

<script is:inline>
  (function () {
    try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (sessionStorage.getItem('atapura-bumper')) return;
      sessionStorage.setItem('atapura-bumper', '1');
    } catch (e) { return; }
    document.documentElement.classList.add('ada-bumper');
  })();
</script>

<div class="bumper" data-bumper aria-hidden="true">
  <div class="bumper-isi">
    <svg class="bumper-atap" viewBox="0 0 120 80"><path d="M6 76 L60 6 L114 76" /></svg>
    <span class="bumper-logo"><Logo tinggi="clamp(1.8rem, 1.2rem + 2.4vw, 3rem)" /></span>
    <ul class="bumper-nilai">
      {nilai.map((n) => <li><b>{n[0]}</b>{n.slice(1)}</li>)}
    </ul>
  </div>
  <button type="button" class="bumper-lewati" tabindex="-1">Lewati</button>
</div>

<script>
  const b = document.querySelector<HTMLElement>('[data-bumper]');
  if (b && document.documentElement.classList.contains('ada-bumper')) {
    const selesai = () => { document.documentElement.classList.add('bumper-selesai'); setTimeout(() => b.remove(), 50); };
    b.addEventListener('animationend', (e) => { if (e.animationName.includes('bp-angkat')) selesai(); });
    const lewati = () => { b.classList.add('cepat'); };
    b.addEventListener('pointerdown', lewati);
    addEventListener('keydown', lewati, { once: true });
    addEventListener('wheel', lewati, { once: true, passive: true });
    setTimeout(selesai, 4000); // pengaman: apa pun yang terjadi, bumper hilang
  } else b?.remove();
</script>

<style>
  .bumper { display: none; }
  :global(html.ada-bumper:not(.bumper-selesai)) { overflow: hidden; }
  :global(html.ada-bumper) .bumper {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 100;
    background: radial-gradient(ellipse 70% 60% at 50% 45%, #183129 0%, var(--color-pinus) 70%);
    color: var(--color-embun);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 100%, 0 100%);
    animation: bp-angkat 900ms cubic-bezier(0.77, 0, 0.18, 1) 1750ms forwards;
  }
  /* Tepi bawah naik membentuk Λ, seperti atap terangkat membuka rumah. */
  @keyframes bp-angkat {
    60% { clip-path: polygon(0 0, 100% 0, 100% 45%, 50% 15%, 0 45%); }
    to { clip-path: polygon(0 0, 100% 0, 100% 0, 50% -40%, 0 0); }
  }
  .bumper.cepat, .bumper.cepat * { animation-delay: 0ms !important; animation-duration: 450ms !important; }

  .bumper-isi { display: grid; justify-items: center; gap: 1.4rem; }
  .bumper-atap { width: clamp(5rem, 3rem + 8vw, 9rem); overflow: visible; }
  .bumper-atap path {
    fill: none; stroke: var(--color-tunas); stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 190; stroke-dashoffset: 190; animation: bp-gambar 900ms cubic-bezier(0.65, 0, 0.35, 1) 100ms forwards;
  }
  @keyframes bp-gambar { to { stroke-dashoffset: 0; } }
  .bumper-logo { opacity: 0; translate: 0 14px; animation: bp-muncul 700ms var(--ease-out) 650ms forwards; }
  .bumper-nilai { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 1.6rem; font-size: clamp(0.85rem, 0.8rem + 0.3vw, 1rem); color: var(--embun-redup); }
  .bumper-nilai li { opacity: 0; translate: 0 10px; animation: bp-muncul 600ms var(--ease-out) forwards; }
  .bumper-nilai li:nth-child(1) { animation-delay: 950ms; }
  .bumper-nilai li:nth-child(2) { animation-delay: 1070ms; }
  .bumper-nilai li:nth-child(3) { animation-delay: 1190ms; }
  .bumper-nilai li:nth-child(4) { animation-delay: 1310ms; }
  .bumper-nilai b { color: var(--color-tunas); font-weight: 500; }
  @keyframes bp-muncul { to { opacity: 1; translate: 0 0; } }
  .bumper-lewati { position: absolute; right: 1.5rem; bottom: 1.5rem; font-size: 0.85rem; color: var(--embun-redup); padding: 0.6rem 1rem; cursor: pointer; }

  /* Hero menyambung: foto mendekat pelan, teks naik setelah atap terangkat. */
  :global(html.ada-bumper .hero-foto) { animation: bp-hero-dekat 2200ms cubic-bezier(0.16, 1, 0.3, 1) 1900ms backwards; }
  @keyframes bp-hero-dekat { from { scale: 1.18; } }
  :global(html.ada-bumper .hero-isi > *) { animation: bp-hero-naik 1000ms cubic-bezier(0.16, 1, 0.3, 1) backwards; }
  :global(html.ada-bumper .hero-isi > :nth-child(1)) { animation-delay: 2150ms; }
  :global(html.ada-bumper .hero-isi > :nth-child(2)) { animation-delay: 2280ms; }
  :global(html.ada-bumper .hero-isi > :nth-child(3)) { animation-delay: 2400ms; }
  @keyframes bp-hero-naik { from { opacity: 0; translate: 0 36px; } }
</style>
