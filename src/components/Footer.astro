---
// Footer pola Andermatt: tagline besar + satu ajakan di kiri, kolom tautan bertajuk di kanan,
// baris identitas, lalu baris legal. Latar gradasi gelap (pilihan Rama).
import { getCollection } from 'astro:content';
import { alamatLengkap, bisnis, waLink } from '../data/bisnis';
import Logo from './Logo.astro';
import ikonInstagram from '../assets/ikon/instagram.svg?raw';
import ikonTiktok from '../assets/ikon/tiktok.svg?raw';
import ikonThreads from '../assets/ikon/threads.svg?raw';
import ikonX from '../assets/ikon/x.svg?raw';
import ikonShopee from '../assets/ikon/shopee.svg?raw';
import ikonTokopedia from '../assets/ikon/tokopedia.svg?raw';
import ikonWhatsapp from '../assets/ikon/whatsapp.svg?raw';
import ikonEmail from '../assets/ikon/email.svg?raw';

interface Props {
  /** Bahasa footer: 'en' untuk halaman /en (ekspat). */
  lang?: 'id' | 'en';
}
const { lang = 'id' } = Astro.props;
const en = lang === 'en';
const waPesan = en ? 'Hi Atapura, I have a question about an asphalt shingle roof.' : 'Halo Atapura, saya mau tanya soal atap bitumen.';

const ikon: Record<string, string> = { instagram: ikonInstagram, tiktok: ikonTiktok, threads: ikonThreads, x: ikonX, shopee: ikonShopee, tokopedia: ikonTokopedia };
const sosial = [
  { nama: 'WhatsApp', url: waLink(waPesan), svg: ikonWhatsapp, luar: true },
  { nama: 'Email', url: `mailto:${bisnis.email}`, svg: ikonEmail, luar: false },
  ...bisnis.sosial.map((x) => ({ nama: x.nama, url: x.url, svg: ikon[x.id], luar: true })),
];

const tahun = new Date().getFullYear();
const panduan = (await getCollection('panduan')).sort((a, b) => b.data.diperbarui.getTime() - a.data.diperbarui.getTime()).slice(0, 3);
const singkat = (j: string) => j.split(/[:?,]/)[0];

type Kolom = { judul: string; tautan: { label: string; href: string; luar?: boolean }[] }[];
const guides = en ? (await getCollection('guides')).sort((a, b) => b.data.diperbarui.getTime() - a.data.diperbarui.getTime()).slice(0, 3) : [];
const kolomEn: Kolom = [
  { judul: 'Guides', tautan: [...guides.map((g) => ({ label: singkat(g.data.judul), href: `/en/guides/${g.id}` })), { label: 'All guides', href: '/en/guides' }] },
  { judul: 'Indonesian site', tautan: [{ label: 'Home', href: '/' }, { label: 'Cost estimator', href: '/hitung' }, { label: 'Guides (Indonesian)', href: '/panduan' }, { label: 'Service areas', href: '/area' }] },
  { judul: 'Contact', tautan: [{ label: 'WhatsApp', href: waLink(waPesan), luar: true }, { label: 'Email', href: `mailto:${bisnis.email}` }] },
];
const kolomId: Kolom = [
  {
    judul: 'Layanan',
    tautan: [
      { label: 'Produk & layanan', href: '/produk' },
      { label: 'Pasang atap baru', href: '/#layanan' },
      { label: 'Ganti atap lama', href: '/#layanan' },
      { label: 'Perbaikan atap bocor', href: '/#layanan' },
      { label: 'Villa & kafe', href: '/#layanan' },
      { label: 'Proyek perusahaan', href: '/perusahaan' },
    ],
  },
  {
    judul: 'Biaya & garansi',
    tautan: [
      { label: 'Hitung biaya', href: '/hitung' },
      { label: 'Pilih merek', href: '/#merek' },
      { label: 'Termin pembayaran', href: '/garansi#bayar' },
      { label: `Garansi ${bisnis.garansiPemasanganTahun} tahun`, href: '/garansi' },
    ],
  },
  {
    judul: 'Panduan',
    tautan: [...panduan.map((p) => ({ label: singkat(p.data.judul), href: `/panduan/${p.id}` })), { label: 'Semua panduan', href: '/panduan' }],
  },
  {
    judul: 'Area layanan',
    tautan: [
      { label: 'Jabodetabek', href: '/area#jabodetabek' },
      { label: 'Luar Jabodetabek', href: '/area#luar-jabodetabek' },
      { label: 'Semua area', href: '/area' },
    ],
  },
  {
    judul: 'Kontak',
    tautan: [
      { label: 'WhatsApp', href: waLink(waPesan), luar: true },
      { label: 'Email', href: `mailto:${bisnis.email}` },
      { label: 'Alamat & kontak', href: '/kontak' },
      ...(bisnis.telepon ? [{ label: `+${bisnis.telepon}`, href: `tel:+${bisnis.telepon}` }] : []),
    ],
  },
  {
    judul: 'Atapura',
    tautan: [
      { label: 'Tentang Atapura', href: '/tentang' },
      { label: 'Cara kerja', href: '/cara-kerja' },
      { label: 'Untuk perusahaan', href: '/perusahaan' },
    ],
  },
];
const kolom = en ? kolomEn : kolomId;
---

<footer class="kaki">
  <div class="wrap kaki-atas">
    <div class="kaki-tagline">
      <p class="kaki-besar">{en ? 'Asphalt shingle roofs, installed right, from Jakarta.' : 'Atap yang masuk AKAL, untuk rumah di Jabodetabek.'}</p>
      <a class="kaki-aksi" href={en ? '/en/guides' : '/hitung'}>{en ? 'Read the guides' : 'Hitung estimasi biaya'}</a>
    </div>
    <nav class="kaki-kolom" aria-label={en ? 'Footer links' : 'Tautan footer'}>
      {kolom.map((k) => (
        <div>
          <p class="kaki-judul">{k.judul}</p>
          <ul>
            {k.tautan.map((t) => (
              <li><a href={t.href} {...(t.luar ? { target: '_blank', rel: 'noopener', 'data-wa': 'footer' } : {})}>{t.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="wrap kaki-identitas">
    <div class="kaki-legal-grup">
      {en ? (
        <p class="kaki-legal kaki-legal-pt">{bisnis.namaLegal} (being incorporated).<br />Founded by {bisnis.pendiri.join(' and ')}. Free site survey in {bisnis.area.length} cities and regencies of Greater Jakarta.<br />{alamatLengkap}</p>
      ) : (
        <p class="kaki-legal kaki-legal-pt">{bisnis.namaLegal} ({bisnis.statusLegal}).<br />Didirikan oleh {bisnis.pendiri.join(' dan ')}. Survey gratis di {bisnis.area.length} kota dan kabupaten Jabodetabek.<br />{alamatLengkap}</p>
      )}
      <ul class="kaki-sosial" aria-label={en ? 'Contact and social media' : 'Kontak dan media sosial'}>
        {sosial.filter((x) => x.url).map((x) => (
          <li>
            {/* Akun yang belum ada tidak ditampilkan (audit 23 Nov: ikon "segera hadir" melemahkan kepercayaan). */}
            <a href={x.url!} aria-label={x.nama} title={x.nama} {...(x.luar ? { target: '_blank', rel: 'noopener' } : {})} data-wa={x.nama === 'WhatsApp' ? 'footer' : undefined} set:html={x.svg} />
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap kaki-bawah">
    <p>© {tahun} Atapura</p>
    <p>{en ? 'Photos of houses, villas, cafés, rain, and workers are AI-generated illustrations, not Atapura projects. Icons: Simple Icons (CC0), Arcticons (CC BY-SA 4.0).' : 'Foto rumah, villa, kafe, hujan, dan tukang adalah ilustrasi buatan AI, bukan proyek Atapura. Ikon: Simple Icons (CC0), Arcticons (CC BY-SA 4.0).'}</p>
  </div>
  <div class="wrap kaki-merek"><Logo tinggi="auto" /><span class="sr-only">Atapura</span></div>
</footer>

<style>
  /* Tipografi footer (acuan Andermatt): judul kolom seukuran tautan & menempel ke daftarnya,
     tautan rapat satu ritme, tagline kompak. Skala: tagline 2.4rem / isi 1rem / legal 0.875rem. */
  .kaki {
    background:
      radial-gradient(50% 70% at 8% 0%, rgb(198 242 78 / 0.10), transparent 70%),
      radial-gradient(45% 75% at 96% 100%, rgb(242 182 107 / 0.16), transparent 70%),
      radial-gradient(40% 60% at 60% 30%, rgb(76 94 85 / 0.22), transparent 70%),
      linear-gradient(180deg, #10231e 0%, #0b1714 100%);
    color: var(--color-embun); padding-top: clamp(4rem, 7vw, 6.5rem); padding-bottom: 2rem; border-top: 1px solid rgb(242 244 241 / 0.08); }
  .kaki-atas { display: grid; gap: 3rem 4rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 64rem) { .kaki-atas { grid-template-columns: minmax(0, 1fr) minmax(0, 1.9fr); } }
  .kaki-besar { font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.12; max-width: 16ch; text-wrap: balance; }
  .kaki-aksi {
    display: inline-block; margin-top: 1.25rem; font-size: var(--fs-16); font-weight: 500; color: var(--color-embun);
    text-decoration: underline; text-decoration-color: var(--color-tunas); text-decoration-thickness: 2px; text-underline-offset: 0.4em;
  }
  .kaki-aksi:hover { color: var(--color-tunas); }
  .kaki-kolom { display: grid; gap: 2.75rem 2rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 48rem) { .kaki-kolom { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .kaki-judul { font-size: var(--fs-16); line-height: 1.4; font-weight: 500; color: var(--color-embun); padding-bottom: 0.15rem; }
  .kaki-kolom ul { display: grid; }
  .kaki-kolom li { font-size: var(--fs-16); line-height: 1.5; }
  .kaki-kolom li + li { margin-top: 0.12rem; }
  .kaki-kolom a { color: rgb(242 244 241 / 0.62); text-decoration: none; transition: color 200ms; }
  .kaki-kolom a:hover { color: var(--color-tunas); text-decoration: underline; text-underline-offset: 0.25em; }
  .kaki-identitas {
    margin-top: clamp(3.5rem, 6vw, 5.5rem); display: grid; gap: 1rem 4rem; align-items: start;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 64rem) { .kaki-identitas { grid-template-columns: minmax(0, 1fr) minmax(0, 1.9fr); } }
  /* Legal mengikuti grid kolom tautan di atasnya: PT selebar 2 kolom, area di kolom ke-3. */
  .kaki-legal-grup { display: grid; gap: 1rem 2rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 48rem) { .kaki-legal-grup { grid-template-columns: repeat(3, minmax(0, 1fr)); } .kaki-legal-pt { grid-column: span 2; } }
  @media (min-width: 64rem) { .kaki-legal-grup { grid-column: 2; } }
  /* Wordmark raksasa selebar konten (acuan Harper Ave.), logo resmi lewat komponen Logo. */
  .kaki-merek { margin-top: clamp(2.5rem, 5vw, 4rem); color: var(--color-embun); }
  .kaki-merek :global(.logo) { display: block; width: 100%; height: auto; }
  .kaki-legal { font-size: var(--fs-14); line-height: 1.6; color: rgb(242 244 241 / 0.6); }
  .kaki-sosial { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .kaki-sosial a {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; color: var(--color-embun);
    background: rgb(242 244 241 / 0.07); box-shadow: inset 0 0 0 1px rgb(242 244 241 / 0.12); transition: background-color 250ms, color 250ms, transform 250ms var(--ease-out);
  }
  .kaki-sosial :global(svg) { width: 18px; height: 18px; }
  .kaki-sosial a:hover { background: var(--color-tunas); color: var(--color-pinus); transform: translateY(-2px); }
  .kaki-bawah {
    margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid rgb(242 244 241 / 0.1);
    display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; justify-content: space-between; font-size: var(--fs-14); line-height: 1.6; color: rgb(242 244 241 / 0.5);
  }
  @media (max-width: 47.99rem) { .kaki-besar { font-size: var(--hp-t2); } }
</style>
