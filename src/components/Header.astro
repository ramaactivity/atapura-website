---
import { waLink } from '../data/bisnis';
import Logo from './Logo.astro';
import ikonWhatsapp from '../assets/ikon/whatsapp.svg?raw';

interface Props {
  /** Halaman berlatar terang (artikel): teks & logo gelap di semua ukuran layar. */
  terang?: boolean;
}
const { terang = false } = Astro.props;

const menu = [
  { href: '/#hitung', label: 'Hitung biaya' },
  { href: '/#layanan', label: 'Layanan' },
  { href: '/#garansi', label: 'Garansi' },
  { href: '/panduan', label: 'Panduan' },
  { href: '/#warna', label: 'Warna' },
];
// Menu HP: daftar lebih lengkap karena tidak ada navigasi lain di layar kecil.
const menuHp = [
  { href: '/#hitung', label: 'Hitung biaya' },
  { href: '/#layanan', label: 'Layanan' },
  { href: '/#cara-kerja', label: 'Cara kerja' },
  { href: '/#garansi', label: 'Bayar & garansi' },
  { href: '/#merek', label: 'Pilih merek' },
  { href: '/#warna', label: 'Warna' },
  { href: '/#area', label: 'Area survey' },
  { href: '/#tanya', label: 'Tanya jawab' },
  { href: '/panduan', label: 'Panduan' },
];
---

<header class:list={["kepala no-print", { "kepala-terang": terang }]}>
  <div class="wrap kepala-isi">
    <a href="/" class="merek-kata" aria-label="Atapura, ke beranda"><Logo tinggi="1.3rem" /></a>
    <nav aria-label="Utama" class="kepala-nav">
      {menu.map((m) => <a href={m.href}>{m.label}</a>)}
    </nav>
    <a class="pill kepala-perusahaan" href="/#layanan-proyek">Untuk perusahaan</a>
    <a class="pill kepala-wa" href={waLink('Halo Atapura, saya mau tanya soal atap bitumen.')} target="_blank" rel="noopener" data-wa="header">
      Chat WhatsApp
    </a>
    <button type="button" class="kepala-menu" aria-haspopup="dialog" aria-controls="menu-hp" data-buka-menu>
      <span class="kepala-garis" aria-hidden="true"></span>Menu
    </button>
  </div>
</header>

<dialog id="menu-hp" class="lembar-menu no-print" aria-label="Menu" data-menu-hp>
  <div class="lembar-pegangan" aria-hidden="true"></div>
  <nav aria-label="Menu HP">
    <ul class="lembar-daftar">
      {menuHp.map((m) => <li><a href={m.href} data-tutup-menu>{m.label}</a></li>)}
    </ul>
  </nav>
  <div class="lembar-aksi">
    <a class="pill pill-tunas" href="/#hitung" data-tutup-menu>Hitung estimasi biaya</a>
    <a class="pill pill-garis" href="/#layanan-proyek" data-tutup-menu>Untuk perusahaan &amp; proyek</a>
  </div>
  <button type="button" class="lembar-tutup" data-tutup-menu aria-label="Tutup menu">Tutup</button>
</dialog>

<!-- Bilah tab bawah (HP saja): pola aplikasi native, jangkauan jempol. Chat di tengah sebagai aksi utama. -->
<nav class="tabbar no-print" aria-label="Navigasi cepat" data-tabbar>
  <a class="tab" href="/" data-tab="beranda">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.4 12 4l8 6.4V19a1.5 1.5 0 0 1-1.5 1.5H15v-5.5H9v5.5H5.5A1.5 1.5 0 0 1 4 19z" /></svg>
    <span>Beranda</span>
  </a>
  <a class="tab" href="/#hitung" data-tab="hitung">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="3" /><path d="M8.5 7.5h7M9 12h.01M12 12h.01M15 12h.01M9 15.5h.01M12 15.5h.01M15 15.5h.01" /></svg>
    <span>Hitung</span>
  </a>
  <a class="tab tab-chat" href={waLink('Halo Atapura, saya mau tanya soal atap bitumen.')} target="_blank" rel="noopener" data-wa="tabbar">
    <span class="tab-bulat" set:html={ikonWhatsapp} />
    <span>Chat</span>
  </a>
  <a class="tab" href="/#merek" data-tab="merek">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 12.2V4.5a1 1 0 0 1 1-1h7.7l8.3 8.3a1.5 1.5 0 0 1 0 2.1l-6.6 6.6a1.5 1.5 0 0 1-2.1 0z" /><circle cx="8" cy="8" r="1.4" /></svg>
    <span>Merek</span>
  </a>
  <a class="tab" href="/#garansi" data-tab="garansi">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 5.8v5.6c0 4.3 2.9 7.9 7 9.6 4.1-1.7 7-5.3 7-9.6V5.8z" /><path d="m9 12 2.1 2.1L15.2 10" /></svg>
    <span>Garansi</span>
  </a>
</nav>

<script>
  // HP: bilah atas berubah jadi kaca buram setelah halaman digulir (seperti nav bar iOS).
  const kepala = document.querySelector<HTMLElement>('.kepala');
  if (kepala) {
    let antre = 0;
    const cek = () => { antre = 0; kepala.classList.toggle('kepala-gulir', scrollY > 12); };
    addEventListener('scroll', () => { if (!antre) antre = requestAnimationFrame(cek); }, { passive: true });
    cek();
  }

  // Tab aktif mengikuti bagian beranda yang sedang dibaca.
  const tabbar = document.querySelector<HTMLElement>('[data-tabbar]');
  if (tabbar) {
    const tab = [...tabbar.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const aktif = (id: string | null) => tab.forEach((t) => (t.dataset.tab === id ? t.setAttribute('aria-current', 'page') : t.removeAttribute('aria-current')));
    const diBeranda = location.pathname === '/' || location.pathname === '/index';
    if (diBeranda) {
      aktif('beranda');
      const peta: Record<string, string> = { hitung: 'hitung', merek: 'merek', warna: 'merek', garansi: 'garansi' };
      const bagian = [...document.querySelectorAll<HTMLElement>('main section[id], main [id=hitung]')];
      const io = new IntersectionObserver((es) => {
        for (const e of es) if (e.isIntersecting) aktif(peta[e.target.id] ?? 'beranda');
      }, { rootMargin: '-45% 0px -50% 0px' });
      bagian.forEach((b) => io.observe(b));
      // Beranda diketuk saat sudah di beranda: kembali ke atas.
      tab[0].addEventListener('click', (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: 'smooth' }); });
    }
  }

  const menu = document.querySelector<HTMLDialogElement>('[data-menu-hp]');
  const buka = document.querySelector<HTMLButtonElement>('[data-buka-menu]');
  if (menu && buka) {
    buka.addEventListener('click', () => menu.showModal());
    // Tutup lewat tautan, tombol, atau ketuk area gelap di luar lembar.
    menu.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === menu || t.closest('[data-tutup-menu]')) menu.close();
    });
  }
</script>

<style>
  .kepala { position: absolute; inset: 0 0 auto; z-index: 20; color: var(--color-putih); }
  .kepala-isi { display: flex; align-items: center; gap: 2rem; min-height: 80px; }
  .merek-kata { display: inline-flex; align-items: center; min-height: 44px; color: inherit; filter: drop-shadow(0 1px 8px rgb(0 0 0 / 0.3)); }
  .kepala-nav { display: none; gap: 1.75rem; margin-left: auto; font-size: 0.95rem; }
  .kepala-nav a { color: inherit; text-decoration: none; padding-block: 0.6rem; opacity: 0.8; transition: opacity 200ms; }
  .kepala-nav a:hover { opacity: 1; }
  .kepala-wa { margin-left: auto; min-height: 44px; padding-inline: 1.2rem; font-size: 0.92rem; background: var(--color-pinus); color: var(--color-putih); }
  .kepala-wa:hover { background: var(--color-pinus-2); }
  .kepala-perusahaan { display: none; min-height: 44px; padding-inline: 1.2rem; font-size: 0.92rem; border: 1px solid currentColor; color: inherit; }
  .kepala-menu {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 1rem; margin-left: -1.25rem;
    border-radius: 999px; font-size: 0.9rem; font-weight: 500; color: inherit; cursor: pointer;
    background: var(--color-embun); color: var(--color-pinus);
  }
  .kepala-garis, .kepala-garis::before { display: block; width: 14px; height: 1.5px; background: currentColor; border-radius: 2px; }
  .kepala-garis { position: relative; transform: translateY(-2.5px); }
  .kepala-garis::before { content: ''; position: absolute; top: 5px; }
  @media (max-width: 47.99rem) {
    .kepala-isi { min-height: 64px; gap: 1.25rem; }
    .kepala-wa { min-height: 44px; padding-inline: 1rem; font-size: 0.85rem; }
  }

  /* Lembar menu dari bawah (pola aplikasi HP). */
  .lembar-menu {
    position: fixed; inset: auto 0 0 0; margin: 0; width: 100%; max-width: none; max-height: 88svh; overflow: auto;
    border: 0; border-radius: 24px 24px 0 0; padding: 0.75rem 20px calc(1.25rem + env(safe-area-inset-bottom));
    background: var(--color-embun); color: var(--color-tinta);
    box-shadow: 0 -20px 40px -20px rgb(16 35 30 / 0.45);
    translate: 0 100%; transition: translate 420ms var(--ease-out), overlay 420ms allow-discrete, display 420ms allow-discrete;
  }
  .lembar-menu[open] { translate: 0 0; }
  @starting-style { .lembar-menu[open] { translate: 0 100%; } }
  .lembar-menu::backdrop { background: rgb(11 23 20 / 0); transition: background-color 420ms, overlay 420ms allow-discrete, display 420ms allow-discrete; }
  .lembar-menu[open]::backdrop { background: rgb(11 23 20 / 0.5); }
  @starting-style { .lembar-menu[open]::backdrop { background: rgb(11 23 20 / 0); } }
  .lembar-pegangan { width: 36px; height: 4px; border-radius: 2px; background: var(--color-garis); margin: 0 auto 0.75rem; }
  .lembar-daftar { display: grid; }
  .lembar-daftar a {
    display: flex; align-items: center; min-height: 50px; font-size: 1.15rem; font-weight: 500; letter-spacing: -0.02em;
    color: var(--color-tinta); text-decoration: none; border-bottom: 1px solid var(--color-garis);
  }
  .lembar-aksi { display: grid; gap: 0.5rem; margin-top: 1.25rem; }
  .lembar-aksi .pill { min-height: 50px; }
  .lembar-aksi .pill-garis { color: var(--color-pinus); }
  .lembar-tutup { display: block; width: 100%; min-height: 44px; margin-top: 0.5rem; font-size: 0.95rem; color: var(--color-lumut); cursor: pointer; }
  @media (prefers-reduced-motion: reduce) { .lembar-menu, .lembar-menu::backdrop { transition: none; } }
  .kepala-terang { color: var(--color-pinus); }
  .kepala-terang .merek-kata { filter: none; }
  @media (min-width: 64rem) {
    .kepala { color: var(--color-pinus); }
    .merek-kata { filter: none; }
    .kepala-nav { display: flex; }
    .kepala-wa { margin-left: 0; }
    .kepala-perusahaan { display: inline-flex; }
    .kepala-menu { display: none; }
  }

  /* ── HP: kerangka aplikasi native (acuan iOS HIG) ──────────────────────────────────────────
     Bilah atas 52 pt menempel (transparan di atas hero, kaca buram setelah digulir),
     bilah tab bawah 49 pt + area home indicator. Chat jadi aksi utama di tengah. */
  .tabbar { display: none; }
  @media (max-width: 47.99rem) {
    .kepala {
      position: fixed; padding-top: env(safe-area-inset-top);
      transition: background-color 300ms, color 300ms, box-shadow 300ms, -webkit-backdrop-filter 300ms, backdrop-filter 300ms;
    }
    .kepala-isi { min-height: 52px; gap: 0.75rem; }
    .kepala-wa { display: none; }
    .kepala-menu { margin-left: auto; min-height: 36px; padding: 0 0.85rem; font-size: 0.8125rem; position: relative; }
    .kepala-menu::after { content: ''; position: absolute; inset: -4px; } /* area sentuh 44 pt */
    .kepala-gulir {
      color: var(--color-pinus); background: rgb(242 244 241 / 0.78);
      -webkit-backdrop-filter: blur(20px) saturate(1.6); backdrop-filter: blur(20px) saturate(1.6);
      box-shadow: 0 0.5px 0 rgb(16 35 30 / 0.14);
    }
    .kepala-gulir .merek-kata { filter: none; }
    .kepala-gulir .kepala-menu { background: rgb(16 35 30 / 0.07); }

    .tabbar {
      display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); position: fixed; inset: auto 0 0; z-index: 30;
      padding: 0 4px env(safe-area-inset-bottom);
      background: rgb(242 244 241 / 0.82);
      -webkit-backdrop-filter: blur(20px) saturate(1.6); backdrop-filter: blur(20px) saturate(1.6);
      box-shadow: 0 -0.5px 0 rgb(16 35 30 / 0.16);
    }
    .tab {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-height: 49px;
      font-size: 0.65625rem; font-weight: 500; letter-spacing: 0.01em; line-height: 1;
      color: rgb(16 35 30 / 0.48); text-decoration: none; -webkit-tap-highlight-color: transparent;
      transition: color 200ms;
    }
    .tab svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; transition: transform 160ms var(--ease-out); }
    .tab:active svg, .tab:active .tab-bulat { transform: scale(0.88); }
    .tab[aria-current='page'] { color: var(--color-pinus); }
    .tab[aria-current='page'] svg { fill: rgb(198 242 78 / 0.55); }
    .tab-chat { color: var(--color-pinus); }
    .tab-bulat {
      display: grid; place-items: center; width: 44px; height: 44px; margin-top: -16px; border-radius: 50%;
      background: var(--color-tunas); color: var(--color-pinus);
      box-shadow: 0 6px 16px -6px rgb(16 35 30 / 0.45), 0 0 0 4px rgb(242 244 241 / 0.9);
      transition: transform 160ms var(--ease-out);
    }
    .tab-bulat :global(svg) { width: 22px; height: 22px; fill: currentColor; stroke: none; }
  }
  @media (prefers-reduced-motion: reduce) { .kepala, .tab, .tab svg { transition: none; } }
</style>
