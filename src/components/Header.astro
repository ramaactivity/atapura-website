---
import { waLink } from '../data/bisnis';
import Logo from './Logo.astro';

const menu = [
  { href: '#hitung', label: 'Hitung biaya' },
  { href: '#layanan', label: 'Layanan' },
  { href: '#cara-kerja', label: 'Cara kerja' },
  { href: '#garansi', label: 'Garansi' },
  { href: '#warna', label: 'Warna' },
];
---

<header class="kepala no-print">
  <div class="wrap kepala-isi">
    <a href="/" class="merek-kata" aria-label="Atapura, ke beranda"><Logo tinggi="1.3rem" /></a>
    <nav aria-label="Utama" class="kepala-nav">
      {menu.map((m) => <a href={m.href}>{m.label}</a>)}
    </nav>
    <a class="pill kepala-perusahaan" href="#layanan-proyek">Untuk perusahaan</a>
    <a class="pill kepala-wa" href={waLink('Halo Atapura, saya mau tanya soal atap bitumen.')} target="_blank" rel="noopener" data-wa="header">
      Chat WhatsApp
    </a>
  </div>
</header>

<style>
  .kepala { position: absolute; inset: 0 0 auto; z-index: 20; color: var(--color-putih); }
  .kepala-isi { display: flex; align-items: center; gap: 2rem; min-height: 80px; }
  .merek-kata { display: inline-flex; align-items: center; min-height: 44px; color: inherit; filter: drop-shadow(0 1px 8px rgb(0 0 0 / 0.3)); }
  .kepala-nav { display: none; gap: 1.75rem; margin-left: auto; font-size: 0.95rem; }
  .kepala-nav a { color: inherit; text-decoration: none; padding-block: 0.6rem; opacity: 0.8; transition: opacity 200ms; }
  .kepala-nav a:hover { opacity: 1; }
  .kepala-wa { margin-left: auto; min-height: 44px; padding-inline: 1.2rem; font-size: 0.92rem; background: var(--color-pinus); color: var(--color-putih); }
  .kepala-wa:hover { background: var(--color-pinus-2); }
  .kepala-perusahaan { display: none; min-height: 44px; padding-inline: 1.2rem; font-size: 0.92rem; border: 1px solid currentColor; color: inherit; }
  @media (min-width: 64rem) {
    .kepala { color: var(--color-pinus); }
    .merek-kata { filter: none; }
    .kepala-nav { display: flex; }
    .kepala-wa { margin-left: 0; }
    .kepala-perusahaan { display: inline-flex; }
  }
</style>
