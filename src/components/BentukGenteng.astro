---
// Gambar bentuk potongan satu lembar genteng aspal (diagram, bukan foto): bagian atas = area tertutup,
// bagian bawah = lidah yang terlihat setelah terpasang. Satu gaya garis untuk semua bentuk.
import type { Bentuk } from '../data/produk';

interface Props {
  bentuk: Bentuk;
  label: string;
}
const { bentuk, label } = Astro.props;

// Lidah yang terlihat (y 40–80) per bentuk, lebar lembar 0–240.
const lidah: Record<Bentuk, string> = {
  tab3: 'M0 40 H240 V80 H160 V44 H158 V80 H82 V44 H80 V80 H0 Z',
  persegi: 'M0 40 H240 V80 H160 V44 H158 V80 H82 V44 H80 V80 H0 Z',
  zigzag: 'M0 40 H240 V70 H214 V80 H176 V56 H150 V80 H118 V64 H86 V80 H52 V60 H26 V80 H0 Z',
  heksagonal: 'M0 40 H240 V58 L224 80 H176 L160 58 L144 80 H96 L80 58 L64 80 H16 L0 58 Z',
  laminasi: 'M0 40 H240 V80 H206 V66 H170 V80 H128 V60 H96 V80 H58 V68 H24 V80 H0 Z',
  sisik: 'M0 40 H240 V64 A20 16 0 0 1 200 64 A20 16 0 0 1 160 64 A20 16 0 0 1 120 64 A20 16 0 0 1 80 64 A20 16 0 0 1 40 64 A20 16 0 0 1 0 64 Z',
  mosaik: 'M0 40 H240 V80 H212 V60 H186 V80 H150 V66 H128 V80 H100 V58 H70 V80 H42 V64 H20 V80 H0 Z',
};
// Laminasi: lapis kedua di belakang lidah (lebih gelap), memberi kesan dua lapis.
const lapisDua = bentuk === 'laminasi';
---

<svg class="bg" viewBox="-4 -4 248 92" role="img" aria-label={label}>
  <rect x="0" y="0" width="240" height="40" rx="2" class="bg-tutup" />
  <line x1="0" y1="40" x2="240" y2="40" class="bg-lem" />
  {lapisDua && <rect x="0" y="40" width="240" height="40" class="bg-dua" />}
  <path d={lidah[bentuk]} class="bg-lidah" />
</svg>

<style>
  .bg { display: block; width: 100%; height: auto; overflow: visible; }
  .bg-tutup { fill: var(--color-embun); stroke: var(--color-garis); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .bg-lem { stroke: var(--color-lumut); stroke-width: 1; stroke-dasharray: 3 4; vector-effect: non-scaling-stroke; opacity: 0.6; }
  .bg-dua { fill: color-mix(in oklab, var(--color-pinus) 55%, var(--color-lumut)); }
  .bg-lidah { fill: var(--color-pinus); stroke: var(--color-pinus); stroke-width: 1; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
</style>
