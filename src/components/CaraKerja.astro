---
// Tahapan dari bahan/atapura/01-PRODUCT-SPEC.md (/cara-kerja), disajikan sebagai tab di atas latar suasana
// (pola askmidnight.com). Tiap tahap menjawab: apa yang Anda pegang di tahap ini.
import { tahap } from '../data/cara-kerja';

---

<div class="ck" data-tab-kerja>
  <div class="ck-tab" role="tablist" aria-label="Tahap pemasangan">
    {tahap.map((t, i) => (
      <button type="button" role="tab" id={`ck-tab-${i}`} aria-controls={`ck-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="ck-tombol">
        <span class="ck-no">{String(i + 1).padStart(2, '0')}</span>{t.nama}
      </button>
    ))}
  </div>
  <div class="ck-kartu">
    {tahap.map((t, i) => (
      <section class="ck-panel" role="tabpanel" id={`ck-panel-${i}`} aria-labelledby={`ck-tab-${i}`} data-aktif={String(i === 0)} inert={i !== 0} style={`--i: ${i}`}>
        <p class="ck-tahap" aria-hidden="true"><span>{String(i + 1).padStart(2, '0')}</span>{t.nama}</p>
        <h3 class="ck-judul">{t.judul}</h3>
        <div class="ck-kanan">
          <p class="ck-pegang"><span>Yang Anda pegang</span>{t.pegang}</p>
          <p class="ck-isi">{t.isi}</p>
        </div>
      </section>
    ))}
  </div>
</div>

<script>
  // HP: tab diganti tumpukan kartu yang menempel saat digulir; semua tahap terbaca, tidak ada yang inert.
  const tumpuk = matchMedia('(max-width: 47.99rem)');
  for (const root of document.querySelectorAll<HTMLElement>('[data-tab-kerja]')) {
    if (tumpuk.matches) {
      root.querySelectorAll<HTMLElement>('[role=tabpanel]').forEach((p) => { p.inert = false; p.dataset.aktif = 'true'; });
      continue;
    }
    const tab = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panel = root.querySelectorAll<HTMLElement>('[role=tabpanel]');
    const daftar = root.querySelector<HTMLElement>('[role=tablist]')!;
    // Tepi daftar memudar hanya di sisi yang masih bisa digeser.
    const kartu = root.querySelector<HTMLElement>('.ck-kartu')!;
    const tepi = () => {
      daftar.dataset.kiri = String(daftar.scrollLeft > 4);
      daftar.dataset.kanan = String(daftar.scrollLeft + daftar.clientWidth < daftar.scrollWidth - 4);
      // Tab aktif yang menempel di tepi kartu: sudut kartu di sisi itu dibuat siku dan lengkung cekungnya
      // disembunyikan, supaya tab dan kartu tetap satu bentuk (tidak ada lengkung menggantung di luar kartu).
      const a = root.querySelector<HTMLElement>('[role=tab][aria-selected=true]');
      if (!a) return;
      const k = kartu.getBoundingClientRect(), r = a.getBoundingClientRect();
      root.dataset.siku = r.left - k.left < 20 ? 'kiri' : k.right - r.right < 20 ? 'kanan' : '';
    };
    daftar.addEventListener('scroll', tepi, { passive: true });
    addEventListener('resize', tepi);
    tepi();
    const pilih = (i: number, fokus = false) => {
      tab.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      // Kartu tetap diam; hanya isi yang berganti (semua panel menumpuk di satu sel grid, tinggi tidak meloncat).
      panel.forEach((p, j) => { p.dataset.aktif = String(i === j); p.inert = i !== j; });
      // Tab terpilih digeser ke tengah daftar (hanya gulir horizontal, halaman tidak ikut melompat).
      daftar.scrollTo({ left: tab[i].offsetLeft - (daftar.clientWidth - tab[i].offsetWidth) / 2, behavior: 'smooth' });
      tepi();
      if (fokus) tab[i].focus({ preventScroll: true });
    };
    tab.forEach((t, i) => {
      t.addEventListener('click', () => pilih(i));
      t.addEventListener('keydown', (e) => {
        const arah = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (arah) { e.preventDefault(); pilih((i + arah + tab.length) % tab.length, true); }
      });
    });
  }
</script>

<style>
  .ck-tab { display: flex; gap: 0.25rem; overflow-x: auto; scrollbar-width: none; --pudar-kiri: 0px; --pudar-kanan: 0px;
    mask-image: linear-gradient(to right, transparent, #000 var(--pudar-kiri), #000 calc(100% - var(--pudar-kanan)), transparent); }
  .ck-tab[data-kiri='true'] { --pudar-kiri: 28px; }
  .ck-tab[data-kanan='true'] { --pudar-kanan: 28px; }
  .ck-tab::-webkit-scrollbar { display: none; }
  .ck-tombol {
    flex: none; display: inline-flex; align-items: center; gap: 0.45rem; min-height: 52px; padding: 0 1.2rem;
    position: relative; border-radius: 14px 14px 0 0; color: rgb(242 244 241 / 0.78); font-size: var(--fs-16); cursor: pointer;
    transition: color 200ms;
  }
  .ck-tombol:hover { color: var(--color-embun); }
  .ck-tombol[aria-selected='true'] { background: var(--color-embun); color: var(--color-tinta); }
  /* Lengkung cekung di kaki tab aktif supaya tab dan kartu jadi satu bentuk (tab pertama terpotong rapi oleh tepi daftar). */
  .ck-tombol[aria-selected='true']::before, .ck-tombol[aria-selected='true']::after {
    content: ''; position: absolute; bottom: 0; width: 14px; height: 14px; pointer-events: none;
  }
  .ck-tombol[aria-selected='true']::before { left: -14px; background: radial-gradient(circle at 0 0, transparent 13.5px, var(--color-embun) 14px); }
  .ck-tombol[aria-selected='true']::after { right: -14px; background: radial-gradient(circle at 100% 0, transparent 13.5px, var(--color-embun) 14px); }
  /* Tab menumpuk 1px di atas kartu: tanpa ini garis rambut muncul di antara tab aktif dan kartu (pembulatan subpiksel). */
  .ck-tab { position: relative; z-index: 1; margin-bottom: -1px; }
  .ck-kartu { display: grid; background: var(--color-embun); color: var(--color-tinta); border-radius: 18px; transition: border-radius 200ms; }
  .ck[data-siku='kiri'] .ck-kartu { border-top-left-radius: 0; }
  .ck[data-siku='kanan'] .ck-kartu { border-top-right-radius: 0; }
  .ck[data-siku='kiri'] .ck-tombol[aria-selected='true']::before, .ck[data-siku='kanan'] .ck-tombol[aria-selected='true']::after { display: none; }
  .ck-no { font-size: var(--fs-13); opacity: 0.6; font-variant-numeric: tabular-nums; }
  .ck-panel {
    grid-area: 1 / 1; display: grid; gap: 1.5rem 4rem; grid-template-columns: minmax(0, 1fr); padding: clamp(1.75rem, 4vw, 4rem);
    min-height: 18rem; align-items: center;
    transition: opacity 380ms var(--ease-out) 150ms, translate 500ms var(--ease-out) 150ms, visibility 0s 150ms;
  }
  .ck-panel[data-aktif='false'] {
    opacity: 0; translate: 0 8px; visibility: hidden;
    transition: opacity 140ms ease-in, translate 140ms ease-in, visibility 0s 140ms;
  }
  @media (min-width: 64rem) { .ck-panel { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }
  .ck-judul { font-size: var(--t-h2); font-weight: var(--bobot-judul); letter-spacing: -0.024em; line-height: 1.23; max-width: 20ch; }
  .ck-kanan { display: grid; gap: 1rem; }
  .ck-pegang { font-size: var(--t-h3); font-weight: var(--bobot-judul); letter-spacing: -0.011em; line-height: 1.27; }
  .ck-pegang span { display: block; font-size: var(--fs-13); font-weight: 500; letter-spacing: 0; color: var(--color-lumut); margin-bottom: 0.4rem; }
  .ck-isi { color: var(--color-lumut); max-width: 46ch; }
  /* HP: ditaruh paling akhir supaya tidak tertimpa aturan dasar di atas. */
  @media (max-width: 47.99rem) {
    .ck-tab { gap: 0; }
    .ck-tombol { min-height: var(--hp-tombol); padding: 0 0.85rem; font-size: var(--fs-14); gap: 0.3rem; border-radius: 12px 12px 0 0; }
    .ck-tombol[aria-selected='true']::before, .ck-tombol[aria-selected='true']::after { width: 12px; height: 12px; }
    .ck-tombol[aria-selected='true']::before { left: -12px; background: radial-gradient(circle at 0 0, transparent 11.5px, var(--color-embun) 12px); }
    .ck-tombol[aria-selected='true']::after { right: -12px; background: radial-gradient(circle at 100% 0, transparent 11.5px, var(--color-embun) 12px); }
    .ck-kartu { border-radius: 16px; }
    .ck-panel { padding: 1.4rem 1.25rem 1.5rem; gap: 1rem; min-height: 0; align-items: start; align-content: start; }
    .ck-judul { font-size: var(--hp-t2); line-height: 1.27; letter-spacing: -0.011em; max-width: 16ch; }
    .ck-pegang { font-size: var(--hp-t4); line-height: 1.35; }
    .ck-pegang span { font-size: var(--fs-13); margin-bottom: 0.3rem; }
    .ck-isi { font-size: var(--fs-15); line-height: 1.5; }
  }
  .ck-tahap { display: none; }
  /* HP: tujuh kartu bertumpuk (referensi Framer "Perform"): tiap kartu menempel di bawah bilah atas,
     kartu berikutnya naik menimpanya dengan selisih 10 px sehingga tumpukan terlihat. */
  @media (max-width: 47.99rem) {
    .ck-tab { display: none; }
    .ck-kartu { display: grid; gap: 14px; background: none; border-radius: 0; }
    .ck-panel, .ck-panel[data-aktif='false'] {
      grid-area: auto; opacity: 1; translate: none; visibility: visible; transition: none;
      position: sticky; top: calc(64px + env(safe-area-inset-top) + var(--i) * 10px);
      background: var(--color-embun); border-radius: 18px; min-height: 15.5rem;
      box-shadow: 0 -10px 28px -18px rgb(0 0 0 / 0.55);
    }
    .ck-tahap { display: flex; align-items: center; gap: 0.5rem; font-size: var(--fs-13); font-weight: 500; color: var(--color-lumut); }
    .ck-tahap span {
      display: inline-grid; place-items: center; min-width: 1.75rem; height: 1.75rem; padding-inline: 0.4rem; border-radius: 999px;
      background: var(--color-pinus); color: var(--color-tunas); font-size: var(--fs-13); font-variant-numeric: tabular-nums;
    }
  }
</style>
