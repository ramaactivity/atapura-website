---
import LapisanGambar from './LapisanGambar.astro';
// ringkas: beranda hanya diagram + nama lapis; uraian tiap lapis di /cara-kerja (DECISIONS 072).
interface Props { ringkas?: boolean }
const { ringkas = false } = Astro.props;
// Penampang atap bitumen terurai, digambar isometrik (sumbu 2:1). Nomor = urutan pemasangan;
// daftar ditampilkan dari atas (Nok) ke bawah (Alas) supaya sejajar dengan gambarnya.
const lapis = [
  {
    id: 'alas',
    y: 86, // posisi tengah lapis di gambar (% tinggi), untuk label desktop
    sisi: 'kiri',
    nama: 'Alas',
    isi: 'Papan rata (multiplek atau GRC) yang dipasang di atas rangka. Genteng bitumen lentur, jadi kerataan alas menentukan kerapian hasil akhir.',
  },
  {
    id: 'underlayment',
    y: 64, // posisi tengah lapis di gambar (% tinggi), untuk label desktop
    sisi: 'kanan',
    nama: 'Underlayment',
    isi: 'Lembaran kedap air di atas alas. Kalau ada air yang lolos dari genteng, lapisan ini yang menahannya agar tidak sampai ke plafon.',
  },
  {
    id: 'flashing',
    y: 49, // posisi tengah lapis di gambar (% tinggi), untuk label desktop
    sisi: 'kiri',
    nama: 'Flashing',
    isi: 'Pelapis di titik rawan: pertemuan atap dengan dinding, talang, dan tepi atap. Di sini paling sering kebocoran bermula.',
  },
  {
    id: 'genteng',
    y: 26, // posisi tengah lapis di gambar (% tinggi), untuk label desktop
    sisi: 'kanan',
    nama: 'Genteng bitumen',
    isi: 'Lembaran fiberglass berlapis aspal dan butiran batu, dipasang dari bawah ke atas dengan pola paku sesuai panduan pabrik.',
  },
  {
    id: 'nok',
    y: 12, // posisi tengah lapis di gambar (% tinggi), untuk label desktop
    sisi: 'kiri',
    nama: 'Nok',
    isi: 'Penutup bubungan, garis puncak tempat dua sisi atap bertemu. Dipasang terakhir dan menutup sambungan paling atas.',
  },
];

---

<div class:list={["lapisan", { "lapisan-ringkas": ringkas }]} data-lapisan>
  <figure class="lapisan-gambar" aria-hidden="true">
    <LapisanGambar />
  </figure>

  <ol class="lapisan-daftar" reversed>
    {lapis.map((l, i) => ({ ...l, no: i + 1 })).reverse().map((l) => (
      <li class={`sisi-${l.sisi}`} style={`--y: ${l.y}%`}>
        <button type="button" class="lapis" data-pilih={l.id} aria-pressed="false">
          <span class="lapis-no angka">{l.no}</span>
          <span class="lapis-teks">
            <span class="lapis-nama">{l.nama}</span>
            <span class="lapis-isi">{l.isi}</span>
          </span>
        </button>
      </li>
    ))}
  </ol>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-lapisan]')) {
    const tombol = root.querySelectorAll<HTMLButtonElement>('[data-pilih]');
    const pilih = (id: string | null) => {
      if (id) root.dataset.aktif = id;
      else delete root.dataset.aktif;
      tombol.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pilih === id)));
    };
    tombol.forEach((b) => {
      b.addEventListener('click', () => pilih(b.dataset.pilih!));
      b.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && pilih(b.dataset.pilih!));
    });
    root.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && pilih(null));

    // HP (gambar menempel di atas): lapis yang menyala mengikuti teks yang sedang dibaca saat menggulir,
    // jadi gambar dan teks selalu sinkron. Garis baca = sedikit di bawah gambar yang menempel.
    const hp = matchMedia('(max-width: 59.99rem)');
    if (hp.matches) {
      const gambar = root.querySelector<HTMLElement>('.lapisan-gambar')!;
      const item = [...tombol];
      let antre = 0;
      const ikut = () => {
        antre = 0;
        const r = root.getBoundingClientRect();
        if (r.bottom < 0 || r.top > innerHeight) return;
        const garis = gambar.getBoundingClientRect().bottom + (innerHeight - gambar.offsetHeight) * 0.3;
        let pilihan = item[0];
        for (const b of item) if (b.getBoundingClientRect().top <= garis) pilihan = b;
        if (root.dataset.aktif !== pilihan.dataset.pilih) pilih(pilihan.dataset.pilih!);
      };
      addEventListener('scroll', () => { if (!antre) antre = requestAnimationFrame(ikut); }, { passive: true });
      ikut();
      continue;
    }

    // Desktop — tur otomatis: saat terlihat, lapis menyala bergiliran sampai pengunjung menyentuh/menyorot diagram.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const urutan = [...tombol].map((b) => b.dataset.pilih!).reverse();
      let i = 0, id = 0, berhenti = false;
      const stop = () => { berhenti = true; clearInterval(id); };
      root.addEventListener('pointerdown', stop, { once: true });
      root.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && stop(), { once: true });
      root.addEventListener('focusin', stop, { once: true });
      new IntersectionObserver(([e]) => {
        clearInterval(id);
        if (berhenti) return;
        if (e.isIntersecting) id = window.setInterval(() => pilih(urutan[i++ % urutan.length]), 2600);
        else pilih(null);
      }, { threshold: 0.45 }).observe(root);
    }
  }
</script>

<style>
  .lapisan {
    display: grid; gap: clamp(2rem, 4vw, 4rem); align-items: center;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 60rem) { .lapisan { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .lapisan-gambar { margin: 0; max-width: 34rem; width: 100%; justify-self: center; }
  .lapisan-gambar :global(svg) { width: 100%; height: auto; overflow: visible; }

  .lapisan-daftar { display: grid; gap: 0.25rem; counter-reset: none; }
  .lapis {
    display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); gap: 1rem; align-items: start;
    width: 100%; text-align: left; padding: 1rem 1rem 1rem 0.75rem; border-radius: 1rem;
    cursor: pointer; transition: background-color 250ms;
  }
  .lapis:hover, .lapis[aria-pressed="true"] { background: var(--color-putih); }
  .lapis-no {
    display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 999px;
    border: 1px solid var(--color-garis); font-weight: 500; font-size: var(--fs-15); color: var(--color-lumut);
    transition: background-color 250ms, color 250ms, border-color 250ms;
  }
  .lapis[aria-pressed="true"] .lapis-no { background: var(--color-pinus); border-color: var(--color-pinus); color: var(--color-tunas); }
  .lapis-teks { display: grid; gap: 0.2rem; }
  .lapis-nama { font-weight: var(--bobot-judul-kartu); font-size: var(--t-title); letter-spacing: -0.006em; line-height: 1.4; }
  .lapis-isi { color: var(--color-lumut); }

  /* Desktop: gambar di tengah, label menempel di kiri-kanan sejajar lapisnya, dengan garis penunjuk. */
  @media (min-width: 60rem) {
    .lapisan { display: block; position: relative; }
    .lapisan-gambar { width: min(40rem, 42%); margin-inline: auto; }
    .lapisan-daftar { position: absolute; inset: 0; display: block; }
    .lapisan-daftar li { position: absolute; top: var(--y); width: 27%; transform: translateY(-50%); }
    .lapisan-daftar .lapis { padding: 0.7rem 0.75rem; gap: 0.75rem; }
    .lapisan-daftar .lapis-isi { font-size: var(--fs-14); line-height: 1.45; }
    .lapisan-daftar .lapis-nama { font-size: var(--fs-17); }
    .sisi-kiri { left: 0; }
    .sisi-kanan { right: 0; }
    .sisi-kiri .lapis { grid-template-columns: minmax(0, 1fr) 2.25rem; text-align: right; }
    .sisi-kiri .lapis-no { order: 2; }
    .lapis { background: rgb(242 244 241 / 0.86); }
    .lapisan-daftar li::after {
      content: ''; position: absolute; top: 50%; width: 6.5vw; height: 1px; pointer-events: none;
      background: linear-gradient(90deg, var(--color-lumut), var(--color-lumut)) no-repeat;
      opacity: 0.45; transition: opacity 300ms, background-color 300ms;
    }
    .sisi-kiri::after { left: 100%; }
    .sisi-kanan::after { right: 100%; }
    .lapisan-daftar li::before {
      content: ''; position: absolute; top: calc(50% - 3px); width: 7px; height: 7px; border-radius: 50%;
      background: var(--color-pinus); pointer-events: none;
    }
    .sisi-kiri::before { left: calc(100% + 6.5vw - 3px); }
    .sisi-kanan::before { right: calc(100% + 6.5vw - 3px); }
    .lapisan-daftar li:has([aria-pressed="true"])::after { opacity: 1; }
  }
  /* HP/tablet: ditaruh paling akhir supaya tidak tertimpa aturan dasar .lapis di atas.
     Panel gambar menempel seperti bilah iOS: kaca buram tipis, garis kotak latar tetap tembus,
     teks yang lewat di bawahnya terburamkan (bukan tumpang-tindih setengah pudar). */
  @media (max-width: 59.99rem) {
    .lapisan-gambar {
      position: sticky; top: 0; z-index: 2; height: 30svh; padding-block: 0.75rem; overflow: hidden;
      max-width: none; margin-inline: calc(-1 * var(--gutter)); width: calc(100% + 2 * var(--gutter));
      /* Pola kotak yang sama dengan latar .anatomi (48 px, garis tegak sejajar karena panel selebar layar). */
      background:
        linear-gradient(rgb(76 94 85 / 0.07) 1px, transparent 1px) 0 -1px / 48px 48px,
        linear-gradient(90deg, rgb(76 94 85 / 0.07) 1px, transparent 1px) -1px 0 / 48px 48px,
        rgb(242 244 241 / 0.6);
      -webkit-backdrop-filter: blur(14px) saturate(1.3); backdrop-filter: blur(14px) saturate(1.3);
      box-shadow: 0 1px 0 rgb(16 35 30 / 0.08);
    }
    .lapisan-gambar :global(svg) { height: 100%; width: 100%; overflow: hidden; }
    .lapisan-daftar { gap: 0.25rem; padding-top: 0.75rem; }
    .lapis { padding: 0.8rem 0.9rem 0.85rem 0.6rem; gap: 0.75rem; grid-template-columns: 1.9rem minmax(0, 1fr); border-radius: 14px; }
    .lapis[aria-pressed="true"] { box-shadow: 0 8px 24px -16px rgb(16 35 30 / 0.35); }
    .lapis-no { width: 1.9rem; height: 1.9rem; font-size: var(--fs-13); }
    .lapis-nama { font-size: var(--hp-t4); }
    .lapis-isi { font-size: var(--fs-15); line-height: 1.5; }
  }
  /* Ringkas: tanpa uraian; pelat label memeluk namanya saja supaya tidak ada kotak kosong di atas grid. */
  .lapisan-ringkas .lapis-isi { display: none; }
  .lapisan-ringkas .lapis { width: fit-content; background: none; }
  .lapisan-ringkas .sisi-kiri .lapis { margin-left: auto; }
  .lapisan-ringkas .lapis:hover, .lapisan-ringkas .lapis[aria-pressed="true"] { background: var(--color-putih); }
</style>
