---
// Bulatan contoh warna untuk pricelist: foto tekstur yang diwarnai ulang bila ada, kalau tidak warna perkiraan layar (hex),
// kalau keduanya tidak ada inisial nama. Ukuran diatur lewat class `bulat` di halaman pemakainya.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  w: { nama: string; hex?: string; foto?: ImageMetadata };
  /** Ubin besar (katalog warna): foto lebih tajam supaya motif potongan terlihat. */
  besar?: boolean;
}
const { w, besar = false } = Astro.props;
const px = besar ? 360 : 160;
---

{w.foto ? (
  <Image loading="eager" format="jpg" quality={85} src={w.foto} alt="" width={px} height={besar ? Math.round(px * 0.8) : px} class="bulat" />
) : w.hex ? (
  <span class="bulat bulat-hex" style={`background:${w.hex}`} aria-hidden="true"></span>
) : (
  <span class="bulat bulat-kosong" aria-hidden="true">{w.nama.slice(0, 1)}</span>
)}
