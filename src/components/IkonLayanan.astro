---
// Ikon garis untuk kartu layanan (digambar sendiri, satu gaya: 24 px, garis 1,6, ujung bulat).
interface Props {
  nama: 'atap-baru' | 'ganti-atap' | 'bocor' | 'proyek' | 'plafon' | 'rangka';
}
const { nama } = Astro.props;
const jalur: Record<Props['nama'], string[]> = {
  'atap-baru': ['M3 11.5 12 4l9 7.5', 'M5.5 9.8v9.7h13V9.8', 'M10 19.5v-5h4v5'],
  'ganti-atap': ['M3 10.5 12 3.5l9 7', 'M7.5 15.5a4.5 4.5 0 0 1 7.9-2.4', 'M16.5 16.5a4.5 4.5 0 0 1-7.9 2.4', 'M15.6 10.6v2.7h-2.7', 'M8.4 21.4v-2.7h2.7'],
  bocor: ['M3 7.5 12 3l9 4.5', 'M12 9.5c2.4 3 4 5.2 4 7.2a4 4 0 0 1-8 0c0-2 1.6-4.2 4-7.2Z'],
  proyek: ['M3.5 20.5h17', 'M6 20.5V8.5l6-4.5 6 4.5v12', 'M9.5 11.5h1.2M13.3 11.5h1.2M9.5 15h1.2M13.3 15h1.2'],
  plafon: ['M3 4.5h18', 'M3 8.5h18', 'M7.5 4.5v4M12 4.5v4M16.5 4.5v4', 'M12 8.5v3', 'M9.8 14a2.2 2.2 0 0 1 4.4 0Z', 'M5 20.5v-6M19 20.5v-6'],
  rangka: ['M2.5 17.5 12 6l9.5 11.5Z', 'M12 6v11.5', 'M7.2 11.8 12 17.5l4.8-5.7'],
};
---

<svg class="ikon-layanan" viewBox="0 0 24 24" aria-hidden="true">
  {jalur[nama].map((d) => <path d={d} />)}
</svg>

<style>
  .ikon-layanan { width: 1.5rem; height: 1.5rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
</style>
