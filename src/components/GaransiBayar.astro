---
// Cara pembayaran + garansi pemasangan (dipindah dari beranda ke /garansi, DECISIONS 072).
// Kartu termin berlatar Embun, kartu garansi berlatar Pinus: taruh di atas bidang Putih.
import { bisnis } from '../data/bisnis';
---
<div class="gb">
  <div class="gb-termin">
    <h3 class="gb-judul">Cara pembayaran</h3>
    <div class="bayar-material">
      <p class="bayar-label">Material</p>
      <p class="bayar-isi"><b>Lunas sebelum dikirim.</b> Material dipesan khusus untuk atap Anda, jadi dibayar penuh sebelum diantar ke lokasi.</p>
    </div>
    <p class="bayar-label bayar-label-jasa">Jasa pasang, bertahap</p>
    <ol class="termin">
      {bisnis.pembayaran.jasa.map((t) => (
        <li>
          <span class="termin-persen">{t.persen}<span>%</span></span>
          <span class="termin-teks"><b>{t.tahap}</b>{t.saat}</span>
        </li>
      ))}
    </ol>
    <p class="gb-catatan">Setiap termin jasa disertai foto progres.</p>
  </div>
  <div class="gb-garansi">
    <p class="garansi-angka">{bisnis.garansiPemasanganTahun}<span>tahun</span></p>
    <p class="garansi-sub">Garansi pemasangan, berlaku sejak serah terima.</p>
    <div class="garansi-dua">
      <div>
        <h3 class="gb-label">Yang ditanggung</h3>
        <ul class="garansi-daftar">{bisnis.garansi.cakupan.map((c) => <li>{c}</li>)}</ul>
      </div>
      <div>
        <h3 class="gb-label">Yang tidak ditanggung</h3>
        <ul class="garansi-daftar garansi-tidak">{bisnis.garansi.pengecualian.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>
  </div>
</div>

<style>
  .gb { display: grid; gap: 1.5rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 64rem) { .gb { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); } }
  .gb-judul { font-size: 1.25rem; font-weight: 500; letter-spacing: -0.02em; margin-bottom: 1.25rem; }
  .gb-label { font-size: 0.85rem; font-weight: 500; color: var(--color-lumut); margin-bottom: 0.6rem; }
  .gb-termin { padding: clamp(1.5rem, 3vw, 2.5rem); border-radius: 16px; background: var(--color-embun); color: var(--color-tinta); }
  .bayar-label { font-size: 0.85rem; font-weight: 500; color: var(--color-lumut); }
  .bayar-material { padding-bottom: 1.25rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-garis); display: grid; gap: 0.35rem; }
  .bayar-isi { color: var(--color-lumut); font-size: 0.95rem; }
  .bayar-isi b { color: var(--color-tinta); font-weight: 500; }
  .bayar-label-jasa { margin-bottom: 0.6rem; }
  .termin { border-top: 1px solid var(--color-tinta); }
  .termin li { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1rem; align-items: center; padding: 1.2rem 0; border-bottom: 1px solid var(--color-garis); }
  .termin-persen { font-size: 3rem; font-weight: 500; letter-spacing: -0.04em; line-height: 1; font-variant-numeric: tabular-nums; }
  .termin-persen span { font-size: 0.45em; color: var(--color-lumut); margin-left: 0.05em; }
  .termin-teks { display: grid; color: var(--color-lumut); font-size: 0.95rem; }
  .termin-teks b { color: var(--color-tinta); font-weight: 500; font-size: 1.05rem; }
  .gb-catatan { margin-top: 1rem; font-size: 0.88rem; color: var(--color-lumut); }
  .gb-garansi { padding: clamp(1.5rem, 3vw, 2.5rem); border-radius: 16px; background: var(--color-pinus); color: var(--color-embun); }
  .garansi-angka { font-size: clamp(5rem, 3rem + 6vw, 8rem); font-weight: 500; letter-spacing: -0.05em; line-height: 0.9; }
  .garansi-angka span { font-size: 0.22em; letter-spacing: -0.01em; margin-left: 0.3em; color: var(--color-tunas); }
  .garansi-sub { margin-top: 0.75rem; color: var(--embun-redup); }
  .garansi-dua { margin-top: 2rem; display: grid; gap: 1.5rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 48rem) { .garansi-dua { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .gb-garansi .gb-label { color: rgb(242 244 241 / 0.6); }
  .garansi-daftar { display: grid; gap: 0.5rem; font-size: 0.93rem; }
  .garansi-daftar li { padding-left: 1.4rem; position: relative; color: var(--color-embun); }
  .garansi-daftar li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 0.6rem; height: 0.35rem; border-left: 1.5px solid var(--color-tunas); border-bottom: 1.5px solid var(--color-tunas); transform: rotate(-45deg); }
  .garansi-tidak li { color: var(--embun-redup); }
  .garansi-tidak li::before { width: 0.6rem; height: 0; border-left: 0; border-bottom: 1.5px solid rgb(242 244 241 / 0.45); transform: none; top: 0.7em; }
  @media (max-width: 47.99rem) {
    /* HP: kartu 5 tahun dulu, sesuai janji judul halaman /garansi. */
    .gb-garansi { order: -1; }
    .gb-judul { font-size: var(--hp-t4); margin-bottom: 0.9rem; }
    .termin-persen { font-size: var(--hp-angka); }
    .garansi-angka { font-size: var(--hp-angka-besar); }
  }
</style>
