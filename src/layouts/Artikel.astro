---
// Kerangka halaman berformat "jawaban dulu" (ai-seo): dipakai /panduan/* dan /area/*.
// Sumber ditampilkan dan ikut ke schema `citation` supaya klaim bisa dilacak manusia maupun mesin.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { bisnis, waLink } from '../data/bisnis';

interface Props {
  judul: string;
  ringkasan: string;
  jawaban: string;
  penulis: string;
  diperbarui: Date;
  sampul: ImageMetadata;
  sampulAlt: string;
  induk: { nama: string; href: string };
  label: string;
  faq: { q: string; a: string }[];
  sumber: { nama: string; url?: string }[];
  cta?: string;
  waPesan: string;
  dataWa: string;
  lainJudul?: string;
  lain: { href: string; label: string; judul: string; sampul?: ImageMetadata; ringkasan?: string; menit?: number }[];
  /** Halaman situs yang dibahas artikel (merek, cara kerja, garansi, area), DECISIONS 074. */
  halaman?: { href: string; label: string }[];
  /** Schema khusus halaman (Article/Service, dst.); Breadcrumb & FAQPage dibuat di sini. */
  schema: object[];
  lang?: 'id' | 'en';
  /** Versi bahasa lain (hreflang), diteruskan ke Base. */
  alternates?: { hreflang: string; href: string }[];
}

const TEKS = {
  id: { beranda: 'Beranda', remah: 'Remah roti', oleh: 'Oleh', diperbarui: 'Diperbarui', jawaban: 'Jawaban singkat', faq: 'Pertanyaan terkait', sumber: 'Sumber angka', ctaJudul: 'Hitung biaya untuk atap Anda.', ctaHitung: 'Buka Hitung AKAL', ctaWa: 'Tanya lewat WhatsApp', lain: 'Baca juga', ilustrasi: 'Ilustrasi, bukan proyek Atapura.', locale: 'id-ID' },
  en: { beranda: 'Home', remah: 'Breadcrumb', oleh: 'By', diperbarui: 'Updated', jawaban: 'Short answer', faq: 'Related questions', sumber: 'Sources', ctaJudul: 'Talk to us about your roof.', ctaHitung: 'Open the cost estimator (Indonesian)', ctaWa: 'Chat on WhatsApp', lain: 'Read next', ilustrasi: 'Illustration, not an Atapura project.', locale: 'en-GB' },
} as const;

const {
  judul, ringkasan, jawaban, penulis, diperbarui, sampul, sampulAlt, induk, label, faq, sumber, waPesan, dataWa, lain, halaman = [],
  cta = `Masukkan luas dan merek, estimasinya langsung terlihat. Melayani seluruh Jabodetabek hingga luar Pulau Jawa.`,
  lang = 'id',
  alternates = [],
} = Astro.props;
const t = TEKS[lang];
const lainJudul = Astro.props.lainJudul ?? t.lain;
const situs = new URL('/', Astro.site).href;
const url = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site).href;
const tgl = (x: Date) => x.toLocaleDateString(t.locale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' });
const schema = [
  ...Astro.props.schema,
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.beranda, item: situs },
      { '@type': 'ListItem', position: 2, name: induk.nama, item: new URL(induk.href, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: judul, item: url },
    ],
  },
  ...(faq.length
    ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]
    : []),
];
---

<Base title={`${judul} | Atapura`} description={ringkasan} schema={schema} lang={lang} alternates={alternates}>
  <Header terang lang={lang} />
  <main class="ar">
    <article>
      <header class="wrap ar-kepala">
        <nav class="remah" aria-label={t.remah}><a href="/">{t.beranda}</a><span aria-hidden="true">/</span><a href={induk.href}>{induk.nama}</a><span aria-hidden="true">/</span><span>{label}</span></nav>
        <h1 class="ar-judul">{judul}</h1>
        <p class="ar-meta">{t.oleh} {penulis}<span class="ar-pisah" aria-hidden="true"></span>{t.diperbarui} <time datetime={diperbarui.toISOString()}>{tgl(diperbarui)}</time></p>
      </header>
      {/* Semua sampul gambar AI (Magnific), jadi diberi keterangan terlihat, seperti galeri produk (DECISIONS 082). */}
      <figure class="wrap">
        <Image src={sampul} alt={sampulAlt} widths={[640, 720, 1024, 1600]} sizes="(min-width: 64rem) 1200px, calc(100vw - 2rem)" class="ar-sampul" loading="eager" />
        <figcaption class="ar-sampul-ket">{t.ilustrasi}</figcaption>
      </figure>
      <div class="wrap ar-badan">
        <aside class="ar-jawab" aria-label={t.jawaban}>
          <p class="ar-jawab-label">{t.jawaban}</p>
          <p class="ar-jawab-isi">{jawaban}</p>
        </aside>
        <div class="ar-utama">
        <slot name="awal" />
        <div class="prosa"><slot /></div>

        {faq.length > 0 && (
          <section class="ar-faq" aria-labelledby="faq-judul">
            <h2 id="faq-judul">{t.faq}</h2>
            <dl>{faq.map((f) => <div><dt>{f.q}</dt><dd>{f.a}</dd></div>)}</dl>
          </section>
        )}

        {sumber.length > 0 && (
          <section class="ar-sumber" aria-labelledby="sumber-judul">
            <h2 id="sumber-judul">{t.sumber}</h2>
            <ul>{sumber.map((s) => <li>{s.url ? <a href={s.url} rel="noopener" target="_blank">{s.nama}</a> : s.nama}</li>)}</ul>
          </section>
        )}

        <aside class="ar-cta">
          <p class="ar-cta-judul">{t.ctaJudul}</p>
          <p>{cta}</p>
          <div class="ar-cta-aksi">
            <a class="pill pill-tunas" href="/hitung">{t.ctaHitung}</a>
            <a class="pill pill-garis" href={waLink(waPesan)} target="_blank" rel="noopener" data-wa={dataWa}>{t.ctaWa}</a>
          </div>
        </aside>
        </div>
      </div>
    </article>

    {lain.length > 0 && (
      <section class="wrap ar-lain" aria-labelledby="lain-judul">
        <h2 id="lain-judul">{lainJudul}</h2>
        <ul class="ar-kartu-daftar">{lain.map((x) => (
          <li><a class="ar-kartu" href={x.href}>
            {x.sampul && <Image src={x.sampul} alt="" widths={[200, 480, 720]} sizes="(min-width: 48rem) 30vw, 88px" class="ar-kartu-foto" />}
            <span class="ar-kartu-teks">
              <span class="ar-kartu-meta">{x.label}{x.menit && <> · {x.menit} menit baca</>}</span>
              <span class="ar-kartu-judul">{x.judul}</span>
              {x.ringkasan && <span class="ar-kartu-ringkas">{x.ringkasan}</span>}
            </span>
          </a></li>
        ))}</ul>
        {halaman.length > 0 && (
          <nav class="ar-halaman" aria-label="Halaman terkait">
            <p class="ar-halaman-judul">Halaman terkait</p>
            <ul>{halaman.map((h) => <li><a class="tautan-lanjut" href={h.href}>{h.label}</a></li>)}</ul>
          </nav>
        )}
      </section>
    )}
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .ar { background: var(--color-embun); color: var(--color-tinta); padding: 120px 0 6rem; }
  .remah { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: var(--fs-14); color: var(--color-lumut); }
  .remah a { color: inherit; }
  .ar-kepala { padding-bottom: 2rem; }
  .ar-judul { margin-top: 1.5rem; font-size: var(--t-d2); font-weight: var(--bobot-judul); letter-spacing: -0.035em; line-height: 1.04; max-width: 20ch; }
  .ar-meta { margin-top: 1.25rem; font-size: var(--fs-15); color: var(--color-lumut); display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .ar-pisah { width: 18px; height: 1px; background: currentColor; }
  .ar-sampul { width: 100%; max-height: 34rem; object-fit: cover; border-radius: 18px; }
  .ar-sampul-ket { margin-top: 0.55rem; font-size: var(--fs-13); color: var(--color-lumut); }
  /* Lebar penuh sejajar judul (DESIGN.md: tanpa kolom sempit di tengah). Mulai 60rem dua kolom:
     jawaban singkat menempel di kiri, isi di kanan dengan panjang baris tetap nyaman dibaca. */
  .ar-badan { padding-top: 3rem; display: grid; gap: 2.5rem 4rem; grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 60rem) {
    .ar-badan { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); }
    .ar-jawab { position: sticky; top: 6.5rem; }
  }
  .ar-utama { min-width: 0; }
  .ar-utama > .prosa { margin-top: 0; }
  .ar-utama > .prosa > :global(:first-child) { margin-top: 0; }
  .ar-jawab { padding: 1.5rem 1.75rem; border-radius: 14px; background: var(--color-pinus); color: var(--color-embun); }
  .ar-jawab-label { font-size: var(--fs-13); font-weight: 500; color: var(--color-tunas); margin-bottom: 0.5rem; }
  .ar-jawab-isi { font-size: 1.15rem; line-height: 1.5; }

  .prosa { margin-top: 2.5rem; font-size: var(--fs-16); line-height: 1.5; } /* body-md Notion (DECISIONS 092) */
  .prosa :global(h2) { font-size: var(--t-h2); font-weight: var(--bobot-judul); letter-spacing: -0.024em; line-height: 1.23; margin: 3rem 0 1rem; }
  .prosa :global(p) { margin: 1rem 0; }
  .prosa :global(ul), .prosa :global(ol) { margin: 1rem 0; padding-left: 1.4rem; }
  .prosa :global(ul) { list-style: disc; }
  .prosa :global(ol) { list-style: decimal; }
  .prosa :global(li) { margin: 0.45rem 0; padding-left: 0.2rem; }
  .prosa :global(strong) { font-weight: 600; }
  .prosa :global(a) { color: var(--color-pinus); text-decoration: underline; }
  .prosa :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: var(--fs-15); display: block; overflow-x: auto; }
  @media (min-width: 48rem) { .prosa :global(table) { display: table; } }
  .prosa :global(th), .prosa :global(td) { text-align: left; vertical-align: top; padding: 0.75rem 1rem 0.75rem 0; border-bottom: 1px solid var(--color-garis); }
  .prosa :global(thead th) { font-weight: 500; color: var(--color-lumut); font-size: var(--fs-14); border-bottom: 1px solid var(--color-tinta); }

  .ar-faq, .ar-sumber { margin-top: 3.5rem; }
  .ar-faq h2, .ar-sumber h2, .ar-lain h2 { font-size: var(--t-h3); font-weight: var(--bobot-judul); letter-spacing: -0.011em; margin-bottom: 1rem; line-height: 1.27; }
  .ar-faq dl > div { padding: 1.1rem 0; border-top: 1px solid var(--color-garis); }
  .ar-faq dt { font-weight: var(--bobot-judul-kartu); font-size: var(--t-title); letter-spacing: -0.006em; line-height: 1.4; }
  .ar-faq dd { margin-top: 0.35rem; color: var(--color-lumut); }
  .ar-sumber li { color: var(--color-lumut); font-size: var(--fs-15); margin: 0.4rem 0; }
  .ar-sumber a { color: inherit; }
  .ar-cta { margin-top: 3.5rem; padding: clamp(1.5rem, 3vw, 2.25rem); border-radius: 16px; background: var(--color-pinus); color: var(--color-embun); }
  .ar-cta-judul { font-size: var(--t-h2); font-weight: var(--bobot-judul); letter-spacing: -0.024em; line-height: 1.23; }
  .ar-cta p:not(.ar-cta-judul) { margin-top: 0.4rem; color: var(--embun-redup); }
  .ar-cta-aksi { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.25rem; }
  .ar-lain { margin-top: 5rem; }
  /* Baca juga (DECISIONS 074): kartu bersampul. Laptop: foto di atas; HP: baris gaya aplikasi berita (gambar kecil di kiri). */
  .ar-kartu-daftar { display: grid; gap: 0.75rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 48rem) { .ar-kartu-daftar { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; } }
  .ar-kartu {
    display: grid; grid-template-rows: auto 1fr; height: 100%; overflow: hidden; border-radius: 16px; background: var(--color-putih); color: inherit; text-decoration: none;
    box-shadow: 0 1px 2px rgb(16 35 30 / 0.06), 0 18px 36px -28px rgb(16 35 30 / 0.4);
    transition: transform 400ms var(--ease-out), box-shadow 400ms var(--ease-out);
  }
  .ar-kartu :global(.ar-kartu-foto) { display: block; width: 100%; aspect-ratio: 16 / 10; height: auto; object-fit: cover; transition: transform 700ms var(--ease-out); }
  .ar-kartu-teks { display: grid; align-content: start; gap: 0.45rem; padding: 1.1rem 1.25rem 1.35rem; }
  .ar-kartu-meta { font-size: var(--fs-13); color: var(--color-lumut); }
  .ar-kartu-judul { font-family: var(--font-merek); font-size: var(--t-title); font-weight: var(--bobot-judul-kartu); letter-spacing: -0.006em; line-height: 1.4; }
  .ar-kartu-ringkas { font-size: var(--fs-14); line-height: 1.5; color: var(--color-lumut); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ar-kartu:focus-visible { outline: 2px solid var(--color-pinus); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .ar-kartu:hover { transform: translateY(-3px); box-shadow: 0 1px 2px rgb(16 35 30 / 0.06), 0 26px 44px -26px rgb(16 35 30 / 0.45); }
    .ar-kartu:hover :global(.ar-kartu-foto) { transform: scale(1.04); }
  }
  .ar-halaman { margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--color-garis); }
  .ar-halaman-judul { font-size: var(--fs-14); font-weight: 500; color: var(--color-lumut); }
  .ar-halaman ul { display: flex; flex-wrap: wrap; gap: 0 1.75rem; margin-top: 0.25rem; }
  .ar-halaman a { display: inline-flex; padding: 0; background: none; border-radius: 0; font-weight: 500; letter-spacing: 0; text-decoration: underline; }
  .ar-halaman a:hover { transform: none; }

  /* Skala HP (token --hp-* di global.css); harus setelah aturan dasar supaya tidak tertimpa. */
  @media (max-width: 47.99rem) {
    .ar { padding-top: 96px; }
    .ar-judul { font-size: var(--hp-t1); line-height: 1.15; }
    .ar-meta { font-size: var(--fs-13); }
    .ar-jawab { padding: 1.25rem; }
    .ar-jawab-isi { font-size: var(--fs-16); }
    .prosa :global(h2) { font-size: var(--hp-t2); margin: 2.25rem 0 0.75rem; }
    .prosa :global(h3) { font-size: var(--hp-t3); }
    .prosa :global(table) { font-size: var(--fs-15); }
    .ar-faq h2, .ar-sumber h2, .ar-lain h2 { font-size: var(--hp-t2); }
    .ar-faq dt { font-size: var(--hp-t4); }
    .ar-faq dd, .ar-sumber li { font-size: var(--fs-15); }
    .ar-cta-judul { font-size: var(--hp-t2); }
    .ar-kartu { grid-template-columns: 88px minmax(0, 1fr); grid-template-rows: auto; align-items: center; gap: 0.9rem; padding: 0.6rem; border-radius: 16px; }
    .ar-kartu :global(.ar-kartu-foto) { aspect-ratio: 1; border-radius: 11px; }
    .ar-kartu-teks { padding: 0.15rem 0.4rem 0.15rem 0; gap: 0.3rem; }
    .ar-kartu-judul { font-size: var(--fs-15); line-height: 1.3; }
    .ar-kartu-meta { font-size: var(--fs-13); }
    .ar-kartu-ringkas { display: none; }
    /* Pola kartu HP sama dengan beranda: latar abu hangat, isi jadi kartu membulat. */
    .ar { background: #dde2dc; padding-bottom: 1rem; }
    .ar article { margin: 8px; padding: 1.5rem 0 2rem; border-radius: 28px; background: var(--color-embun); overflow: clip; }
    .ar-lain { margin: 8px; padding: 1.75rem calc(var(--gutter) - 8px); border-radius: 28px; background: var(--color-embun); }
    .ar-halaman a { font-size: var(--fs-15); }
    .ar-halaman ul { gap: 0 1.25rem; }
    .ar-kartu-daftar { margin-top: 0.25rem; gap: 0.5rem; }
  }
</style>
