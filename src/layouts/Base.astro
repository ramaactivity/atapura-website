---
import '../styles/global.css';
import { harga } from '../data/harga';
import { bisnis, TAMPIL_PLAFON } from '../data/bisnis';

interface Props {
  title: string;
  description: string;
  /** JSON-LD tambahan khusus halaman (FAQPage, BreadcrumbList, dst.). */
  schema?: object[];
  /** Gambar pratinjau share (relatif dari root). */
  ogImage?: string;
  /** Halaman internal: jangan diindeks walau situs sudah keluar dari mode konsep. */
  noindex?: boolean;
  /** Bahasa halaman. 'en' untuk artikel ekspat di /en/*. */
  lang?: 'id' | 'en';
  /** Versi bahasa lain dari halaman ini (hreflang). */
  alternates?: { hreflang: string; href: string }[];
}

const { title, description, schema = [], ogImage = '/og/beranda.jpg', noindex = false, lang = 'id', alternates = [] } = Astro.props;
// Judul di hasil Google terpotong di ±60–65 karakter: akhiran merek dibuang bila judul jadi terlalu panjang (DECISIONS 078).
const judulTampil = title.endsWith(' | Atapura') && title.length > 65 ? title.slice(0, -' | Atapura'.length) : title;
// build.format 'file' membuat pathname berakhiran .html; canonical selalu versi bersih tanpa .html / slash akhir.
const bersih = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '');
const canonical = new URL(bersih || '/', Astro.site).href;
const siteUrl = new URL('/', Astro.site).href;
const gambar = new URL(ogImage, Astro.site).href;

// Alamat kantor (sementara) + area layanan eksplisit. Field yang belum ada datanya tidak ditulis.
// Rentang harga terpasang per m² (termurah–termahal) untuk priceRange; dari data yang sama dengan kalkulator.
const semuaTerpasang = Object.values(harga.merek).flatMap((m) => m.terpasang);
const rb = (n: number) => `Rp${(n / 1000).toLocaleString('id-ID')} rb`;
const organisasi = {
  '@context': 'https://schema.org',
  '@type': 'RoofingContractor',
  '@id': `${siteUrl}#bisnis`,
  name: bisnis.nama,
  legalName: bisnis.namaLegal,
  description: bisnis.deskripsi,
  priceRange: `${rb(Math.min(...semuaTerpasang))}–${rb(Math.max(...semuaTerpasang))} per m² terpasang`,
  slogan: bisnis.tagline,
  url: siteUrl,
  email: bisnis.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: bisnis.alamat.jalan,
    addressLocality: `${bisnis.alamat.kecamatan}, ${bisnis.alamat.kota}`,
    addressRegion: bisnis.alamat.provinsi,
    postalCode: bisnis.alamat.kodePos,
    addressCountry: 'ID',
  },
  ...((bisnis.telepon ?? bisnis.whatsapp) && { telephone: `+${bisnis.telepon ?? bisnis.whatsapp}` }),
  ...(bisnis.sosmed.length && { sameAs: bisnis.sosmed }),
  areaServed: bisnis.area.map((name) => ({
    '@type': name.startsWith('Kabupaten') ? 'AdministrativeArea' : 'City',
    name: `${name}, Indonesia`,
  })),
  founder: bisnis.pendiri.map((name) => ({ '@type': 'Person', name })),
  knowsAbout: ['atap bitumen', 'genteng aspal', 'asphalt shingle', ...bisnis.merek, ...(TAMPIL_PLAFON ? ['plafon PVC', 'Shunda', 'Javafon'] : []), 'rangka atap baja ringan', 'Taso', 'Hi-Steel', 'K-Steel'],
  image: gambar,
  logo: new URL('/brand/icon-512.png', Astro.site).href,
};
const situs = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#situs`,
  name: bisnis.nama,
  url: siteUrl,
  inLanguage: ['id-ID', 'en'],
  publisher: { '@id': `${siteUrl}#bisnis` },
};
const jsonLd = [organisasi, situs, ...schema];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{judulTampil}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, Astro.site).href} />)}
    {(bisnis.konsep || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preload" href="/fonts/Inter-Variable-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#10231e" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'id_ID'} />
    <meta property="og:site_name" content={bisnis.nama} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={gambar} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    {/* Penghitung kunjungan tanpa cookie (DECISIONS 069): satu beacon kecil per halaman (dan per klik WhatsApp) ke /api/kunjungan → Atapura Ops.
        Tidak jalan di /internal, localhost, robot, dan browser yang dikendalikan otomasi (uji Playwright/Lighthouse). */}
    <script is:inline>
      (function () {
        try {
          var p = location.pathname, n = navigator;
          if (/^\/internal/.test(p) || /^(localhost|127\.)/.test(location.hostname) || !n.sendBeacon || n.webdriver || /bot|headless|lighthouse/i.test(n.userAgent)) return;
          var d = { p: p, r: document.referrer, s: new URLSearchParams(location.search).get('utm_source') };
          n.sendBeacon('/api/kunjungan', JSON.stringify(d));
          // Klik tombol WhatsApp (DECISIONS 079): label = atribut data-wa, dicatat terpisah dari kunjungan di Ops.
          document.addEventListener('click', function (ev) {
            var el = ev.target.closest && ev.target.closest('[data-wa]');
            if (el) n.sendBeacon('/api/kunjungan', JSON.stringify({ p: d.p, r: d.r, s: d.s, e: 'klik-wa', l: el.getAttribute('data-wa') }));
          }, true);
        } catch (e) {}
      })();
    </script>
  </body>
</html>
